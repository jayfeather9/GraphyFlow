#include "generated_host.h"
#include <iostream>
#include <vector>
#include <map>
#include <limits>

// A helper function to reinterpret the bits of an ap_fixed value as an int32_t
// This is used for preparing node distances for the kernel.
static int32_t ap_fixed_to_int32(const ap_fixed<32, 16>& val) {
    return *reinterpret_cast<const int32_t*>(&val);
}

AlgorithmHost::AlgorithmHost(AccDescriptor& acc)
    : acc(acc) {}


// --- PHASE 1: BUFFER SETUP ---
void AlgorithmHost::setup_buffers(const PartitionContainer& container, int start_node) {
    cl_int err;
    std::cout << "--- [Host] Phase 1: Setting up HBM buffers for all kernels ---" << std::endl;

    // 1.1: Initialize global distance vector on the host
    m_num_vertices = container.num_graph_vertices;
    h_distances.assign(m_num_vertices, ap_fixed<32, 16>(INFINITY_DIST));
    if (start_node < m_num_vertices) {
        h_distances[start_node] = 0;
    }

    // 1.2: Clear old buffer handles and resize host-side result vectors
    big_kernel_buffers.clear();
    little_kernel_buffers.clear();
    big_kernel_host_outputs.resize(container.SPs.size());
    little_kernel_host_outputs.resize(container.DPs.size());

    // --- 1.3: Setup buffers for BIG kernels (Sparse Partitions) ---
    for (size_t i = 0; i < container.SPs.size(); ++i) {
        const auto& partition = container.SPs[i];
        const auto& p_graph = partition.partitioned_graph;
        KernelBuffers buffers;

        // Prepare HBM extension pointers for buffer allocation
        cl_mem_ext_ptr_t hbm_ext_in0, hbm_ext_in1, hbm_ext_in2, hbm_ext_out;
        hbm_ext_in0.flags = XCL_MEM_TOPOLOGY | acc.big_kernel_hbm_input_id[i]; hbm_ext_in0.obj = nullptr; hbm_ext_in0.param = 0;
        hbm_ext_in1.flags = XCL_MEM_TOPOLOGY | acc.big_kernel_hbm_input_id[i]; hbm_ext_in1.obj = nullptr; hbm_ext_in1.param = 0;
        hbm_ext_in2.flags = XCL_MEM_TOPOLOGY | acc.big_kernel_hbm_input_id[i]; hbm_ext_in2.obj = nullptr; hbm_ext_in2.param = 0;
        hbm_ext_out.flags = XCL_MEM_TOPOLOGY | acc.big_kernel_hbm_output_id[i]; hbm_ext_out.obj = nullptr; hbm_ext_out.param = 0;

        // Create buffers for static CSR data (offsets and edge properties)
        OCL_CHECK(err, buffers.src_offsets_buf = cl::Buffer(acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX, (p_graph.num_vertices + 1) * sizeof(int), &hbm_ext_in0, &err));
        
        size_t num_edge_bursts = (p_graph.num_edges + PE_NUM - 1) / PE_NUM;
        std::vector<edge_des_burst_t, aligned_allocator<edge_des_burst_t>> edge_bursts(num_edge_bursts);
        for(size_t j=0; j < p_graph.num_edges; ++j) {
            edge_bursts[j / PE_NUM].edges[j % PE_NUM] = { (uint16_t)p_graph.columns[j], p_graph.weights[j] };
        }
        OCL_CHECK(err, buffers.edge_props_buf = cl::Buffer(acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX, num_edge_bursts * sizeof(edge_des_burst_t), &hbm_ext_in1, &err));
        
        // Create buffer for dynamic node distances (will be updated each iteration)
        OCL_CHECK(err, buffers.node_props_buf = cl::Buffer(acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX, p_graph.num_vertices * sizeof(int32_t), &hbm_ext_in2, &err));

        // Create buffer for kernel output
        size_t max_output_batches = (p_graph.num_vertices + PE_NUM - 1) / PE_NUM + 1;
        big_kernel_host_outputs[i].resize(max_output_batches);
        OCL_CHECK(err, buffers.output_buf = cl::Buffer(acc.context, CL_MEM_WRITE_ONLY | CL_MEM_EXT_PTR_XILINX, max_output_batches * sizeof(KernelOutputBatch), &hbm_ext_out, &err));

        big_kernel_buffers.push_back(buffers);
    }

    // --- 1.4: Setup buffers for LITTLE kernels (Dense Partitions) ---
    for (size_t i = 0; i < container.DPs.size(); ++i) {
        // (Logic is identical to big kernels, just using different container and HBM banks)
        const auto& partition = container.DPs[i];
        const auto& p_graph = partition.partitioned_graph;
        KernelBuffers buffers;

        cl_mem_ext_ptr_t hbm_ext_in0, hbm_ext_in1, hbm_ext_in2, hbm_ext_out;
        hbm_ext_in0.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_input_id[i]; hbm_ext_in0.obj = nullptr; hbm_ext_in0.param = 0;
        hbm_ext_in1.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_input_id[i]; hbm_ext_in1.obj = nullptr; hbm_ext_in1.param = 0;
        hbm_ext_in2.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_input_id[i]; hbm_ext_in2.obj = nullptr; hbm_ext_in2.param = 0;
        hbm_ext_out.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_output_id[i]; hbm_ext_out.obj = nullptr; hbm_ext_out.param = 0;
        
        OCL_CHECK(err, buffers.src_offsets_buf = cl::Buffer(acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX, (p_graph.num_vertices + 1) * sizeof(int), &hbm_ext_in0, &err));
        
        size_t num_edge_bursts = (p_graph.num_edges + PE_NUM - 1) / PE_NUM;
        OCL_CHECK(err, buffers.edge_props_buf = cl::Buffer(acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX, num_edge_bursts * sizeof(edge_des_burst_t), &hbm_ext_in1, &err));

        OCL_CHECK(err, buffers.node_props_buf = cl::Buffer(acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX, p_graph.num_vertices * sizeof(int32_t), &hbm_ext_in2, &err));

        size_t max_output_batches = (p_graph.num_vertices + PE_NUM - 1) / PE_NUM + 1;
        little_kernel_host_outputs[i].resize(max_output_batches);
        OCL_CHECK(err, buffers.output_buf = cl::Buffer(acc.context, CL_MEM_WRITE_ONLY | CL_MEM_EXT_PTR_XILINX, max_output_batches * sizeof(KernelOutputBatch), &hbm_ext_out, &err));

        little_kernel_buffers.push_back(buffers);
    }
    
    std::cout << "[SUCCESS] HBM buffers created for " << container.SPs.size() << " big and " << container.DPs.size() << " little kernels." << std::endl;
}

// --- PHASE 2: DATA TRANSFER TO FPGA ---
void AlgorithmHost::transfer_data_to_fpga(const PartitionContainer& container) {
    cl_int err;
    std::cout << "--- [Host] Phase 2: Transferring node distances to HBM ---" << std::endl;

    // 2.1: Transfer data for BIG kernels
    for (size_t i = 0; i < big_kernel_buffers.size(); ++i) {
        const auto& p_graph = container.SPs[i].partitioned_graph;
        std::vector<int32_t> local_node_distances(p_graph.num_vertices);
        for (int local_id = 0; local_id < p_graph.num_vertices; ++local_id) {
            int global_id = p_graph.vtx_map_rev.at(local_id);
            local_node_distances[local_id] = ap_fixed_to_int32(h_distances[global_id]);
        }

        OCL_CHECK(err, err = acc.big_gs_queue[i].enqueueWriteBuffer(
            big_kernel_buffers[i].node_props_buf,
            CL_TRUE, 0,
            local_node_distances.size() * sizeof(int32_t),
            local_node_distances.data()
        ));

        std::vector<edge_des_burst_t> edge_bursts((p_graph.num_edges + PE_NUM - 1) / PE_NUM);
        for (size_t j = 0; j < p_graph.num_edges; ++j) {
            edge_bursts[j / PE_NUM].edges[j % PE_NUM].node_id = (node_id_t)p_graph.columns[j];
            ap_fixed<32, 16> weight_fixed = (float)p_graph.weights[j];
            edge_bursts[j / PE_NUM].edges[j % PE_NUM].prop = *reinterpret_cast<int32_t*>(&weight_fixed);
        }
        OCL_CHECK(err, err = acc.big_gs_queue[i].enqueueWriteBuffer(
            big_kernel_buffers[i].edge_props_buf,
            CL_TRUE, 0,
            edge_bursts.size() * sizeof(edge_des_burst_t),
            edge_bursts.data()
        ));

        OCL_CHECK(err, err = acc.big_gs_queue[i].enqueueWriteBuffer(
            big_kernel_buffers[i].src_offsets_buf,
            CL_TRUE, 0,
            (p_graph.num_vertices + 1) * sizeof(int),
            p_graph.offsets.data()
        ));
    }

    // 2.2: Transfer data for LITTLE kernels
    for (size_t i = 0; i < little_kernel_buffers.size(); ++i) {
        const auto& p_graph = container.DPs[i].partitioned_graph;
        std::vector<int32_t> local_node_distances(p_graph.num_vertices);
        for (int local_id = 0; local_id < p_graph.num_vertices; ++local_id) {
            int global_id = p_graph.vtx_map_rev.at(local_id);
            local_node_distances[local_id] = ap_fixed_to_int32(h_distances[global_id]);
        }

        OCL_CHECK(err, err = acc.little_gs_queue[i].enqueueWriteBuffer(
            little_kernel_buffers[i].node_props_buf,
            CL_TRUE, 0,
            local_node_distances.size() * sizeof(int32_t),
            local_node_distances.data()
        ));

        std::vector<edge_des_burst_t> edge_bursts((p_graph.num_edges + PE_NUM - 1) / PE_NUM);
        for (size_t j = 0; j < p_graph.num_edges; ++j) {
            edge_bursts[j / PE_NUM].edges[j % PE_NUM].node_id = (node_id_t)p_graph.columns[j];
            ap_fixed<32, 16> weight_fixed = (float)p_graph.weights[j];
            edge_bursts[j / PE_NUM].edges[j % PE_NUM].prop = *reinterpret_cast<int32_t*>(&weight_fixed);
        }
        OCL_CHECK(err, err = acc.little_gs_queue[i].enqueueWriteBuffer(
            little_kernel_buffers[i].edge_props_buf,
            CL_TRUE, 0,
            edge_bursts.size() * sizeof(edge_des_burst_t),
            edge_bursts.data()
        ));

        OCL_CHECK(err, err = acc.little_gs_queue[i].enqueueWriteBuffer(
            little_kernel_buffers[i].src_offsets_buf,
            CL_TRUE, 0,
            (p_graph.num_vertices + 1) * sizeof(int),
            p_graph.offsets.data()
        ));
    }

    // 2.3: Wait for all transfers to complete
    for (auto& q : acc.big_gs_queue) q.finish();
    for (auto& q : acc.little_gs_queue) q.finish();
    std::cout << "[SUCCESS] All node distances for current iteration transferred." << std::endl;
}

// --- PHASE 3: KERNEL EXECUTION ---
void AlgorithmHost::execute_kernel_iteration(const PartitionContainer& container, std::vector<cl::Event> &big_kernel_events, std::vector<cl::Event> &little_kernel_events) {
    cl_int err;
    std::cout << "--- [Host] Phase 3: Enqueuing kernel tasks ---" << std::endl;

    // 3.1: Enqueue BIG kernels
    for (size_t i = 0; i < big_kernel_buffers.size(); ++i) {
        auto& kernel = acc.big_gs_krnls[i];
        auto& buffers = big_kernel_buffers[i];
        const auto& p_graph = container.SPs[i].partitioned_graph;

        int arg_idx = 0;
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.src_offsets_buf));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.edge_props_buf));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.node_props_buf));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.output_buf));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, p_graph.num_vertices));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, p_graph.num_edges));

        cl::Event* event_ptr = &big_kernel_events[i];
        OCL_CHECK(err, err = acc.big_gs_queue[i].enqueueTask(kernel, nullptr, event_ptr));
    }

    // 3.2: Enqueue LITTLE kernels
    for (size_t i = 0; i < little_kernel_buffers.size(); ++i) {
        auto& kernel = acc.little_gs_krnls[i];
        auto& buffers = little_kernel_buffers[i];
        const auto& p_graph = container.DPs[i].partitioned_graph;

        int arg_idx = 0;
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.src_offsets_buf));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.edge_props_buf));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.node_props_buf));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.output_buf));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, p_graph.num_vertices));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, p_graph.num_edges));

        cl::Event* event_ptr = &little_kernel_events[i];
        OCL_CHECK(err, err = acc.little_gs_queue[i].enqueueTask(kernel, nullptr, event_ptr));
    }
    std::cout << "[SUCCESS] All kernel tasks enqueued for one iteration." << std::endl;
}

// --- PHASE 4: DATA TRANSFER FROM FPGA ---
void AlgorithmHost::transfer_data_from_fpga() {
    cl_int err;
    std::cout << "--- [Host] Phase 4: Transferring results from HBM ---" << std::endl;

    for (size_t i = 0; i < big_kernel_buffers.size(); ++i) {
        OCL_CHECK(err, err = acc.big_gs_queue[i].enqueueReadBuffer(
            big_kernel_buffers[i].output_buf,
            CL_FALSE, 0,
            big_kernel_host_outputs[i].size() * sizeof(KernelOutputBatch),
            big_kernel_host_outputs[i].data()
        ));
    }

    for (size_t i = 0; i < little_kernel_buffers.size(); ++i) {
        OCL_CHECK(err, err = acc.little_gs_queue[i].enqueueReadBuffer(
            little_kernel_buffers[i].output_buf,
            CL_FALSE, 0,
            little_kernel_host_outputs[i].size() * sizeof(KernelOutputBatch),
            little_kernel_host_outputs[i].data()
        ));
    }
    
    // Wait for all transfers to complete
    for (auto& q : acc.big_gs_queue) q.finish();
    for (auto& q : acc.little_gs_queue) q.finish();
    std::cout << "[SUCCESS] All results transferred from HBM." << std::endl;
}


// --- PHASE 5: CONVERGENCE CHECK AND GLOBAL STATE UPDATE ---
bool AlgorithmHost::check_convergence_and_update(const PartitionContainer& container) {
    bool changed = false;
    std::cout << "--- [Host] Phase 5: Checking for convergence and updating global distances ---" << std::endl;

    // Use a map to collect the minimum distance for each updated vertex from all partitions
    std::map<int, ap_fixed<32, 16>> min_distances;

    // 5.1: Gather results from BIG kernels
    for (size_t i = 0; i < big_kernel_host_outputs.size(); ++i) {
        const auto& p_graph = container.SPs[i].partitioned_graph;
        for (const auto& batch : big_kernel_host_outputs[i]) {
            for (int k = 0; k < batch.end_pos; ++k) {
                int local_id = batch.data[k].id;
                int global_id = p_graph.vtx_map_rev.at(local_id);
                ap_fixed<32, 16> new_dist(batch.data[k].distance);

                if (min_distances.find(global_id) == min_distances.end() || new_dist < min_distances[global_id]) {
                    min_distances[global_id] = new_dist;
                }
            }
            if (batch.end_flag) break;
        }
    }

    // 5.2: Gather results from LITTLE kernels
    for (size_t i = 0; i < little_kernel_host_outputs.size(); ++i) {
        const auto& p_graph = container.DPs[i].partitioned_graph;
         for (const auto& batch : little_kernel_host_outputs[i]) {
            for (int k = 0; k < batch.end_pos; ++k) {
                int local_id = batch.data[k].id;
                int global_id = p_graph.vtx_map_rev.at(local_id);
                ap_fixed<32, 16> new_dist(batch.data[k].distance);

                if (min_distances.find(global_id) == min_distances.end() || new_dist < min_distances[global_id]) {
                    min_distances[global_id] = new_dist;
                }
            }
            if (batch.end_flag) break;
        }
    }

    // 5.3: Update global distance vector and check for changes
    for (auto const& [global_id, new_dist] : min_distances) {
        if (global_id < m_num_vertices && new_dist < h_distances[global_id]) {
            h_distances[global_id] = new_dist;
            changed = true;
        }
    }

    if (changed) {
        std::cout << "[INFO] Distances updated. Preparing for next iteration." << std::endl;
    } else {
        std::cout << "[INFO] No distance updates. Algorithm has converged." << std::endl;
    }

    // Return true if converged (i.e., NOT changed)
    return !changed;
}

// --- FINALIZATION ---
const std::vector<int>& AlgorithmHost::get_results() const {
    static std::vector<int> final_distances;
    final_distances.clear();
    final_distances.reserve(h_distances.size());

    for (const auto& dist : h_distances) {
        if (dist > std::numeric_limits<int>::max()) {
            final_distances.push_back(std::numeric_limits<int>::max());
        } else {
            final_distances.push_back(dist.to_int());
        }
    }
    return final_distances;
}
