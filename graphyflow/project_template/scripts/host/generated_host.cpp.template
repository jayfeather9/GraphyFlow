// example 示例：
/**
 * @brief 从已准备好的分区数据为所有核心创建并设置OpenCL HBM缓冲区。
 * 此函数使用修正后的 partition_descriptor_dt 定义，直接从 batch_array_host 读取数据。
 * @param container 包含图分区数据的容器，其中每个分区的 'batch_array_host' 已是批处理格式。
 * @param start_node (未使用) 为保持API一致性而保留。
 */
void AlgorithmHost::setup_buffers(const partition_container_dt& container, int start_node) {
    cl_int err;

    // 1. 初始化状态和主机端容器
    m_num_vertices = container.num_graph_vertices;

    // 清空所有旧的OpenCL缓冲区句柄
    big_kernel_input_bufs.clear();
    big_kernel_output_bufs.clear();
    big_kernel_stop_flag_bufs.clear();
    little_kernel_input_bufs.clear();
    little_kernel_output_bufs.clear();
    little_kernel_stop_flag_bufs.clear();

    // 调整主机端输出/停止标志向量的大小以匹配核心数量
    big_kernel_host_outputs.resize(container.SP.size());
    big_kernel_stop_flags.resize(container.SP.size());
    little_kernel_host_outputs.resize(container.DP.size());
    little_kernel_stop_flags.resize(container.DP.size());


    // --- 为大核（稀疏分区）设置缓冲区 ---
    for (size_t i = 0; i < container.SP.size(); ++i) {
        const auto& partition = container.SP[i];
        
        // a. 直接从修正后的成员 `batch_array_host` 获取预处理好的输入数据
        const auto& host_input_batches = partition.batch_array_host;

        // b. 准备输出和停止标志的主机端内存
        big_kernel_host_outputs[i].resize(host_input_batches.size());
        //big_kernel_host_stop_flags[i].assign(1, 0);

        // c. 在指定的HBM bank上创建缓冲区
        cl_mem_ext_ptr_t hbm_ext_in, hbm_ext_out, hbm_ext_stop;

        hbm_ext_in.flags = XCL_MEM_TOPOLOGY | acc.big_kernel_hbm_input_id[i];
        hbm_ext_in.obj = nullptr;
        hbm_ext_in.param = 0;

        hbm_ext_out.flags = XCL_MEM_TOPOLOGY | acc.big_kernel_hbm_output_id[i];
        hbm_ext_out.obj = nullptr;
        hbm_ext_out.param = 0;

        hbm_ext_stop.flags = XCL_MEM_TOPOLOGY | acc.big_kernel_hbm_stop_flag_id[i];
        hbm_ext_stop.obj = nullptr;
        hbm_ext_stop.param = 0;
        
        cl::Buffer in_buf, out_buf, stop_buf;
        OCL_CHECK(err, in_buf = cl::Buffer(acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX , host_input_batches.size() * sizeof(BATCH_TYPE), &hbm_ext_in, &err));
        OCL_CHECK(err, out_buf = cl::Buffer(acc.context, CL_MEM_WRITE_ONLY | CL_MEM_EXT_PTR_XILINX , big_kernel_host_outputs[i].size() * sizeof(KERNEL_OUTPUT_BATCH_TYPE), &hbm_ext_out, &err));
        OCL_CHECK(err, stop_buf = cl::Buffer(acc.context, CL_MEM_READ_WRITE | CL_MEM_EXT_PTR_XILINX , sizeof(int), &hbm_ext_stop, &err));

        // d. 将新创建的缓冲区句柄添加到向量中
        big_kernel_input_bufs.push_back(in_buf);
        big_kernel_output_bufs.push_back(out_buf);
        big_kernel_stop_flag_bufs.push_back(stop_buf);
    }


    // --- 为小核（密集分区）设置缓冲区 ---
    for (size_t i = 0; i < container.DP.size(); ++i) {
        const auto& partition = container.DP[i];
        
        // a. 直接从修正后的成员 `batch_array_host` 获取预处理好的输入数据
        const auto& host_input_batches = partition.batch_array_host;

        // b. 准备输出和停止标志的主机端内存
        little_kernel_host_outputs[i].resize(host_input_batches.size());
        //little_kernel_host_stop_flags[i].assign(1, 0);

        // c. 在指定的HBM bank上创建缓冲区
        cl_mem_ext_ptr_t hbm_ext_in, hbm_ext_out, hbm_ext_stop;

        hbm_ext_in.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_input_id[i];
        hbm_ext_in.obj = nullptr;
        hbm_ext_in.param = 0;

        hbm_ext_out.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_output_id[i];
        hbm_ext_out.obj = nullptr;
        hbm_ext_out.param = 0;

        hbm_ext_stop.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_stop_flag_id[i];
        hbm_ext_stop.obj = nullptr;
        hbm_ext_stop.param = 0;

        cl::Buffer in_buf, out_buf, stop_buf;
        OCL_CHECK(err, in_buf = cl::Buffer(acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX , host_input_batches.size() * sizeof(BATCH_TYPE), &hbm_ext_in, &err));
        OCL_CHECK(err, out_buf = cl::Buffer(acc.context, CL_MEM_WRITE_ONLY | CL_MEM_EXT_PTR_XILINX , little_kernel_host_outputs[i].size() * sizeof(KERNEL_OUTPUT_BATCH_TYPE), &hbm_ext_out, &err));
        OCL_CHECK(err, stop_buf = cl::Buffer(acc.context, CL_MEM_READ_WRITE | CL_MEM_EXT_PTR_XILINX , sizeof(int), &hbm_ext_stop, &err));

        // d. 将新创建的缓冲区句柄添加到向量中
        little_kernel_input_bufs.push_back(in_buf);
        little_kernel_output_bufs.push_back(out_buf);
        little_kernel_stop_flag_bufs.push_back(stop_buf);
    }
    
    std::cout << "Successfully set up buffers for " << container.SP.size() << " big kernels and "
              << container.DP.size() << " little kernels using pre-batched data." << std::endl;
}


/**
 * @brief 将主机上准备好的批处理数据传输到FPGA的HBM中。
 * 此函数为每个大核和小核分别执行数据拷贝，并初始化它们的停止标志。
 * @param partition_container 含有已经分好区并打包成批处理的数据。
 * @param acc 包含OpenCL队列和内核信息的加速器描述符。
 */
void AlgorithmHost::transfer_data_to_fpga(
    const partition_container_dt &partition_container,
    acc_descriptor_dt &acc
) {
    cl_int err;
    // stop_flag 在设备端的初始值应为0
    const int stop_flag_init = 0; 

    // --- 1. 为所有 "big" 内核实例传输数据 ---
    std::cout << "--- Transferring partitioned data to HBM for Big Kernels ---" << std::endl;
    for (int i = 0; i < acc.num_big_krnl; ++i) {
        
        // 获取第i个大核需要处理的数据源 (来自稀疏分区SP[i]的batch_array_host)
        const auto& source_data = partition_container.SP[i].batch_array_host;
        
        // 获取第i个大核对应的HBM输入缓冲区句柄 (这是AlgorithmHost的成员)
        cl::Buffer &target_buffer = this->big_kernel_input_bufs[i];

        // 获取第i个大核专属的命令队列
        cl::CommandQueue &queue = acc.big_gs_queue[i];
        
        // --- 新增的 C++ 风格调试打印代码 开始 ---
        std::cout << "\n--- [DEBUG] Data for Big Kernel ID: " << i << " ---" << std::endl;
        std::cout << "Total batches to transfer: " << source_data.size() << std::endl;
        for (size_t j = 0; j < source_data.size(); ++j) {
            const auto& batch = source_data[j];
            std::cout << "  Batch [" << j << "]: "
                      << "end_pos = " << std::left << std::setw(2) << static_cast<unsigned int>(batch.end_pos) << ", "
                      << "end_flag = " << (batch.end_flag ? "true" : "false")
                      << std::endl;
            
            for (uint8_t k = 0; k < batch.end_pos; ++k) {
                const auto& edge = batch.data[k];
                std::cout << "    Edge " << static_cast<unsigned int>(k) << ": "
                          << "(src={id:"   << std::left << std::setw(4) << edge.src.id      << ", "
                          << "dist:"       << std::setw(5) << edge.src.distance  << "}, "
                          << "dst={id:"   << std::setw(4) << edge.dst.id      << ", "
                          << "dist:"       << std::setw(5) << edge.dst.distance  << "}, "
                          << "w:"          << std::setw(4) << edge.weight      << ")"
                          << std::endl;
            }
        }
        std::cout << "--- [DEBUG] End of data for Big Kernel ID: " << i << " ---\n" << std::endl;
        // --- 新增的 C++ 风格调试打印代码 结束 ---


        // 执行从主机RAM到HBM的物理拷贝
        OCL_CHECK(err, err = queue.enqueueWriteBuffer(
                                 target_buffer,
                                 CL_FALSE, // 非阻塞式，让所有传输任务先排队
                                 0,
                                 source_data.size() * sizeof(BATCH_TYPE),
                                 source_data.data(),
                                 nullptr, nullptr));

        // 初始化该内核的stop_flag
        big_kernel_stop_flags[i] = 0;
        OCL_CHECK(err, err = queue.enqueueWriteBuffer(
                                 this->big_kernel_stop_flag_bufs[i], 
                                 CL_FALSE, 
                                 0, 
                                 sizeof(int), 
                                 &big_kernel_stop_flags[i], 
                                 nullptr, nullptr));
    }

    // --- 2. 为所有 "little" 内核实例传输数据 ---
    std::cout << "--- Transferring partitioned data to HBM for Little Kernels ---" << std::endl;
    for (int i = 0; i < acc.num_little_krnl; ++i) {

        // 获取第i个小核需要处理的数据源 (来自稠密分区DP[i]的batch_array_host)
        const auto& source_data = partition_container.DP[i].batch_array_host;

        // 获取第i个小核对应的HBM输入缓冲区句柄 (这是AlgorithmHost的成员)
        cl::Buffer &target_buffer = this->little_kernel_input_bufs[i];
        
        // 获取第i个小核专属的命令队列
        cl::CommandQueue &queue = acc.little_gs_queue[i];


                // --- 新增的 C++ 风格调试打印代码 开始 ---
        std::cout << "\n--- [DEBUG] Data for Little Kernel ID: " << i << " ---" << std::endl;
        std::cout << "Total batches to transfer: " << source_data.size() << std::endl;
        for (size_t j = 0; j < source_data.size(); ++j) {
            const auto& batch = source_data[j];
            std::cout << "  Batch [" << j << "]: "
                      << "end_pos = " << std::left << std::setw(2) << static_cast<unsigned int>(batch.end_pos) << ", "
                      << "end_flag = " << (batch.end_flag ? "true" : "false")
                      << std::endl;

            for (uint8_t k = 0; k < batch.end_pos; ++k) {
                const auto& edge = batch.data[k];
                std::cout << "    Edge " << static_cast<unsigned int>(k) << ": "
                          << "(src={id:"   << std::left << std::setw(4) << edge.src.id      << ", "
                          << "dist:"       << std::setw(5) << edge.src.distance  << "}, "
                          << "dst={id:"   << std::setw(4) << edge.dst.id      << ", "
                          << "dist:"       << std::setw(5) << edge.dst.distance  << "}, "
                          << "w:"          << std::setw(4) << edge.weight      << ")"
                          << std::endl;
            }
        }
        std::cout << "--- [DEBUG] End of data for Little Kernel ID: " << i << " ---\n" << std::endl;
        // --- 新增的 C++ 风格调试打印代码 结束 ---

        // 执行从主机RAM到HBM的物理拷贝
        OCL_CHECK(err, err = queue.enqueueWriteBuffer(
                                 target_buffer,
                                 CL_FALSE, // 非阻塞式
                                 0,
                                 source_data.size() * sizeof(BATCH_TYPE),
                                 source_data.data(),
                                 nullptr, nullptr));

        // 初始化该内核的stop_flag
        little_kernel_stop_flags[i]= 0;
        OCL_CHECK(err, err = queue.enqueueWriteBuffer(
                                 this->little_kernel_stop_flag_bufs[i], 
                                 CL_FALSE,
                                 0, 
                                 sizeof(int), 
                                 &little_kernel_stop_flags[i], 
                                 nullptr, nullptr));
    }

    // --- 3. 全局同步：等待所有队列中的传输任务完成 ---
    // 调用 finish() 会阻塞主机线程，直到该队列中所有先前提交的命令都执行完毕。
    std::cout << "--- Waiting for all data transfers to complete ---" << std::endl;
    for (int i = 0; i < acc.num_big_krnl; ++i) {
        OCL_CHECK(err, err = acc.big_gs_queue[i].finish());
    }
    for (int i = 0; i < acc.num_little_krnl; ++i) {
        OCL_CHECK(err, err = acc.little_gs_queue[i].finish());
    }
    std::cout << "--- All data successfully transferred to HBM ---" << std::endl;
}


/**
 * @brief 将所有大核和小核的计算任务压入队列以执行一次迭代。
 * 该函数会为每个内核实例单独设置参数并启动它。
 * @param event [输出] 用于跟踪最后启动的内核任务完成情况的事件对象。
 */
void AlgorithmHost::execute_kernel_iteration(cl::Event &event) {
    cl_int err;

    // --- 1. 启动所有 "big" 内核实例 ---
    std::cout << "--- Enqueuing tasks for Big Kernels ---" << std::endl;
    for (int i = 0; i < acc.num_big_krnl; ++i) {
        
        // a. 获取第i个大核所需的所有资源
        cl::Kernel &kernel = acc.big_gs_krnls[i];
        cl::CommandQueue &queue = acc.big_gs_queue[i];

        // b. 确定该内核需要处理的批处理数量
        //    这个数量是在 setup_buffers 阶段根据分区数据的大小确定的。
        uint16_t num_batches = this->big_kernel_host_outputs[i].size();


        // c. 为该内核设置参数 (Argument Index: 0, 1, 2, 3)
        int arg_idx = 0;
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, this->big_kernel_input_bufs[i]));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, this->big_kernel_output_bufs[i]));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, this->big_kernel_stop_flag_bufs[i]));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, num_batches)); 

        // d. 将内核执行任务压入其专属队列
        //    注意：我们只为最后一个启动的任务关联外部事件 `event`
        cl::Event* p_event = ((i == acc.num_big_krnl - 1) && (acc.num_little_krnl == 0)) ? &event : nullptr;
        OCL_CHECK(err, err = queue.enqueueTask(kernel, nullptr, p_event));
    }

    // --- 2. 启动所有 "little" 内核实例 ---
    std::cout << "--- Enqueuing tasks for Little Kernels ---" << std::endl;
    for (int i = 0; i < acc.num_little_krnl; ++i) {
        
        // a. 获取第i个小核所需的所有资源
        cl::Kernel &kernel = acc.little_gs_krnls[i];
        cl::CommandQueue &queue = acc.little_gs_queue[i];

        // b. 确定该内核需要处理的批处理数量
        uint16_t num_batches = this->little_kernel_host_outputs[i].size();
        //if (num_batches == 0) {
        //    std::cout << "Skipping Little Kernel " << i << " as it has no batches to process." << std::endl;
        //    continue;
        //}

        // c. 为该内核设置参数 (Argument Index: 0, 1, 2, 3)
        int arg_idx = 0;
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, this->little_kernel_input_bufs[i]));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, this->little_kernel_output_bufs[i]));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, this->little_kernel_stop_flag_bufs[i]));
        OCL_CHECK(err, err = kernel.setArg(arg_idx++, num_batches));

        // d. 将内核执行任务压入其专属队列
        //    如果这是最后一个小核，就将外部事件 `event` 与它关联
        cl::Event* p_event = (i == acc.num_little_krnl - 1) ? &event : nullptr;
        OCL_CHECK(err, err = queue.enqueueTask(kernel, nullptr, p_event));
    }

    std::cout << "--- All kernel tasks enqueued for one iteration ---" << std::endl;
}



/**
 * @brief 将所有内核的计算结果（输出数据和停止标志）从FPGA的HBM传输回主机内存。
 * 按照要求，此版本将读回的数据存储在函数内的局部变量中，以便后续处理。
 */
void AlgorithmHost::transfer_data_from_fpga(
    const partition_container_dt &partition_container,
    acc_descriptor_dt &acc
) { 
    cl_int err;

    // --- 1. 准备用于存储结果的局部变量 ---
    // 我们根据 AlgorithmHost 中已有的主机端输出向量的大小来准备这些局部容器。
    // 这些大小是在 setup_buffers 阶段确定的。

    //std::vector<std::vector<KERNEL_OUTPUT_BATCH_TYPE> > big_kernel_results(acc.num_big_krnl);
    //std::vector<std::vector<int>> big_kernel_stop_flags(acc.num_big_krnl);

    //std::vector<std::vector<KERNEL_OUTPUT_BATCH_TYPE> > little_kernel_results(acc.num_little_krnl);
    //std::vector<std::vector<int>> little_kernel_stop_flags(acc.num_little_krnl);


    // --- 2. 从所有 "big" 内核实例的HBM中回收数据 ---
    std::cout << "--- Transferring results from HBM for Big Kernels ---" << std::endl;
    for (int i = 0; i < acc.num_big_krnl; ++i) {
        
        std::vector<KERNEL_OUTPUT_BATCH_TYPE> &target_host_buffer = big_kernel_host_outputs[i];
        
        // 源：HBM上第i个大核的输出缓冲区句柄 (来自AlgorithmHost成员)
        cl::Buffer &source_device_buffer = this->big_kernel_output_bufs[i];

        // 获取第i个大核专属的命令队列
        cl::CommandQueue &queue = acc.big_gs_queue[i];

        // 计算需要读取的总字节数
        size_t output_size_in_bytes = target_host_buffer.size() * sizeof(KERNEL_OUTPUT_BATCH_TYPE);

        // 执行从HBM到主机RAM的物理拷贝
        OCL_CHECK(err, err = queue.enqueueReadBuffer(
                                 source_device_buffer,
                                 CL_FALSE, // 非阻塞式，让所有传输任务先排队
                                 0,
                                 output_size_in_bytes,
                                 target_host_buffer.data(),
                                 nullptr, nullptr));

        // 回收该内核的stop_flag
        OCL_CHECK(err, err = queue.enqueueReadBuffer(
                                 this->big_kernel_stop_flag_bufs[i], // 正确的stop_flag句柄
                                 CL_FALSE,
                                 0, 
                                 sizeof(int), 
                                 &big_kernel_stop_flags[i],
                                 nullptr, nullptr));
    }

    // --- 3. 从所有 "little" 内核实例的HBM中回收数据 ---
    std::cout << "--- Transferring results from HBM for Little Kernels ---" << std::endl;
    for (int i = 0; i < acc.num_little_krnl; ++i) {

        // 目标：主机上为第i个小核准备的局部结果向量
        std::vector<KERNEL_OUTPUT_BATCH_TYPE> &target_host_buffer = little_kernel_host_outputs[i];

        // 源：HBM上第i个小核的输出缓冲区句柄 (来自AlgorithmHost成员)
        cl::Buffer &source_device_buffer = this->little_kernel_output_bufs[i];
        
        // 获取第i个小核专属的命令队列
        cl::CommandQueue &queue = acc.little_gs_queue[i];

        size_t output_size_in_bytes = target_host_buffer.size() * sizeof(KERNEL_OUTPUT_BATCH_TYPE);

        // 执行从HBM到主机RAM的物理拷贝
        OCL_CHECK(err, err = queue.enqueueReadBuffer(
                                 source_device_buffer,
                                 CL_FALSE, // 非阻塞式
                                 0,
                                 output_size_in_bytes,
                                 target_host_buffer.data(),
                                 nullptr, nullptr));

        // 回收该内核的stop_flag
        OCL_CHECK(err, err = queue.enqueueReadBuffer(
                                 this->little_kernel_stop_flag_bufs[i], // 正确的stop_flag句柄
                                 CL_FALSE,
                                  0, 
                                  sizeof(int), 
                                 &little_kernel_stop_flags[i], // 存入局部变量
                                 nullptr, nullptr));
    }

    // --- 4. 全局同步：等待所有队列中的数据回收任务完成 ---
    std::cout << "--- Waiting for all result transfers to complete ---" << std::endl;
    for (int i = 0; i < acc.num_big_krnl; ++i) {
        OCL_CHECK(err, err = acc.big_gs_queue[i].finish());
    }
    for (int i = 0; i < acc.num_little_krnl; ++i) {
        OCL_CHECK(err, err = acc.little_gs_queue[i].finish());
    }
    std::cout << "--- All results successfully transferred from HBM to host ---" << std::endl;

    // ==================== 新增的调试代码块 ====================
    // ==========================================================
    // --- 打印 "big" 内核的返回结果 ---
    for (int i = 0; i < acc.num_big_krnl; ++i) {
        const auto& result_data = this->big_kernel_host_outputs[i];
        std::cout << "\n--- [DEBUG] Results from Big Kernel ID: " << i << " ---" << std::endl;
        std::cout << "Total batches received: " << result_data.size() 
                  << ", Stop Flag: " << this->big_kernel_stop_flags[i] << std::endl;
                  
        for (size_t j = 0; j < result_data.size(); ++j) {
            const auto& batch = result_data[j];
            std::cout << "  Batch [" << j << "]: "
                      << "end_pos = " << std::left << std::setw(2) << static_cast<unsigned int>(batch.end_pos) << ", "
                      << "end_flag = " << (batch.end_flag ? "true" : "false")
                      << std::endl;
            
            for (uint8_t k = 0; k < batch.end_pos; ++k) {
                const auto& output = batch.data[k];
                std::cout << "    Output " << static_cast<unsigned int>(k) << ": "
                          << "(id:" << std::left << std::setw(4) << output.id << ", "
                          << "distance:" << std::setw(8) << output.distance << ")"
                          << std::endl;
            }
        }
        std::cout << "--- [DEBUG] End of results for Big Kernel ID: " << i << " ---\n" << std::endl;
    }

    // --- 打印 "little" 内核的返回结果 ---
    for (int i = 0; i < acc.num_little_krnl; ++i) {
        const auto& result_data = this->little_kernel_host_outputs[i];
        std::cout << "\n--- [DEBUG] Results from Little Kernel ID: " << i << " ---" << std::endl;
        std::cout << "Total batches received: " << result_data.size() 
                  << ", Stop Flag: " << this->little_kernel_stop_flags[i] << std::endl;

        for (size_t j = 0; j < result_data.size(); ++j) {
            const auto& batch = result_data[j];
             std::cout << "  Batch [" << j << "]: "
                      << "end_pos = " << std::left << std::setw(2) << static_cast<unsigned int>(batch.end_pos) << ", "
                      << "end_flag = " << (batch.end_flag ? "true" : "false")
                      << std::endl;

            for (uint8_t k = 0; k < batch.end_pos; ++k) {
                const auto& output = batch.data[k];
                std::cout << "    Output " << static_cast<unsigned int>(k) << ": "
                          << "(id:" << std::left << std::setw(4) << output.id << ", "
                          << "distance:" << std::setw(8) << output.distance << ")"
                          << std::endl;
            }
        }
        std::cout << "--- [DEBUG] End of results for Little Kernel ID: " << i << " ---\n" << std::endl;
    }
    // ==========================================================
    // ==================== 调试代码块结束 ======================
}

