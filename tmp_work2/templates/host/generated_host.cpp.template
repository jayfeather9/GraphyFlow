// Helper function to print bus_word_t as separate ap_uint<32> chunks
void print_bus_word(const bus_word_t &word, const std::string &type, size_t word_idx) {
    constexpr int chunks_per_word = AXI_BUS_WIDTH / 32; // 512 / 32 = 16
    std::cout << "      Word[" << word_idx << "] (type=" << type << "):" << std::endl;
    if (word == 0) {
        std::cout << "        [ALL ZERO WORD]" << std::endl;
        return;
    }
    
    if (type == "edge") {
        // For edges: each edge is 64 bits (2 x 32 bits: dst_id, src_id)
        constexpr int edges_per_word = AXI_BUS_WIDTH / 64; // 512 / 64 = 8
        for (int e = 0; e < edges_per_word; ++e) {
            int bit_offset = e * 64;
            ap_uint<32> dst_id = word.range(bit_offset + 31, bit_offset);
            ap_uint<32> src_id = word.range(bit_offset + 63, bit_offset + 32);
            std::cout << "        Edge[" << e << "]: dst_id=" << dst_id.to_uint() 
                      << " (0x" << std::hex << dst_id.to_uint() << std::dec << ")"
                      << ", src_id=" << src_id.to_uint()
                      << " (0x" << std::hex << src_id.to_uint() << std::dec << ")" << std::endl;
        }
    } else if (type == "node_prop") {
        // For node properties: each distance is DISTANCE_BITWIDTH bits
        constexpr int dists_per_word = AXI_BUS_WIDTH / DISTANCE_BITWIDTH; // 512 / 32 = 16
        for (int d = 0; d < dists_per_word; ++d) {
            int bit_offset = d * DISTANCE_BITWIDTH;
            ap_uint<DISTANCE_BITWIDTH> raw_bits = word.range(bit_offset + DISTANCE_BITWIDTH - 1, bit_offset);
            distance_t dist = 0;
            dist.range(DISTANCE_BITWIDTH - 1, 0) = raw_bits;
            float dist_float = dist.to_float();
            std::cout << "        NodeProp[" << d << "]: raw=0x" << std::hex << raw_bits.to_uint() 
                      << std::dec << ", float=" << dist_float << std::endl;
        }
    } else {
        // Generic: print as 32-bit chunks
        for (int c = 0; c < chunks_per_word; ++c) {
            int bit_offset = c * 32;
            ap_uint<32> chunk = word.range(bit_offset + 31, bit_offset);
            std::cout << "        Chunk[" << c << "]: 0x" << std::hex << chunk.to_uint() 
                      << std::dec << " (" << chunk.to_uint() << ")" << std::endl;
        }
    }
}

AlgorithmHost::AlgorithmHost(AccDescriptor &acc) : acc(acc) {}

void AlgorithmHost::prepare_data(const PartitionContainer &container,
                                 int start_node) {
    std::cout << "[DEBUG] Entering prepare_data" << std::endl;
    std::cout << std::flush;
    std::cout << "--- [Host] Phase 0: Preparing data structures ---"
              << std::endl;

    auto start_time = std::chrono::system_clock::now();
    auto current_time = start_time;

    // 1. Initialize algorithm state
    m_num_vertices = container.num_graph_vertices;
    h_distances.assign(m_num_vertices, distance_t(INFINITY_DIST));
    if (start_node < m_num_vertices) {
        h_distances[start_node] = 0;
    }
    
    std::cout << "\n========== PHASE 0.1: INITIALIZATION ==========" << std::endl;
    std::cout << "  m_num_vertices: " << m_num_vertices << std::endl;
    std::cout << "  start_node: " << start_node << std::endl;
    std::cout << "  h_distances.size(): " << h_distances.size() << std::endl;
    std::cout << "  All initial distances:" << std::endl;
    for (size_t i = 0; i < h_distances.size(); ++i) {
        std::cout << "    h_distances[" << i << "] = " << h_distances[i].to_float() << std::endl;
    }
    std::cout << "========== END PHASE 0.1 ==========\n" << std::endl;

    // 2. Prepare host-side input buffers for each pipeline
    const size_t bytes_per_word = AXI_BUS_WIDTH / 8;
    dense_buffers.resize(container.num_dense_partitions);
    sparse_buffers.resize(container.num_sparse_partitions);

    for (size_t flat_idx = 0; flat_idx < container.num_dense_partitions;
         ++flat_idx) {
        auto group_part = container.dense_partition_order[flat_idx];
        const auto &group = container.dense_groups[group_part.first];
        dense_buffers[flat_idx].pipelines.resize(group.num_pipelines);
        dense_buffers[flat_idx].node_prop_offset = 0;
        dense_buffers[flat_idx].dst_prop_offset = 0;
        dense_buffers[flat_idx].src_buf_offset = 0;
    }
    for (size_t flat_idx = 0; flat_idx < container.num_sparse_partitions;
         ++flat_idx) {
        auto group_part = container.sparse_partition_order[flat_idx];
        const auto &group = container.sparse_groups[group_part.first];
        sparse_buffers[flat_idx].pipelines.resize(group.num_pipelines);
        sparse_buffers[flat_idx].node_prop_offset = 0;
        sparse_buffers[flat_idx].dst_prop_offset = 0;
    }

    size_t sparse_node_offset = 0;
    size_t sparse_dst_offset = 0;
    size_t dense_node_offset = 0;
    size_t dense_src_buf_offset = 0;
    size_t dense_dst_offset = 0;
    size_t sparse_src_prop_offset = 0;
    int32_t previous_group = -1;

    // --- 2.1: Prepare BIG partition data (shared node props, separate edge
    // props per pipeline) ---
    for (size_t flat_idx = 0; flat_idx < container.num_sparse_partitions;
         ++flat_idx) {
        auto group_part = container.sparse_partition_order[flat_idx];
        const auto &group = container.sparse_groups[group_part.first];
        const auto &big_partition = group.partitions[group_part.second];
        printf("Preparing BIG partition data for group %zu, partition %zu\n",
               group_part.first, group_part.second);
        if (previous_group != static_cast<int32_t>(group_part.first)) {
            // Reset offsets for new group
            sparse_src_prop_offset = 0;
            sparse_node_offset = 0;
            previous_group = static_cast<int32_t>(group_part.first);
        }

        // Pack node distances ONCE for the big partition (shared)
        {
            const size_t bytes_per_dist = DISTANCE_BITWIDTH / 8;
            const size_t dist_per_word = bytes_per_word / bytes_per_dist;
            const size_t word_number =
                (big_partition.num_vertices + dist_per_word - 1) /
                dist_per_word;
            std::vector<char> temp_byte_buffer;
            temp_byte_buffer.reserve(word_number * bytes_per_word);

            for (int j = 0; j < big_partition.num_vertices; ++j) {
                if ((temp_byte_buffer.size() % bytes_per_word) +
                        bytes_per_dist >
                    bytes_per_word) {
                    size_t padding_needed =
                        bytes_per_word -
                        (temp_byte_buffer.size() % bytes_per_word);
                    temp_byte_buffer.insert(temp_byte_buffer.end(),
                                            padding_needed, 0);
                }

                int global_id = big_partition.vtx_map_rev.at(j);
                distance_t dist_val = h_distances[global_id];
                const char *data_ptr =
                    reinterpret_cast<const char *>(&dist_val);
                temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr,
                                        data_ptr + bytes_per_dist);
            }

            size_t node_word_count =
                (temp_byte_buffer.size() + bytes_per_word - 1) /
                bytes_per_word;
            if (node_word_count == 0) {
                // Ensure at least one word so kernel sees a valid buffer
                node_word_count = 1;
            }
            sparse_buffers[flat_idx].packed_node_props.resize(
                node_word_count, 0);
            std::memcpy(sparse_buffers[flat_idx].packed_node_props.data(),
                        temp_byte_buffer.data(), temp_byte_buffer.size());
            sparse_buffers[flat_idx].src_prop_offset = sparse_src_prop_offset;
            sparse_src_prop_offset += node_word_count;
            sparse_buffers[flat_idx].node_prop_offset = sparse_node_offset;
            sparse_node_offset += node_word_count;
            
            // Detailed debug print for BIG partition node props
            std::cout << "\n========== PHASE 0.2.1: BIG Partition " << flat_idx 
                      << " (Group " << group_part.first << ", Partition " << group_part.second 
                      << ") Node Props ==========" << std::endl;
            std::cout << "  node_word_count: " << node_word_count << std::endl;
            std::cout << "  node_prop_offset: " << sparse_buffers[flat_idx].node_prop_offset << std::endl;
            std::cout << "  src_prop_offset: " << sparse_buffers[flat_idx].src_prop_offset << std::endl;
            std::cout << "  packed_node_props.size(): " << sparse_buffers[flat_idx].packed_node_props.size() << std::endl;
            std::cout << "  All words of packed_node_props:" << std::endl;
            for (size_t w = 0; w < sparse_buffers[flat_idx].packed_node_props.size(); ++w) {
                print_bus_word(sparse_buffers[flat_idx].packed_node_props[w], "node_prop", w);
            }
            std::cout << "========== END PHASE 0.2.1 ==========\n" << std::endl;

            const size_t dst_word_number =
                (big_partition.num_dsts + dist_per_word - 1) / dist_per_word;
            temp_byte_buffer.clear();
            temp_byte_buffer.reserve(dst_word_number * bytes_per_word);
            for (int j = 0; j < big_partition.num_dsts; ++j) {
                if ((temp_byte_buffer.size() % bytes_per_word) +
                        bytes_per_dist >
                    bytes_per_word) {
                    size_t padding_needed =
                        bytes_per_word -
                        (temp_byte_buffer.size() % bytes_per_word);
                    temp_byte_buffer.insert(temp_byte_buffer.end(),
                                            padding_needed, 0);
                }
                int global_id = big_partition.vtx_map_rev.at(j);
                distance_t dist_val = h_distances[global_id];
                const char *data_ptr =
                    reinterpret_cast<const char *>(&dist_val);
                temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr,
                                        data_ptr + bytes_per_dist);
            }
            size_t dst_word_count =
                (temp_byte_buffer.size() + bytes_per_word - 1) /
                bytes_per_word;
            sparse_buffers[flat_idx].packed_dst_props.resize(dst_word_count,
                                                             0);
            std::memcpy(sparse_buffers[flat_idx].packed_dst_props.data(),
                        temp_byte_buffer.data(), temp_byte_buffer.size());
            sparse_buffers[flat_idx].dst_prop_offset = sparse_dst_offset;
            sparse_dst_offset += dst_word_count;
            
            // Detailed debug print for BIG partition dst props
            std::cout << "\n========== PHASE 0.2.2: BIG Partition " << flat_idx 
                      << " (Group " << group_part.first << ", Partition " << group_part.second 
                      << ") Dst Props ==========" << std::endl;
            std::cout << "  dst_word_count: " << dst_word_count << std::endl;
            std::cout << "  dst_prop_offset: " << sparse_buffers[flat_idx].dst_prop_offset << std::endl;
            std::cout << "  packed_dst_props.size(): " << sparse_buffers[flat_idx].packed_dst_props.size() << std::endl;
            std::cout << "  All words of packed_dst_props:" << std::endl;
            for (size_t w = 0; w < sparse_buffers[flat_idx].packed_dst_props.size(); ++w) {
                print_bus_word(sparse_buffers[flat_idx].packed_dst_props[w], "node_prop", w);
            }
            std::cout << "========== END PHASE 0.2.2 ==========\n" << std::endl;
        }

        current_time = std::chrono::system_clock::now();
        std::cout
            << "--- [Host] Phase 0: Prepared shared big node props ("
            << std::chrono::duration<double>(current_time - start_time).count()
            << " sec) ---" << std::endl;
        start_time = current_time;

        // Pack edge properties for EACH big pipeline
        for (unsigned int local_pip = 0; local_pip < group.num_pipelines;
             ++local_pip) {
            const auto &pipeline_edges = big_partition.pipeline_edges[local_pip];
            const size_t bytes_per_edge =
                (NODE_ID_BITWIDTH + NODE_ID_BITWIDTH) / 8;
            const size_t edges_per_word = bytes_per_word / bytes_per_edge;

            const size_t actual_edges =
                (pipeline_edges.num_edges == 0) ? 8 : pipeline_edges.num_edges;
            const size_t word_number =
                (actual_edges + edges_per_word - 1) / edges_per_word;
            std::vector<char> temp_byte_buffer;
            temp_byte_buffer.reserve(word_number * bytes_per_word);

            if (pipeline_edges.num_edges == 0) {
                printf(
                    "Padding SP Group %zu Partition %zu, big pipe %u with 8 dummy edges.\n",
                    group_part.first, group_part.second, local_pip);
                const uint32_t dummy_dst_id = 0x7FFFFFFF;
                const uint32_t dummy_src_id = 0;

                for (int dummy_idx = 0; dummy_idx < 8; ++dummy_idx) {
                    if ((temp_byte_buffer.size() % bytes_per_word) +
                            bytes_per_edge >
                        bytes_per_word) {
                        size_t padding_needed =
                            bytes_per_word -
                            (static_cast<size_t>(temp_byte_buffer.size()) %
                             bytes_per_word);
                        temp_byte_buffer.insert(temp_byte_buffer.end(),
                                                padding_needed, 0);
                    }

                    char edge_bytes[bytes_per_edge];

                    for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
                        edge_bytes[b] = (dummy_dst_id >> (8 * b)) & 0xFF;
                    }
                    for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
                        edge_bytes[(NODE_ID_BITWIDTH / 8) + b] =
                            (dummy_src_id >> (8 * b)) & 0xFF;
                    }

                    temp_byte_buffer.insert(temp_byte_buffer.end(), edge_bytes,
                                            edge_bytes + bytes_per_edge);
                }
            } else {
                for (int v = 0; v < big_partition.num_vertices; ++v) {
                    node_id_t src_id = v;
                    for (int edge_idx = pipeline_edges.offsets[v];
                         edge_idx < pipeline_edges.offsets[v + 1]; ++edge_idx) {
                        if ((temp_byte_buffer.size() % bytes_per_word) +
                                bytes_per_edge >
                            bytes_per_word) {
                            size_t padding_needed =
                                bytes_per_word -
                                (temp_byte_buffer.size() % bytes_per_word);
                            temp_byte_buffer.insert(temp_byte_buffer.end(),
                                                    padding_needed, 0);
                        }

                        char edge_bytes[bytes_per_edge];
                        uint32_t dest_id = pipeline_edges.columns[edge_idx];

                        for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
                            edge_bytes[b] = (dest_id >> (8 * b)) & 0xFF;
                        }
                        for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
                            edge_bytes[(NODE_ID_BITWIDTH / 8) + b] =
                                (src_id >> (8 * b)) & 0xFF;
                        }

                        temp_byte_buffer.insert(temp_byte_buffer.end(),
                                                edge_bytes,
                                                edge_bytes + bytes_per_edge);
                    }
                }
            }

            sparse_buffers[flat_idx].pipelines[local_pip].packed_edge_props
                .resize((temp_byte_buffer.size() + bytes_per_word - 1) /
                            bytes_per_word,
                        0);
            std::memcpy(
                sparse_buffers[flat_idx].pipelines[local_pip]
                    .packed_edge_props.data(),
                temp_byte_buffer.data(), temp_byte_buffer.size());
            
            // Detailed debug print for BIG partition edge props
            std::cout << "\n========== PHASE 0.2.3: BIG Partition " << flat_idx 
                      << " (Group " << group_part.first << ", Partition " << group_part.second 
                      << ") Pipeline " << local_pip << " Edge Props ==========" << std::endl;
            std::cout << "  packed_edge_props.size(): " << sparse_buffers[flat_idx].pipelines[local_pip].packed_edge_props.size() << std::endl;
            std::cout << "  All words of packed_edge_props:" << std::endl;
            for (size_t w = 0; w < sparse_buffers[flat_idx].pipelines[local_pip].packed_edge_props.size(); ++w) {
                print_bus_word(sparse_buffers[flat_idx].pipelines[local_pip].packed_edge_props[w], "edge", w);
            }
            std::cout << "========== END PHASE 0.2.3 ==========\n" << std::endl;
        }

        current_time = std::chrono::system_clock::now();
        std::cout
            << "--- [Host] Phase 0: Prepared " << group.num_pipelines
            << " big pipeline edge props ("
            << std::chrono::duration<double>(current_time - start_time).count()
            << " sec) ---" << std::endl;
        start_time = current_time;
    }

    previous_group = -1;
    // --- 2.2: Prepare LITTLE partition data (shared node props, separate edge
    // props per pipeline) ---
    for (size_t flat_idx = 0; flat_idx < container.num_dense_partitions;
         ++flat_idx) {
        auto group_part = container.dense_partition_order[flat_idx];
        const auto &group = container.dense_groups[group_part.first];
        const auto &little_partition =
            group.partitions[group_part.second];
        printf("Preparing LITTLE partition data for group %zu, partition %zu\n",
               group_part.first, group_part.second);
        if (previous_group != static_cast<int32_t>(group_part.first)) {
            // Reset offsets for new group
            dense_src_buf_offset = 0;
            dense_node_offset = 0;
            previous_group = static_cast<int32_t>(group_part.first);
        }

        // Pack node distances ONCE for the little partition (shared)
        {
            const size_t bytes_per_dist = DISTANCE_BITWIDTH / 8;
            const size_t dist_per_word = bytes_per_word / bytes_per_dist;
            const size_t word_number =
                (little_partition.num_vertices + dist_per_word - 1) /
                dist_per_word;
            std::vector<char> temp_byte_buffer;
            temp_byte_buffer.reserve(word_number * bytes_per_word);

            for (int j = 0; j < little_partition.num_vertices; ++j) {
                if ((temp_byte_buffer.size() % bytes_per_word) +
                        bytes_per_dist >
                    bytes_per_word) {
                    size_t padding_needed =
                        bytes_per_word -
                        (temp_byte_buffer.size() % bytes_per_word);
                    temp_byte_buffer.insert(temp_byte_buffer.end(),
                                            padding_needed, 0);
                }
                int global_id = little_partition.vtx_map_rev.at(j);
                distance_t dist_val = h_distances[global_id];
                // printf("Putting Data: DP No.%d, little pipe No.%d, local_id
                // %d, global_id %d, dist %.3f\n",
                //        i, 0,  j, global_id, (float)dist_val);
                const char *data_ptr =
                    reinterpret_cast<const char *>(&dist_val);
                temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr,
                                        data_ptr + bytes_per_dist);
            }
            // pack temp_byte_buffer to SRC_BUFFER_SIZE nodes
            size_t buffer_size = SRC_BUFFER_SIZE * bytes_per_dist;
            if (temp_byte_buffer.size() % buffer_size != 0) {
                size_t padding_needed =
                    buffer_size - (temp_byte_buffer.size() % buffer_size);
                temp_byte_buffer.insert(temp_byte_buffer.end(), padding_needed,
                                        0);
            }
            if (temp_byte_buffer.empty()) {
                // Ensure at least one SRC_BUFFER_SIZE block for little kernel
                temp_byte_buffer.insert(temp_byte_buffer.end(), buffer_size, 0);
            }
            size_t src_buf_cnt = temp_byte_buffer.size() / buffer_size;

            size_t node_word_count =
                (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word;
            if (node_word_count == 0) {
                // Ensure at least one word so kernel sees a valid buffer
                node_word_count = 1;
            }
            dense_buffers[flat_idx].packed_node_props.resize(node_word_count,
                                                            0);
            std::memcpy(dense_buffers[flat_idx].packed_node_props.data(),
                        temp_byte_buffer.data(), temp_byte_buffer.size());
            dense_buffers[flat_idx].node_prop_offset = dense_node_offset;
            dense_node_offset += node_word_count;
            dense_buffers[flat_idx].src_buf_offset = dense_src_buf_offset;
            dense_src_buf_offset += src_buf_cnt;
            
            // Detailed debug print for LITTLE partition node props
            std::cout << "\n========== PHASE 0.3.1: LITTLE Partition " << flat_idx 
                      << " (Group " << group_part.first << ", Partition " << group_part.second 
                      << ") Node Props ==========" << std::endl;
            std::cout << "  node_word_count: " << node_word_count << std::endl;
            std::cout << "  src_buf_cnt: " << src_buf_cnt << std::endl;
            std::cout << "  node_prop_offset: " << dense_buffers[flat_idx].node_prop_offset << std::endl;
            std::cout << "  src_buf_offset: " << dense_buffers[flat_idx].src_buf_offset << std::endl;
            std::cout << "  packed_node_props.size(): " << dense_buffers[flat_idx].packed_node_props.size() << std::endl;
            std::cout << "  All words of packed_node_props:" << std::endl;
            for (size_t w = 0; w < dense_buffers[flat_idx].packed_node_props.size(); ++w) {
                print_bus_word(dense_buffers[flat_idx].packed_node_props[w], "node_prop", w);
            }
            std::cout << "========== END PHASE 0.3.1 ==========\n" << std::endl;

            const size_t dst_word_number =
                (little_partition.num_dsts + dist_per_word - 1) / dist_per_word;
            temp_byte_buffer.clear();
            temp_byte_buffer.reserve(dst_word_number * bytes_per_word);
            for (int j = 0; j < little_partition.num_dsts; ++j) {
                if ((temp_byte_buffer.size() % bytes_per_word) +
                        bytes_per_dist >
                    bytes_per_word) {
                    size_t padding_needed =
                        bytes_per_word -
                        (temp_byte_buffer.size() % bytes_per_word);
                    temp_byte_buffer.insert(temp_byte_buffer.end(),
                                            padding_needed, 0);
                }
                int global_id = little_partition.vtx_map_rev.at(j);
                distance_t dist_val = h_distances[global_id];
                const char *data_ptr =
                    reinterpret_cast<const char *>(&dist_val);
                temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr,
                                        data_ptr + bytes_per_dist);
            }
            size_t dst_word_count =
                (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word;
            dense_buffers[flat_idx].packed_dst_props.resize(dst_word_count, 0);
            std::memcpy(dense_buffers[flat_idx].packed_dst_props.data(),
                        temp_byte_buffer.data(), temp_byte_buffer.size());
            dense_buffers[flat_idx].dst_prop_offset = dense_dst_offset;
            dense_dst_offset += dst_word_count;
            
            // Detailed debug print for LITTLE partition dst props
            std::cout << "\n========== PHASE 0.3.2: LITTLE Partition " << flat_idx 
                      << " (Group " << group_part.first << ", Partition " << group_part.second 
                      << ") Dst Props ==========" << std::endl;
            std::cout << "  dst_word_count: " << dst_word_count << std::endl;
            std::cout << "  dst_prop_offset: " << dense_buffers[flat_idx].dst_prop_offset << std::endl;
            std::cout << "  packed_dst_props.size(): " << dense_buffers[flat_idx].packed_dst_props.size() << std::endl;
            std::cout << "  All words of packed_dst_props:" << std::endl;
            for (size_t w = 0; w < dense_buffers[flat_idx].packed_dst_props.size(); ++w) {
                print_bus_word(dense_buffers[flat_idx].packed_dst_props[w], "node_prop", w);
            }
            std::cout << "========== END PHASE 0.3.2 ==========\n" << std::endl;
        }

        current_time = std::chrono::system_clock::now();
        std::cout
            << "--- [Host] Phase 0: Prepared shared little node props ("
            << std::chrono::duration<double>(current_time - start_time).count()
            << " sec) ---" << std::endl;
        start_time = current_time;

        // Pack edge properties for EACH little pipeline
        for (unsigned int pip = 0; pip < group.num_pipelines; ++pip) {
            const auto &pipeline_edges = little_partition.pipeline_edges[pip];

            // Pack this pipeline's edge properties
            const size_t bytes_per_edge =
                (NODE_ID_BITWIDTH + NODE_ID_BITWIDTH) / 8;
            const size_t edges_per_word = bytes_per_word / bytes_per_edge;

            // Check if this pipeline has no edges - if so, add 8 dummy edges
            const size_t actual_edges =
                (pipeline_edges.num_edges == 0) ? 8 : pipeline_edges.num_edges;
            const size_t word_number =
                (actual_edges + edges_per_word - 1) / edges_per_word;
            std::vector<char> temp_byte_buffer;
            temp_byte_buffer.reserve(word_number * bytes_per_word);

            if (pipeline_edges.num_edges == 0) {
                printf(
                    "Padding DP Group %zu Partition %zu, little pipe %u with 8 dummy edges.\n",
                    group_part.first, group_part.second, pip);
                // Add 8 dummy edges with dst_id = 0x7FFFFFFF and src_id = 0
                const uint32_t dummy_dst_id = 0x7FFFFFFF;
                const uint32_t dummy_src_id = 0;

                for (int dummy_idx = 0; dummy_idx < 8; ++dummy_idx) {
                    if ((temp_byte_buffer.size() % bytes_per_word) +
                            bytes_per_edge >
                        bytes_per_word) {
                        size_t padding_needed =
                            bytes_per_word -
                            (temp_byte_buffer.size() % bytes_per_word);
                        temp_byte_buffer.insert(temp_byte_buffer.end(),
                                                padding_needed, 0);
                    }

                    char edge_bytes[bytes_per_edge];

                    // Pack dst_id (first NODE_ID_BITWIDTH bits)
                    for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
                        edge_bytes[b] = (dummy_dst_id >> (8 * b)) & 0xFF;
                    }

                    // Pack src_id (next NODE_ID_BITWIDTH bits)
                    for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
                        edge_bytes[(NODE_ID_BITWIDTH / 8) + b] =
                            (dummy_src_id >> (8 * b)) & 0xFF;
                    }

                    temp_byte_buffer.insert(temp_byte_buffer.end(), edge_bytes,
                                            edge_bytes + bytes_per_edge);
                }
            } else {
                // Iterate through vertices, then their edges
                for (int v = 0; v < little_partition.num_vertices; ++v) {
                    node_id_t src_id = v;
                    for (int edge_idx = pipeline_edges.offsets[v];
                         edge_idx < pipeline_edges.offsets[v + 1]; ++edge_idx) {
                        if ((temp_byte_buffer.size() % bytes_per_word) +
                                bytes_per_edge >
                            bytes_per_word) {
                            size_t padding_needed =
                                bytes_per_word -
                                (temp_byte_buffer.size() % bytes_per_word);
                            temp_byte_buffer.insert(temp_byte_buffer.end(),
                                                    padding_needed, 0);
                        }

                        char edge_bytes[bytes_per_edge];
                        uint32_t dest_id = pipeline_edges.columns[edge_idx];

                        // Pack dst_id (first NODE_ID_BITWIDTH bits)
                        for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
                            edge_bytes[b] = (dest_id >> (8 * b)) & 0xFF;
                        }

                        // Pack src_id (next NODE_ID_BITWIDTH bits)
                        for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
                            edge_bytes[(NODE_ID_BITWIDTH / 8) + b] =
                                (src_id >> (8 * b)) & 0xFF;
                        }

                        temp_byte_buffer.insert(temp_byte_buffer.end(),
                                                edge_bytes,
                                                edge_bytes + bytes_per_edge);
                    }
                }
            }
            dense_buffers[flat_idx].pipelines[pip].packed_edge_props.resize(
                (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word,
                0);
            // printf("DP No.%d, little pipe No.%d, edge words %d = %d edges\n",
            // i, pip,
            //        (int)dense_buffers[i].pipelines[pip]
            //            .packed_edge_props.size(),
            //         (int)dense_buffers[i].pipelines[pip]
            //            .packed_edge_props.size() * edges_per_word);
            std::memcpy(
                dense_buffers[flat_idx].pipelines[pip].packed_edge_props.data(),
                temp_byte_buffer.data(), temp_byte_buffer.size());
            
            // Detailed debug print for LITTLE partition edge props
            std::cout << "\n========== PHASE 0.3.3: LITTLE Partition " << flat_idx 
                      << " (Group " << group_part.first << ", Partition " << group_part.second 
                      << ") Pipeline " << pip << " Edge Props ==========" << std::endl;
            std::cout << "  packed_edge_props.size(): " << dense_buffers[flat_idx].pipelines[pip].packed_edge_props.size() << std::endl;
            std::cout << "  All words of packed_edge_props:" << std::endl;
            for (size_t w = 0; w < dense_buffers[flat_idx].pipelines[pip].packed_edge_props.size(); ++w) {
                print_bus_word(dense_buffers[flat_idx].pipelines[pip].packed_edge_props[w], "edge", w);
            }
            std::cout << "========== END PHASE 0.3.3 ==========\n" << std::endl;
        }

        current_time = std::chrono::system_clock::now();
        std::cout
            << "--- [Host] Phase 0: Prepared " << group.num_pipelines
            << " little pipeline edge props ("
            << std::chrono::duration<double>(current_time - start_time).count()
            << " sec) ---" << std::endl;
        start_time = current_time;
    }

    // apply kernel node props layout:
    // [ all little mergers concatenated by partition ][ all big mergers concatenated by partition ]
    // Sizing must be the sum of per-partition dst words across all groups.
    size_t total_little_dst_words = 0;
    for (size_t flat_idx = 0; flat_idx < container.num_dense_partitions;
         ++flat_idx) {
        total_little_dst_words += dense_buffers[flat_idx].packed_dst_props.size();
    }
    size_t total_big_dst_words = 0;
    for (size_t flat_idx = 0; flat_idx < container.num_sparse_partitions;
         ++flat_idx) {
        total_big_dst_words += sparse_buffers[flat_idx].packed_dst_props.size();
    }
    size_t total_little_node_words = dense_node_offset;
    size_t total_big_node_words = sparse_node_offset;

    apply_kernel_node_props.assign(total_little_dst_words + total_big_dst_words,
                                   0);
    
    std::cout << "\n========== PHASE 0.4: APPLY KERNEL NODE PROPS INIT ==========" << std::endl;
    std::cout << "  total_little_dst_words: " << total_little_dst_words << std::endl;
    std::cout << "  total_big_dst_words: " << total_big_dst_words << std::endl;
    std::cout << "  apply_kernel_node_props.size(): " << apply_kernel_node_props.size() << std::endl;
    std::cout << "========== END PHASE 0.4 ==========\n" << std::endl;

    little_merger_lengths.assign(container.num_dense_groups, 0);
    little_merger_offsets.assign(container.num_dense_groups, 0);

    size_t apply_offset = 0;
    for (size_t group_idx = 0; group_idx < container.num_dense_groups;
         ++group_idx) {
        little_merger_offsets[group_idx] = static_cast<uint32_t>(apply_offset);
        for (size_t part_idx = 0;
             part_idx < container.dense_groups[group_idx].partitions.size();
             ++part_idx) {
            size_t flat_idx =
                container.dense_partition_indices[group_idx][part_idx];
            const auto &dst_props = dense_buffers[flat_idx].packed_dst_props;
            std::copy(dst_props.begin(), dst_props.end(),
                      apply_kernel_node_props.begin() + apply_offset);
            apply_offset += dst_props.size();
        }
        little_merger_lengths[group_idx] = static_cast<uint32_t>(
            apply_offset - little_merger_offsets[group_idx]);
    }

    big_dst_offset = static_cast<uint32_t>(apply_offset);
    big_merger_lengths.assign(container.num_sparse_groups, 0);
    big_merger_offsets.assign(container.num_sparse_groups, 0);

    for (size_t group_idx = 0; group_idx < container.num_sparse_groups;
         ++group_idx) {
        big_merger_offsets[group_idx] = static_cast<uint32_t>(apply_offset);
        for (size_t part_idx = 0;
             part_idx < container.sparse_groups[group_idx].partitions.size();
             ++part_idx) {
            size_t flat_idx =
                container.sparse_partition_indices[group_idx][part_idx];
            const auto &dst_props = sparse_buffers[flat_idx].packed_dst_props;
            std::copy(dst_props.begin(), dst_props.end(),
                      apply_kernel_node_props.begin() + apply_offset);
            apply_offset += dst_props.size();
        }
        big_merger_lengths[group_idx] = static_cast<uint32_t>(
            apply_offset - big_merger_offsets[group_idx]);
    }
    
    std::cout << "\n========== PHASE 0.5: MERGER OFFSETS AND LENGTHS ==========" << std::endl;
    std::cout << "  little_merger_lengths:" << std::endl;
    for (size_t i = 0; i < little_merger_lengths.size(); ++i) {
        std::cout << "    [" << i << "] = " << little_merger_lengths[i] << std::endl;
    }
    std::cout << "  little_merger_offsets:" << std::endl;
    for (size_t i = 0; i < little_merger_offsets.size(); ++i) {
        std::cout << "    [" << i << "] = " << little_merger_offsets[i] << std::endl;
    }
    std::cout << "  big_merger_lengths:" << std::endl;
    for (size_t i = 0; i < big_merger_lengths.size(); ++i) {
        std::cout << "    [" << i << "] = " << big_merger_lengths[i] << std::endl;
    }
    std::cout << "  big_merger_offsets:" << std::endl;
    for (size_t i = 0; i < big_merger_offsets.size(); ++i) {
        std::cout << "    [" << i << "] = " << big_merger_offsets[i] << std::endl;
    }
    std::cout << "  big_dst_offset: " << big_dst_offset << std::endl;
    std::cout << "========== END PHASE 0.5 ==========\n" << std::endl;

    if (apply_kernel_node_props.empty()) {
        apply_kernel_node_props.assign(1, 0);
    }
    
    std::cout << "\n========== PHASE 0.6: APPLY KERNEL NODE PROPS FINAL ==========" << std::endl;
    std::cout << "  apply_kernel_node_props.size(): " << apply_kernel_node_props.size() << std::endl;
    std::cout << "  All words of apply_kernel_node_props:" << std::endl;
    for (size_t w = 0; w < apply_kernel_node_props.size(); ++w) {
        print_bus_word(apply_kernel_node_props[w], "node_prop", w);
    }
    std::cout << "========== END PHASE 0.6 ==========\n" << std::endl;

    writer_kernel_node_props.resize(LITTLE_KERNEL_NUM + BIG_KERNEL_NUM);
    size_t little_node_words =
        (total_little_node_words == 0) ? static_cast<size_t>(1)
                                       : total_little_node_words;
    size_t big_node_words = (total_big_node_words == 0)
                                ? static_cast<size_t>(1)
                                : total_big_node_words;

    for (int pip = 0; pip < LITTLE_KERNEL_NUM; ++pip) {
        writer_kernel_node_props[pip].assign(little_node_words, 0);
    }
    for (int pip = 0; pip < BIG_KERNEL_NUM; ++pip) {
        writer_kernel_node_props[pip + LITTLE_KERNEL_NUM].assign(
            big_node_words, 0);
    }
    
    std::cout << "\n========== PHASE 0.7: WRITER KERNEL NODE PROPS INIT ==========" << std::endl;
    std::cout << "  LITTLE_KERNEL_NUM: " << LITTLE_KERNEL_NUM << std::endl;
    std::cout << "  BIG_KERNEL_NUM: " << BIG_KERNEL_NUM << std::endl;
    std::cout << "  total_little_node_words: " << total_little_node_words << std::endl;
    std::cout << "  total_big_node_words: " << total_big_node_words << std::endl;
    std::cout << "  little_node_words: " << little_node_words << std::endl;
    std::cout << "  big_node_words: " << big_node_words << std::endl;
    std::cout << "  writer_kernel_node_props.size(): " << writer_kernel_node_props.size() << std::endl;
    for (size_t i = 0; i < writer_kernel_node_props.size(); ++i) {
        std::cout << "    writer_kernel_node_props[" << i << "].size(): " << writer_kernel_node_props[i].size() << std::endl;
    }
    std::cout << "========== END PHASE 0.7 ==========\n" << std::endl;

    for (size_t flat_idx = 0; flat_idx < container.num_dense_partitions;
         ++flat_idx) {
        auto group_part = container.dense_partition_order[flat_idx];
        const auto &group = container.dense_groups[group_part.first];
        for (unsigned int local_pip = 0; local_pip < group.num_pipelines;
             ++local_pip) {
            unsigned int global_pip = group.pipeline_offset + local_pip;
            std::copy(dense_buffers[flat_idx].packed_node_props.begin(),
                      dense_buffers[flat_idx].packed_node_props.end(),
                      writer_kernel_node_props[global_pip].begin() +
                          dense_buffers[flat_idx].node_prop_offset);
            printf("LITTLE group %zu partition %zu (global pip %u) node_offset %u\n",
                   group_part.first, group_part.second, global_pip,
                   dense_buffers[flat_idx].node_prop_offset);
            fflush(stdout);
        }
    }
    for (size_t flat_idx = 0; flat_idx < container.num_sparse_partitions;
         ++flat_idx) {
        auto group_part = container.sparse_partition_order[flat_idx];
        const auto &group = container.sparse_groups[group_part.first];
        for (unsigned int local_pip = 0; local_pip < group.num_pipelines;
             ++local_pip) {
            unsigned int global_pip = group.pipeline_offset + local_pip;
            std::copy(
                sparse_buffers[flat_idx].packed_node_props.begin(),
                sparse_buffers[flat_idx].packed_node_props.end(),
                writer_kernel_node_props[global_pip + LITTLE_KERNEL_NUM]
                    .begin() + sparse_buffers[flat_idx].node_prop_offset);
            printf("BIG group %zu partition %zu (global pip %u) node_offset %u\n",
                   group_part.first, group_part.second, global_pip,
                   sparse_buffers[flat_idx].node_prop_offset);
            fflush(stdout);
        }
    }
    
    std::cout << "\n========== PHASE 0.8: WRITER KERNEL NODE PROPS FILLED ==========" << std::endl;
    for (int pip = 0; pip < LITTLE_KERNEL_NUM; ++pip) {
        std::cout << "  writer_kernel_node_props[" << pip << "] (LITTLE):" << std::endl;
        std::cout << "    size(): " << writer_kernel_node_props[pip].size() << std::endl;
        std::cout << "    All words:" << std::endl;
        for (size_t w = 0; w < writer_kernel_node_props[pip].size(); ++w) {
            print_bus_word(writer_kernel_node_props[pip][w], "node_prop", w);
        }
    }
    for (int pip = 0; pip < BIG_KERNEL_NUM; ++pip) {
        int idx = pip + LITTLE_KERNEL_NUM;
        std::cout << "  writer_kernel_node_props[" << idx << "] (BIG):" << std::endl;
        std::cout << "    size(): " << writer_kernel_node_props[idx].size() << std::endl;
        std::cout << "    All words:" << std::endl;
        for (size_t w = 0; w < writer_kernel_node_props[idx].size(); ++w) {
            print_bus_word(writer_kernel_node_props[idx][w], "node_prop", w);
        }
    }
    std::cout << "========== END PHASE 0.8 ==========\n" << std::endl;
    
    current_time = std::chrono::system_clock::now();
    std::cout
        << "--- [Host] Phase 0: Prepared apply kernel node props ("
        << std::chrono::duration<double>(current_time - start_time).count()
        << " sec) ---" << std::endl;
    std::cout << "[DEBUG] Exiting prepare_data" << std::endl;
    std::cout << std::flush;
}

// --- PHASE 1: BUFFER SETUP ---
// MODIFIED: Create separate edge buffers for each pipeline, but share node
// buffers within partition
void AlgorithmHost::setup_buffers(const PartitionContainer &container) {
    std::cout << "[DEBUG] Entering setup_buffers" << std::endl;
    std::cout << std::flush;
    cl_int err;
    std::cout
        << "--- [Host] Phase 1: Setting up HBM buffers for all pipelines ---"
        << std::endl;

    // 1.1: Clear old buffer handles and resize host-side result vectors
    writer_kernel_node_prop_buffers.clear();

    const size_t bytes_per_word = AXI_BUS_WIDTH / 8;
    size_t dists_per_word = AXI_BUS_WIDTH / DISTANCE_BITWIDTH;
    size_t total_output_words = apply_kernel_node_props.size();
    
    std::cout << "\n========== PHASE 1.1: BUFFER SETUP INIT ==========" << std::endl;
    std::cout << "  bytes_per_word: " << bytes_per_word << std::endl;
    std::cout << "  dists_per_word: " << dists_per_word << std::endl;
    std::cout << "  total_output_words: " << total_output_words << std::endl;
    std::cout << "  container.num_dense_partitions: " << container.num_dense_partitions << std::endl;
    std::cout << "  container.num_sparse_partitions: " << container.num_sparse_partitions << std::endl;
    std::cout << "========== END PHASE 1.1 ==========\n" << std::endl;

    // --- 1.2: Setup buffers for LITTLE pipelines ---
    for (size_t flat_idx = 0; flat_idx < container.num_dense_partitions;
         ++flat_idx) {
        auto group_part = container.dense_partition_order[flat_idx];
        const auto &group = container.dense_groups[group_part.first];

        for (unsigned int local_pip = 0; local_pip < group.num_pipelines;
             ++local_pip) {
            unsigned int global_pip = group.pipeline_offset + local_pip;
            cl::Buffer edge_props_buf;

            cl_mem_ext_ptr_t hbm_ext_edge;
            hbm_ext_edge.flags =
                XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_edge_id[global_pip];
            hbm_ext_edge.obj =
                dense_buffers[flat_idx].pipelines[local_pip]
                    .packed_edge_props.data();
            hbm_ext_edge.param = 0;

            size_t num_edge_words =
                dense_buffers[flat_idx].pipelines[local_pip]
                    .packed_edge_props.size();
            printf(
                "LITTLE group %zu partition %zu (global pip %u) edge words %zu\n",
                group_part.first, group_part.second, global_pip,
                num_edge_words);
            OCL_CHECK(err, edge_props_buf = cl::Buffer(
                               acc.context,
                               CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX |
                                   CL_MEM_USE_HOST_PTR,
                               num_edge_words * bytes_per_word, &hbm_ext_edge,
                               &err));

            dense_buffers[flat_idx].pipelines[local_pip].edge_props_buffer =
                edge_props_buf;
            
            std::cout << "  [DEBUG] Created LITTLE edge buffer: group=" << group_part.first 
                      << ", partition=" << group_part.second << ", local_pip=" << local_pip 
                      << ", global_pip=" << global_pip << ", num_edge_words=" << num_edge_words << std::endl;
        }

        std::cout << "  Created " << group.num_pipelines
                  << " little pipeline edge buffers." << std::endl;
    }

    // --- 1.3: Setup buffers for BIG pipelines ---
    for (size_t flat_idx = 0; flat_idx < container.num_sparse_partitions;
         ++flat_idx) {
        auto group_part = container.sparse_partition_order[flat_idx];
        const auto &group = container.sparse_groups[group_part.first];

        for (unsigned int local_pip = 0; local_pip < group.num_pipelines;
             ++local_pip) {
            unsigned int global_pip = group.pipeline_offset + local_pip;
            cl::Buffer edge_props_buf;

            cl_mem_ext_ptr_t hbm_ext_edge;
            hbm_ext_edge.flags =
                XCL_MEM_TOPOLOGY | acc.big_kernel_hbm_edge_id[global_pip];
            hbm_ext_edge.obj =
                sparse_buffers[flat_idx].pipelines[local_pip]
                    .packed_edge_props.data();
            hbm_ext_edge.param = 0;

            size_t num_edge_words =
                sparse_buffers[flat_idx].pipelines[local_pip]
                    .packed_edge_props.size();
            printf("BIG group %zu partition %zu (global pip %u) edge words %zu\n",
                   group_part.first, group_part.second, global_pip,
                   num_edge_words);
            OCL_CHECK(err, edge_props_buf = cl::Buffer(
                               acc.context,
                               CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX |
                                   CL_MEM_USE_HOST_PTR,
                               num_edge_words * bytes_per_word, &hbm_ext_edge,
                               &err));

            sparse_buffers[flat_idx].pipelines[local_pip].edge_props_buffer =
                edge_props_buf;
            
            std::cout << "  [DEBUG] Created BIG edge buffer: group=" << group_part.first 
                      << ", partition=" << group_part.second << ", local_pip=" << local_pip 
                      << ", global_pip=" << global_pip << ", num_edge_words=" << num_edge_words << std::endl;
        }

        std::cout << "  Created " << group.num_pipelines
                  << " big pipeline edge buffers." << std::endl;
    }

    // --- 1.4: Setup shared node property buffers for hbm_writer (14 total: 11
    // little + 3 big) --- Create 11 little node prop buffers for hbm_writer
    for (int pip = 0; pip < LITTLE_KERNEL_NUM; ++pip) {
        cl_mem_ext_ptr_t hbm_ext_node;
        hbm_ext_node.flags =
            XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_node_id[pip];
        hbm_ext_node.obj = writer_kernel_node_props[pip].data();
        hbm_ext_node.param = 0;

        size_t num_node_words = writer_kernel_node_props[pip].size();
        cl::Buffer node_buf;
        OCL_CHECK(err, node_buf =
                           cl::Buffer(acc.context,
                                      CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX |
                                          CL_MEM_USE_HOST_PTR,
                                      num_node_words * bytes_per_word,
                                      &hbm_ext_node, &err));
        writer_kernel_node_prop_buffers.push_back(node_buf);
        printf("[DEBUG] Pushed to writer_kernel_node_prop_buffers[%d] little pip %d, words %zu\n",
               pip, pip, num_node_words);
        
        std::cout << "  [DETAILED] LITTLE writer_kernel_node_prop_buffers[" << pip << "]:" << std::endl;
        std::cout << "    num_node_words: " << num_node_words << std::endl;
        std::cout << "    All words of data:" << std::endl;
        for (size_t w = 0; w < writer_kernel_node_props[pip].size(); ++w) {
            print_bus_word(writer_kernel_node_props[pip][w], "node_prop", w);
        }
    }

    // Create 3 big node prop buffers for hbm_writer
    for (int pip = 0; pip < BIG_KERNEL_NUM; ++pip) {
        cl_mem_ext_ptr_t hbm_ext_node;
        hbm_ext_node.flags = XCL_MEM_TOPOLOGY | acc.big_kernel_hbm_node_id[pip];
        hbm_ext_node.obj =
            writer_kernel_node_props[pip + LITTLE_KERNEL_NUM].data();
        hbm_ext_node.param = 0;

        size_t num_node_words =
            writer_kernel_node_props[pip + LITTLE_KERNEL_NUM].size();
        cl::Buffer node_buf;
        OCL_CHECK(err, node_buf =
                           cl::Buffer(acc.context,
                                      CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX |
                                          CL_MEM_USE_HOST_PTR,
                                      num_node_words * bytes_per_word,
                                      &hbm_ext_node, &err));
        writer_kernel_node_prop_buffers.push_back(node_buf);
        printf("[DEBUG] Pushed to writer_kernel_node_prop_buffers[%d] big pip %d, words %zu\n",
               pip + LITTLE_KERNEL_NUM, pip, num_node_words);
        
        std::cout << "  [DETAILED] BIG writer_kernel_node_prop_buffers[" << (pip + LITTLE_KERNEL_NUM) << "]:" << std::endl;
        std::cout << "    num_node_words: " << num_node_words << std::endl;
        std::cout << "    All words of data:" << std::endl;
        for (size_t w = 0; w < writer_kernel_node_props[pip + LITTLE_KERNEL_NUM].size(); ++w) {
            print_bus_word(writer_kernel_node_props[pip + LITTLE_KERNEL_NUM][w], "node_prop", w);
        }
    }

    // --- 1.5: Setup unified output buffer ---
    cl_mem_ext_ptr_t hbm_ext_output;
    if (container.num_dense_partitions == 0) {
        hbm_ext_output.flags =
            XCL_MEM_TOPOLOGY | acc.big_kernel_hbm_node_id[0]; // Use first BIG HBM bank
    } else {
        hbm_ext_output.flags =
            XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_node_id[0]; // Use first LITTLE HBM bank
    }
    hbm_ext_output.obj = nullptr;
    hbm_ext_output.param = 0;

    writer_kernel_host_outputs.resize(total_output_words, 0);
    OCL_CHECK(err,
              writer_kernel_output_buffer = cl::Buffer(
                  acc.context, CL_MEM_WRITE_ONLY | CL_MEM_EXT_PTR_XILINX,
                  total_output_words * bytes_per_word, &hbm_ext_output, &err));

    // --- 1.6: Setup apply_kernel node prop buffer ---
    cl_mem_ext_ptr_t hbm_ext_apply;
    hbm_ext_apply.flags = XCL_MEM_TOPOLOGY | 30;
    hbm_ext_apply.obj = apply_kernel_node_props.data();
    hbm_ext_apply.param = 0;

    size_t apply_node_words = apply_kernel_node_props.size();
    OCL_CHECK(err, apply_kernel_node_prop_buffer =
                       cl::Buffer(acc.context,
                                  CL_MEM_READ_WRITE | CL_MEM_EXT_PTR_XILINX |
                                      CL_MEM_USE_HOST_PTR,
                                  apply_node_words * bytes_per_word,
                                  &hbm_ext_apply, &err));
    
    std::cout << "\n========== PHASE 1.6: APPLY KERNEL NODE PROP BUFFER ==========" << std::endl;
    std::cout << "  apply_node_words: " << apply_node_words << std::endl;
    std::cout << "  Buffer size (bytes): " << (apply_node_words * bytes_per_word) << std::endl;
    std::cout << "  All words of apply_kernel_node_props:" << std::endl;
    for (size_t w = 0; w < apply_kernel_node_props.size(); ++w) {
        print_bus_word(apply_kernel_node_props[w], "node_prop", w);
    }
    std::cout << "========== END PHASE 1.6 ==========\n" << std::endl;

    std::cout << "[SUCCESS] HBM buffers created: " << LITTLE_KERNEL_NUM
              << " little + " << BIG_KERNEL_NUM << " big pipelines, "
              << "total output size: " << total_output_words << " words."
              << std::endl;
    std::cout << "[DEBUG] Exiting setup_buffers" << std::endl;
    std::cout << std::flush;
}

void AlgorithmHost::update_data(const PartitionContainer &container) {
    std::cout << "[DEBUG] Entering update_data" << std::endl;
    std::cout << std::flush;
    std::cout
        << "--- [Host] Phase 2.1: Updating host-side data for new iteration ---"
        << std::endl;

    const size_t bytes_per_word = AXI_BUS_WIDTH / 8;
    const size_t dists_per_word = AXI_BUS_WIDTH / DISTANCE_BITWIDTH;
    
    std::cout << "\n========== PHASE 2.1: UPDATE DATA INIT ==========" << std::endl;
    std::cout << "  bytes_per_word: " << bytes_per_word << std::endl;
    std::cout << "  dists_per_word: " << dists_per_word << std::endl;
    std::cout << "  h_distances.size(): " << h_distances.size() << std::endl;
    std::cout << "  All updated distances:" << std::endl;
    for (size_t i = 0; i < h_distances.size(); ++i) {
        std::cout << "    h_distances[" << i << "] = " << h_distances[i].to_float() << std::endl;
    }
    std::cout << "========== END PHASE 2.1 INIT ==========\n" << std::endl;

    // Update BIG partition node distances (shared across all big pipelines)
    for (size_t flat_idx = 0; flat_idx < container.num_sparse_partitions;
         ++flat_idx) {
        auto group_part = container.sparse_partition_order[flat_idx];
        const auto &group = container.sparse_groups[group_part.first];
        const auto &big_partition = group.partitions[group_part.second];
        const size_t bytes_per_dist = DISTANCE_BITWIDTH / 8;
        std::vector<char> temp_byte_buffer;
        temp_byte_buffer.clear();

        for (int j = 0; j < big_partition.num_vertices; ++j) {
            if ((temp_byte_buffer.size() % bytes_per_word) + bytes_per_dist >
                bytes_per_word) {
                size_t padding_needed =
                    bytes_per_word - (temp_byte_buffer.size() % bytes_per_word);
                temp_byte_buffer.insert(temp_byte_buffer.end(), padding_needed,
                                        0);
            }

            int global_id = big_partition.vtx_map_rev.at(j);
            distance_t dist_val = h_distances[global_id];

            // printf("Putting Data: SP No.%d, local_id %d, global_id %d, dist
            // %.3f\n",
            //        i,  j, global_id, (float)dist_val);

            const char *data_ptr = reinterpret_cast<const char *>(&dist_val);
            temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr,
                                    data_ptr + bytes_per_dist);
        }

        // Update all big pipeline buffers with same node data
        size_t num_words =
            (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word;
        if (num_words == 0) {
            // Ensure at least one word for zero-vertex partitions
            num_words = 1;
        }

        sparse_buffers[flat_idx].packed_node_props.resize(num_words, 0);
        std::memcpy(sparse_buffers[flat_idx].packed_node_props.data(),
                    temp_byte_buffer.data(), temp_byte_buffer.size());
        for (unsigned int local_pip = 0; local_pip < group.num_pipelines;
             ++local_pip) {
            unsigned int global_pip = group.pipeline_offset + local_pip;
            std::copy(
                sparse_buffers[flat_idx].packed_node_props.begin(),
                sparse_buffers[flat_idx].packed_node_props.end(),
                writer_kernel_node_props[global_pip + LITTLE_KERNEL_NUM]
                    .begin() + sparse_buffers[flat_idx].node_prop_offset);
            
            std::cout << "  [UPDATE] BIG partition " << flat_idx << ", pipeline " << local_pip 
                      << " (global " << global_pip << "): updated node props" << std::endl;
        }
        
        std::cout << "\n========== PHASE 2.1.1: BIG Partition " << flat_idx 
                  << " Updated Node Props ==========" << std::endl;
        std::cout << "  packed_node_props.size(): " << sparse_buffers[flat_idx].packed_node_props.size() << std::endl;
        std::cout << "  All words:" << std::endl;
        for (size_t w = 0; w < sparse_buffers[flat_idx].packed_node_props.size(); ++w) {
            print_bus_word(sparse_buffers[flat_idx].packed_node_props[w], "node_prop", w);
        }
        std::cout << "========== END PHASE 2.1.1 ==========\n" << std::endl;

        // update big_dst_node_props for apply kernel
        {
            const size_t dist_per_word = bytes_per_word / bytes_per_dist;
            const size_t dst_word_number =
                (big_partition.num_dsts + dist_per_word - 1) / dist_per_word;
            temp_byte_buffer.clear();
            temp_byte_buffer.reserve(dst_word_number * bytes_per_word);
            for (int j = 0; j < big_partition.num_dsts; ++j) {
                if ((temp_byte_buffer.size() % bytes_per_word) +
                        bytes_per_dist >
                    bytes_per_word) {
                    size_t padding_needed =
                        bytes_per_word -
                        (temp_byte_buffer.size() % bytes_per_word);
                    temp_byte_buffer.insert(temp_byte_buffer.end(),
                                            padding_needed, 0);
                }
                int global_id = big_partition.vtx_map_rev.at(j);
                distance_t dist_val = h_distances[global_id];
                const char *data_ptr =
                    reinterpret_cast<const char *>(&dist_val);
                temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr,
                                        data_ptr + bytes_per_dist);
            }
            sparse_buffers[flat_idx].packed_dst_props.resize(
                (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word,
                0);
            std::memcpy(sparse_buffers[flat_idx].packed_dst_props.data(),
                        temp_byte_buffer.data(), temp_byte_buffer.size());
            // Copy into absolute location within apply buffer:
            // base = big merger's absolute offset + group-local dst offset
            const uint32_t merger_abs_offset =
                big_merger_offsets[group_part.first];
            std::copy(
                sparse_buffers[flat_idx].packed_dst_props.begin(),
                sparse_buffers[flat_idx].packed_dst_props.end(),
                apply_kernel_node_props.begin() + merger_abs_offset +
                    sparse_buffers[flat_idx].dst_prop_offset);
        }
        
        std::cout << "\n========== PHASE 2.1.2: BIG Partition " << flat_idx 
                  << " Updated Dst Props ==========" << std::endl;
        std::cout << "  packed_dst_props.size(): " << sparse_buffers[flat_idx].packed_dst_props.size() << std::endl;
        std::cout << "  merger_abs_offset: " << big_merger_offsets[group_part.first] << std::endl;
        std::cout << "  dst_prop_offset: " << sparse_buffers[flat_idx].dst_prop_offset << std::endl;
        std::cout << "  All words:" << std::endl;
        for (size_t w = 0; w < sparse_buffers[flat_idx].packed_dst_props.size(); ++w) {
            print_bus_word(sparse_buffers[flat_idx].packed_dst_props[w], "node_prop", w);
        }
        std::cout << "========== END PHASE 2.1.2 ==========\n" << std::endl;
    }

    // Update LITTLE partition node distances (shared across all little
    // pipelines)
    for (size_t flat_idx = 0; flat_idx < container.num_dense_partitions;
         ++flat_idx) {
        auto group_part = container.dense_partition_order[flat_idx];
        const auto &group = container.dense_groups[group_part.first];
        const auto &little_partition =
            group.partitions[group_part.second];
        const size_t bytes_per_dist = DISTANCE_BITWIDTH / 8;
        std::vector<char> temp_byte_buffer;
        temp_byte_buffer.clear();

        for (int j = 0; j < little_partition.num_vertices; ++j) {
            if ((temp_byte_buffer.size() % bytes_per_word) + bytes_per_dist >
                bytes_per_word) {
                size_t padding_needed =
                    bytes_per_word - (temp_byte_buffer.size() % bytes_per_word);
                temp_byte_buffer.insert(temp_byte_buffer.end(), padding_needed,
                                        0);
            }
            int global_id = little_partition.vtx_map_rev.at(j);
            distance_t dist_val = h_distances[global_id];
            // printf("Putting Data: DP No.%d, local_id %d, global_id %d, dist
            // %.3f\n",
            //        i,  j, global_id, (float)dist_val);
            const char *data_ptr = reinterpret_cast<const char *>(&dist_val);
            temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr,
                                    data_ptr + bytes_per_dist);
        }
        // Pad to SRC_BUFFER_SIZE nodes for little kernel
        {
            size_t buffer_size = SRC_BUFFER_SIZE * bytes_per_dist;
            if (temp_byte_buffer.size() % buffer_size != 0) {
                size_t padding_needed =
                    buffer_size - (temp_byte_buffer.size() % buffer_size);
                temp_byte_buffer.insert(temp_byte_buffer.end(), padding_needed, 0);
            }
            if (temp_byte_buffer.empty()) {
                temp_byte_buffer.insert(temp_byte_buffer.end(), buffer_size, 0);
            }
        }
        // Update all little pipeline buffers with same node data
        size_t num_words =
            (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word;
        if (num_words == 0) {
            // Ensure at least one word for zero-vertex partitions
            num_words = 1;
        }

        dense_buffers[flat_idx].packed_node_props.resize(num_words, 0);
        std::memcpy(dense_buffers[flat_idx].packed_node_props.data(),
                    temp_byte_buffer.data(), temp_byte_buffer.size());
        for (unsigned int local_pip = 0; local_pip < group.num_pipelines;
             ++local_pip) {
            unsigned int global_pip = group.pipeline_offset + local_pip;
            std::copy(dense_buffers[flat_idx].packed_node_props.begin(),
                      dense_buffers[flat_idx].packed_node_props.end(),
                      writer_kernel_node_props[global_pip].begin() +
                          dense_buffers[flat_idx].node_prop_offset);
            
            std::cout << "  [UPDATE] LITTLE partition " << flat_idx << ", pipeline " << local_pip 
                      << " (global " << global_pip << "): updated node props" << std::endl;
        }
        
        std::cout << "\n========== PHASE 2.1.3: LITTLE Partition " << flat_idx 
                  << " Updated Node Props ==========" << std::endl;
        std::cout << "  packed_node_props.size(): " << dense_buffers[flat_idx].packed_node_props.size() << std::endl;
        std::cout << "  All words:" << std::endl;
        for (size_t w = 0; w < dense_buffers[flat_idx].packed_node_props.size(); ++w) {
            print_bus_word(dense_buffers[flat_idx].packed_node_props[w], "node_prop", w);
        }
        std::cout << "========== END PHASE 2.1.3 ==========\n" << std::endl;

        // update little_dst_node_props for apply kernel
        {
            const size_t dist_per_word = bytes_per_word / bytes_per_dist;
            const size_t dst_word_number =
                (little_partition.num_dsts + dist_per_word - 1) / dist_per_word;
            temp_byte_buffer.clear();
            temp_byte_buffer.reserve(dst_word_number * bytes_per_word);
            for (int j = 0; j < little_partition.num_dsts; ++j) {
                if ((temp_byte_buffer.size() % bytes_per_word) +
                        bytes_per_dist >
                    bytes_per_word) {
                    size_t padding_needed =
                        bytes_per_word -
                        (temp_byte_buffer.size() % bytes_per_word);
                    temp_byte_buffer.insert(temp_byte_buffer.end(),
                                            padding_needed, 0);
                }
                int global_id = little_partition.vtx_map_rev.at(j);
                distance_t dist_val = h_distances[global_id];
                const char *data_ptr =
                    reinterpret_cast<const char *>(&dist_val);
                temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr,
                                        data_ptr + bytes_per_dist);
            }
            dense_buffers[flat_idx].packed_dst_props.resize(
                (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word,
                0);
            std::memcpy(dense_buffers[flat_idx].packed_dst_props.data(),
                        temp_byte_buffer.data(), temp_byte_buffer.size());
            // Copy into absolute location within apply buffer:
            // base = little merger's absolute offset + group-local dst offset
            const uint32_t merger_abs_offset =
                little_merger_offsets[group_part.first];
            std::copy(
                dense_buffers[flat_idx].packed_dst_props.begin(),
                dense_buffers[flat_idx].packed_dst_props.end(),
                apply_kernel_node_props.begin() + merger_abs_offset +
                    dense_buffers[flat_idx].dst_prop_offset);
        }
        
        std::cout << "\n========== PHASE 2.1.4: LITTLE Partition " << flat_idx 
                  << " Updated Dst Props ==========" << std::endl;
        std::cout << "  packed_dst_props.size(): " << dense_buffers[flat_idx].packed_dst_props.size() << std::endl;
        std::cout << "  merger_abs_offset: " << little_merger_offsets[group_part.first] << std::endl;
        std::cout << "  dst_prop_offset: " << dense_buffers[flat_idx].dst_prop_offset << std::endl;
        std::cout << "  All words:" << std::endl;
        for (size_t w = 0; w < dense_buffers[flat_idx].packed_dst_props.size(); ++w) {
            print_bus_word(dense_buffers[flat_idx].packed_dst_props[w], "node_prop", w);
        }
        std::cout << "========== END PHASE 2.1.4 ==========\n" << std::endl;
    }

    // Print first pipeline's node prop data for each dense and sparse group
    // Dense groups
    for (size_t g = 0; g < container.num_dense_groups; ++g) {
        const auto &grp = container.dense_groups[g];
        if (grp.num_pipelines == 0) {
            continue;
        }
        size_t pip = grp.pipeline_offset; // dense pipelines are 0-based in global index space
        if (pip >= writer_kernel_node_props.size()) {
            continue;
        }
        const auto &node_props = writer_kernel_node_props[pip];
        std::cout << "Pipeline " << pip << std::endl;
        std::cout << "  (Dense partition)" << std::endl;
        std::cout << "  Group " << g << std::endl;
        std::cout << "  Words: " << node_props.size() << std::endl;
        for (size_t word_idx = 0; word_idx < node_props.size(); ++word_idx) {
            const bus_word_t &word = node_props[word_idx];
            std::cout << "Pipeline " << pip << ", Word " << word_idx << ": ";
            for (size_t data_idx = 0; data_idx < dists_per_word; ++data_idx) {
                const int high_bit =
                    static_cast<int>((data_idx + 1) * DISTANCE_BITWIDTH - 1);
                const int low_bit =
                    static_cast<int>(data_idx * DISTANCE_BITWIDTH);
                ap_uint<DISTANCE_BITWIDTH> raw_bits =
                    word.range(high_bit, low_bit);
                distance_t dist = 0;
                dist.range(DISTANCE_BITWIDTH - 1, 0) = raw_bits;
                float dist_float = dist.to_float();
                std::cout << dist_float << " ";
            }
            std::cout << std::endl;
        }
        std::cout << std::flush;
    }
    // Sparse groups
    for (size_t g = 0; g < container.num_sparse_groups; ++g) {
        const auto &grp = container.sparse_groups[g];
        if (grp.num_pipelines == 0) {
            continue;
        }
        size_t pip = LITTLE_KERNEL_NUM + grp.pipeline_offset; // sparse pipelines follow dense pipelines
        if (pip >= writer_kernel_node_props.size()) {
            continue;
        }
        const auto &node_props = writer_kernel_node_props[pip];
        std::cout << "Pipeline " << pip << std::endl;
        std::cout << "  (Sparse partition)" << std::endl;
        std::cout << "  Group " << g << std::endl;
        std::cout << "  Words: " << node_props.size() << std::endl;
        for (size_t word_idx = 0; word_idx < node_props.size(); ++word_idx) {
            const bus_word_t &word = node_props[word_idx];
            std::cout << "Pipeline " << pip << ", Word " << word_idx << ": ";
            for (size_t data_idx = 0; data_idx < dists_per_word; ++data_idx) {
                const int high_bit =
                    static_cast<int>((data_idx + 1) * DISTANCE_BITWIDTH - 1);
                const int low_bit =
                    static_cast<int>(data_idx * DISTANCE_BITWIDTH);
                ap_uint<DISTANCE_BITWIDTH> raw_bits =
                    word.range(high_bit, low_bit);
                distance_t dist = 0;
                dist.range(DISTANCE_BITWIDTH - 1, 0) = raw_bits;
                float dist_float = dist.to_float();
                std::cout << dist_float << " ";
            }
            std::cout << std::endl;
        }
        std::cout << std::flush;
    }

    std::cout << "\n========== PHASE 2.2: ALL UPDATED APPLY KERNEL NODE PROPS ==========" << std::endl;
    std::cout << "  apply_kernel_node_props.size(): " << apply_kernel_node_props.size() << std::endl;
    std::cout << "  All words of apply_kernel_node_props:" << std::endl;
    for (size_t w = 0; w < apply_kernel_node_props.size(); ++w) {
        print_bus_word(apply_kernel_node_props[w], "node_prop", w);
    }
    std::cout << "========== END PHASE 2.2 ==========\n" << std::endl;

    std::cout << "\n========== PHASE 2.3: ALL UPDATED WRITER KERNEL NODE PROPS ==========" << std::endl;
    for (int pip = 0; pip < LITTLE_KERNEL_NUM; ++pip) {
        std::cout << "  writer_kernel_node_props[" << pip << "] (LITTLE):" << std::endl;
        std::cout << "    size(): " << writer_kernel_node_props[pip].size() << std::endl;
        std::cout << "    All words:" << std::endl;
        for (size_t w = 0; w < writer_kernel_node_props[pip].size(); ++w) {
            print_bus_word(writer_kernel_node_props[pip][w], "node_prop", w);
        }
    }
    for (int pip = 0; pip < BIG_KERNEL_NUM; ++pip) {
        int idx = pip + LITTLE_KERNEL_NUM;
        std::cout << "  writer_kernel_node_props[" << idx << "] (BIG):" << std::endl;
        std::cout << "    size(): " << writer_kernel_node_props[idx].size() << std::endl;
        std::cout << "    All words:" << std::endl;
        for (size_t w = 0; w < writer_kernel_node_props[idx].size(); ++w) {
            print_bus_word(writer_kernel_node_props[idx][w], "node_prop", w);
        }
    }
    std::cout << "========== END PHASE 2.3 ==========\n" << std::endl;

    std::cout << "[SUCCESS] Host-side data updated for new iteration."
              << std::endl;
    std::cout << "[DEBUG] Exiting update_data" << std::endl;
    std::cout << std::flush;
}

void AlgorithmHost::transfer_data_to_fpga(const PartitionContainer &container) {
    std::cout << "[DEBUG] Entering transfer_data_to_fpga" << std::endl;
    std::cout << std::flush;
    cl_int err;
    std::cout << "--- [Host] Phase 2.2: Transferring data to FPGA HBM ---"
              << std::endl;

    // Transfer edge buffers for sparse groups
    for (size_t group_idx = 0; group_idx < container.num_sparse_groups;
         ++group_idx) {
        const auto &group = container.sparse_groups[group_idx];
        for (unsigned int local_pip = 0; local_pip < group.num_pipelines;
             ++local_pip) {
            unsigned int global_pip = group.pipeline_offset + local_pip;
            // Bounds check: global_pip
            if (global_pip >= acc.big_gs_queue.size()) {
                std::cerr << "[ERROR] Bounds violation: global_pip=" << global_pip
                          << " >= big_gs_queue.size()=" << acc.big_gs_queue.size()
                          << " (sparse group=" << group_idx
                          << ", local_pip=" << local_pip << ")" << std::endl;
                std::cerr << std::flush;
                throw std::runtime_error("global_pip out of bounds for big_gs_queue");
            }
            for (size_t part_idx = 0;
                 part_idx < container.sparse_groups[group_idx].partitions.size();
                 ++part_idx) {
                size_t flat_idx =
                    container.sparse_partition_indices[group_idx][part_idx];
                // Bounds check: flat_idx
                if (flat_idx >= sparse_buffers.size()) {
                    std::cerr << "[ERROR] Bounds violation: flat_idx=" << flat_idx
                              << " >= sparse_buffers.size()=" << sparse_buffers.size()
                              << " (sparse group=" << group_idx
                              << ", part_idx=" << part_idx << ")" << std::endl;
                    std::cerr << std::flush;
                    throw std::runtime_error("flat_idx out of bounds for sparse_buffers");
                }
                // Bounds check: local_pip
                if (local_pip >= sparse_buffers[flat_idx].pipelines.size()) {
                    std::cerr << "[ERROR] Bounds violation: local_pip=" << local_pip
                              << " >= sparse_buffers[" << flat_idx
                              << "].pipelines.size()="
                              << sparse_buffers[flat_idx].pipelines.size()
                              << " (sparse group=" << group_idx
                              << ", part_idx=" << part_idx << ")" << std::endl;
                    std::cerr << std::flush;
                    throw std::runtime_error("local_pip out of bounds for sparse_buffers pipelines");
                }
                std::cout << "[DEBUG] Migrating sparse group " << group_idx
                          << " local_pip " << local_pip << " (global "
                          << global_pip << ") partition " << part_idx
                          << " flat_idx " << flat_idx << std::endl;
                std::cout << std::flush;
                OCL_CHECK(err,
                          err = acc.big_gs_queue[global_pip]
                                    .enqueueMigrateMemObjects(
                                        {sparse_buffers[flat_idx]
                                             .pipelines[local_pip]
                                             .edge_props_buffer},
                                        0));
            }
        }
    }

    // exit(0);
    // possible bug part

    // Transfer edge buffers for dense groups
    for (size_t group_idx = 0; group_idx < container.num_dense_groups;
         ++group_idx) {
        if (group_idx >= container.dense_groups.size()) {
            std::cerr << "[ERROR] Bounds violation: group_idx=" << group_idx
                      << " >= container.dense_groups.size()=" << container.dense_groups.size()
                      << std::endl;
            std::cerr << std::flush;
            throw std::runtime_error("group_idx out of bounds for dense_groups");
        }
        const auto &group = container.dense_groups[group_idx];
        for (unsigned int local_pip = 0; local_pip < group.num_pipelines;
             ++local_pip) {
            unsigned int global_pip = group.pipeline_offset + local_pip;
            // Bounds check: global_pip
            if (global_pip >= acc.little_gs_queue.size()) {
                std::cerr << "[ERROR] Bounds violation: global_pip=" << global_pip
                          << " >= little_gs_queue.size()=" << acc.little_gs_queue.size()
                          << " (dense group=" << group_idx
                          << ", local_pip=" << local_pip << ")" << std::endl;
                std::cerr << std::flush;
                throw std::runtime_error("global_pip out of bounds for little_gs_queue");
            }
            for (size_t part_idx = 0;
                 part_idx < container.dense_groups[group_idx].partitions.size();
                 ++part_idx) {
                if (group_idx >= container.dense_partition_indices.size()) {
                    std::cerr << "[ERROR] Bounds violation: group_idx=" << group_idx
                              << " >= container.dense_partition_indices.size()=" << container.dense_partition_indices.size()
                              << std::endl;
                    std::cerr << std::flush;
                    throw std::runtime_error("group_idx out of bounds for dense_partition_indices");
                }
                if (part_idx >= container.dense_partition_indices[group_idx].size()) {
                    std::cerr << "[ERROR] Bounds violation: part_idx=" << part_idx
                              << " >= container.dense_partition_indices[" << group_idx << "].size()=" << container.dense_partition_indices[group_idx].size()
                              << std::endl;
                    std::cerr << std::flush;
                    throw std::runtime_error("part_idx out of bounds for dense_partition_indices");
                }
                size_t flat_idx =
                    container.dense_partition_indices[group_idx][part_idx];
                // Bounds check: flat_idx
                if (flat_idx >= dense_buffers.size()) {
                    std::cerr << "[ERROR] Bounds violation: flat_idx=" << flat_idx
                              << " >= dense_buffers.size()=" << dense_buffers.size()
                              << " (dense group=" << group_idx
                              << ", part_idx=" << part_idx << ")" << std::endl;
                    std::cerr << std::flush;
                    throw std::runtime_error("flat_idx out of bounds for dense_buffers");
                }
                // Bounds check: local_pip
                if (local_pip >= dense_buffers[flat_idx].pipelines.size()) {
                    std::cerr << "[ERROR] Bounds violation: local_pip=" << local_pip
                              << " >= dense_buffers[" << flat_idx
                              << "].pipelines.size()="
                              << dense_buffers[flat_idx].pipelines.size()
                              << " (dense group=" << group_idx
                              << ", part_idx=" << part_idx << ")" << std::endl;
                    std::cerr << std::flush;
                    throw std::runtime_error("local_pip out of bounds for dense_buffers pipelines");
                }
                std::cout << "[DEBUG] Migrating dense group " << group_idx
                          << " local_pip " << local_pip << " (global "
                          << global_pip << ") partition " << part_idx
                          << " flat_idx " << flat_idx << std::endl;
                std::cout << std::flush;
                // OCL_CHECK(err,
                //           err = acc.little_gs_queue[global_pip]
                //                     .enqueueMigrateMemObjects(
                //                         {dense_buffers[flat_idx]
                //                              .pipelines[local_pip]
                //                              .edge_props_buffer},
                //                         0));
            }
        }
    }
    // possible bug part
    // exit(0);

    // Transfer apply_kernel node buffer
    std::cout << "[DEBUG] Migrating apply_kernel_node_prop_buffer (words="
              << apply_kernel_node_props.size() << ")" << std::endl;
    std::cout << std::flush;
    OCL_CHECK(err,
              err = acc.apply_queue.enqueueMigrateMemObjects(
                  {apply_kernel_node_prop_buffer}, 0 /* 0 means from host*/));

    // Transfer hbm_writer node prop buffers
    const size_t expected_writer_buffers =
        static_cast<size_t>(LITTLE_KERNEL_NUM + BIG_KERNEL_NUM);
    if (writer_kernel_node_prop_buffers.size() != expected_writer_buffers) {
        std::cerr << "[ERROR] Bounds violation: writer_kernel_node_prop_buffers.size()="
                  << writer_kernel_node_prop_buffers.size()
                  << " (expected " << expected_writer_buffers << ")" << std::endl;
        std::cerr << std::flush;
        throw std::runtime_error(
            "writer_kernel_node_prop_buffers size mismatch");
    }
    for (size_t i = 0; i < writer_kernel_node_prop_buffers.size(); ++i) {
        std::cout << "[DEBUG] Migrating writer_kernel_node_prop_buffer index "
                  << i << std::endl;
        std::cout << std::flush;
        OCL_CHECK(err, err = acc.hbm_writer_queue.enqueueMigrateMemObjects(
                           {writer_kernel_node_prop_buffers[i]},
                           0 /* 0 means from host*/));
    }
    // exit(0);

    std::cout << "[DEBUG] Completed writer buffer migrations" << std::endl;
    std::cout << std::flush;

    // Wait for all transfers to complete
    if (acc.big_gs_queue.size() != static_cast<size_t>(BIG_KERNEL_NUM)) {
        std::cerr << "[ERROR] Bounds violation: big_gs_queue.size()="
                  << acc.big_gs_queue.size() << " (expected "
                  << BIG_KERNEL_NUM << ")" << std::endl;
        std::cerr << std::flush;
        throw std::runtime_error("big_gs_queue size mismatch");
    }
    std::cout << "[DEBUG] Finishing big queues (" << acc.big_gs_queue.size()
              << ")" << std::endl;
    std::cout << std::flush;
    for (auto &q : acc.big_gs_queue)
        q.finish();
    if (acc.little_gs_queue.size() != static_cast<size_t>(LITTLE_KERNEL_NUM)) {
        std::cerr << "[ERROR] Bounds violation: little_gs_queue.size()="
                  << acc.little_gs_queue.size() << " (expected "
                  << LITTLE_KERNEL_NUM << ")" << std::endl;
        std::cerr << std::flush;
        throw std::runtime_error("little_gs_queue size mismatch");
    }
    std::cout << "[DEBUG] Finishing little queues ("
              << acc.little_gs_queue.size() << ")" << std::endl;
    std::cout << std::flush;
    for (auto &q : acc.little_gs_queue)
        q.finish();
    std::cout << "[DEBUG] Finishing apply queue" << std::endl;
    std::cout << std::flush;
    acc.apply_queue.finish();
    std::cout << "[DEBUG] Finishing hbm_writer queue" << std::endl;
    std::cout << std::flush;
    acc.hbm_writer_queue.finish();

    std::cout
        << "[SUCCESS] All data packed and transferred for current iteration."
        << std::endl;
    std::cout << "[DEBUG] Exiting transfer_data_to_fpga" << std::endl;
    std::cout << std::flush;
}

// --- PHASE 3: KERNEL EXECUTION ---
// MODIFIED: Kernel arguments are updated to match the new kernel signature.
void AlgorithmHost::execute_kernel_iteration(
    const PartitionContainer &container) {
    std::cout << "[DEBUG] Entering execute_kernel_iteration" << std::endl;
    std::cout << std::flush;
    cl_int err;
    // std::cout << "--- [Host] Phase 3: Enqueuing kernel tasks ---" <<
    // std::endl;

    auto enqueue_start = std::chrono::high_resolution_clock::now();

    // uint32_t byte_per_word = AXI_BUS_WIDTH / 8;
    // uint32_t dists_per_word = AXI_BUS_WIDTH / DISTANCE_BITWIDTH;
    uint32_t little_dst_word_num = std::accumulate(
        little_merger_lengths.begin(), little_merger_lengths.end(), 0u);
    uint32_t big_dst_word_num = std::accumulate(
        big_merger_lengths.begin(), big_merger_lengths.end(), 0u);

    // 3.1: Enqueue BIG gs kernels (one per pipeline, each with different edges,
    // same nodes)
    size_t sparse_flat_idx = 0;
    for (size_t group_idx = 0; group_idx < container.num_sparse_groups;
         ++group_idx) {
        const auto &group = container.sparse_groups[group_idx];
        for (size_t part_idx = 0; part_idx < group.partitions.size();
             ++part_idx, ++sparse_flat_idx) {
            const auto &partition = group.partitions[part_idx];
            for (unsigned int local_pip = 0; local_pip < group.num_pipelines;
                 ++local_pip) {
                unsigned int global_pip = group.pipeline_offset + local_pip;
                auto &kernel = acc.big_gs_krnls[global_pip];
                auto &buffer = sparse_buffers[sparse_flat_idx]
                                   .pipelines[local_pip]
                                   .edge_props_buffer;
                uint32_t original_num_edges =
                    partition.pipeline_edges[local_pip].num_edges;
                uint32_t pip_num_edges =
                    (original_num_edges == 0) ? 8 : original_num_edges;
                uint32_t big_num_vertices = partition.num_vertices;
                uint32_t big_num_dsts = partition.num_dsts;
                uint32_t memory_offset =
                    sparse_buffers[sparse_flat_idx].src_prop_offset;

                int arg_idx = 0;
                OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffer));
                OCL_CHECK(err, err = kernel.setArg(arg_idx++, big_num_vertices));
                OCL_CHECK(err, err = kernel.setArg(arg_idx++, pip_num_edges));
                OCL_CHECK(err, err = kernel.setArg(arg_idx++, big_num_dsts));
                OCL_CHECK(err, err = kernel.setArg(arg_idx++, memory_offset));

                printf("Enqueue Big GS Kernel: SP Group %zu Partition %zu, "
                       "big pipe %u, num_vertices %u, num_edges %u, num_dsts "
                       "%u, memory_offset %u\n",
                       group_idx, part_idx, global_pip, big_num_vertices,
                       pip_num_edges, big_num_dsts, memory_offset);
                fflush(stdout);

                OCL_CHECK(
                    err,
                    err = acc.big_gs_queue[global_pip].enqueueTask(
                        kernel, nullptr,
                        &acc.big_kernel_events[sparse_flat_idx][global_pip]));
            }
        }
    }

    // 3.2: Enqueue LITTLE gs kernels (one per pipeline, each with different
    // edges, same nodes)
    size_t dense_flat_idx = 0;
    for (size_t group_idx = 0; group_idx < container.num_dense_groups;
         ++group_idx) {
        const auto &group = container.dense_groups[group_idx];
        for (size_t part_idx = 0; part_idx < group.partitions.size();
             ++part_idx, ++dense_flat_idx) {
            const auto &partition = group.partitions[part_idx];
            for (unsigned int local_pip = 0; local_pip < group.num_pipelines;
                 ++local_pip) {
                unsigned int global_pip = group.pipeline_offset + local_pip;
                auto &kernel = acc.little_gs_krnls[global_pip];
                auto &buffer = dense_buffers[dense_flat_idx]
                                   .pipelines[local_pip]
                                   .edge_props_buffer;
                uint32_t original_num_edges =
                    partition.pipeline_edges[local_pip].num_edges;
                uint32_t pip_num_edges =
                    (original_num_edges == 0) ? 8 : original_num_edges;
                uint32_t little_num_vertices = partition.num_vertices;
                uint32_t little_num_dsts = partition.num_dsts;
                // Pad num_dsts up to a multiple of 8 so little mergers always flush full packets
                uint32_t padded_little_num_dsts =
                    (little_num_dsts + 7u) / 8u * 8u;
                uint32_t memory_offset =
                    dense_buffers[dense_flat_idx].src_buf_offset;

                int arg_idx = 0;
                OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffer));
                OCL_CHECK(err,
                          err = kernel.setArg(arg_idx++, little_num_vertices));
                OCL_CHECK(err, err = kernel.setArg(arg_idx++, pip_num_edges));
                OCL_CHECK(err,
                          err = kernel.setArg(arg_idx++, padded_little_num_dsts));
                OCL_CHECK(err, err = kernel.setArg(arg_idx++, memory_offset));

                printf(
                    "Enqueue Little GS Kernel: DP Group %zu Partition %zu, "
                    "little pipe %u, num_vertices %u, num_edges %u, num_dsts "
                    "%u (padded to %u), memory_offset %u\n",
                    group_idx, part_idx, global_pip, little_num_vertices,
                    pip_num_edges, little_num_dsts, padded_little_num_dsts, memory_offset);
                fflush(stdout);

                OCL_CHECK(err,
                          err = acc.little_gs_queue[global_pip].enqueueTask(
                              kernel, nullptr,
                              &acc.little_kernel_events[dense_flat_idx]
                                    [global_pip]));
            }
        }
    }

    // 3.3: Enqueue apply_kernel (receives merged streams from little_merger and
    // big_merger)
    {
        auto &apply_kernel = acc.apply_krnl;

        int arg_idx = 0;
        OCL_CHECK(err, err = apply_kernel.setArg(
                           arg_idx++, apply_kernel_node_prop_buffer));
        OCL_CHECK(err,
                  err = apply_kernel.setArg(
                      arg_idx++, static_cast<uint32_t>(little_merger_lengths.size())));
        OCL_CHECK(err,
                  err = apply_kernel.setArg(
                      arg_idx++, static_cast<uint32_t>(big_merger_lengths.size())));
        {
            uint32_t idx = 0;
            for (uint32_t len : little_merger_lengths) {
                printf("apply little_merger_lengths[%u] = %u\n", idx, len);
                OCL_CHECK(err, err = apply_kernel.setArg(arg_idx++, len));
                idx++;
            }
            fflush(stdout);
        }
        {
            uint32_t idx = 0;
            for (uint32_t len : big_merger_lengths) {
                printf("apply big_merger_lengths[%u] = %u\n", idx, len);
                OCL_CHECK(err, err = apply_kernel.setArg(arg_idx++, len));
                idx++;
            }
            fflush(stdout);
        }
        {
            uint32_t idx = 0;
            for (uint32_t offset : little_merger_offsets) {
                printf("apply little_merger_offsets[%u] = %u\n", idx, offset);
                OCL_CHECK(err, err = apply_kernel.setArg(arg_idx++, offset));
                idx++;
            }
            fflush(stdout);
        }
        {
            uint32_t idx = 0;
            for (uint32_t offset : big_merger_offsets) {
                printf("apply big_merger_offsets[%u] = %u\n", idx, offset);
                OCL_CHECK(err, err = apply_kernel.setArg(arg_idx++, offset));
                idx++;
            }
            fflush(stdout);
        }

        printf(
            "Enqueue Apply Kernel: little_dst_words %u, big_dst_words %u, "
            "little_groups %u, big_groups %u\n",
            little_dst_word_num, big_dst_word_num,
            static_cast<uint32_t>(little_merger_lengths.size()),
            static_cast<uint32_t>(big_merger_lengths.size()));
        fflush(stdout);

        OCL_CHECK(err, err = acc.apply_queue.enqueueTask(
                           apply_kernel, nullptr, &acc.apply_kernel_event));
    }

    // Enqueue hbm_writer kernel
    {
        auto &writer_kernel = acc.hbm_writer_krnl;
        uint32_t num_little_partitions = container.num_dense_partitions;
        ;
        uint32_t num_big_partitions = container.num_sparse_partitions;

        int arg_idx = 0;
        // writer_kernel_node_prop_buffers
        for (const auto &buffer : writer_kernel_node_prop_buffers) {
            OCL_CHECK(err, err = writer_kernel.setArg(arg_idx++, buffer));
        }
        OCL_CHECK(err, err = writer_kernel.setArg(arg_idx++,
                                                  writer_kernel_output_buffer));
        OCL_CHECK(err,
                  err = writer_kernel.setArg(arg_idx++, num_little_partitions));
        OCL_CHECK(err,
                  err = writer_kernel.setArg(arg_idx++, num_big_partitions));

        printf(
            "Enqueue HBM Writer Kernel: node_prop_buffers %zu, "
            "num_little_partitions %u, num_big_partitions %u\n",
            writer_kernel_node_prop_buffers.size(), num_little_partitions,
            num_big_partitions);
        fflush(stdout);

        OCL_CHECK(err, err = acc.hbm_writer_queue.enqueueTask(
                           writer_kernel, nullptr, &acc.hbm_writer_event));
    }

    auto enqueue_end = std::chrono::high_resolution_clock::now();
    std::chrono::duration<double> enqueue_time = enqueue_end - enqueue_start;
    std::cout << "[SUCCESS] All kernel tasks enqueued for one iteration (Time: "
              << enqueue_time.count() << " seconds)" << std::endl;
    std::cout << "[DEBUG] Exiting execute_kernel_iteration" << std::endl;
    std::cout << std::flush;
}

// --- PHASE 4: DATA TRANSFER FROM FPGA ---
void AlgorithmHost::transfer_data_from_fpga() {
    std::cout << "[DEBUG] Entering transfer_data_from_fpga" << std::endl;
    std::cout << std::flush;
    cl_int err;
    std::cout << "--- [Host] Phase 4: Transferring results from FPGA ---"
              << std::endl;

    auto transfer_start = std::chrono::high_resolution_clock::now();

    // Read from the single unified output buffer
    OCL_CHECK(err, err = acc.hbm_writer_queue.enqueueReadBuffer(
                       writer_kernel_output_buffer, CL_FALSE, 0,
                       writer_kernel_host_outputs.size() * sizeof(bus_word_t),
                       writer_kernel_host_outputs.data()));

    // Wait for all transfers to complete
    acc.hbm_writer_queue.finish();

    auto transfer_end = std::chrono::high_resolution_clock::now();
    std::chrono::duration<double> transfer_time = transfer_end - transfer_start;
    std::cout << "[SUCCESS] All results transferred from HBM (Time: "
              << transfer_time.count() << " seconds)" << std::endl;
    std::cout << "[DEBUG] Exiting transfer_data_from_fpga" << std::endl;
    std::cout << std::flush;
}

// --- PHASE 5: CONVERGENCE CHECK AND GLOBAL STATE UPDATE ---
// REWRITTEN: Implements unpacking logic to parse results from 512-bit words.
bool AlgorithmHost::check_convergence_and_update(
    const PartitionContainer &container) {
    std::cout << "[DEBUG] Entering check_convergence_and_update" << std::endl;
    std::cout << std::flush;
    bool changed = false;
    std::cout << "--- [Host] Phase 5: Unpacking results and checking for "
                 "convergence ---"
              << std::endl;

    std::map<int, distance_t> min_distances;
    const int dists_per_word = AXI_BUS_WIDTH / DISTANCE_BITWIDTH;

    // Output layout: [little_dsts][big_dsts]
    // First little_dst_num entries are little partition destinations
    // Next big_dst_num entries are big partition destinations

    int word_idx = 0;
    int dist_in_word = 0;
    
    std::cout << "\n========== PHASE 5: CONVERGENCE CHECK INIT ==========" << std::endl;
    std::cout << "  dists_per_word: " << dists_per_word << std::endl;
    std::cout << "  writer_kernel_host_outputs.size(): " << writer_kernel_host_outputs.size() << std::endl;
    std::cout << "  All words of writer_kernel_host_outputs:" << std::endl;
    for (size_t w = 0; w < writer_kernel_host_outputs.size(); ++w) {
        print_bus_word(writer_kernel_host_outputs[w], "node_prop", w);
    }
    std::cout << "========== END PHASE 5 INIT ==========\n" << std::endl;

    // Process little partition destinations [0:little_dst_num]
    for (size_t group_idx = 0; group_idx < container.num_dense_groups;
         ++group_idx) {
        const auto &group = container.dense_groups[group_idx];
        for (size_t part_idx = 0; part_idx < group.partitions.size();
             ++part_idx) {
            const auto &little_partition = group.partitions[part_idx];
            for (int local_id = 0; local_id < little_partition.num_dsts;
                 ++local_id) {
                int bit_offset = dist_in_word * DISTANCE_BITWIDTH;
                ap_fixed_pod_t dist_pod =
                    writer_kernel_host_outputs[word_idx].range(
                        bit_offset + DISTANCE_BITWIDTH - 1, bit_offset);

                if (little_partition.vtx_map_rev.count(local_id)) {
                    int global_id = little_partition.vtx_map_rev.at(local_id);
                    if (global_id < m_num_vertices) {
                        distance_t new_dist =
                            *reinterpret_cast<distance_t *>(&dist_pod);

                        if (min_distances.find(global_id) ==
                                min_distances.end() ||
                            new_dist < min_distances[global_id]) {
                            min_distances[global_id] = new_dist;
                        }
                    }
                }

                dist_in_word++;
                if (dist_in_word >= dists_per_word) {
                    dist_in_word = 0;
                    word_idx++;
                }
            }

            // print other node's local & global id
            for (int local_id = little_partition.num_dsts;
                 local_id < little_partition.num_vertices; ++local_id) {
                if (little_partition.vtx_map_rev.count(local_id)) {
                    int global_id = little_partition.vtx_map_rev.at(local_id);
                    (void)global_id;
                }
            }
        }
    }

    if (dist_in_word != 0) {
        dist_in_word = 0;
        word_idx++;
    }

    // Process big partition destinations
    // [little_dst_num:little_dst_num+big_dst_num]
    for (size_t group_idx = 0; group_idx < container.num_sparse_groups;
         ++group_idx) {
        const auto &group = container.sparse_groups[group_idx];
        for (size_t part_idx = 0; part_idx < group.partitions.size();
             ++part_idx) {
            const auto &big_partition = group.partitions[part_idx];
            for (int local_id = 0; local_id < big_partition.num_dsts;
                 ++local_id) {
                int bit_offset = dist_in_word * DISTANCE_BITWIDTH;
                ap_fixed_pod_t dist_pod =
                    writer_kernel_host_outputs[word_idx].range(
                        bit_offset + DISTANCE_BITWIDTH - 1, bit_offset);

                if (big_partition.vtx_map_rev.count(local_id)) {
                    int global_id = big_partition.vtx_map_rev.at(local_id);
                    if (global_id < m_num_vertices) {
                        distance_t new_dist =
                            *reinterpret_cast<distance_t *>(&dist_pod);

                        if (min_distances.find(global_id) ==
                                min_distances.end() ||
                            new_dist < min_distances[global_id]) {
                            min_distances[global_id] = new_dist;
                        }
                    }
                }

                dist_in_word++;
                if (dist_in_word >= dists_per_word) {
                    dist_in_word = 0;
                    word_idx++;
                }
            }
            // Optional: iterate non-destination nodes if needed
            for (int local_id = big_partition.num_dsts;
                 local_id < big_partition.num_vertices; ++local_id) {
                if (big_partition.vtx_map_rev.count(local_id)) {
                    int global_id = big_partition.vtx_map_rev.at(local_id);
                    (void)global_id;
                }
            }
        }
    }

    // Update global distance vector and check for changes
    std::cout << "\n========== PHASE 5.1: MIN DISTANCES COLLECTED ==========" << std::endl;
    std::cout << "  min_distances.size(): " << min_distances.size() << std::endl;
    std::cout << "  All min_distances:" << std::endl;
    for (auto const &[global_id, new_dist] : min_distances) {
        std::cout << "    global_id=" << global_id << ", new_dist=" << new_dist.to_float() 
                  << ", old_dist=" << (global_id < m_num_vertices ? h_distances[global_id].to_float() : -1.0f) << std::endl;
    }
    std::cout << "========== END PHASE 5.1 ==========\n" << std::endl;
    
    for (auto const &[global_id, new_dist] : min_distances) {
        if (global_id < m_num_vertices && new_dist < h_distances[global_id]) {
            std::cout << "  [UPDATE] global_id=" << global_id << ": " << h_distances[global_id].to_float() 
                      << " -> " << new_dist.to_float() << std::endl;
            h_distances[global_id] = new_dist;
            changed = true;
        }
    }

    std::cout << "\n========== PHASE 5.2: ALL UPDATED H_DISTANCES ==========" << std::endl;
    std::cout << "  All h_distances after update:" << std::endl;
    for (size_t i = 0; i < h_distances.size(); ++i) {
        std::cout << "    h_distances[" << i << "] = " << h_distances[i].to_float() << std::endl;
    }
    std::cout << "========== END PHASE 5.2 ==========\n" << std::endl;

    if (changed) {
        std::cout << "[INFO] Distances updated. Preparing for next iteration."
                  << std::endl;
    } else {
        std::cout << "[INFO] No distance updates. Algorithm has converged."
                  << std::endl;
    }

    std::cout << "[DEBUG] Exiting check_convergence_and_update (changed="
              << std::boolalpha << changed << ")" << std::endl;
    std::cout << std::noboolalpha << std::flush;
    return !changed;
}

// --- FINALIZATION ---
const std::vector<int> &AlgorithmHost::get_results() const {
    static std::vector<int> final_distances;
    final_distances.clear();
    final_distances.reserve(h_distances.size());

    for (const auto &dist : h_distances) {
        if (dist >= INFINITY_DIST) {
            final_distances.push_back(INFINITY_DIST);
        } else {
            final_distances.push_back(dist.to_int());
        }
    }
    return final_distances;
}
