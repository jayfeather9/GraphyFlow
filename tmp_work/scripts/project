 3737 |  3494 | 3404 |  899 | inline distance_t get_val(reduce_word_t word, int idx) {
 3738 |  3495 | 3405 |  900 | #pragma HLS INLINE
 3739 |  3496 | 3406 |  901 |     ap_uint<DISTANCE_BITWIDTH> bits;
 3740 |  3497 | 3407 |  902 |     switch (idx) {
 3741 |  3498 | 3408 |  903 |     case 0:
 3742 |  3499 | 3409 |  904 |         bits = word.range(DISTANCE_BITWIDTH - 1, 0);
 3743 |  3500 | 3410 |  905 |         break;
 3744 |  3501 | 3411 |  906 |     case 1:
 3745 |  3502 | 3412 |  907 |         bits = word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH);
 3746 |  3503 | 3413 |  908 |         break;
 3747 |  3504 | 3414 |  909 |     case 2:
 3748 |  3505 | 3415 |  910 |         bits =
 3749 |  3506 | 3416 |  911 |             word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1));
 3750 |  3507 | 3417 |  912 |         break;
 3751 |  3508 | 3418 |  913 |     default:
 3752 |  3509 | 3419 |  914 |         bits = 0;
 3753 |  3510 | 3420 |  915 |         break;
 3754 |  3511 | 3421 |  916 |     }
 3755 |  3512 | 3422 |  917 |     // Convert bits back to distance_t (floating point)
 3756 |  3513 | 3423 |  918 |     return *reinterpret_cast<distance_t *>(&bits);
 3757 |  3514 | 3424 |  919 | }
 3758 |  3515 | 3425 |  920 | 
 3759 |  3516 | 3426 |  921 | inline void set_val(reduce_word_t &word, int idx, distance_t val) {
 3760 |  3517 | 3427 |  922 | #pragma HLS INLINE
 3761 |  3518 | 3428 |  923 |     ap_uint<DISTANCE_BITWIDTH> val_bits =
 3762 |  3519 | 3429 |  924 |         *reinterpret_cast<ap_uint<DISTANCE_BITWIDTH> *>(&val);
 3763 |  3520 | 3430 |  925 |     switch (idx) {
 3764 |  3521 | 3431 |  926 |     case 0:
 3765 |  3522 | 3432 |  927 |         word.range(DISTANCE_BITWIDTH - 1, 0) = val_bits;
 3766 |  3523 | 3433 |  928 |         break;
 3767 |  3524 | 3434 |  929 |     case 1:
 3768 |  3525 | 3435 |  930 |         word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH) = val_bits;
 3769 |  3526 | 3436 |  931 |         break;
 3770 |  3527 | 3437 |  932 |     case 2:
 3771 |  3528 | 3438 |  933 |         word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1)) =
 3772 |  3529 | 3439 |  934 |             val_bits;
 3773 |  3530 | 3440 |  935 |         break;
 3774 |  3531 | 3441 |  936 |     default:
 3775 |  3532 | 3442 |  937 |         break;
 3776 |  3533 | 3443 |  938 |     }
