 9015 |  8772 | 492 |         auto &buffers = hbm_manager_buffers[0];
 9016 |  8773 | 493 |         
 9017 |  8774 | 494 |         // This assumes the number of vertices for the manager is the total number
 9018 |  8775 | 495 |         // or a relevant subset for all little kernels. Using m_num_vertices for now.
 9019 |  8776 | 496 |         int num_nodes_for_manager = m_num_vertices;
 9020 |  8777 | 497 | 
 9021 |  8778 | 498 |         int arg_idx = 0;
 9022 |  8779 | 499 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.node_props_buf));
 9023 |  8780 | 500 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, num_nodes_for_manager));
 9024 |  8781 | 501 | 
 9025 |  8782 | 502 |         // Use the first little kernel's event to chain the manager
 9026 |  8783 | 503 |         cl::Event *event_ptr = &little_kernel_events[0];
 9027 |  8784 | 504 |         OCL_CHECK(err, err = acc.hbm_manager_queue.enqueueTask(kernel, nullptr, event_ptr));
 9028 |  8785 | 505 |     }
 9029 |  8786 | 506 | 
 9030 |  8787 | 507 | 
 9031 |  8788 | 508 |     // ENABLED AND CORRECTED FOR LITTLE KERNEL TESTING
 9032 |  8789 | 509 |     for (size_t i = 0; i < little_kernel_buffers.size(); ++i) {
 9033 |  8790 | 510 |         auto &kernel = acc.little_gs_krnls[i];
 9034 |  8791 | 511 |         auto &buffers = little_kernel_buffers[i];
 9035 |  8792 | 512 |         const auto &p_graph = container.DPs[i].partitioned_graph;
 9036 |  8793 | 513 | 
 9037 |  8794 | 514 |         int arg_idx = 0;
 9038 |  8795 | 515 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.src_ids_buf));
 9039 |  8796 | 516 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.edge_props_buf));
 9040 |  8797 | 517 |         // 关键修正: little kernel不再直接接收node_props_buf
 9041 |  8798 | 518 |         // OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.node_props_buf));
 9042 |  8799 | 519 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.output_buf));
 9043 |  8800 | 520 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, p_graph.num_vertices));
 9044 |  8801 | 521 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, p_graph.num_edges));
 9045 |  8802 | 522 |         // Assuming dst_num is required, using num_vertices as a placeholder.
 9046 |  8803 | 523 |         // You might need to calculate the actual number of destination vertices.
 9047 |  8804 | 524 |         size_t max_dst_local_id = 0;
 9048 |  8805 | 525 |         for (size_t e = 0; e < p_graph.num_edges; ++e) {
 9049 |  8806 | 526 |             if (p_graph.columns[e] > max_dst_local_id) max_dst_local_id = p_graph.columns[e];
 9050 |  8807 | 527 |         }
 9051 |  8808 | 528 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, (int)(max_dst_local_id + 1)));
 9052 |  8809 | 529 | 
 9053 |  8810 | 530 | 
 9054 |  8811 | 531 |         cl::Event *event_ptr = &little_kernel_events[i];
 9055 |  8812 | 532 |         OCL_CHECK(err, err = acc.little_gs_queue[i].enqueueTask(kernel, nullptr, event_ptr));
 9056 |  8813 | 533 |     }
 9057 |  8814 | 534 |     std::cout << "[SUCCESS] All kernel tasks enqueued for one iteration." << std::endl;
 9058 |  8815 | 535 | }
