  903 |   660 |  570 |   9 | 
  904 |   661 |  571 |  10 | std::vector<int> run_fpga_kernel(const std::string &xclbin_path,
  905 |   662 |  572 |  11 |                                  const GraphCSR &graph, int start_node,
  906 |   663 |  573 |  12 |                                  double &total_kernel_time_sec,
  907 |   664 |  574 |  13 |                                  int &iter_count) {
  908 |   665 |  575 |  14 | 
  909 |   666 |  576 |  15 |     // GraphPartiton
  910 |   667 |  577 |  16 |     PartitionContainer partition_container = partitionGraph(&graph);
  911 |   668 |  578 |  17 | 
  912 |   669 |  579 |  18 |     // init accelerator
  913 |   670 |  580 |  19 |     AccDescriptor acc = initAccelerator(xclbin_path);
  914 |   671 |  581 |  20 | 
  915 |   672 |  582 |  21 |     AlgorithmHost algo_host(acc);
  916 |   673 |  583 |  22 |     algo_host.prepare_data(partition_container, start_node);
  917 |   674 |  584 |  23 |     algo_host.setup_buffers(partition_container);
  918 |   675 |  585 |  24 |     total_kernel_time_sec = 0;
  919 |   676 |  586 |  25 |     double current_kernel_time_sec = 0;
  920 |   677 |  587 |  26 |     int max_iterations = graph.num_vertices;
  921 |   678 |  588 |  27 |     int iter = 0;
  922 |   679 |  589 |  28 |     std::cout << "\nStarting FPGA execution..." << std::endl;
  923 |   680 |  590 |  29 | 
  924 |   681 |  591 |  30 |     for (iter = 0; iter < max_iterations; ++iter) {
  925 |   682 |  592 |  31 |         algo_host.update_data(partition_container);
  926 |   683 |  593 |  32 |         algo_host.transfer_data_to_fpga(partition_container);
  927 |   684 |  594 |  33 |         std::vector<cl::Event> big_kernel_events(acc.num_big_krnl),
  928 |   685 |  595 |  34 |             little_kernel_events(acc.num_little_krnl);
  929 |   686 |  596 |  35 |         algo_host.execute_kernel_iteration(
  930 |   687 |  597 |  36 |             partition_container, big_kernel_events, little_kernel_events);
  931 |   688 |  598 |  37 |         for (auto &q : acc.big_gs_queue)
  932 |   689 |  599 |  38 |             q.finish();
  933 |   690 |  600 |  39 |         acc.hbm_manager_queue.finish();
  934 |   691 |  601 |  40 |         for (auto &q : acc.little_gs_queue)
  935 |   692 |  602 |  41 |             q.finish();
  936 |   693 |  603 |  42 |         algo_host.transfer_data_from_fpga();
  937 |   694 |  604 |  43 | 
  938 |   695 |  605 |  44 |         // iv. 性能统计
  939 |   696 |  606 |  45 |         for (auto &event : big_kernel_events)
  940 |   697 |  607 |  46 |             event.wait();
  941 |   698 |  608 |  47 |         for (auto &event : little_kernel_events)
  942 |   699 |  609 |  48 |             event.wait();
  943 |   700 |  610 |  49 | 
  944 |   701 |  611 |  50 |         int cnt = 0;
  945 |   702 |  612 |  51 |         for (auto &event : big_kernel_events) {
  946 |   703 |  613 |  52 |             unsigned long start = 0, end = 0;
  947 |   704 |  614 |  53 |             event.getProfilingInfo(CL_PROFILING_COMMAND_START, &start);
  948 |   705 |  615 |  54 |             event.getProfilingInfo(CL_PROFILING_COMMAND_END, &end);
  949 |   706 |  616 |  55 |             double iteration_time_ns = end - start;
  950 |   707 |  617 |  56 |             current_kernel_time_sec =
  951 |   708 |  618 |  57 |                 std::max(current_kernel_time_sec, iteration_time_ns * 1.0e-9);
  952 |   709 |  619 |  58 |             double mteps = (double)partition_container.SPs[cnt].num_edges /
  953 |   710 |  620 |  59 |                            (iteration_time_ns * 1.0e-9) / 1.0e6;
  954 |   711 |  621 |  60 | 
  955 |   712 |  622 |  61 |             std::cout << "FPGA Iteration " << iter << ": "
  956 |   713 |  623 |  62 |                       << "Big Kernel " << cnt++ << ", "
  957 |   714 |  624 |  63 |                       << "Time = " << (iteration_time_ns * 1.0e-6) << " ms, "
  958 |   715 |  625 |  64 |                       << "Throughput = " << mteps << " MTEPS" << std::endl;
  959 |   716 |  626 |  65 |         }
  960 |   717 |  627 |  66 |         cnt = 0;
  961 |   718 |  628 |  67 |         for (auto &event : little_kernel_events) {
  962 |   719 |  629 |  68 |             unsigned long start = 0, end = 0;
  963 |   720 |  630 |  69 |             event.getProfilingInfo(CL_PROFILING_COMMAND_START, &start);
  964 |   721 |  631 |  70 |             event.getProfilingInfo(CL_PROFILING_COMMAND_END, &end);
  965 |   722 |  632 |  71 |             double iteration_time_ns = end - start;
  966 |   723 |  633 |  72 |             current_kernel_time_sec =
  967 |   724 |  634 |  73 |                 std::max(current_kernel_time_sec, iteration_time_ns * 1.0e-9);
  968 |   725 |  635 |  74 |             double mteps = (double)partition_container.DPs[cnt].num_edges /
  969 |   726 |  636 |  75 |                            (iteration_time_ns * 1.0e-9) / 1.0e6;
  970 |   727 |  637 |  76 | 
  971 |   728 |  638 |  77 |             std::cout << "FPGA Iteration " << iter << ": "
  972 |   729 |  639 |  78 |                       << "Little Kernel " << cnt++ << ", "
  973 |   730 |  640 |  79 |                       << "Time = " << (iteration_time_ns * 1.0e-6) << " ms, "
  974 |   731 |  641 |  80 |                       << "Throughput = " << mteps << " MTEPS" << std::endl;
  975 |   732 |  642 |  81 |         }
  976 |   733 |  643 |  82 | 
  977 |   734 |  644 |  83 |         double iteration_time_ns = current_kernel_time_sec * 1.0e9;
  978 |   735 |  645 |  84 |         total_kernel_time_sec += current_kernel_time_sec;
  979 |   736 |  646 |  85 |         current_kernel_time_sec = 0;
  980 |   737 |  647 |  86 |         double mteps =
  981 |   738 |  648 |  87 |             (double)graph.num_edges / (iteration_time_ns * 1.0e-9) / 1.0e6;
  982 |   739 |  649 |  88 | 
  983 |   740 |  650 |  89 |         std::cout << "FPGA Iteration " << iter << ": "
  984 |   741 |  651 |  90 |                   << "Time = " << (iteration_time_ns * 1.0e-6) << " ms, "
  985 |   742 |  652 |  91 |                   << "Throughput = " << mteps << " MTEPS" << std::endl;
  986 |   743 |  653 |  92 | 
  987 |   744 |  654 |  93 |         // v. 检查是否收敛。如果未收敛，此函数会更新 partition_container
  988 |   745 |  655 |  94 |         // 为下次迭代做准备
  989 |   746 |  656 |  95 |         if (algo_host.check_convergence_and_update(partition_container)) {
  990 |   747 |  657 |  96 |             std::cout << "FPGA computation converged after " << iter + 1
  991 |   748 |  658 |  97 |                       << " iteration(s)." << std::endl;
  992 |   749 |  659 |  98 |             break;
  993 |   750 |  660 |  99 |         }
  994 |   751 |  661 | 100 |     }
  995 |   752 |  662 | 101 | 
  996 |   753 |  663 | 102 |     iter_count = iter + 1;
  997 |   754 |  664 | 103 | 
  998 |   755 |  665 | 104 |     const std::vector<int> &final_results_ref = algo_host.get_results();
  999 |   756 |  666 | 105 |     std::vector<int> final_results = final_results_ref;
 1000 |   757 |  667 | 106 | 
 1001 |   758 |  668 | 107 |     return final_results;
 1002 |   759 |  669 | 108 | }
