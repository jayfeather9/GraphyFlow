18187 |  562 | static void
18188 |  563 | Reduc_105_unit_reduce(hls::stream<struct_kbu_50_t> &in_kt_pair_stream,
18189 |  564 |                       hls::stream<internal_end_data_batch_t> &o_0,
18190 |  565 |                       int32_t dst_num) { // <-- 函数签名已修改
18191 |  566 |     // --- Phase 1: Memory Declaration ---
18192 |  567 |     // (此部分保持不变)
18193 |  568 |     const int MEM_SIZE =
18194 |  569 |         (MAX_NUM + DISTANCES_PER_REDUCE_WORD - 1) / DISTANCES_PER_REDUCE_WORD;
18195 |  570 |     reduce_word_t prop_mem[PE_NUM][MEM_SIZE];
18196 |  571 | #pragma HLS BIND_STORAGE variable = prop_mem type = RAM_2P impl = URAM
18197 |  572 | #pragma HLS ARRAY_PARTITION variable = prop_mem complete dim = 1
18198 |  573 | #pragma HLS dependence variable = prop_mem inter false direction = WAW
18199 |  574 | #pragma HLS dependence variable = prop_mem inter false direction = RAW
18200 |  575 | 
18201 |  576 |     bool prop_valid[PE_NUM][MAX_NUM];
18202 |  577 | #pragma HLS BIND_STORAGE variable = prop_valid type = RAM_2P impl = BRAM
18203 |  578 | #pragma HLS ARRAY_PARTITION variable = prop_valid complete dim = 1
18204 |  579 | #pragma HLS dependence variable = prop_valid inter false direction = WAW
18205 |  580 | #pragma HLS dependence variable = prop_valid inter false direction = RAW
18206 |  581 | 
18207 |  582 |     typedef ap_uint<16> addr_map_t;
18208 |  583 |     addr_map_t key_to_addr_map[MAX_NUM];
18209 |  584 | #pragma HLS BIND_STORAGE variable = key_to_addr_map type = RAM_1P impl = BRAM
18210 |  585 | 
18211 |  586 |     reduce_word_t cache_data_buffer[PE_NUM][L + 1];
18212 |  587 | #pragma HLS ARRAY_PARTITION variable = cache_data_buffer complete dim = 0
18213 |  588 |     reduce_word_t tmp_cache_data_buffer[PE_NUM][L];
18214 |  589 | #pragma HLS ARRAY_PARTITION variable = tmp_cache_data_buffer complete dim = 0
18215 |  590 |     int cache_addr_buffer[PE_NUM][L + 1];
18216 |  591 | #pragma HLS ARRAY_PARTITION variable = cache_addr_buffer complete dim = 0
18217 |  592 |     int tmp_cache_addr_buffer[PE_NUM][L];
18218 |  593 | #pragma HLS ARRAY_PARTITION variable = tmp_cache_addr_buffer complete dim = 0
18219 |  594 | 
18220 |  595 | 
18221 |  596 |     // --- Phase 2: Initialization ---
18222 |  597 |     // (此部分保持不变)
18223 |  598 | LOOP_INIT_LITTLE:
18224 |  599 |     for (int i = 0; i < MAX_NUM; i++) {
18225 |  600 | #pragma HLS PIPELINE II = 1
18226 |  601 |         addr_map_t map_val;
18227 |  602 |         map_val.range(15, 2) = i / DISTANCES_PER_REDUCE_WORD; // word_addr
18228 |  603 |         map_val.range(1, 0) = i % DISTANCES_PER_REDUCE_WORD;  // pack_idx
18229 |  604 |         key_to_addr_map[i] = map_val;
18230 |  605 |         for (int pe = 0; pe < PE_NUM; pe++) {
18231 |  606 | #pragma HLS UNROLL
18232 |  607 |             prop_valid[pe][i] = false;
18233 |  608 |         }
18234 |  609 |     }
18235 |  610 | LOOP_INIT_LITTLE_CACHE:
18236 |  611 |     for (int i = 0; i < L + 1; i++) {
18237 |  612 |         for (int pe = 0; pe < PE_NUM; pe++) {
18238 |  613 | #pragma HLS UNROLL
18239 |  614 |             cache_addr_buffer[pe][i] = -1; // Invalidate cache
18240 |  615 |         }
18241 |  616 |     }
18242 |  617 | 
18243 |  618 |     // --- Phase 3: Aggregation Loop ---
18244 |  619 |     // (此部分保持不变)
18245 |  620 | LOOP_AGGREGATE_LITTLE:
18246 |  621 |     while (true) {
18247 |  622 | #pragma HLS PIPELINE II = 1
18248 |  623 |         struct_kbu_50_t in_batch;
18249 |  624 |         if (in_kt_pair_stream.read_nb(in_batch)) {
18250 |  625 |             for (int pe = 0; pe < PE_NUM; pe++) {
18251 |  626 | #pragma HLS UNROLL
18252 |  627 |                 if (pe < in_batch.end_pos) {
18253 |  628 |                     int key = in_batch.data[pe].key;
18254 |  629 |                     ap_fixed_pod_t incoming_dist_pod =
18255 |  630 |                         in_batch.data[pe].transform.prop;
18256 |  631 |                     
18257 |  632 |                     // Note: In the original code, key_to_addr_map was PE-specific.
18258 |  633 |                     // It's more efficient to have a single shared map if the mapping is the same.
18259 |  634 |                     // Using a non-PE-specific map here for optimization.
18260 |  635 |                     addr_map_t map_val = key_to_addr_map[key];
18261 |  636 |                     int word_addr = map_val.range(15, 2);
18262 |  637 |                     int pack_idx = map_val.range(1, 0);
18263 |  638 | 
18264 |  639 |                     reduce_word_t current_word = prop_mem[pe][word_addr];
18265 |  640 | 
18266 |  641 |                     for (int i = L; i >= 0; --i) {
18267 |  642 | #pragma HLS UNROLL
18268 |  643 |                         if (cache_addr_buffer[pe][i] == word_addr) {
18269 |  644 |                             current_word = cache_data_buffer[pe][i];
18270 |  645 |                             break;
18271 |  646 |                         }
18272 |  647 |                     }
18273 |  648 | 
18274 |  649 |                     bool is_valid = prop_valid[pe][key];
18275 |  650 | 
18276 |  651 |                     for (int i = 0; i < L; i++) {
18277 |  652 | #pragma HLS UNROLL
18278 |  653 |                         tmp_cache_addr_buffer[pe][i] = cache_addr_buffer[pe][i + 1];
18279 |  654 |                         tmp_cache_data_buffer[pe][i] = cache_data_buffer[pe][i + 1];
18280 |  655 |                     }
18281 |  656 | 
18282 |  657 |                     for (int i = 0; i < L; i++) {
18283 |  658 | #pragma HLS UNROLL
18284 |  659 |                         cache_addr_buffer[pe][i] = tmp_cache_addr_buffer[pe][i];
18285 |  660 |                         cache_data_buffer[pe][i] = tmp_cache_data_buffer[pe][i];
18286 |  661 |                     }
18287 |  662 | 
18288 |  663 |                     distance_t new_dist_fp;
18289 |  664 |                     distance_t incoming_dist_fp = *reinterpret_cast<distance_t *>(&incoming_dist_pod);
18290 |  665 | 
18291 |  666 |                     if (is_valid) {
18292 |  667 |                         distance_t old_dist_fp = get_val(current_word, pack_idx);
18293 |  668 |                         new_dist_fp = (old_dist_fp < incoming_dist_fp) ? old_dist_fp : incoming_dist_fp;
18294 |  669 |                     } else {
18295 |  670 |                         new_dist_fp = incoming_dist_fp;
18296 |  671 |                     }
18297 |  672 | 
18298 |  673 |                     prop_valid[pe][key] = true;
18299 |  674 |                     set_val(current_word, pack_idx, new_dist_fp);
18300 |  675 |                     prop_mem[pe][word_addr] = current_word;
18301 |  676 |                     cache_addr_buffer[pe][L] = word_addr;
18302 |  677 |                     cache_data_buffer[pe][L] = current_word;
18303 |  678 |                 }
18304 |  679 |             }
18305 |  680 |             if (in_batch.end_flag) {
18306 |  681 |                 break;
18307 |  682 |             }
18308 |  683 |         }
18309 |  684 |     }
18310 |  685 | 
18311 |  686 |     // --- Phase 4: OPTIMIZED Final Merge and Drain Loop ---
18312 |  687 |     internal_end_data_batch_t data_pack;
18313 |  688 | #pragma HLS ARRAY_PARTITION variable = data_pack.data complete dim = 0
18314 |  689 |     data_pack.end_flag = false;
18315 |  690 |     data_pack.end_pos = 0;
18316 |  691 | 
18317 |  692 | LOOP_DRAIN_OPTIMIZED:
18318 |  693 |     // 遍历已知的有效 key (0 - dst_num-1)
18319 |  694 |     for (int key = 0; key < dst_num; key++) {
18320 |  695 | #pragma HLS PIPELINE II = 1
18321 |  696 |         
18322 |  697 |         addr_map_t map_val = key_to_addr_map[key];
18323 |  698 |         int word_addr = map_val.range(15, 2);
18324 |  699 |         int pack_idx = map_val.range(1, 0);
18325 |  700 | 
18326 |  701 |         distance_t min_dist = (distance_t)INFINITY_DIST;
18327 |  702 | 
18328 |  703 |     LOOP_MERGE_PES:
18329 |  704 |         for (int pe = 0; pe < PE_NUM; pe++) {
18330 |  705 | #pragma HLS UNROLL
18331 |  706 |             // 仍然需要检查 prop_valid: key有效意味着至少一个PE更新了它，但不代表所有PE都更新了它。
18332 |  707 |             // 此检查用于在跨PE合并时，过滤掉那些包含无效数据的PE。
18333 |  708 |             if (prop_valid[pe][key]) {
18334 |  709 |                 reduce_word_t word = prop_mem[pe][word_addr];
18335 |  710 |                 distance_t dist_fp = get_val(word, pack_idx);
18336 |  711 | 
18337 |  712 |                 if (dist_fp < min_dist) {
18338 |  713 |                     min_dist = dist_fp;
18339 |  714 |                 }
18340 |  715 |             }
18341 |  716 |         }
18342 |  717 | 
18343 |  718 |         // 无需 'valid_found' 标志，因为保证key有效，min_dist一定会被更新。
18344 |  719 |         data_pack.data[data_pack.end_pos].prop = *reinterpret_cast<ap_fixed_pod_t *>(&min_dist);
18345 |  720 |         data_pack.data[data_pack.end_pos].node_id = key;
18346 |  721 |         data_pack.end_pos++;
18347 |  722 | 
18348 |  723 |         if (data_pack.end_pos == PE_NUM) {
18349 |  724 |             data_pack.end_flag = false;
18350 |  725 |             o_0.write(data_pack);
18351 |  726 |             data_pack.end_pos = 0;
18352 |  727 |         }
18353 |  728 |     }
18354 |  729 | 
18355 |  730 |     // 发送最后一个（可能不满的）数据包
18356 |  731 |     if (data_pack.end_pos > 0) {
18357 |  732 |         data_pack.end_flag = false;
18358 |  733 |         o_0.write(data_pack);
18359 |  734 |     }
18360 |  735 |     
18361 |  736 |     // 发送结束标志
18362 |  737 |     data_pack.end_flag = true;
18363 |  738 |     data_pack.end_pos = 0;
18364 |  739 |     o_0.write(data_pack);
18365 |  740 | }
