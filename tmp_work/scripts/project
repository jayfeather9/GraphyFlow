 2692 |  2449 | 2359 | 161 |             std::vector<Edge> local_edges;
 2693 |  2450 | 2360 | 162 |             local_edges.reserve(p_graph.num_edges);
 2694 |  2451 | 2361 | 163 |             for (const auto &global_edge : partition_edges) {
