475 | void AlgorithmHost::execute_kernel_iteration(
476 |     const PartitionContainer &container,
477 |     std::vector<cl::Event> &big_kernel_events,
478 |     std::vector<cl::Event> &little_kernel_events) {
479 |     cl_int err;
480 |     std::cout << "--- [Host] Phase 3: Enqueuing kernel tasks ---" << std::endl;
481 | 
482 |     // DISABLED FOR LITTLE KERNEL TESTING
483 |     /*
484 |     for (size_t i = 0; i < big_kernel_buffers.size(); ++i) {
485 |         // ... (BIG KERNEL LOGIC IS COMMENTED OUT)
486 |     }
487 |     */
488 | 
489 |     // Enqueue HBM Manager (for little kernels)
490 |     if (!hbm_manager_buffers.empty()) {
491 |         auto &kernel = acc.hbm_manager_krnl;
492 |         auto &buffers = hbm_manager_buffers[0];
493 |         
494 |         // This assumes the number of vertices for the manager is the total number
495 |         // or a relevant subset for all little kernels. Using m_num_vertices for now.
496 |         int num_nodes_for_manager = m_num_vertices;
497 | 
498 |         int arg_idx = 0;
499 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.node_props_buf));
500 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, num_nodes_for_manager));
501 | 
502 |         // Use the first little kernel's event to chain the manager
503 |         cl::Event *event_ptr = &little_kernel_events[0];
504 |         OCL_CHECK(err, err = acc.hbm_manager_queue.enqueueTask(kernel, nullptr, event_ptr));
505 |     }
506 | 
507 | 
508 |     // ENABLED AND CORRECTED FOR LITTLE KERNEL TESTING
509 |     for (size_t i = 0; i < little_kernel_buffers.size(); ++i) {
510 |         auto &kernel = acc.little_gs_krnls[i];
511 |         auto &buffers = little_kernel_buffers[i];
512 |         const auto &p_graph = container.DPs[i].partitioned_graph;
513 | 
514 |         int arg_idx = 0;
515 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.src_ids_buf));
516 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.edge_props_buf));
517 |         // 关键修正: little kernel不再直接接收node_props_buf
518 |         // OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.node_props_buf));
519 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.output_buf));
520 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, p_graph.num_vertices));
521 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, p_graph.num_edges));
522 |         // Assuming dst_num is required, using num_vertices as a placeholder.
523 |         // You might need to calculate the actual number of destination vertices.
524 |         size_t max_dst_local_id = 0;
525 |         for (size_t e = 0; e < p_graph.num_edges; ++e) {
526 |             if (p_graph.columns[e] > max_dst_local_id) max_dst_local_id = p_graph.columns[e];
527 |         }
528 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, (int)(max_dst_local_id + 1)));
529 | 
530 | 
531 |         cl::Event *event_ptr = &little_kernel_events[i];
532 |         OCL_CHECK(err, err = acc.little_gs_queue[i].enqueueTask(kernel, nullptr, event_ptr));
533 |     }
534 |     std::cout << "[SUCCESS] All kernel tasks enqueued for one iteration." << std::endl;
535 | }
