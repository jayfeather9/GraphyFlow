18144 |  519 | inline distance_t get_val(reduce_word_t word, int idx) {
18145 |  520 | #pragma HLS INLINE
18146 |  521 |     ap_uint<DISTANCE_BITWIDTH> bits;
18147 |  522 |     switch (idx) {
18148 |  523 |     case 0:
18149 |  524 |         bits = word.range(DISTANCE_BITWIDTH - 1, 0);
18150 |  525 |         break;
18151 |  526 |     case 1:
18152 |  527 |         bits = word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH);
18153 |  528 |         break;
18154 |  529 |     case 2:
18155 |  530 |         bits =
18156 |  531 |             word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1));
18157 |  532 |         break;
18158 |  533 |     default:
18159 |  534 |         bits = 0;
18160 |  535 |         break;
18161 |  536 |     }
18162 |  537 |     // Convert bits back to distance_t (floating point)
18163 |  538 |     return *reinterpret_cast<distance_t *>(&bits);
18164 |  539 | }
18165 |  540 | 
18166 |  541 | inline void set_val(reduce_word_t &word, int idx, distance_t val) {
18167 |  542 | #pragma HLS INLINE
18168 |  543 |     ap_uint<DISTANCE_BITWIDTH> val_bits =
18169 |  544 |         *reinterpret_cast<ap_uint<DISTANCE_BITWIDTH> *>(&val);
18170 |  545 |     switch (idx) {
18171 |  546 |     case 0:
18172 |  547 |         word.range(DISTANCE_BITWIDTH - 1, 0) = val_bits;
18173 |  548 |         break;
18174 |  549 |     case 1:
18175 |  550 |         word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH) = val_bits;
18176 |  551 |         break;
18177 |  552 |     case 2:
18178 |  553 |         word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1)) =
18179 |  554 |             val_bits;
18180 |  555 |         break;
18181 |  556 |     default:
18182 |  557 |         break;
18183 |  558 |     }
18184 |  559 | }
