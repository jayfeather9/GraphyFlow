 7390 |  7147 | 7057 |  14 |     printf(" DEBUG Starting hbm_manager.\n"); fflush(NULL);
 7391 |  7148 | 7058 |  15 | 
 7392 |  7149 | 7059 |  16 |     // Stream 0
 7393 |  7150 | 7060 |  17 |     /*
 7394 |  7151 | 7061 |  18 | LOOP_NPL_S0_READ:
 7395 |  7152 | 7062 |  19 |     while (true) {
 7396 |  7153 | 7063 |  20 | #pragma HLS PIPELINE
 7397 |  7154 | 7064 |  21 |         if (!cacheline_req_stream.empty()) {
 7398 |  7155 | 7065 |  22 |             // printf("Waiting for cacheline request...\n");fflush(NULL);
 7399 |  7156 | 7066 |  23 |             cacheline_req_t cache_req;
 7400 |  7157 | 7067 |  24 |             b_cacheline_req_t b_cache_req = cacheline_req_stream.read();
 7401 |  7158 | 7068 |  25 |             cache_req.idx = b_cache_req.data;
 7402 |  7159 | 7069 |  26 |             cache_req.dst = b_cache_req.dest;
 7403 |  7160 | 7070 |  27 |             cache_req.end_flag = b_cache_req.last;
 7404 |  7161 | 7071 |  28 |             // printf("Received cacheline request for idx %d from PE %d\n",
 7405 |  7162 | 7072 |  29 |             // (int)cache_req.idx, (int)cache_req.dst); fflush(NULL);
 7406 |  7163 | 7073 |  30 |             if (cache_req.end_flag) {
 7407 |  7164 | 7074 |  31 |                 cache_resp.end_flag = true;
 7408 |  7165 | 7075 |  32 |                 end_flag_get = true;
 7409 |  7166 | 7076 |  33 |             } else {
 7410 |  7167 | 7077 |  34 |                 cache_resp.end_flag = false;
 7411 |  7168 | 7078 |  35 |                 if (cache_req.idx == last_cache_idx) {
 7412 |  7169 | 7079 |  36 |                     cache_resp.data = last_cacheline;
 7413 |  7170 | 7080 |  37 |                 } else {
 7414 |  7171 | 7081 |  38 |                     cache_resp.data = node_distances[cache_req.idx];
 7415 |  7172 | 7082 |  39 |                 }
 7416 |  7173 | 7083 |  40 |             }
 7417 |  7174 | 7084 |  41 | 
 7418 |  7175 | 7085 |  42 |             last_cacheline = cache_resp.data;
 7419 |  7176 | 7086 |  43 |             last_cache_idx = cache_req.idx;
 7420 |  7177 | 7087 |  44 |             cache_resp.dst = cache_req.dst;
 7421 |  7178 | 7088 |  45 | 
 7422 |  7179 | 7089 |  46 |             b_cacheline_resp_t b_cache_resp;
 7423 |  7180 | 7090 |  47 |             b_cache_resp.data = cache_resp.data;
 7424 |  7181 | 7091 |  48 |             b_cache_resp.dest = cache_resp.dst;
 7425 |  7182 | 7092 |  49 |             b_cache_resp.last = cache_resp.end_flag;
 7426 |  7183 | 7093 |  50 |             cacheline_resp_stream.write(b_cache_resp);
 7427 |  7184 | 7094 |  51 |             // printf("Sent cacheline response for idx %d to PE %d\n",
 7428 |  7185 | 7095 |  52 |             // (int)cache_req.idx, (int)cache_req.dst); fflush(NULL);
 7429 |  7186 | 7096 |  53 |             if (end_flag_get) {
 7430 |  7187 | 7097 |  54 |                 break;
 7431 |  7188 | 7098 |  55 |             }
 7432 |  7189 | 7099 |  56 |         }
 7433 |  7190 | 7100 |  57 |     }
 7434 |  7191 | 7101 |  58 | 
 7435 |  7192 | 7102 |  59 |     const int num_dists_per_word = AXI_BUS_WIDTH / DISTANCE_BITWIDTH;
 7436 |  7193 | 7103 |  60 |     const int num_wide_reads =
 7437 |  7194 | 7104 |  61 |         (num_nodes + num_dists_per_word - 1) / num_dists_per_word;
 7438 |  7195 | 7105 |  62 | 
 7439 |  7196 | 7106 |  63 |     // Stream 1
 7440 |  7197 | 7107 |  64 |     int nodes_read_s1 = 0;
 7441 |  7198 | 7108 |  65 |     int burst_idx1 = 0, burst_idx2 = 0;
 7442 |  7199 | 7109 |  66 |     // printf("Loading node distances for %d nodes (%d wide reads)\n",
 7443 |  7200 | 7110 |  67 |     // num_nodes, num_wide_reads); fflush(NULL);
 7444 |  7201 | 7111 |  68 |     */
 7445 |  7202 | 7112 |  69 |    LOOP_NPL_S0_READ:
 7446 |  7203 | 7113 |  70 |     while (true) {
 7447 |  7204 | 7114 |  71 | #pragma HLS PIPELINE
 7448 |  7205 | 7115 |  72 |         b_cacheline_req_t b_cache_req;
 7449 |  7206 | 7116 |  73 |         // 使用 read_nb() 进行非阻塞读取
 7450 |  7207 | 7117 |  74 |         if (cacheline_req_stream.read_nb(b_cache_req)) {
 7451 |  7208 | 7118 |  75 |             printf("Waiting for cacheline request...\n");fflush(NULL);
 7452 |  7209 | 7119 |  76 |             // --- 数据成功读取，现在开始处理 ---
 7453 |  7210 | 7120 |  77 |             cacheline_req_t cache_req;
 7454 |  7211 | 7121 |  78 |             cache_req.idx = b_cache_req.data;
 7455 |  7212 | 7122 |  79 |             cache_req.dst = b_cache_req.dest;
 7456 |  7213 | 7123 |  80 |             cache_req.end_flag = b_cache_req.last;
 7457 |  7214 | 7124 |  81 | 
 7458 |  7215 | 7125 |  82 |             if (cache_req.end_flag) {
 7459 |  7216 | 7126 |  83 |                 cache_resp.end_flag = true;
 7460 |  7217 | 7127 |  84 |                 end_flag_get = true;
 7461 |  7218 | 7128 |  85 |             } else {
 7462 |  7219 | 7129 |  86 |                 cache_resp.end_flag = false;
 7463 |  7220 | 7130 |  87 |                 if (cache_req.idx == last_cache_idx) {
 7464 |  7221 | 7131 |  88 |                     cache_resp.data = last_cacheline;
 7465 |  7222 | 7132 |  89 |                 } else {
 7466 |  7223 | 7133 |  90 |                     cache_resp.data = node_distances[cache_req.idx];
 7467 |  7224 | 7134 |  91 |                 }
 7468 |  7225 | 7135 |  92 |             }
 7469 |  7226 | 7136 |  93 | 
 7470 |  7227 | 7137 |  94 |             last_cacheline = cache_resp.data;
 7471 |  7228 | 7138 |  95 |             last_cache_idx = cache_req.idx;
 7472 |  7229 | 7139 |  96 |             cache_resp.dst = cache_req.dst;
 7473 |  7230 | 7140 |  97 | 
 7474 |  7231 | 7141 |  98 |             b_cacheline_resp_t b_cache_resp;
 7475 |  7232 | 7142 |  99 |             b_cache_resp.data = cache_resp.data;
 7476 |  7233 | 7143 | 100 |             b_cache_resp.dest = cache_resp.dst;
 7477 |  7234 | 7144 | 101 |             b_cache_resp.last = cache_resp.end_flag;
 7478 |  7235 | 7145 | 102 |             cacheline_resp_stream.write(b_cache_resp);
 7479 |  7236 | 7146 | 103 | 
 7480 |  7237 | 7147 | 104 |             if (end_flag_get) {
 7481 |  7238 | 7148 | 105 |                 printf("DEBUG HBM end\n");fflush(NULL);
 7482 |  7239 | 7149 | 106 |                 break;
 7483 |  7240 | 7150 | 107 |             }
 7484 |  7241 | 7151 | 108 |         }
 7485 |  7242 | 7152 | 109 |         // 如果 read_nb() 返回 false (流为空)，则直接进入下一个流水线周期，不会执行if内的代码
 7486 |  7243 | 7153 | 110 |     }
 7487 |  7244 | 7154 | 111 | 
 7488 |  7245 | 7155 | 112 |     const int num_dists_per_word = AXI_BUS_WIDTH / DISTANCE_BITWIDTH;
 7489 |  7246 | 7156 | 113 |     const int num_wide_reads =
 7490 |  7247 | 7157 | 114 |         (num_nodes + num_dists_per_word - 1) / num_dists_per_word;
 7491 |  7248 | 7158 | 115 | 
 7492 |  7249 | 7159 | 116 |     // Stream 1
 7493 |  7250 | 7160 | 117 |     int nodes_read_s1 = 0;
 7494 |  7251 | 7161 | 118 |     int burst_idx1 = 0, burst_idx2 = 0;
 7495 |  7252 | 7162 | 119 | 
 7496 |  7253 | 7163 | 120 | LOOP_NPL_S1_READ:
 7497 |  7254 | 7164 | 121 |     for (int i = 0; i < num_wide_reads; i++) {
