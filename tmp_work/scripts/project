10220 |  9977 | 181 |                 p_graph.weights[j] = local_edges[j].weight;
10221 |  9978 | 182 |                 out_degree[local_edges[j].src]++;
10222 |  9979 | 183 |             }
10223 |  9980 | 184 | 
10224 |  9981 | 185 |             p_graph.offsets[0] = 0;
10225 |  9982 | 186 |             for (int j = 0; j < p_graph.num_vertices; ++j) {
10226 |  9983 | 187 |                 p_graph.offsets[j + 1] = p_graph.offsets[j] + out_degree[j];
