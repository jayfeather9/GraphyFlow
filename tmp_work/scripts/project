17965 |  340 | // --- REWRITTEN: New final_writeback function packs results into 512-bit words.
17966 |  341 | static void final_writeback(hls::stream<internal_end_data_batch_t> &in_stream,
17967 |  342 |                             bus_word_t *out_ddr) {
17968 |  343 |     const int bits_per_output =
17969 |  344 |         NODE_ID_BITWIDTH + DISTANCE_BITWIDTH + OUT_END_MARKER_BITWIDTH;
17970 |  345 |     const int outputs_per_word = AXI_BUS_WIDTH / bits_per_output;
17971 |  346 | 
17972 |  347 |     bus_word_t write_word = 0;
17973 |  348 |     int pack_count = 0;
17974 |  349 |     int ddr_addr = 0;
17975 |  350 | 
17976 |  351 | LOOP_WRITEBACK_MAIN:
17977 |  352 |     while (true) {
17978 |  353 | #pragma HLS PIPELINE II = 1
17979 |  354 |         internal_end_data_batch_t in_batch;
17980 |  355 |         if (in_stream.read_nb(in_batch)) {
17981 |  356 | 
17982 |  357 |         LOOP_WRITEBACK_PACK:
17983 |  358 |             for (int i = 0; i < in_batch.end_pos; i++) {
17984 |  359 | #pragma HLS UNROLL
17985 |  360 |                 node_with_prop_t item = in_batch.data[i];
17986 |  361 |                 ap_uint<bits_per_output> packed_output;
17987 |  362 |                 // printf("[LITTLE]Packing output: node_id=%d, distance=%f\n",
17988 |  363 |                 // (int)item.node_id, (float)*reinterpret_cast<distance_t
17989 |  364 |                 // *>(&item.prop)); fflush(NULL);
17990 |  365 |                 packed_output.range(NODE_ID_BITWIDTH - 1, 0) = item.node_id;
17991 |  366 |                 packed_output.range(NODE_ID_BITWIDTH + DISTANCE_BITWIDTH - 1,
17992 |  367 |                                     NODE_ID_BITWIDTH) = item.prop;
17993 |  368 |                 out_end_marker_t end_marker =
17994 |  369 |                     0; // No end marker for regular entries
17995 |  370 |                 packed_output.range(bits_per_output - 1,
17996 |  371 |                                     NODE_ID_BITWIDTH + DISTANCE_BITWIDTH) =
17997 |  372 |                     end_marker;
17998 |  373 |                 ap_fixed_pod_t tmp_dist = packed_output.range(
17999 |  374 |                     NODE_ID_BITWIDTH + DISTANCE_BITWIDTH - 1, NODE_ID_BITWIDTH);
18000 |  375 |                 // printf("[LITTLE]Packing output: node_id=%d, distance=%f\n",
18001 |  376 |                 // (int)packed_output.range(NODE_ID_BITWIDTH - 1, 0),
18002 |  377 |                 // (float)*reinterpret_cast<distance_t *>(&tmp_dist));
18003 |  378 |                 // fflush(NULL);
18004 |  379 | 
18005 |  380 |                 int start_bit = pack_count * bits_per_output;
18006 |  381 |                 write_word.range(start_bit + bits_per_output - 1, start_bit) =
18007 |  382 |                     packed_output;
18008 |  383 | 
18009 |  384 |                 pack_count++;
18010 |  385 |                 if (pack_count == outputs_per_word) {
18011 |  386 |                     // printf("[LITTLE] Writing packed word to DDR at address
18012 |  387 |                     // %d\n", ddr_addr); fflush(NULL);
18013 |  388 |                     out_ddr[ddr_addr++] = write_word;
18014 |  389 |                     write_word = 0;
18015 |  390 |                     pack_count = 0;
18016 |  391 |                 }
18017 |  392 |             }
18018 |  393 | 
18019 |  394 |             if (in_batch.end_flag) {
18020 |  395 |                 break;
18021 |  396 |             }
18022 |  397 |         }
18023 |  398 |     }
18024 |  399 | 
18025 |  400 |     // if pack_count is 0, write a final end marker word
18026 |  401 |     // else, put the end marker in the current write_word and write it
18027 |  402 |     ap_uint<bits_per_output> end_marker;
18028 |  403 |     end_marker.range(NODE_ID_BITWIDTH - 1, 0) = 0;
18029 |  404 |     end_marker.range(NODE_ID_BITWIDTH + DISTANCE_BITWIDTH - 1,
18030 |  405 |                      NODE_ID_BITWIDTH) = 0; // Distance = 0
18031 |  406 |     end_marker.range(bits_per_output - 1,
18032 |  407 |                      NODE_ID_BITWIDTH + DISTANCE_BITWIDTH) =
18033 |  408 |         (out_end_marker_t)1; // End marker = 1
18034 |  409 |     if (pack_count == 0) {
18035 |  410 |         bus_word_t end_word = 0;
18036 |  411 |         end_word.range(bits_per_output - 1, 0) = end_marker;
18037 |  412 |         out_ddr[ddr_addr++] = end_word;
18038 |  413 |     } else {
18039 |  414 |         int start_bit = pack_count * bits_per_output;
18040 |  415 |         write_word.range(start_bit + bits_per_output - 1, start_bit) =
18041 |  416 |             end_marker;
18042 |  417 |         out_ddr[ddr_addr++] = write_word;
18043 |  418 |     }
18044 |  419 | }
