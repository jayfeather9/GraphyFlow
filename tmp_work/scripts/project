 6350 |  6107 | 6017 |  853 |             temp_BinOp_68_o_0_ap_result = (lhs_68 + rhs_68);
 6351 |  6108 | 6018 |  854 |             fused_temp_BinOp_68_o_0 = *reinterpret_cast<ap_fixed_pod_t *>(
 6352 |  6109 | 6019 |  855 |                 &temp_BinOp_68_o_0_ap_result);
 6353 |  6110 | 6020 |  856 |             // Inlining Gathe_179
