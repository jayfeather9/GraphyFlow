 578 | 
 579 | static void
 580 | Reduc_105_unit_reduce(hls::stream<struct_kbu_50_t> &in_kt_pair_stream,
 581 |                       hls::stream<internal_end_data_batch_t> &o_0,
 582 |                       int32_t dst_num) { // <-- 函数签名已修改
 583 |     // --- Phase 1: Memory Declaration ---
 584 |     // (此部分保持不变)
 585 |     const int MEM_SIZE =
 586 |         (MAX_NUM + DISTANCES_PER_REDUCE_WORD - 1) / DISTANCES_PER_REDUCE_WORD;
 587 |     reduce_word_t prop_mem[PE_NUM][MEM_SIZE];
 588 | #pragma HLS BIND_STORAGE variable = prop_mem type = RAM_2P impl = URAM
 589 | #pragma HLS ARRAY_PARTITION variable = prop_mem complete dim = 1
 590 | #pragma HLS dependence variable = prop_mem inter false direction = WAW
 591 | #pragma HLS dependence variable = prop_mem inter false direction = RAW
 592 | 
 593 |     bool prop_valid[PE_NUM][MAX_NUM];
 594 | #pragma HLS BIND_STORAGE variable = prop_valid type = RAM_2P impl = BRAM
 595 | #pragma HLS ARRAY_PARTITION variable = prop_valid complete dim = 1
 596 | #pragma HLS dependence variable = prop_valid inter false direction = WAW
 597 | #pragma HLS dependence variable = prop_valid inter false direction = RAW
 598 | 
 599 |     typedef ap_uint<16> addr_map_t;
 600 |     addr_map_t key_to_addr_map[MAX_NUM];
 601 | #pragma HLS BIND_STORAGE variable = key_to_addr_map type = RAM_1P impl = BRAM
 602 | 
 603 |     reduce_word_t cache_data_buffer[PE_NUM][L + 1];
 604 | #pragma HLS ARRAY_PARTITION variable = cache_data_buffer complete dim = 0
 605 |     reduce_word_t tmp_cache_data_buffer[PE_NUM][L];
 606 | #pragma HLS ARRAY_PARTITION variable = tmp_cache_data_buffer complete dim = 0
 607 |     int cache_addr_buffer[PE_NUM][L + 1];
 608 | #pragma HLS ARRAY_PARTITION variable = cache_addr_buffer complete dim = 0
 609 |     int tmp_cache_addr_buffer[PE_NUM][L];
 610 | #pragma HLS ARRAY_PARTITION variable = tmp_cache_addr_buffer complete dim = 0
 611 | 
 612 | 
 613 |     // --- Phase 2: Initialization ---
 614 |     // (此部分保持不变)
 615 | LOOP_INIT_LITTLE:
 616 |     for (int i = 0; i < MAX_NUM; i++) {
 617 | #pragma HLS PIPELINE II = 1
 618 |         addr_map_t map_val;
 619 |         map_val.range(15, 2) = i / DISTANCES_PER_REDUCE_WORD; // word_addr
 620 |         map_val.range(1, 0) = i % DISTANCES_PER_REDUCE_WORD;  // pack_idx
 621 |         key_to_addr_map[i] = map_val;
 622 |         for (int pe = 0; pe < PE_NUM; pe++) {
 623 | #pragma HLS UNROLL
 624 |             prop_valid[pe][i] = false;
 625 |         }
 626 |     }
 627 | LOOP_INIT_LITTLE_CACHE:
 628 |     for (int i = 0; i < L + 1; i++) {
 629 |         for (int pe = 0; pe < PE_NUM; pe++) {
 630 | #pragma HLS UNROLL
 631 |             cache_addr_buffer[pe][i] = -1; // Invalidate cache
 632 |         }
 633 |     }
 634 | 
 635 |     // --- Phase 3: Aggregation Loop ---
 636 |     // (此部分保持不变)
 637 | LOOP_AGGREGATE_LITTLE:
 638 |     while (true) {
 639 | #pragma HLS PIPELINE II = 1
 640 |         struct_kbu_50_t in_batch;
 641 |         if (in_kt_pair_stream.read_nb(in_batch)) {
 642 |             for (int pe = 0; pe < PE_NUM; pe++) {
 643 | #pragma HLS UNROLL
 644 |                 if (pe < in_batch.end_pos) {
 645 |                     int key = in_batch.data[pe].key;
 646 |                     ap_fixed_pod_t incoming_dist_pod =
 647 |                         in_batch.data[pe].transform.prop;
 648 |                     
 649 |                     // Note: In the original code, key_to_addr_map was PE-specific.
 650 |                     // It's more efficient to have a single shared map if the mapping is the same.
 651 |                     // Using a non-PE-specific map here for optimization.
 652 |                     addr_map_t map_val = key_to_addr_map[key];
 653 |                     int word_addr = map_val.range(15, 2);
 654 |                     int pack_idx = map_val.range(1, 0);
 655 | 
 656 |                     reduce_word_t current_word = prop_mem[pe][word_addr];
 657 | 
 658 |                     for (int i = L; i >= 0; --i) {
 659 | #pragma HLS UNROLL
 660 |                         if (cache_addr_buffer[pe][i] == word_addr) {
 661 |                             current_word = cache_data_buffer[pe][i];
 662 |                             break;
 663 |                         }
 664 |                     }
 665 | 
 666 |                     bool is_valid = prop_valid[pe][key];
 667 | 
 668 |                     for (int i = 0; i < L; i++) {
 669 | #pragma HLS UNROLL
 670 |                         tmp_cache_addr_buffer[pe][i] = cache_addr_buffer[pe][i + 1];
 671 |                         tmp_cache_data_buffer[pe][i] = cache_data_buffer[pe][i + 1];
 672 |                     }
 673 | 
 674 |                     for (int i = 0; i < L; i++) {
 675 | #pragma HLS UNROLL
 676 |                         cache_addr_buffer[pe][i] = tmp_cache_addr_buffer[pe][i];
 677 |                         cache_data_buffer[pe][i] = tmp_cache_data_buffer[pe][i];
 678 |                     }
 679 | 
 680 |                     distance_t new_dist_fp;
 681 |                     distance_t incoming_dist_fp = *reinterpret_cast<distance_t *>(&incoming_dist_pod);
 682 | 
 683 |                     if (is_valid) {
 684 |                         distance_t old_dist_fp = get_val(current_word, pack_idx);
 685 |                         new_dist_fp = (old_dist_fp < incoming_dist_fp) ? old_dist_fp : incoming_dist_fp;
 686 |                     } else {
 687 |                         new_dist_fp = incoming_dist_fp;
 688 |                     }
 689 | 
 690 |                     prop_valid[pe][key] = true;
 691 |                     set_val(current_word, pack_idx, new_dist_fp);
 692 |                     prop_mem[pe][word_addr] = current_word;
 693 |                     cache_addr_buffer[pe][L] = word_addr;
 694 |                     cache_data_buffer[pe][L] = current_word;
 695 |                 }
 696 |             }
 697 |             if (in_batch.end_flag) {
 698 |                 break;
 699 |             }
 700 |         }
 701 |     }
 702 | 
 703 |     // --- Phase 4: OPTIMIZED Final Merge and Drain Loop ---
 704 |     internal_end_data_batch_t data_pack;
 705 | #pragma HLS ARRAY_PARTITION variable = data_pack.data complete dim = 0
 706 |     data_pack.end_flag = false;
 707 |     data_pack.end_pos = 0;
 708 | 
 709 | LOOP_DRAIN_OPTIMIZED:
 710 |     // 遍历已知的有效 key (0 - dst_num-1)
 711 |     for (int key = 0; key < dst_num; key++) {
 712 | #pragma HLS PIPELINE II = 1
 713 |         
 714 |         addr_map_t map_val = key_to_addr_map[key];
 715 |         int word_addr = map_val.range(15, 2);
 716 |         int pack_idx = map_val.range(1, 0);
 717 | 
 718 |         distance_t min_dist = (distance_t)INFINITY_DIST;
 719 | 
 720 |     LOOP_MERGE_PES:
 721 |         for (int pe = 0; pe < PE_NUM; pe++) {
 722 | #pragma HLS UNROLL
 723 |             // 仍然需要检查 prop_valid: key有效意味着至少一个PE更新了它，但不代表所有PE都更新了它。
 724 |             // 此检查用于在跨PE合并时，过滤掉那些包含无效数据的PE。
 725 |             if (prop_valid[pe][key]) {
 726 |                 reduce_word_t word = prop_mem[pe][word_addr];
 727 |                 distance_t dist_fp = get_val(word, pack_idx);
 728 | 
 729 |                 if (dist_fp < min_dist) {
 730 |                     min_dist = dist_fp;
 731 |                 }
 732 |             }
 733 |         }
 734 | 
 735 |         // 无需 'valid_found' 标志，因为保证key有效，min_dist一定会被更新。
 736 |         data_pack.data[data_pack.end_pos].prop = *reinterpret_cast<ap_fixed_pod_t *>(&min_dist);
 737 |         data_pack.data[data_pack.end_pos].node_id = key;
 738 |         data_pack.end_pos++;
 739 | 
 740 |         if (data_pack.end_pos == PE_NUM) {
 741 |             data_pack.end_flag = false;
 742 |             o_0.write(data_pack);
 743 |             data_pack.end_pos = 0;
 744 |         }
 745 |     }
 746 | 
 747 |     // 发送最后一个（可能不满的）数据包
 748 |     if (data_pack.end_pos > 0) {
 749 |         data_pack.end_flag = false;
 750 |         o_0.write(data_pack);
 751 |     }
 752 |     
 753 |     // 发送结束标志
 754 |     data_pack.end_flag = true;
 755 |     data_pack.end_pos = 0;
 756 |     o_0.write(data_pack);
 757 | }
 758 | static void Scatt_234(hls::stream<struct_sbu_7_t> &i_0,
 759 |                       hls::stream<struct_abu_9_t> &o_0,
 760 |                       hls::stream<struct_nbu_11_t> &o_1,
 761 |                       hls::stream<struct_abu_9_t> &o_2) {
 762 |     struct_sbu_7_t in_batch_i_0;
