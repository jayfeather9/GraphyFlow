 5550 |  5307 | 5217 |   53 | static void
 5551 |  5308 | 5218 |   54 | edge_descriptor_loader(const bus_word_t *edge_props_ddr,
 5552 |  5309 | 5219 |   55 |                        hls::stream<edge_descriptor_batch_t> &edge_stream,
 5553 |  5310 | 5220 |   56 |                        int32_t num_edges) {
 5554 |  5311 | 5221 |   57 |     const int bits_per_edge = NODE_ID_BITWIDTH + WEIGHT_BITWIDTH;
 5555 |  5312 | 5222 |   58 |     const int edges_per_word = AXI_BUS_WIDTH / bits_per_edge;
 5556 |  5313 | 5223 |   59 |     const int num_wide_reads =
 5557 |  5314 | 5224 |   60 |         (num_edges + edges_per_word - 1) / edges_per_word;
 5558 |  5315 | 5225 |   61 | 
 5559 |  5316 | 5226 |   62 |     int edges_read = 0;
 5560 |  5317 | 5227 |   63 |     edge_descriptor_batch_t edge_batch;
 5561 |  5318 | 5228 |   64 | #pragma HLS ARRAY_PARTITION variable = edge_batch.edges complete dim = 0
 5562 |  5319 | 5229 |   65 |     edge_batch.end_pos = 0;
 5563 |  5320 | 5230 |   66 | 
 5564 |  5321 | 5231 |   67 | #if (NODE_ID_BITWIDTH == 32) && (WEIGHT_BITWIDTH == 32)
 5565 |  5322 | 5232 |   68 | LOOP_EDL_READ:
 5566 |  5323 | 5233 |   69 |     for (int i = 0; i < num_wide_reads; i++) {
 5567 |  5324 | 5234 |   70 | #pragma HLS PIPELINE II = 1
 5568 |  5325 | 5235 |   71 |         bus_word_t wide_word = edge_props_ddr[i];
 5569 |  5326 | 5236 |   72 |     LOOP_EDL_UNPACK:
 5570 |  5327 | 5237 |   73 |         for (int j = 0; j < edges_per_word; j++) {
 5571 |  5328 | 5238 |   74 | #pragma HLS UNROLL
 5572 |  5329 | 5239 |   75 |             if (edges_read + j < num_edges) {
 5573 |  5330 | 5240 |   76 |                 ap_uint<bits_per_edge> packed_edge = wide_word.range(
 5574 |  5331 | 5241 |   77 |                     (j + 1) * bits_per_edge - 1, j * bits_per_edge);
 5575 |  5332 | 5242 |   78 |                 node_with_prop_t edge;
 5576 |  5333 | 5243 |   79 |                 edge.node_id = packed_edge.range(NODE_ID_BITWIDTH - 1, 0);
 5577 |  5334 | 5244 |   80 |                 edge.prop =
 5578 |  5335 | 5245 |   81 |                     packed_edge.range(bits_per_edge - 1, NODE_ID_BITWIDTH);
 5579 |  5336 | 5246 |   82 | 
 5580 |  5337 | 5247 |   83 |                 edge_batch.edges[j] = edge;
 5581 |  5338 | 5248 |   84 |             }
 5582 |  5339 | 5249 |   85 |         }
 5583 |  5340 | 5250 |   86 |         edges_read += edges_per_word;
 5584 |  5341 | 5251 |   87 |         edge_batch.end_pos = (edges_read <= num_edges)
 5585 |  5342 | 5252 |   88 |                                  ? edges_per_word
 5586 |  5343 | 5253 |   89 |                                  : (num_edges % edges_per_word);
 5587 |  5344 | 5254 |   90 |         edge_stream.write(edge_batch);
 5588 |  5345 | 5255 |   91 |         edge_batch.end_pos = 0;
 5589 |  5346 | 5256 |   92 |     }
 5590 |  5347 | 5257 |   93 | #else
 5591 |  5348 | 5258 |   94 | // Add support for other bitwidth combinations if needed.
 5592 |  5349 | 5259 |   95 | #error                                                                         \
 5593 |  5350 | 5260 |   96 |     "edge_descriptor_loader currently only supports 32-bit node_id and 32-bit weight."
 5594 |  5351 | 5261 |   97 | #endif
 5595 |  5352 | 5262 |   98 | }
