17527 | 209 | 
17528 | 210 |     container.num_dense_partitions = container.DPs.size();
17529 | 211 |     container.num_sparse_partitions = container.SPs.size();
17530 | 212 | 
17531 | 213 |     std::cout<<"DP: "<<container.num_dense_partitions<<"SP: "<<container.num_sparse_partitions<<std::endl;
17532 | 214 |     std::cout << "[SUCCESS] Graph partitioning and preprocessing complete."
17533 | 215 |               << std::endl;
17534 | 216 |     return container;
17535 | 217 | }
