20069 |  636 | static void sender_2(int32_t i, hls::stream<net_wrapper_kt_pair_105_t_t> &in1,
20070 |  637 |                      hls::stream<net_wrapper_kt_pair_105_t_t> &in2,
20071 |  638 |                      hls::stream<net_wrapper_kt_pair_105_t_t> &out1,
20072 |  639 |                      hls::stream<net_wrapper_kt_pair_105_t_t> &out2,
20073 |  640 |                      hls::stream<net_wrapper_kt_pair_105_t_t> &out3,
20074 |  641 |                      hls::stream<net_wrapper_kt_pair_105_t_t> &out4) {
20075 |  642 | #pragma HLS function_instantiate variable = i
20076 |  643 |     bool in1_end_flag = false;
20077 |  644 |     bool in2_end_flag = false;
20078 |  645 | LOOP_WHILE_23:
20079 |  646 |     while (true) {
20080 |  647 | #pragma HLS PIPELINE II = 1
20081 |  648 |         if ((!in1.empty())) {
20082 |  649 |             net_wrapper_kt_pair_105_t_t data1;
20083 |  650 |             data1 = in1.read();
20084 |  651 |             if ((!data1.end_flag)) {
20085 |  652 |                 if (((data1.data.key >> i) & 1)) {
20086 |  653 |                     out2.write(data1);
20087 |  654 |                 } else {
20088 |  655 |                     out1.write(data1);
20089 |  656 |                 }
20090 |  657 |             } else {
20091 |  658 |                 in1_end_flag = true;
20092 |  659 |             }
