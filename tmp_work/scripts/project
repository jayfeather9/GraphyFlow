 5634 |  5391 | 5301 |  137 | static void
 5635 |  5392 | 5302 |  138 | dist_req_packer(hls::stream<node_id_burst_t> &src_id_burst_stream,
 5636 |  5393 | 5303 |  139 |                 hls::stream<distance_req_pack_t> &distance_req_pack_stream,
 5637 |  5394 | 5304 |  140 |                 int32_t num_nodes) {
 5638 |  5395 | 5305 |  141 | 
 5639 |  5396 | 5306 |  142 |     const int max_node_burst_idx = (num_nodes + PE_NUM - 1) / PE_NUM;
 5640 |  5397 | 5307 |  143 |     ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> last_idx_max = 0;
 5641 |  5398 | 5308 |  144 | 
 5642 |  5399 | 5309 |  145 | LOOP_DRP_SEND_REQ:
 5643 |  5400 | 5310 |  146 |     for (int32_t node_burst_idx = 0; node_burst_idx < max_node_burst_idx;
 5644 |  5401 | 5311 |  147 |          node_burst_idx += 1) {
