 6362 |  6119 | 6029 |  865 |         out_batch_intermediate_key.end_pos = in_batch_i_global_data_0.end_pos;
 6363 |  6120 | 6030 |  866 |         out_batch_intermediate_transform.end_flag =
 6364 |  6121 | 6031 |  867 |             in_batch_i_global_data_0.end_flag;
 6365 |  6122 | 6032 |  868 |         out_batch_intermediate_transform.end_pos =
 6366 |  6123 | 6033 |  869 |             in_batch_i_global_data_0.end_pos;
