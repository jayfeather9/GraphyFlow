13074 | 12831 |  145 | LOOP_DRP_SEND_REQ:
13075 | 12832 |  146 |     for (int32_t node_burst_idx = 0; node_burst_idx < max_node_burst_idx;
13076 | 12833 |  147 |          node_burst_idx += 1) {
13077 | 12834 |  148 | #pragma HLS PIPELINE II = 1
13078 | 12835 |  149 |         ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cache_idx[PE_NUM];
13079 | 12836 |  150 | #pragma HLS ARRAY_PARTITION variable = cache_idx complete dim = 0
13080 | 12837 |  151 |         node_id_burst_t node_id_burst = src_id_burst_stream.read();
13081 | 12838 |  152 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
13082 | 12839 |  153 | #pragma HLS UNROLL
13083 | 12840 |  154 |             cache_idx[pe_idx] = node_id_burst.data[pe_idx] >> LOG_DIST_PER_WORD;
13084 | 12841 |  155 |             // printf("PE %d requests node ID %d (cache idx %d)\n", pe_idx,
13085 | 12842 |  156 |             // (int)node_id_burst.data[pe_idx], (int)cache_idx[pe_idx]);
13086 | 12843 |  157 |             // fflush(NULL);
13087 | 12844 |  158 |         }
13088 | 12845 |  159 | 
13089 | 12846 |  160 |         ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cache_idx_diffs[PE_NUM];
13090 | 12847 |  161 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
13091 | 12848 |  162 | #pragma HLS UNROLL
13092 | 12849 |  163 |             cache_idx_diffs[pe_idx] = cache_idx[pe_idx] - last_idx_max;
13093 | 12850 |  164 |             // printf("PE %d cache idx diff: %d\n", pe_idx,
13094 | 12851 |  165 |             // (int)cache_idx_diffs[pe_idx]); fflush(NULL);
13095 | 12852 |  166 |         }
13096 | 12853 |  167 | 
13097 | 12854 |  168 |         // if not all diffs are zero, send a req_pack
13098 | 12855 |  169 |         if (cache_idx_diffs[PE_NUM - 1]) {
13099 | 12856 |  170 |             ap_uint<PE_NUM> valid_mask;
13100 | 12857 |  171 |             for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
13101 | 12858 |  172 | #pragma HLS UNROLL
13102 | 12859 |  173 |                 if (cache_idx_diffs[pe_idx] == 0) {
13103 | 12860 |  174 |                     valid_mask[pe_idx] = 1;
13104 | 12861 |  175 |                 } else {
13105 | 12862 |  176 |                     valid_mask[pe_idx] = 0;
13106 | 12863 |  177 |                 }
13107 | 12864 |  178 |             }
13108 | 12865 |  179 | 
13109 | 12866 |  180 |             ap_uint<4> num_unread = count_end_ones(valid_mask);
13110 | 12867 |  181 |             // printf("Packing req for %d unread PEs\n", (int)num_unread);
13111 | 12868 |  182 |             // fflush(NULL);
13112 | 12869 |  183 | 
13113 | 12870 |  184 |             distance_req_pack_t req_pack;
13114 | 12871 |  185 |             req_pack.offset = num_unread;
13115 | 12872 |  186 |             req_pack.end_flag = false;
13116 | 12873 |  187 | 
13117 | 12874 |  188 |             for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
13118 | 12875 |  189 | #pragma HLS UNROLL
13119 | 12876 |  190 |                 req_pack.node_ids[pe_idx] = node_id_burst.data[pe_idx];
13120 | 12877 |  191 |                 // printf("Req pack PE %d node ID: %d\n", pe_idx,
13121 | 12878 |  192 |                 // (int)req_pack.node_ids[pe_idx]); fflush(NULL);
13122 | 12879 |  193 |             }
13123 | 12880 |  194 | 
13124 | 12881 |  195 |             distance_req_pack_stream.write(req_pack);
13125 | 12882 |  196 |         }
13126 | 12883 |  197 | 
13127 | 12884 |  198 |         last_idx_max = cache_idx[PE_NUM - 1];
13128 | 12885 |  199 |     }
13129 | 12886 |  200 | 
13130 | 12887 |  201 |     distance_req_pack_t end_req_pack;
13131 | 12888 |  202 |     end_req_pack.end_flag = true;
13132 | 12889 |  203 |     end_req_pack.offset = 8;
13133 | 12890 |  204 |     distance_req_pack_stream.write(end_req_pack);
13134 | 12891 |  205 | }
