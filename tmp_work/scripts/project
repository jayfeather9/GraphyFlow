16161 | 359 |                   buffers.src_ids_buf = cl::Buffer(
16162 | 360 |                       acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX,
16163 | 361 |                       num_id_words * bytes_per_word, &hbm_ext_in0, &err));
16164 | 362 |         OCL_CHECK(err,
16165 | 363 |                   buffers.edge_props_buf = cl::Buffer(
16166 | 364 |                       acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX,
16167 | 365 |                       num_edge_words * bytes_per_word, &hbm_ext_in1, &err));
16168 | 366 |         
16169 | 367 |         // Note: node_props_buf is no longer set here, it's handled by the HBM manager
16170 | 368 | 
16171 | 369 |         size_t bits_per_output = NODE_ID_BITWIDTH + DISTANCE_BITWIDTH + OUT_END_MARKER_BITWIDTH;
16172 | 370 |         size_t max_dst_local_id = 0;
16173 | 371 |         for (size_t e = 0; e < p_graph.num_edges; ++e) {
16174 | 372 |             int dst = p_graph.columns[e];
16175 | 373 |             if (dst > max_dst_local_id) {
16176 | 374 |                 max_dst_local_id = dst;
16177 | 375 |             }
16178 | 376 |         }
16179 | 377 |         size_t num_dst_vertices = max_dst_local_id + 1;
16180 | 378 |         size_t vert_num_in_word = AXI_BUS_WIDTH / bits_per_output;
16181 | 379 |         size_t num_output_words = (num_dst_vertices + vert_num_in_word - 1) / vert_num_in_word + 1;
16182 | 380 | 
16183 | 381 |         little_kernel_host_outputs[i].resize(num_output_words);
16184 | 382 |         OCL_CHECK(err,
16185 | 383 |                   buffers.output_buf = cl::Buffer(
16186 | 384 |                       acc.context, CL_MEM_WRITE_ONLY | CL_MEM_EXT_PTR_XILINX,
16187 | 385 |                       num_output_words * bytes_per_word, &hbm_ext_out, &err));
16188 | 386 | 
16189 | 387 |         little_kernel_buffers.push_back(buffers);
16190 | 388 |     }
16191 | 389 | 
16192 | 390 |     std::cout << "[SUCCESS] HBM buffers created for " << container.DPs.size() << " little kernels and 1 HBM manager." << std::endl;
16193 | 391 | }
