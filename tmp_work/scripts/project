 2533 |  2290 | 2200 |   2 | #include <algorithm>
 2534 |  2291 | 2201 |   3 | #include <iostream>
 2535 |  2292 | 2202 |   4 | #include <numeric>
 2536 |  2293 | 2203 |   5 | #include <set>
 2537 |  2294 | 2204 |   6 | #include <vector>
 2538 |  2295 | 2205 |   7 | 
 2539 |  2296 | 2206 |   8 | // A local helper struct to temporarily hold edge information with global vertex
 2540 |  2297 | 2207 |   9 | // IDs.
 2541 |  2298 | 2208 |  10 | struct Edge {
 2542 |  2299 | 2209 |  11 |     int src, dest, weight;
 2543 |  2300 | 2210 |  12 | };
 2544 |  2301 | 2211 |  13 | 
 2545 |  2302 | 2212 |  14 | /**
 2546 |  2303 | 2213 |  15 |  * @brief Partitions a global graph and preprocesses each partition into a local
 2547 |  2304 | 2214 |  16 |  * CSR format.
 2548 |  2305 | 2215 |  17 |  *
 2549 |  2306 | 2216 |  18 |  * This function implements a partitioning strategy based on destination
 2550 |  2307 | 2217 |  19 |  * vertices.
 2551 |  2308 | 2218 |  20 |  * 1.  It identifies all unique destination vertices in the graph.
 2552 |  2309 | 2219 |  21 |  * 2.  It distributes these destination vertices disjointly and as evenly as
 2553 |  2310 | 2220 |  22 |  * possible among all available partitions (for both big and little kernels).
 2554 |  2311 | 2221 |  23 |  * 3.  It assigns each edge from the global graph to the partition that is
 2555 |  2312 | 2222 |  24 |  * responsible for its destination vertex.
 2556 |  2313 | 2223 |  25 |  * 4.  For each partition, it collects all unique vertices involved (both
 2557 |  2314 | 2224 |  26 |  * sources and destinations).
 2558 |  2315 | 2225 |  27 |  * 5.  It performs vertex ID compression for each partition, creating a local ID
 2559 |  2316 | 2226 |  28 |  * space. Destination vertices are mapped first to ensure they occupy the lower
 2560 |  2317 | 2227 |  29 |  * ID range.
 2561 |  2318 | 2228 |  30 |  * 6.  It rewrites the partition's edges using these new local IDs.
 2562 |  2319 | 2229 |  31 |  * 7.  Finally, it converts the rewritten edges into a local CSR format.
 2563 |  2320 | 2230 |  32 |  *
 2564 |  2321 | 2231 |  33 |  * @param graph The input global graph in CSR format.
 2565 |  2322 | 2232 |  34 |  * @return A PartitionContainer object containing all processed partitions.
 2566 |  2323 | 2233 |  35 |  */
 2567 |  2324 | 2234 |  36 | PartitionContainer partitionGraph(const GraphCSR *graph) {
 2568 |  2325 | 2235 |  37 |     std::cout << "--- Starting Graph Partitioning and Preprocessing ---"
 2569 |  2326 | 2236 |  38 |               << std::endl;
 2570 |  2327 | 2237 |  39 |     PartitionContainer container;
 2571 |  2328 | 2238 |  40 |     container.num_graph_vertices = graph->num_vertices;
 2572 |  2329 | 2239 |  41 |     container.num_graph_edges = graph->num_edges;
 2573 |  2330 | 2240 |  42 |     printf("Global graph has %d vertices and %d edges.\n", graph->num_vertices,
 2574 |  2331 | 2241 |  43 |            graph->num_edges);
 2575 |  2332 | 2242 |  44 |     const int num_partitions = BIG_KERNEL_NUM + LITTLE_KERNEL_NUM;
 2576 |  2333 | 2243 |  45 | 
 2577 |  2334 | 2244 |  46 |     std::cout<<"DEBUG big num:"<<BIG_KERNEL_NUM<<" little num :"<<LITTLE_KERNEL_NUM;
 2578 |  2335 | 2245 |  47 | 
 2579 |  2336 | 2246 |  48 |     if (num_partitions == 0) {
 2580 |  2337 | 2247 |  49 |         std::cerr << "Error: No kernels defined (BIG_KERNEL_NUM and "
 2581 |  2338 | 2248 |  50 |                      "LITTLE_KERNEL_NUM are both 0)."
 2582 |  2339 | 2249 |  51 |                   << std::endl;
 2583 |  2340 | 2250 |  52 |         return container;
 2584 |  2341 | 2251 |  53 |     }
 2585 |  2342 | 2252 |  54 |     std::cout << "[INFO] Total partitions to create: " << num_partitions
 2586 |  2343 | 2253 |  55 |               << std::endl;
 2587 |  2344 | 2254 |  56 | 
 2588 |  2345 | 2255 |  57 |     // --- PHASE 1: Identify and Collect All Unique Destination Vertices ---
 2589 |  2346 | 2256 |  58 |     std::set<int> unique_dst_vertices_set;
 2590 |  2347 | 2257 |  59 |     for (int i = 0; i < graph->num_edges; ++i) {
 2591 |  2348 | 2258 |  60 |         unique_dst_vertices_set.insert(graph->columns[i]);
 2592 |  2349 | 2259 |  61 |     }
 2593 |  2350 | 2260 |  62 |     std::vector<int> unique_dst_vertices(unique_dst_vertices_set.begin(),
 2594 |  2351 | 2261 |  63 |                                          unique_dst_vertices_set.end());
 2595 |  2352 | 2262 |  64 |     std::cout << "[PHASE 1] Found " << unique_dst_vertices.size()
 2596 |  2353 | 2263 |  65 |               << " unique destination vertices." << std::endl;
 2597 |  2354 | 2264 |  66 | 
 2598 |  2355 | 2265 |  67 |     // --- PHASE 2: Distribute Destination Vertices to Partitions ---
 2599 |  2356 | 2266 |  68 |     std::vector<std::set<int>> dst_vertices_per_partition(num_partitions);
 2600 |  2357 | 2267 |  69 |     std::unordered_map<int, int> dst_vertex_to_partition_map;
 2601 |  2358 | 2268 |  70 | 
 2602 |  2359 | 2269 |  71 |     size_t base_dst_per_part = unique_dst_vertices.size() / num_partitions;
 2603 |  2360 | 2270 |  72 |     size_t remainder_dst = unique_dst_vertices.size() % num_partitions;
 2604 |  2361 | 2271 |  73 |     size_t current_dst_idx = 0;
 2605 |  2362 | 2272 |  74 | 
 2606 |  2363 | 2273 |  75 |     for (int i = 0; i < num_partitions; ++i) {
 2607 |  2364 | 2274 |  76 |         size_t num_dst_in_part =
 2608 |  2365 | 2275 |  77 |             base_dst_per_part + (i < remainder_dst ? 1 : 0);
 2609 |  2366 | 2276 |  78 |         for (size_t j = 0; j < num_dst_in_part; ++j) {
 2610 |  2367 | 2277 |  79 |             if (current_dst_idx < unique_dst_vertices.size()) {
 2611 |  2368 | 2278 |  80 |                 int vertex_id = unique_dst_vertices[current_dst_idx];
 2612 |  2369 | 2279 |  81 |                 dst_vertices_per_partition[i].insert(vertex_id);
 2613 |  2370 | 2280 |  82 |                 dst_vertex_to_partition_map[vertex_id] = i;
 2614 |  2371 | 2281 |  83 |                 current_dst_idx++;
 2615 |  2372 | 2282 |  84 |             }
 2616 |  2373 | 2283 |  85 |         }
 2617 |  2374 | 2284 |  86 |         std::cout << "[PHASE 2] Partition " << i << " assigned "
 2618 |  2375 | 2285 |  87 |                   << dst_vertices_per_partition[i].size()
 2619 |  2376 | 2286 |  88 |                   << " destination vertices." << std::endl;
 2620 |  2377 | 2287 |  89 |     }
 2621 |  2378 | 2288 |  90 | 
 2622 |  2379 | 2289 |  91 |     // --- PHASE 3: Assign Edges to Partitions Based on Destination Vertex ---
 2623 |  2380 | 2290 |  92 |     std::vector<std::vector<Edge>> edges_per_partition(num_partitions);
 2624 |  2381 | 2291 |  93 |     for (int u = 0; u < graph->num_vertices; ++u) {
 2625 |  2382 | 2292 |  94 |         for (int i = graph->offsets[u]; i < graph->offsets[u + 1]; ++i) {
 2626 |  2383 | 2293 |  95 |             int v = graph->columns[i];
 2627 |  2384 | 2294 |  96 |             int w = graph->weights[i];
 2628 |  2385 | 2295 |  97 | 
 2629 |  2386 | 2296 |  98 |             // Find which partition this edge belongs to
 2630 |  2387 | 2297 |  99 |             auto it = dst_vertex_to_partition_map.find(v);
 2631 |  2388 | 2298 | 100 |             if (it != dst_vertex_to_partition_map.end()) {
 2632 |  2389 | 2299 | 101 |                 int partition_id = it->second;
 2633 |  2390 | 2300 | 102 |                 edges_per_partition[partition_id].push_back({u, v, w});
 2634 |  2391 | 2301 | 103 |             } else {
 2635 |  2392 | 2302 | 104 |                 // This case should not happen if all dst vertices are mapped.
 2636 |  2393 | 2303 | 105 |                 // It might occur for sink nodes with no incoming edges, which
 2637 |  2394 | 2304 | 106 |                 // is fine.
 2638 |  2395 | 2305 | 107 |             }
 2639 |  2396 | 2306 | 108 |         }
 2640 |  2397 | 2307 | 109 |     }
 2641 |  2398 | 2308 | 110 |     std::cout << "[PHASE 3] All edges have been assigned to their respective "
 2642 |  2399 | 2309 | 111 |                  "partitions."
 2643 |  2400 | 2310 | 112 |               << std::endl;
 2644 |  2401 | 2311 | 113 | 
 2645 |  2402 | 2312 | 114 |     // --- PHASE 4: Process Each Partition (Compress IDs and Convert to CSR) ---
 2646 |  2403 | 2313 | 115 |     std::cout << "[PHASE 4] Processing each partition..." << std::endl;
 2647 |  2404 | 2314 | 116 |     for (int i = 0; i < num_partitions; ++i) {
 2648 |  2405 | 2315 | 117 |         PartitionDescriptor pd;
 2649 |  2406 | 2316 | 118 |         GraphCSR &p_graph = pd.partitioned_graph;
 2650 |  2407 | 2317 | 119 |         const auto &partition_edges = edges_per_partition[i];
 2651 |  2408 | 2318 | 120 |         const auto &partition_dst_nodes = dst_vertices_per_partition[i];
 2652 |  2409 | 2319 | 121 | 
 2653 |  2410 | 2320 | 122 |         if (partition_edges.empty()) {
 2654 |  2411 | 2321 | 123 |             std::cout << "  - Partition " << i << " has no edges. Skipping."
 2655 |  2412 | 2322 | 124 |                       << std::endl;
 2656 |  2413 | 2323 | 125 |             // Still create a valid (but empty) partition descriptor
 2657 |  2414 | 2324 | 126 |             pd.num_edges = 0;
 2658 |  2415 | 2325 | 127 |             pd.num_vertices = 0;
 2659 |  2416 | 2326 | 128 |             p_graph.num_edges = 0;
 2660 |  2417 | 2327 | 129 |             p_graph.num_vertices = 0;
 2661 |  2418 | 2328 | 130 |             p_graph.offsets.push_back(0);
 2662 |  2419 | 2329 | 131 | 
 2663 |  2420 | 2330 | 132 |         } else {
 2664 |  2421 | 2331 | 133 |             // --- 4.1: Collect unique vertices and build ID mappings ---
 2665 |  2422 | 2332 | 134 |             std::set<int> local_vertices_set;
 2666 |  2423 | 2333 | 135 |             for (const auto &edge : partition_edges) {
 2667 |  2424 | 2334 | 136 |                 local_vertices_set.insert(edge.src);
 2668 |  2425 | 2335 | 137 |                 local_vertices_set.insert(edge.dest);
 2669 |  2426 | 2336 | 138 |             }
 2670 |  2427 | 2337 | 139 | 
 2671 |  2428 | 2338 | 140 |             int local_id_counter = 0;
 2672 |  2429 | 2339 | 141 |             // First, map destination vertices to guarantee they have
 2673 |  2430 | 2340 | 142 |             // lower-range IDs
 2674 |  2431 | 2341 | 143 |             for (int global_id : partition_dst_nodes) {
 2675 |  2432 | 2342 | 144 |                 p_graph.vtx_map[global_id] = local_id_counter;
 2676 |  2433 | 2343 | 145 |                 p_graph.vtx_map_rev[local_id_counter] = global_id;
 2677 |  2434 | 2344 | 146 |                 local_id_counter++;
 2678 |  2435 | 2345 | 147 |             }
 2679 |  2436 | 2346 | 148 |             p_graph.num_dsts = partition_dst_nodes.size();
 2680 |  2437 | 2347 | 149 |             // Then, map the remaining source vertices
 2681 |  2438 | 2348 | 150 |             for (int global_id : local_vertices_set) {
 2682 |  2439 | 2349 | 151 |                 if (p_graph.vtx_map.find(global_id) == p_graph.vtx_map.end()) {
