 6376 |  6133 | 6043 |  879 | inline ap_fixed_pod_t get_raw_val(reduce_word_t word, int idx) {
 6377 |  6134 | 6044 |  880 | #pragma HLS INLINE
 6378 |  6135 | 6045 |  881 |     ap_uint<DISTANCE_BITWIDTH> bits;
 6379 |  6136 | 6046 |  882 |     switch (idx) {
 6380 |  6137 | 6047 |  883 |     case 0:
 6381 |  6138 | 6048 |  884 |         bits = word.range(DISTANCE_BITWIDTH - 1, 0);
 6382 |  6139 | 6049 |  885 |         break;
 6383 |  6140 | 6050 |  886 |     case 1:
 6384 |  6141 | 6051 |  887 |         bits = word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH);
 6385 |  6142 | 6052 |  888 |         break;
 6386 |  6143 | 6053 |  889 |     case 2:
 6387 |  6144 | 6054 |  890 |         bits =
 6388 |  6145 | 6055 |  891 |             word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1));
 6389 |  6146 | 6056 |  892 |         break;
 6390 |  6147 | 6057 |  893 |     default:
 6391 |  6148 | 6058 |  894 |         bits = 0;
 6392 |  6149 | 6059 |  895 |         break;
 6393 |  6150 | 6060 |  896 |     }
 6394 |  6151 | 6061 |  897 |     return bits;
 6395 |  6152 | 6062 |  898 | }
 6396 |  6153 | 6063 |  899 | 
 6397 |  6154 | 6064 |  900 | inline distance_t get_val(reduce_word_t word, int idx) {
 6398 |  6155 | 6065 |  901 | #pragma HLS INLINE
 6399 |  6156 | 6066 |  902 |     ap_fixed_pod_t raw_val = get_raw_val(word, idx);
 6400 |  6157 | 6067 |  903 |     distance_t val = *reinterpret_cast<distance_t *>(&raw_val);
 6401 |  6158 | 6068 |  904 |     return val;
 6402 |  6159 | 6069 |  905 | }
 6403 |  6160 | 6070 |  906 | 
 6404 |  6161 | 6071 |  907 | inline void set_val(reduce_word_t &word, int idx, distance_t val) {
 6405 |  6162 | 6072 |  908 | #pragma HLS INLINE
 6406 |  6163 | 6073 |  909 |     ap_uint<DISTANCE_BITWIDTH> val_bits =
 6407 |  6164 | 6074 |  910 |         *reinterpret_cast<ap_uint<DISTANCE_BITWIDTH> *>(&val);
 6408 |  6165 | 6075 |  911 |     switch (idx) {
 6409 |  6166 | 6076 |  912 |     case 0:
 6410 |  6167 | 6077 |  913 |         word.range(DISTANCE_BITWIDTH - 1, 0) = val_bits;
 6411 |  6168 | 6078 |  914 |         break;
 6412 |  6169 | 6079 |  915 |     case 1:
 6413 |  6170 | 6080 |  916 |         word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH) = val_bits;
 6414 |  6171 | 6081 |  917 |         break;
 6415 |  6172 | 6082 |  918 |     case 2:
 6416 |  6173 | 6083 |  919 |         word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1)) =
 6417 |  6174 | 6084 |  920 |             val_bits;
 6418 |  6175 | 6085 |  921 |         break;
 6419 |  6176 | 6086 |  922 |     default:
 6420 |  6177 | 6087 |  923 |         break;
 6421 |  6178 | 6088 |  924 |     }
 6422 |  6179 | 6089 |  925 | }
 6423 |  6180 | 6090 |  926 | 
 6424 |  6181 | 6091 |  927 | static void Reduc_105_unit_reduce(
 6425 |  6182 | 6092 |  928 |     hls::stream<net_wrapper_kt_pair_105_t_t> (&kt_wrap_item)[PE_NUM],
 6426 |  6183 | 6093 |  929 |     hls::stream<internal_end_data_batch_t> &o_0, int32_t dst_num) {
 6427 |  6184 | 6094 |  930 |     // --- Phase 1: Memory Declaration ---
 6428 |  6185 | 6095 |  931 | 
 6429 |  6186 | 6096 |  932 |     // URAM for packed distance data (3 distances per 72-bit word)
 6430 |  6187 | 6097 |  933 |     const int MEM_SIZE = (MAX_NUM >> LOG_PE_NUM) / DISTANCES_PER_REDUCE_WORD;
 6431 |  6188 | 6098 |  934 |     reduce_word_t prop_mem[PE_NUM][MEM_SIZE];
 6432 |  6189 | 6099 |  935 | #pragma HLS BIND_STORAGE variable = prop_mem type = RAM_2P impl = URAM
 6433 |  6190 | 6100 |  936 | #pragma HLS ARRAY_PARTITION variable = prop_mem complete dim = 1
 6434 |  6191 | 6101 |  937 | #pragma HLS dependence variable = prop_mem inter false direction = WAW
 6435 |  6192 | 6102 |  938 | #pragma HLS dependence variable = prop_mem inter false direction = RAW
 6436 |  6193 | 6103 |  939 | 
 6437 |  6194 | 6104 |  940 |     // BRAM for individual validity flags (fast access)
 6438 |  6195 | 6105 |  941 |     bool prop_valid[PE_NUM][MAX_NUM >> LOG_PE_NUM];
 6439 |  6196 | 6106 |  942 | #pragma HLS BIND_STORAGE variable = prop_valid type = RAM_2P impl = BRAM
 6440 |  6197 | 6107 |  943 | #pragma HLS ARRAY_PARTITION variable = prop_valid complete dim = 1
 6441 |  6198 | 6108 |  944 | #pragma HLS dependence variable = prop_valid inter false direction = WAW
 6442 |  6199 | 6109 |  945 | #pragma HLS dependence variable = prop_valid inter false direction = RAW
 6443 |  6200 | 6110 |  946 | 
 6444 |  6201 | 6111 |  947 |     // BRAM for pre-calculated address mapping (avoids division/modulo)
 6445 |  6202 | 6112 |  948 |     // 16 bits: 14 for word_addr, 2 for pack_idx
 6446 |  6203 | 6113 |  949 |     typedef ap_uint<16> addr_map_t;
 6447 |  6204 | 6114 |  950 |     addr_map_t key_to_addr_map[PE_NUM][MAX_NUM >> LOG_PE_NUM];
 6448 |  6205 | 6115 |  951 | #pragma HLS BIND_STORAGE variable = key_to_addr_map type = RAM_1P impl = BRAM
 6449 |  6206 | 6116 |  952 | #pragma HLS ARRAY_PARTITION variable = key_to_addr_map complete dim = 1
 6450 |  6207 | 6117 |  953 | 
 6451 |  6208 | 6118 |  954 |     // Latency-hiding cache for recently accessed URAM words
 6452 |  6209 | 6119 |  955 |     reduce_word_t cache_data_buffer[PE_NUM][L + 1];
 6453 |  6210 | 6120 |  956 | #pragma HLS ARRAY_PARTITION variable = cache_data_buffer complete dim = 0
 6454 |  6211 | 6121 |  957 |     reduce_word_t tmp_cache_data_buffer[PE_NUM][L];
 6455 |  6212 | 6122 |  958 | #pragma HLS ARRAY_PARTITION variable = tmp_cache_data_buffer complete dim = 0
 6456 |  6213 | 6123 |  959 |     int cache_addr_buffer[PE_NUM][L + 1];
 6457 |  6214 | 6124 |  960 | #pragma HLS ARRAY_PARTITION variable = cache_addr_buffer complete dim = 0
 6458 |  6215 | 6125 |  961 |     int tmp_cache_addr_buffer[PE_NUM][L];
 6459 |  6216 | 6126 |  962 | #pragma HLS ARRAY_PARTITION variable = tmp_cache_addr_buffer complete dim = 0
 6460 |  6217 | 6127 |  963 | 
 6461 |  6218 | 6128 |  964 | // --- Phase 2: Initialization ---
 6462 |  6219 | 6129 |  965 | LOOP_INIT_VALID:
 6463 |  6220 | 6130 |  966 |     for (int i = 0; i < (MAX_NUM >> LOG_PE_NUM); i++) {
 6464 |  6221 | 6131 |  967 | #pragma HLS PIPELINE II = 1
 6465 |  6222 | 6132 |  968 |         // Populate the address map
 6466 |  6223 | 6133 |  969 |         addr_map_t map_val;
 6467 |  6224 | 6134 |  970 |         map_val.range(15, 2) = i / DISTANCES_PER_REDUCE_WORD; // word_addr
 6468 |  6225 | 6135 |  971 |         map_val.range(1, 0) = i % DISTANCES_PER_REDUCE_WORD;  // pack_idx
 6469 |  6226 | 6136 |  972 |         for (int pe = 0; pe < PE_NUM; pe++) {
 6470 |  6227 | 6137 |  973 | #pragma HLS UNROLL
 6471 |  6228 | 6138 |  974 |             key_to_addr_map[pe][i] = map_val;
 6472 |  6229 | 6139 |  975 |         }
 6473 |  6230 | 6140 |  976 |         // Initialize valid flags
 6474 |  6231 | 6141 |  977 |         for (int pe = 0; pe < PE_NUM; pe++) {
 6475 |  6232 | 6142 |  978 | #pragma HLS UNROLL
 6476 |  6233 | 6143 |  979 |             prop_valid[pe][i] = false;
 6477 |  6234 | 6144 |  980 |         }
 6478 |  6235 | 6145 |  981 |     }
 6479 |  6236 | 6146 |  982 | LOOP_INIT_CACHE_ADDR:
 6480 |  6237 | 6147 |  983 |     for (int i = 0; i < L + 1; i++) {
 6481 |  6238 | 6148 |  984 |         for (int pe = 0; pe < PE_NUM; pe++) {
 6482 |  6239 | 6149 |  985 | #pragma HLS UNROLL
 6483 |  6240 | 6150 |  986 |             cache_addr_buffer[pe][i] = -1; // Invalidate cache
 6484 |  6241 | 6151 |  987 |         }
 6485 |  6242 | 6152 |  988 |     }
 6486 |  6243 | 6153 |  989 | 
 6487 |  6244 | 6154 |  990 |     // --- Phase 3: Aggregation Loop ---
 6488 |  6245 | 6155 |  991 |     bool all_end_flags[PE_NUM];
 6489 |  6246 | 6156 |  992 | #pragma HLS ARRAY_PARTITION variable = all_end_flags complete dim = 0
 6490 |  6247 | 6157 |  993 |     for (int i = 0; i < PE_NUM; i++) {
 6491 |  6248 | 6158 |  994 | #pragma HLS UNROLL
 6492 |  6249 | 6159 |  995 |         all_end_flags[i] = false;
 6493 |  6250 | 6160 |  996 |     }
 6494 |  6251 | 6161 |  997 | 
 6495 |  6252 | 6162 |  998 | LOOP_AGGREGATE:
 6496 |  6253 | 6163 |  999 |     while (true) {
 6497 |  6254 | 6164 | 1000 | #pragma HLS PIPELINE II = 1
 6498 |  6255 | 6165 | 1001 |         for (int pe = 0; pe < PE_NUM; pe++) {
 6499 |  6256 | 6166 | 1002 | #pragma HLS UNROLL
 6500 |  6257 | 6167 | 1003 |             net_wrapper_kt_pair_105_t_t kt_elem;
 6501 |  6258 | 6168 | 1004 |             if (!all_end_flags[pe] && kt_wrap_item[pe].read_nb(kt_elem)) {
 6502 |  6259 | 6169 | 1005 |                 if (kt_elem.end_flag) {
 6503 |  6260 | 6170 | 1006 |                     all_end_flags[pe] = true;
 6504 |  6261 | 6171 | 1007 |                 } else {
 6505 |  6262 | 6172 | 1008 |                     int key = kt_elem.data.key >> LOG_PE_NUM;
 6506 |  6263 | 6173 | 1009 |                     ap_fixed_pod_t incoming_dist_pod =
 6507 |  6264 | 6174 | 1010 |                         kt_elem.data.transform.prop;
 6508 |  6265 | 6175 | 1011 | 
 6509 |  6266 | 6176 | 1012 |                     addr_map_t map_val = key_to_addr_map[pe][key];
 6510 |  6267 | 6177 | 1013 |                     int word_addr = map_val.range(15, 2);
 6511 |  6268 | 6178 | 1014 |                     int pack_idx = map_val.range(1, 0);
 6512 |  6269 | 6179 | 1015 | 
 6513 |  6270 | 6180 | 1016 |                     reduce_word_t current_word = prop_mem[pe][word_addr];
 6514 |  6271 | 6181 | 1017 | 
 6515 |  6272 | 6182 | 1018 |                     // Check cache first
 6516 |  6273 | 6183 | 1019 |                     for (int i = L; i >= 0; --i) {
 6517 |  6274 | 6184 | 1020 | #pragma HLS UNROLL
 6518 |  6275 | 6185 | 1021 |                         if (cache_addr_buffer[pe][i] == word_addr) {
 6519 |  6276 | 6186 | 1022 |                             current_word = cache_data_buffer[pe][i];
 6520 |  6277 | 6187 | 1023 |                             break;
 6521 |  6278 | 6188 | 1024 |                         }
 6522 |  6279 | 6189 | 1025 |                     }
 6523 |  6280 | 6190 | 1026 | 
 6524 |  6281 | 6191 | 1027 |                     bool is_valid = prop_valid[pe][key];
 6525 |  6282 | 6192 | 1028 | 
 6526 |  6283 | 6193 | 1029 |                     for (int i = 0; i < L; i++) {
 6527 |  6284 | 6194 | 1030 | #pragma HLS UNROLL
 6528 |  6285 | 6195 | 1031 |                         tmp_cache_addr_buffer[pe][i] =
 6529 |  6286 | 6196 | 1032 |                             cache_addr_buffer[pe][i + 1];
 6530 |  6287 | 6197 | 1033 |                         tmp_cache_data_buffer[pe][i] =
 6531 |  6288 | 6198 | 1034 |                             cache_data_buffer[pe][i + 1];
 6532 |  6289 | 6199 | 1035 |                     }
 6533 |  6290 | 6200 | 1036 | 
 6534 |  6291 | 6201 | 1037 |                     for (int i = 0; i < L; i++) {
 6535 |  6292 | 6202 | 1038 | #pragma HLS UNROLL
 6536 |  6293 | 6203 | 1039 |                         cache_addr_buffer[pe][i] = tmp_cache_addr_buffer[pe][i];
 6537 |  6294 | 6204 | 1040 |                         cache_data_buffer[pe][i] = tmp_cache_data_buffer[pe][i];
 6538 |  6295 | 6205 | 1041 |                     }
 6539 |  6296 | 6206 | 1042 | 
 6540 |  6297 | 6207 | 1043 |                     distance_t new_dist_fp;
 6541 |  6298 | 6208 | 1044 |                     distance_t incoming_dist_fp =
 6542 |  6299 | 6209 | 1045 |                         *reinterpret_cast<distance_t *>(&incoming_dist_pod);
 6543 |  6300 | 6210 | 1046 | 
 6544 |  6301 | 6211 | 1047 |                     // printf("[BIG] PE %d processing key %d (word_addr %d,
 6545 |  6302 | 6212 | 1048 |                     // pack_idx %d) with incoming_dist %f\n", pe, key,
 6546 |  6303 | 6213 | 1049 |                     // word_addr, pack_idx, (float)incoming_dist_fp);
 6547 |  6304 | 6214 | 1050 |                     // fflush(NULL);
 6548 |  6305 | 6215 | 1051 | 
 6549 |  6306 | 6216 | 1052 |                     if (is_valid) {
 6550 |  6307 | 6217 | 1053 |                         distance_t old_dist_fp =
 6551 |  6308 | 6218 | 1054 |                             get_val(current_word, pack_idx);
 6552 |  6309 | 6219 | 1055 |                         // printf("[BIG]  Old distance: %f\n",
 6553 |  6310 | 6220 | 1056 |                         // (float)old_dist_fp);
 6554 |  6311 | 6221 | 1057 |                         new_dist_fp = (old_dist_fp < incoming_dist_fp)
 6555 |  6312 | 6222 | 1058 |                                           ? old_dist_fp
 6556 |  6313 | 6223 | 1059 |                                           : incoming_dist_fp;
 6557 |  6314 | 6224 | 1060 |                     } else {
 6558 |  6315 | 6225 | 1061 |                         new_dist_fp = incoming_dist_fp;
 6559 |  6316 | 6226 | 1062 |                     }
 6560 |  6317 | 6227 | 1063 | 
 6561 |  6318 | 6228 | 1064 |                     prop_valid[pe][key] = true;
 6562 |  6319 | 6229 | 1065 | 
 6563 |  6320 | 6230 | 1066 |                     ap_fixed_pod_t new_dist_pod =
 6564 |  6321 | 6231 | 1067 |                         *reinterpret_cast<ap_fixed_pod_t *>(&new_dist_fp);
 6565 |  6322 | 6232 | 1068 |                     // current_word.range(end_bit, start_bit) = new_dist_pod;
 6566 |  6323 | 6233 | 1069 |                     set_val(current_word, pack_idx, new_dist_fp);
 6567 |  6324 | 6234 | 1070 | 
 6568 |  6325 | 6235 | 1071 |                     // Write back to URAM and update cache
 6569 |  6326 | 6236 | 1072 |                     prop_mem[pe][word_addr] = current_word;
 6570 |  6327 | 6237 | 1073 |                     cache_addr_buffer[pe][L] = word_addr;
 6571 |  6328 | 6238 | 1074 |                     cache_data_buffer[pe][L] = current_word;
 6572 |  6329 | 6239 | 1075 |                 }
 6573 |  6330 | 6240 | 1076 |             }
 6574 |  6331 | 6241 | 1077 |         }
 6575 |  6332 | 6242 | 1078 |         bool end_flag = true;
 6576 |  6333 | 6243 | 1079 |         for (int i = 0; i < PE_NUM; i++) {
 6577 |  6334 | 6244 | 1080 | #pragma HLS UNROLL
 6578 |  6335 | 6245 | 1081 |             end_flag = (end_flag & all_end_flags[i]);
 6579 |  6336 | 6246 | 1082 |         }
 6580 |  6337 | 6247 | 1083 |         if (end_flag) {
 6581 |  6338 | 6248 | 1084 |             break;
 6582 |  6339 | 6249 | 1085 |         }
 6583 |  6340 | 6250 | 1086 |     }
 6584 |  6341 | 6251 | 1087 | 
 6585 |  6342 | 6252 | 1088 |     // --- Phase 4: High-Performance Drain Loop ---
 6586 |  6343 | 6253 | 1089 |     internal_end_data_batch_t data_pack;
 6587 |  6344 | 6254 | 1090 | #pragma HLS ARRAY_PARTITION variable = data_pack.data complete dim = 0
 6588 |  6345 | 6255 | 1091 |     data_pack.end_flag = 0;
 6589 |  6346 | 6256 | 1092 | 
 6590 |  6347 | 6257 | 1093 |     const int32_t num_keys_per_pe = (dst_num + PE_NUM - 1) >> LOG_PE_NUM;
