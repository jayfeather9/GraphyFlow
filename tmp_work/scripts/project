 5890 |  5647 | 5557 |  393 |         ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cur_last_cache_idx;
 5891 |  5648 | 5558 |  394 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
 5892 |  5649 | 5559 |  395 | #pragma HLS UNROLL
 5893 |  5650 | 5560 |  396 |             ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cacheline_idx =
 5894 |  5651 | 5561 |  397 |                 (src_id_burst.data[pe_idx] >> LOG_DIST_PER_WORD);
 5895 |  5652 | 5562 |  398 |             uint32_t offset = (src_id_burst.data[pe_idx] & (DIST_PER_WORD - 1));
 5896 |  5653 | 5563 |  399 |             if (pe_idx < edge_batch.end_pos) {
 5897 |  5654 | 5564 |  400 |                 bus_word_t cacheline;
 5898 |  5655 | 5565 |  401 |                 if (cacheline_idx == last_cache_idx[pe_idx]) {
