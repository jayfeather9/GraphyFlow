467 |     // --- 2.4: 在所有命令入队后，执行一次全局同步 ---
468 |     for (auto &q : acc.big_gs_queue) q.finish(); // Stays for safety, though should be empty
469 |     acc.hbm_manager_queue.finish();
470 |     for (auto &q : acc.little_gs_queue) q.finish();
471 | 
