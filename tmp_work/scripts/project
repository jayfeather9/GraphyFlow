13136 | 12893 |  207 | static void
13137 | 12894 |  208 | cacheline_req_sender(hls::stream<distance_req_pack_t> &distance_req_pack_stream,
13138 | 12895 |  209 |                      hls::stream<cacheline_req_t> &cacheline_req_stream) {
13139 | 12896 |  210 | 
13140 | 12897 |  211 |     cacheline_req_t cache_req;
13141 | 12898 |  212 |     cache_req.end_flag = false;
13142 | 12899 |  213 |     cache_req.idx = 0;
13143 | 12900 |  214 |     cache_req.dst = 0;
13144 | 12901 |  215 |     cacheline_req_stream.write(cache_req);
13145 | 12902 |  216 | 
13146 | 12903 |  217 |     ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cacheline_idx[PE_NUM];
13147 | 12904 |  218 | #pragma HLS ARRAY_PARTITION variable = cacheline_idx complete dim = 0
13148 | 12905 |  219 | 
13149 | 12906 |  220 | LOOP_SEND_CACHE_REQ:
13150 | 12907 |  221 |     while (true) {
13151 | 12908 |  222 | #pragma HLS PIPELINE II = 1
13152 | 12909 |  223 |         distance_req_pack_t req_pack = distance_req_pack_stream.read();
13153 | 12910 |  224 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
13154 | 12911 |  225 | #pragma HLS UNROLL
13155 | 12912 |  226 |             cacheline_idx[pe_idx] =
13156 | 12913 |  227 |                 req_pack.node_ids[pe_idx] >> LOG_DIST_PER_WORD;
13157 | 12914 |  228 |         }
13158 | 12915 |  229 | 
13159 | 12916 |  230 |         {
13160 | 12917 |  231 |         LOOP_SEND_CACHE_REQ_INNER:
13161 | 12918 |  232 |             for (ap_uint<4> i = req_pack.offset; i < PE_NUM; i++) {
13162 | 12919 |  233 | #pragma HLS PIPELINE II = 1 rewind
13163 | 12920 |  234 | #pragma HLS unroll factor = 1
13164 | 12921 |  235 |                 cache_req.idx = cacheline_idx[i];
13165 | 12922 |  236 |                 cache_req.dst = i;
13166 | 12923 |  237 |                 cache_req.end_flag = req_pack.end_flag;
13167 | 12924 |  238 |                 cacheline_req_stream.write(cache_req);
13168 | 12925 |  239 |                 // printf("Sent cacheline req for idx %d to PE %d\n",
13169 | 12926 |  240 |                 // (int)cache_req.idx, (int)cache_req.dst); fflush(NULL);
13170 | 12927 |  241 |             }
13171 | 12928 |  242 |         }
13172 | 12929 |  243 | 
13173 | 12930 |  244 |         if (req_pack.end_flag) {
13174 | 12931 |  245 |             break;
13175 | 12932 |  246 |         }
13176 | 12933 |  247 |     }
13177 | 12934 |  248 |     cache_req.end_flag = true;
13178 | 12935 |  249 |     cacheline_req_stream.write(cache_req);
13179 | 12936 |  250 | }
