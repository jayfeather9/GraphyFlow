17673 |   48 | static void
17674 |   49 | edge_descriptor_loader(const bus_word_t *edge_props_ddr,
17675 |   50 |                        hls::stream<edge_descriptor_batch_t> &edge_stream,
17676 |   51 |                        int32_t num_edges) {
17677 |   52 |     const int bits_per_edge = NODE_ID_BITWIDTH + WEIGHT_BITWIDTH;
17678 |   53 |     const int edges_per_word = AXI_BUS_WIDTH / bits_per_edge;
17679 |   54 |     const int num_wide_reads =
17680 |   55 |         (num_edges + edges_per_word - 1) / edges_per_word;
17681 |   56 | 
17682 |   57 |     int edges_read = 0;
17683 |   58 |     edge_descriptor_batch_t edge_batch;
17684 |   59 | #pragma HLS ARRAY_PARTITION variable = edge_batch.edges complete dim = 0
17685 |   60 |     edge_batch.end_pos = 0;
17686 |   61 | 
17687 |   62 | LOOP_EDL_READ:
17688 |   63 |     for (int i = 0; i < num_wide_reads; i++) {
17689 |   64 | #pragma HLS PIPELINE II = 1
17690 |   65 |         bus_word_t wide_word = edge_props_ddr[i];
17691 |   66 |         // printf("Read a new edge.\n");
17692 |   67 |     LOOP_EDL_UNPACK:
17693 |   68 |         for (int j = 0; j < edges_per_word; j++) {
17694 |   69 | #pragma HLS UNROLL
17695 |   70 |             if (edges_read < num_edges) {
17696 |   71 |                 ap_uint<bits_per_edge> packed_edge = wide_word.range(
17697 |   72 |                     (j + 1) * bits_per_edge - 1, j * bits_per_edge);
17698 |   73 | 
17699 |   74 |                 node_with_prop_t edge;
17700 |   75 |                 edge.node_id = packed_edge.range(NODE_ID_BITWIDTH - 1, 0);
17701 |   76 |                 edge.prop =
17702 |   77 |                     packed_edge.range(bits_per_edge - 1, NODE_ID_BITWIDTH);
17703 |   78 |                 //   printf("[LITTLE]Loaded edge: dst=%d, weight=%f\n",
17704 |   79 |                 //   edge.node_id, (float)*reinterpret_cast<distance_t
17705 |   80 |                 //   *>(&edge.prop)); fflush(NULL);
17706 |   81 | 
17707 |   82 |                 edge_batch.edges[edge_batch.end_pos++] = edge;
17708 |   83 |                 edges_read++;
17709 |   84 | 
17710 |   85 |                 if (edge_batch.end_pos == PE_NUM) {
17711 |   86 |                     edge_stream.write(edge_batch);
17712 |   87 |                     edge_batch.end_pos = 0;
17713 |   88 |                 }
17714 |   89 |             }
17715 |   90 |         }
17716 |   91 |     }
17717 |   92 | 
17718 |   93 |     // Send any remaining partial batch
17719 |   94 |     if (edge_batch.end_pos > 0) {
17720 |   95 |         edge_stream.write(edge_batch);
17721 |   96 |     }
17722 |   97 | }
