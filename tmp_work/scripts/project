 8082 |  7839 | 
 8083 |  7840 | ```cpp
 8084 |  7841 |  1 | #include "host_bellman_ford.h"
 8085 |  7842 |  2 | 
 8086 |  7843 |  3 | bool host_bellman_ford_iteration(const GraphCSR &graph,
 8087 |  7844 |  4 |                                  std::vector<int> &distances) {
 8088 |  7845 |  5 |     bool changed = false;
 8089 |  7846 |  6 | 
 8090 |  7847 |  7 |     // --- USER MODIFIABLE SECTION: Host Computation Logic ---
 8091 |  7848 |  8 |     // For each vertex, relax all outgoing edges
 8092 |  7849 |  9 |     for (int u = 0; u < graph.num_vertices; ++u) {
 8093 |  7850 | 10 |         if (distances[u] != INFINITY_DIST) {
 8094 |  7851 | 11 |             for (int i = graph.offsets[u]; i < graph.offsets[u + 1]; ++i) {
 8095 |  7852 | 12 |                 int v = graph.columns[i];
 8096 |  7853 | 13 |                 int weight = graph.weights[i];
 8097 |  7854 | 14 | 
 8098 |  7855 | 15 |                 // Relaxation step
 8099 |  7856 | 16 |                 if (distances[u] + weight < distances[v]) {
 8100 |  7857 | 17 |                     distances[v] = distances[u] + weight;
 8101 |  7858 | 18 |                     changed = true;
 8102 |  7859 | 19 |                 }
 8103 |  7860 | 20 |             }
 8104 |  7861 | 21 |         }
 8105 |  7862 | 22 |     }
 8106 |  7863 | 23 |     // --- END USER MODIFIABLE SECTION ---
 8107 |  7864 | 24 | 
 8108 |  7865 | 25 |     return changed;
 8109 |  7866 | 26 | }
 8110 |  7867 | ```
