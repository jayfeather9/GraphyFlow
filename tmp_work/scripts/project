 9009 |  8766 | 486 |     }
 9010 |  8767 | 487 |     */
 9011 |  8768 | 488 | 
 9012 |  8769 | 489 |     // Enqueue HBM Manager (for little kernels)
 9013 |  8770 | 490 |     if (!hbm_manager_buffers.empty()) {
