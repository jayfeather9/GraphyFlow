19783 |  350 |     default:
19784 |  351 |         return 0;
19785 |  352 |     }
19786 |  353 | }
19787 |  354 | 
19788 |  355 | static void
19789 |  356 | merge_node_props(hls::stream<bus_word_t> (&cacheline_streams)[PE_NUM],
19790 |  357 |                  hls::stream<edge_descriptor_batch_t> &edge_stream,
19791 |  358 |                  hls::stream<node_id_burst_t> &src_id_burst_stream,
19792 |  359 |                  hls::stream<edge_batch_t> &edge_batch_stream,
19793 |  360 |                  uint32_t edge_num) {
19794 |  361 |     bus_word_t last_cacheline[PE_NUM];
19795 |  362 | #pragma HLS ARRAY_PARTITION variable = last_cacheline complete dim = 0
19796 |  363 |     ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> last_cache_idx[PE_NUM];
19797 |  364 | #pragma HLS ARRAY_PARTITION variable = last_cache_idx complete dim = 0
19798 |  365 | 
19799 |  366 | // Init first cacheline for each PE
19800 |  367 | LOOP_INIT_CACHELINE:
19801 |  368 |     for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
19802 |  369 | #pragma HLS UNROLL
19803 |  370 |         last_cacheline[pe_idx] = cacheline_streams[pe_idx].read();
19804 |  371 |         last_cache_idx[pe_idx] = 0;
19805 |  372 |     }
19806 |  373 | 
19807 |  374 |     const uint32_t scatter_size = (edge_num + PE_NUM - 1) / PE_NUM;
19808 |  375 | // printf("Merging node properties for %d edges (%d scatter batches)\n",
19809 |  376 | // edge_num, scatter_size); fflush(NULL);
19810 |  377 | LOOP_SCATTER_EDGES:
19811 |  378 |     for (int32_t edge_batch_idx = 0; edge_batch_idx < scatter_size;
19812 |  379 |          edge_batch_idx++) {
19813 |  380 | #pragma HLS PIPELINE II = 1
19814 |  381 |         edge_descriptor_batch_t edge_batch;
19815 |  382 | #pragma HLS ARRAY_PARTITION variable = edge_batch.edges complete dim = 0
19816 |  383 |         edge_batch = edge_stream.read();
19817 |  384 |         node_id_burst_t src_id_burst = src_id_burst_stream.read();
19818 |  385 | #pragma HLS ARRAY_PARTITION variable = src_id_burst.data complete dim = 0
19819 |  386 |         edge_batch_t out_batch;
19820 |  387 | #pragma HLS ARRAY_PARTITION variable = out_batch.src_distances complete dim = 0
19821 |  388 | #pragma HLS ARRAY_PARTITION variable = out_batch.weights complete dim = 0
19822 |  389 | #pragma HLS ARRAY_PARTITION variable = out_batch.dsts complete dim = 0
19823 |  390 |         out_batch.end_flag = false;
19824 |  391 |         out_batch.end_pos = edge_batch.end_pos;
19825 |  392 |         bus_word_t cur_last_cacheline;
19826 |  393 |         ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cur_last_cache_idx;
19827 |  394 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
19828 |  395 | #pragma HLS UNROLL
19829 |  396 |             ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cacheline_idx =
19830 |  397 |                 (src_id_burst.data[pe_idx] >> LOG_DIST_PER_WORD);
19831 |  398 |             uint32_t offset = (src_id_burst.data[pe_idx] & (DIST_PER_WORD - 1));
19832 |  399 |             if (pe_idx < edge_batch.end_pos) {
19833 |  400 |                 bus_word_t cacheline;
19834 |  401 |                 if (cacheline_idx == last_cache_idx[pe_idx]) {
19835 |  402 |                     cacheline = last_cacheline[pe_idx];
19836 |  403 |                 } else {
19837 |  404 |                     cacheline = cacheline_streams[pe_idx].read();
19838 |  405 |                 }
19839 |  406 | 
19840 |  407 |                 // ap_fixed_pod_t prop = cacheline.range(
19841 |  408 |                 //     31 + (offset << 5), offset << 5);
19842 |  409 |                 ap_fixed_pod_t prop = get_val_from_512_bus(cacheline, offset);
19843 |  410 | 
19844 |  411 |                 out_batch.src_distances[pe_idx] = prop;
19845 |  412 |                 out_batch.weights[pe_idx] = edge_batch.edges[pe_idx].prop;
19846 |  413 |                 out_batch.dsts[pe_idx] = edge_batch.edges[pe_idx].node_id;
19847 |  414 | 
19848 |  415 |                 if (pe_idx == PE_NUM - 1) {
19849 |  416 |                     cur_last_cacheline = cacheline;
19850 |  417 |                     cur_last_cache_idx = cacheline_idx;
19851 |  418 |                 }
19852 |  419 |             }
19853 |  420 |         }
19854 |  421 |         edge_batch_stream.write(out_batch);
19855 |  422 |         // printf("Sent edge batch with %d entries\n", (int)out_batch.end_pos);
19856 |  423 |         // fflush(NULL);
19857 |  424 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
19858 |  425 | #pragma HLS UNROLL
19859 |  426 |             last_cacheline[pe_idx] = cur_last_cacheline;
19860 |  427 |             last_cache_idx[pe_idx] = cur_last_cache_idx;
19861 |  428 |         }
19862 |  429 |     }
19863 |  430 |     // Send end marker
19864 |  431 |     edge_batch_t end_batch;
19865 |  432 |     end_batch.end_flag = true;
19866 |  433 |     end_batch.end_pos = 0;
19867 |  434 |     edge_batch_stream.write(end_batch);
19868 |  435 | }
19869 |  436 | 
19870 |  437 | ap_fixed_pod_t get_val_from_256_bus(const ap_uint<256> bus, int offset) {
19871 |  438 | #pragma HLS INLINE
19872 |  439 |     switch (offset) {
19873 |  440 |     case 0:
19874 |  441 |         return bus.range(31, 0);
19875 |  442 |     case 1:
19876 |  443 |         return bus.range(63, 32);
19877 |  444 |     case 2:
19878 |  445 |         return bus.range(95, 64);
19879 |  446 |     case 3:
19880 |  447 |         return bus.range(127, 96);
19881 |  448 |     case 4:
19882 |  449 |         return bus.range(159, 128);
19883 |  450 |     case 5:
19884 |  451 |         return bus.range(191, 160);
19885 |  452 |     case 6:
19886 |  453 |         return bus.range(223, 192);
19887 |  454 |     case 7:
19888 |  455 |         return bus.range(255, 224);
19889 |  456 |     default:
19890 |  457 |         return 0;
19891 |  458 |     }
19892 |  459 | }
