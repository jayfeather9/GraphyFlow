 5852 |  5609 | 5519 |  355 | static void
 5853 |  5610 | 5520 |  356 | merge_node_props(hls::stream<bus_word_t> (&cacheline_streams)[PE_NUM],
 5854 |  5611 | 5521 |  357 |                  hls::stream<edge_descriptor_batch_t> &edge_stream,
 5855 |  5612 | 5522 |  358 |                  hls::stream<node_id_burst_t> &src_id_burst_stream,
 5856 |  5613 | 5523 |  359 |                  hls::stream<edge_batch_t> &edge_batch_stream,
 5857 |  5614 | 5524 |  360 |                  uint32_t edge_num) {
 5858 |  5615 | 5525 |  361 |     bus_word_t last_cacheline[PE_NUM];
 5859 |  5616 | 5526 |  362 | #pragma HLS ARRAY_PARTITION variable = last_cacheline complete dim = 0
 5860 |  5617 | 5527 |  363 |     ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> last_cache_idx[PE_NUM];
 5861 |  5618 | 5528 |  364 | #pragma HLS ARRAY_PARTITION variable = last_cache_idx complete dim = 0
 5862 |  5619 | 5529 |  365 | 
 5863 |  5620 | 5530 |  366 | // Init first cacheline for each PE
