17502 | 184 | 
17503 | 185 |             p_graph.offsets[0] = 0;
17504 | 186 |             for (int j = 0; j < p_graph.num_vertices; ++j) {
17505 | 187 |                 p_graph.offsets[j + 1] = p_graph.offsets[j] + out_degree[j];
17506 | 188 |             }
17507 | 189 | 
17508 | 190 |             // --- 4.4: Finalize partition descriptor metadata ---
17509 | 191 |             pd.num_edges = p_graph.num_edges;
17510 | 192 |             pd.num_vertices = p_graph.num_vertices;
17511 | 193 |         }
