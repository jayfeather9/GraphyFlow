393 | void AlgorithmHost::update_data(const PartitionContainer &container) {
394 |     std::cout << "--- [Host] Phase 2.1: Updating host-side data for new iteration ---" << std::endl;
395 | 
396 |     const size_t bytes_per_word = AXI_BUS_WIDTH / 8;
397 | 
398 |     // DISABLED FOR LITTLE KERNEL TESTING
399 |     /*
400 |     for (size_t i = 0; i < big_kernel_buffers.size(); ++i) {
401 |         // ... (BIG KERNEL LOGIC IS COMMENTED OUT)
402 |     }
403 |     */
404 | 
405 |     // ENABLED for LITTLE KERNEL TESTING
406 |     // This loop now only updates the HBM manager's buffer, which is correct for subsequent iterations.
407 |     for (size_t i = 0; i < little_kernel_buffers.size(); ++i) {
408 |         const auto &p_graph = container.DPs[i].partitioned_graph;
409 |         {
410 |             const size_t bytes_per_dist = DISTANCE_BITWIDTH / 8;
411 |             std::vector<char> temp_byte_buffer;
412 |             for (int j = 0; j < p_graph.num_vertices; ++j) {
413 |                 if ((temp_byte_buffer.size() % bytes_per_word) + bytes_per_dist > bytes_per_word) {
414 |                     size_t padding_needed = bytes_per_word - (temp_byte_buffer.size() % bytes_per_word);
415 |                     temp_byte_buffer.insert(temp_byte_buffer.end(), padding_needed, 0);
416 |                 }
417 |                 int global_id = p_graph.vtx_map_rev.at(j);
418 |                 distance_t dist_val = h_distances[global_id];
419 |                 const char *data_ptr = reinterpret_cast<const char *>(&dist_val);
420 |                 temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr, data_ptr + bytes_per_dist);
421 |             }
422 |             hbm_manager_host_buffers[0].packed_node_props.resize(
423 |                 (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word, 0);
424 |             std::memcpy(hbm_manager_host_buffers[0].packed_node_props.data(),
425 |                         temp_byte_buffer.data(), temp_byte_buffer.size());
426 |         }
427 |     }
428 | 
429 |     std::cout << "[SUCCESS] Host-side data updated for new iteration." << std::endl;
430 | }
