17513 | 195 |         pd.kernel_id = i;
17514 | 196 |         if (i < LITTLE_KERNEL_NUM) {
17515 | 197 |             pd.is_dense =
17516 | 198 |                 true; // This is a Dense Partition (DP) for a little kernel
17517 | 199 |             container.DPs.push_back(pd);
17518 | 200 |         } else {
17519 | 201 |             pd.is_dense =
17520 | 202 |                 false; // This is a Sparse Partition (SP) for a big kernel
17521 | 203 |             container.SPs.push_back(pd);
