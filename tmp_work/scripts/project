 7500 |  7257 | 7167 | 124 |         node_distance_burst_t burst;
 7501 |  7258 | 7168 | 125 | 
 7502 |  7259 | 7169 | 126 |         b_node_distance_burst_t b_burst;
 7503 |  7260 | 7170 | 127 |         b_burst.last = false;
 7504 |  7261 | 7171 | 128 |         b_burst.dest = 0;
 7505 |  7262 | 7172 | 129 |         b_burst.data = wide_word.range(255, 0);
 7506 |  7263 | 7173 | 130 |         node_dist_stream.write(b_burst);
 7507 |  7264 | 7174 | 131 | 
 7508 |  7265 | 7175 | 132 |         b_burst.data = wide_word.range(511, 256);
 7509 |  7266 | 7176 | 133 |         node_dist_stream.write(b_burst);
 7510 |  7267 | 7177 | 134 |     }
 7511 |  7268 | 7178 | 135 |     // write last packet
 7512 |  7269 | 7179 | 136 |     b_node_distance_burst_t b_burst;
 7513 |  7270 | 7180 | 137 |     b_burst.last = true;
 7514 |  7271 | 7181 | 138 |     b_burst.dest = 0;
 7515 |  7272 | 7182 | 139 |     b_burst.data = 0;
 7516 |  7273 | 7183 | 140 |     node_dist_stream.write(b_burst);
 7517 |  7274 | 7184 | 141 |     // printf("Finished loading node distances.\n"); fflush(NULL);
 7518 |  7275 | 7185 | 142 | }
 7519 |  7276 | 7186 | 143 | 
 7520 |  7277 | 7187 | 144 | extern "C" void
