 783 |         o_0.write(out_batch_o_0);
 784 |         out_batch_o_1.end_flag = end_flag;
 785 |         out_batch_o_1.end_pos = end_pos;
 786 |         o_1.write(out_batch_o_1);
 787 |         out_batch_o_2.end_flag = end_flag;
 788 |         out_batch_o_2.end_pos = end_pos;
 789 |         o_2.write(out_batch_o_2);
 790 |         if (end_flag) {
