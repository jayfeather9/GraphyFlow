  575 |   332 |  242 | ```cpp
  576 |   333 |  243 |  1 | #include "host_bellman_ford.h"
  577 |   334 |  244 |  2 | 
  578 |   335 |  245 |  3 | bool host_bellman_ford_iteration(const GraphCSR &graph,
  579 |   336 |  246 |  4 |                                  std::vector<int> &distances) {
  580 |   337 |  247 |  5 |     bool changed = false;
  581 |   338 |  248 |  6 | 
  582 |   339 |  249 |  7 |     // --- USER MODIFIABLE SECTION: Host Computation Logic ---
  583 |   340 |  250 |  8 |     // For each vertex, relax all outgoing edges
  584 |   341 |  251 |  9 |     for (int u = 0; u < graph.num_vertices; ++u) {
  585 |   342 |  252 | 10 |         if (distances[u] != INFINITY_DIST) {
  586 |   343 |  253 | 11 |             for (int i = graph.offsets[u]; i < graph.offsets[u + 1]; ++i) {
  587 |   344 |  254 | 12 |                 int v = graph.columns[i];
  588 |   345 |  255 | 13 |                 int weight = graph.weights[i];
  589 |   346 |  256 | 14 | 
  590 |   347 |  257 | 15 |                 // Relaxation step
  591 |   348 |  258 | 16 |                 if (distances[u] + weight < distances[v]) {
  592 |   349 |  259 | 17 |                     distances[v] = distances[u] + weight;
  593 |   350 |  260 | 18 |                     changed = true;
  594 |   351 |  261 | 19 |                 }
  595 |   352 |  262 | 20 |             }
  596 |   353 |  263 | 21 |         }
  597 |   354 |  264 | 22 |     }
  598 |   355 |  265 | 23 |     // --- END USER MODIFIABLE SECTION ---
  599 |   356 |  266 | 24 | 
  600 |   357 |  267 | 25 |     return changed;
  601 |   358 |  268 | 26 | }
  602 |   359 |  269 | ```
