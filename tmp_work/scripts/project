19722 |  289 | static void
19723 |  290 | node_prop_resp_receiver(hls::stream<cacheline_resp_t> &cacheline_resp_stream,
19724 |  291 |                         hls::stream<bus_word_t> (&cacheline_streams)[PE_NUM]) {
19725 |  292 | 
19726 |  293 |     cacheline_resp_t cache_resp = cacheline_resp_stream.read();
