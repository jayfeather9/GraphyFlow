10120 |  9877 |  81 |                 dst_vertices_per_partition[i].insert(vertex_id);
10121 |  9878 |  82 |                 dst_vertex_to_partition_map[vertex_id] = i;
10122 |  9879 |  83 |                 current_dst_idx++;
