15362 | ```cpp
15363 |  1 | #include "host_bellman_ford.h"
15364 |  2 | 
15365 |  3 | bool host_bellman_ford_iteration(const GraphCSR &graph,
15366 |  4 |                                  std::vector<int> &distances) {
15367 |  5 |     bool changed = false;
15368 |  6 | 
15369 |  7 |     // --- USER MODIFIABLE SECTION: Host Computation Logic ---
15370 |  8 |     // For each vertex, relax all outgoing edges
15371 |  9 |     for (int u = 0; u < graph.num_vertices; ++u) {
15372 | 10 |         if (distances[u] != INFINITY_DIST) {
15373 | 11 |             for (int i = graph.offsets[u]; i < graph.offsets[u + 1]; ++i) {
15374 | 12 |                 int v = graph.columns[i];
15375 | 13 |                 int weight = graph.weights[i];
15376 | 14 | 
15377 | 15 |                 // Relaxation step
15378 | 16 |                 if (distances[u] + weight < distances[v]) {
15379 | 17 |                     distances[v] = distances[u] + weight;
15380 | 18 |                     changed = true;
15381 | 19 |                 }
15382 | 20 |             }
15383 | 21 |         }
15384 | 22 |     }
15385 | 23 |     // --- END USER MODIFIABLE SECTION ---
15386 | 24 | 
15387 | 25 |     return changed;
15388 | 26 | }
15389 | ```
