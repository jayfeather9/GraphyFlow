10198 |  9955 | 159 | 
10199 |  9956 | 160 |             // --- 4.2: Rewrite edges with local, compressed IDs ---
10200 |  9957 | 161 |             std::vector<Edge> local_edges;
10201 |  9958 | 162 |             local_edges.reserve(p_graph.num_edges);
10202 |  9959 | 163 |             for (const auto &global_edge : partition_edges) {
10203 |  9960 | 164 |                 local_edges.push_back({p_graph.vtx_map[global_edge.src],
10204 |  9961 | 165 |                                        p_graph.vtx_map[global_edge.dest],
10205 |  9962 | 166 |                                        global_edge.weight});
10206 |  9963 | 167 |             }
10207 |  9964 | 168 | 
