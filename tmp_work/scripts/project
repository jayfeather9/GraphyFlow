 5646 |  5403 | 5313 |  149 |         ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cache_idx[PE_NUM];
 5647 |  5404 | 5314 |  150 | #pragma HLS ARRAY_PARTITION variable = cache_idx complete dim = 0
 5648 |  5405 | 5315 |  151 |         node_id_burst_t node_id_burst = src_id_burst_stream.read();
 5649 |  5406 | 5316 |  152 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
 5650 |  5407 | 5317 |  153 | #pragma HLS UNROLL
 5651 |  5408 | 5318 |  154 |             cache_idx[pe_idx] = node_id_burst.data[pe_idx] >> LOG_DIST_PER_WORD;
 5652 |  5409 | 5319 |  155 |             // printf("PE %d requests node ID %d (cache idx %d)\n", pe_idx,
 5653 |  5410 | 5320 |  156 |             // (int)node_id_burst.data[pe_idx], (int)cache_idx[pe_idx]);
 5654 |  5411 | 5321 |  157 |             // fflush(NULL);
 5655 |  5412 | 5322 |  158 |         }
 5656 |  5413 | 5323 |  159 | 
 5657 |  5414 | 5324 |  160 |         ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cache_idx_diffs[PE_NUM];
 5658 |  5415 | 5325 |  161 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
 5659 |  5416 | 5326 |  162 | #pragma HLS UNROLL
 5660 |  5417 | 5327 |  163 |             cache_idx_diffs[pe_idx] = cache_idx[pe_idx] - last_idx_max;
 5661 |  5418 | 5328 |  164 |             // printf("PE %d cache idx diff: %d\n", pe_idx,
 5662 |  5419 | 5329 |  165 |             // (int)cache_idx_diffs[pe_idx]); fflush(NULL);
 5663 |  5420 | 5330 |  166 |         }
 5664 |  5421 | 5331 |  167 | 
 5665 |  5422 | 5332 |  168 |         // if not all diffs are zero, send a req_pack
 5666 |  5423 | 5333 |  169 |         if (cache_idx_diffs[PE_NUM - 1]) {
 5667 |  5424 | 5334 |  170 |             ap_uint<PE_NUM> valid_mask;
 5668 |  5425 | 5335 |  171 |             for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
 5669 |  5426 | 5336 |  172 | #pragma HLS UNROLL
 5670 |  5427 | 5337 |  173 |                 if (cache_idx_diffs[pe_idx] == 0) {
 5671 |  5428 | 5338 |  174 |                     valid_mask[pe_idx] = 1;
 5672 |  5429 | 5339 |  175 |                 } else {
 5673 |  5430 | 5340 |  176 |                     valid_mask[pe_idx] = 0;
 5674 |  5431 | 5341 |  177 |                 }
 5675 |  5432 | 5342 |  178 |             }
 5676 |  5433 | 5343 |  179 | 
 5677 |  5434 | 5344 |  180 |             ap_uint<4> num_unread = count_end_ones(valid_mask);
 5678 |  5435 | 5345 |  181 |             // printf("Packing req for %d unread PEs\n", (int)num_unread);
 5679 |  5436 | 5346 |  182 |             // fflush(NULL);
 5680 |  5437 | 5347 |  183 | 
 5681 |  5438 | 5348 |  184 |             distance_req_pack_t req_pack;
 5682 |  5439 | 5349 |  185 |             req_pack.offset = num_unread;
 5683 |  5440 | 5350 |  186 |             req_pack.end_flag = false;
 5684 |  5441 | 5351 |  187 | 
 5685 |  5442 | 5352 |  188 |             for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
 5686 |  5443 | 5353 |  189 | #pragma HLS UNROLL
