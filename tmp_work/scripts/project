10685 | 10442 |  339 |             cache_idx_diffs[pe_idx] = cache_idx[pe_idx] - last_idx_max;
10686 | 10443 |  340 |             // printf("PE %d cache idx diff: %d\n", pe_idx,
10687 | 10444 |  341 |             // (int)cache_idx_diffs[pe_idx]); fflush(NULL);
10688 | 10445 |  342 |         }
10689 | 10446 |  343 | 
