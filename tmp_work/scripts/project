 5995 |  5752 | 5662 |  498 | // --- REWRITTEN: New final_writeback function packs results into 512-bit words.
 5996 |  5753 | 5663 |  499 | static void final_writeback(hls::stream<internal_end_data_batch_t> &in_stream,
 5997 |  5754 | 5664 |  500 |                             bus_word_t *out_ddr) {
 5998 |  5755 | 5665 |  501 |     const int bits_per_output =
 5999 |  5756 | 5666 |  502 |         NODE_ID_BITWIDTH + DISTANCE_BITWIDTH + OUT_END_MARKER_BITWIDTH;
 6000 |  5757 | 5667 |  503 |     const int outputs_per_word = AXI_BUS_WIDTH / bits_per_output;
 6001 |  5758 | 5668 |  504 | 
 6002 |  5759 | 5669 |  505 |     bus_word_t write_word = 0;
 6003 |  5760 | 5670 |  506 |     int pack_count = 0;
