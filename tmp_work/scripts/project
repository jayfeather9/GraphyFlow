20312 |  879 | inline ap_fixed_pod_t get_raw_val(reduce_word_t word, int idx) {
20313 |  880 | #pragma HLS INLINE
20314 |  881 |     ap_uint<DISTANCE_BITWIDTH> bits;
20315 |  882 |     switch (idx) {
20316 |  883 |     case 0:
20317 |  884 |         bits = word.range(DISTANCE_BITWIDTH - 1, 0);
20318 |  885 |         break;
20319 |  886 |     case 1:
20320 |  887 |         bits = word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH);
20321 |  888 |         break;
20322 |  889 |     case 2:
20323 |  890 |         bits =
20324 |  891 |             word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1));
20325 |  892 |         break;
20326 |  893 |     default:
20327 |  894 |         bits = 0;
20328 |  895 |         break;
20329 |  896 |     }
20330 |  897 |     return bits;
20331 |  898 | }
20332 |  899 | 
20333 |  900 | inline distance_t get_val(reduce_word_t word, int idx) {
20334 |  901 | #pragma HLS INLINE
20335 |  902 |     ap_fixed_pod_t raw_val = get_raw_val(word, idx);
20336 |  903 |     distance_t val = *reinterpret_cast<distance_t *>(&raw_val);
20337 |  904 |     return val;
20338 |  905 | }
20339 |  906 | 
20340 |  907 | inline void set_val(reduce_word_t &word, int idx, distance_t val) {
20341 |  908 | #pragma HLS INLINE
20342 |  909 |     ap_uint<DISTANCE_BITWIDTH> val_bits =
20343 |  910 |         *reinterpret_cast<ap_uint<DISTANCE_BITWIDTH> *>(&val);
20344 |  911 |     switch (idx) {
20345 |  912 |     case 0:
20346 |  913 |         word.range(DISTANCE_BITWIDTH - 1, 0) = val_bits;
20347 |  914 |         break;
20348 |  915 |     case 1:
20349 |  916 |         word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH) = val_bits;
20350 |  917 |         break;
20351 |  918 |     case 2:
20352 |  919 |         word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1)) =
20353 |  920 |             val_bits;
20354 |  921 |         break;
20355 |  922 |     default:
20356 |  923 |         break;
20357 |  924 |     }
20358 |  925 | }
