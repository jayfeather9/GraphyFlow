19931 |  498 | // --- REWRITTEN: New final_writeback function packs results into 512-bit words.
19932 |  499 | static void final_writeback(hls::stream<internal_end_data_batch_t> &in_stream,
19933 |  500 |                             bus_word_t *out_ddr) {
19934 |  501 |     const int bits_per_output =
19935 |  502 |         NODE_ID_BITWIDTH + DISTANCE_BITWIDTH + OUT_END_MARKER_BITWIDTH;
19936 |  503 |     const int outputs_per_word = AXI_BUS_WIDTH / bits_per_output;
19937 |  504 | 
19938 |  505 |     bus_word_t write_word = 0;
19939 |  506 |     int pack_count = 0;
19940 |  507 |     int ddr_addr = 0;
19941 |  508 | 
19942 |  509 | LOOP_WRITEBACK_MAIN:
19943 |  510 |     while (true) {
19944 |  511 | #pragma HLS PIPELINE II = 1
19945 |  512 |         internal_end_data_batch_t in_batch;
19946 |  513 |         if (in_stream.read_nb(in_batch)) {
19947 |  514 | 
19948 |  515 |         LOOP_WRITEBACK_PACK:
19949 |  516 |             for (int i = 0; i < in_batch.end_pos; i++) {
19950 |  517 | #pragma HLS UNROLL
19951 |  518 |                 node_with_prop_t item = in_batch.data[i];
19952 |  519 |                 ap_uint<bits_per_output> packed_output;
19953 |  520 |                 packed_output.range(NODE_ID_BITWIDTH - 1, 0) = item.node_id;
19954 |  521 |                 packed_output.range(NODE_ID_BITWIDTH + DISTANCE_BITWIDTH - 1,
19955 |  522 |                                     NODE_ID_BITWIDTH) = item.prop;
19956 |  523 |                 out_end_marker_t end_marker =
19957 |  524 |                     0; // No end marker for regular entries
19958 |  525 |                 packed_output.range(bits_per_output - 1,
19959 |  526 |                                     NODE_ID_BITWIDTH + DISTANCE_BITWIDTH) =
19960 |  527 |                     end_marker;
19961 |  528 |                 // distance_t tmp_dist =
19962 |  529 |                 //     packed_output.range(NODE_ID_BITWIDTH + DISTANCE_BITWIDTH
19963 |  530 |                 //     - 1, NODE_ID_BITWIDTH);
19964 |  531 |                 // printf("[BIG]Packing output: node_id=%d, distance=%f\n",
19965 |  532 |                 // (int)packed_output.range(NODE_ID_BITWIDTH - 1, 0),
19966 |  533 |                 // (float)tmp_dist); fflush(NULL);
19967 |  534 | 
19968 |  535 |                 int start_bit = pack_count * bits_per_output;
19969 |  536 |                 write_word.range(start_bit + bits_per_output - 1, start_bit) =
19970 |  537 |                     packed_output;
19971 |  538 | 
19972 |  539 |                 pack_count++;
19973 |  540 |                 if (pack_count == outputs_per_word) {
19974 |  541 |                     // printf("[BIG] Writing packed word to DDR at address
19975 |  542 |                     // %d\n", ddr_addr); fflush(NULL);
19976 |  543 |                     out_ddr[ddr_addr++] = write_word;
19977 |  544 |                     write_word = 0;
19978 |  545 |                     pack_count = 0;
19979 |  546 |                 }
19980 |  547 |             }
19981 |  548 | 
19982 |  549 |             if (in_batch.end_flag) {
19983 |  550 |                 break;
19984 |  551 |             }
19985 |  552 |         }
19986 |  553 |     }
19987 |  554 | 
19988 |  555 |     // if pack_count is 0, write a final end marker word
19989 |  556 |     // else, put the end marker in the current write_word and write it
19990 |  557 |     ap_uint<bits_per_output> end_marker;
19991 |  558 |     end_marker.range(NODE_ID_BITWIDTH - 1, 0) = 0;
19992 |  559 |     end_marker.range(NODE_ID_BITWIDTH + DISTANCE_BITWIDTH - 1,
19993 |  560 |                      NODE_ID_BITWIDTH) = 0; // Distance = 0
19994 |  561 |     end_marker.range(bits_per_output - 1,
19995 |  562 |                      NODE_ID_BITWIDTH + DISTANCE_BITWIDTH) =
19996 |  563 |         (out_end_marker_t)1; // End marker = 1
19997 |  564 |     if (pack_count == 0) {
19998 |  565 |         bus_word_t end_word = 0;
19999 |  566 |         end_word.range(bits_per_output - 1, 0) = end_marker;
20000 |  567 |         out_ddr[ddr_addr++] = end_word;
20001 |  568 |     } else {
20002 |  569 |         int start_bit = pack_count * bits_per_output;
20003 |  570 |         write_word.range(start_bit + bits_per_output - 1, start_bit) =
20004 |  571 |             end_marker;
20005 |  572 |         out_ddr[ddr_addr++] = write_word;
20006 |  573 |     }
20007 |  574 | }
20008 |  575 | 
