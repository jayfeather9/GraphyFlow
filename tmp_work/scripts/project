20360 |  927 | static void Reduc_105_unit_reduce(
20361 |  928 |     hls::stream<net_wrapper_kt_pair_105_t_t> (&kt_wrap_item)[PE_NUM],
20362 |  929 |     hls::stream<internal_end_data_batch_t> &o_0, int32_t dst_num) {
20363 |  930 |     // --- Phase 1: Memory Declaration ---
20364 |  931 | 
20365 |  932 |     // URAM for packed distance data (3 distances per 72-bit word)
20366 |  933 |     const int MEM_SIZE = (MAX_NUM >> LOG_PE_NUM) / DISTANCES_PER_REDUCE_WORD;
20367 |  934 |     reduce_word_t prop_mem[PE_NUM][MEM_SIZE];
20368 |  935 | #pragma HLS BIND_STORAGE variable = prop_mem type = RAM_2P impl = URAM
20369 |  936 | #pragma HLS ARRAY_PARTITION variable = prop_mem complete dim = 1
20370 |  937 | #pragma HLS dependence variable = prop_mem inter false direction = WAW
20371 |  938 | #pragma HLS dependence variable = prop_mem inter false direction = RAW
20372 |  939 | 
20373 |  940 |     // BRAM for individual validity flags (fast access)
20374 |  941 |     bool prop_valid[PE_NUM][MAX_NUM >> LOG_PE_NUM];
20375 |  942 | #pragma HLS BIND_STORAGE variable = prop_valid type = RAM_2P impl = BRAM
20376 |  943 | #pragma HLS ARRAY_PARTITION variable = prop_valid complete dim = 1
20377 |  944 | #pragma HLS dependence variable = prop_valid inter false direction = WAW
20378 |  945 | #pragma HLS dependence variable = prop_valid inter false direction = RAW
20379 |  946 | 
20380 |  947 |     // BRAM for pre-calculated address mapping (avoids division/modulo)
20381 |  948 |     // 16 bits: 14 for word_addr, 2 for pack_idx
20382 |  949 |     typedef ap_uint<16> addr_map_t;
20383 |  950 |     addr_map_t key_to_addr_map[PE_NUM][MAX_NUM >> LOG_PE_NUM];
20384 |  951 | #pragma HLS BIND_STORAGE variable = key_to_addr_map type = RAM_1P impl = BRAM
20385 |  952 | #pragma HLS ARRAY_PARTITION variable = key_to_addr_map complete dim = 1
20386 |  953 | 
20387 |  954 |     // Latency-hiding cache for recently accessed URAM words
20388 |  955 |     reduce_word_t cache_data_buffer[PE_NUM][L + 1];
20389 |  956 | #pragma HLS ARRAY_PARTITION variable = cache_data_buffer complete dim = 0
20390 |  957 |     reduce_word_t tmp_cache_data_buffer[PE_NUM][L];
20391 |  958 | #pragma HLS ARRAY_PARTITION variable = tmp_cache_data_buffer complete dim = 0
20392 |  959 |     int cache_addr_buffer[PE_NUM][L + 1];
20393 |  960 | #pragma HLS ARRAY_PARTITION variable = cache_addr_buffer complete dim = 0
20394 |  961 |     int tmp_cache_addr_buffer[PE_NUM][L];
20395 |  962 | #pragma HLS ARRAY_PARTITION variable = tmp_cache_addr_buffer complete dim = 0
20396 |  963 | 
20397 |  964 | // --- Phase 2: Initialization ---
20398 |  965 | LOOP_INIT_VALID:
20399 |  966 |     for (int i = 0; i < (MAX_NUM >> LOG_PE_NUM); i++) {
20400 |  967 | #pragma HLS PIPELINE II = 1
20401 |  968 |         // Populate the address map
20402 |  969 |         addr_map_t map_val;
20403 |  970 |         map_val.range(15, 2) = i / DISTANCES_PER_REDUCE_WORD; // word_addr
20404 |  971 |         map_val.range(1, 0) = i % DISTANCES_PER_REDUCE_WORD;  // pack_idx
20405 |  972 |         for (int pe = 0; pe < PE_NUM; pe++) {
20406 |  973 | #pragma HLS UNROLL
20407 |  974 |             key_to_addr_map[pe][i] = map_val;
20408 |  975 |         }
20409 |  976 |         // Initialize valid flags
20410 |  977 |         for (int pe = 0; pe < PE_NUM; pe++) {
20411 |  978 | #pragma HLS UNROLL
20412 |  979 |             prop_valid[pe][i] = false;
20413 |  980 |         }
20414 |  981 |     }
20415 |  982 | LOOP_INIT_CACHE_ADDR:
20416 |  983 |     for (int i = 0; i < L + 1; i++) {
20417 |  984 |         for (int pe = 0; pe < PE_NUM; pe++) {
20418 |  985 | #pragma HLS UNROLL
20419 |  986 |             cache_addr_buffer[pe][i] = -1; // Invalidate cache
20420 |  987 |         }
20421 |  988 |     }
20422 |  989 | 
20423 |  990 |     // --- Phase 3: Aggregation Loop ---
20424 |  991 |     bool all_end_flags[PE_NUM];
20425 |  992 | #pragma HLS ARRAY_PARTITION variable = all_end_flags complete dim = 0
20426 |  993 |     for (int i = 0; i < PE_NUM; i++) {
20427 |  994 | #pragma HLS UNROLL
20428 |  995 |         all_end_flags[i] = false;
20429 |  996 |     }
20430 |  997 | 
20431 |  998 | LOOP_AGGREGATE:
20432 |  999 |     while (true) {
20433 | 1000 | #pragma HLS PIPELINE II = 1
20434 | 1001 |         for (int pe = 0; pe < PE_NUM; pe++) {
20435 | 1002 | #pragma HLS UNROLL
20436 | 1003 |             net_wrapper_kt_pair_105_t_t kt_elem;
20437 | 1004 |             if (!all_end_flags[pe] && kt_wrap_item[pe].read_nb(kt_elem)) {
20438 | 1005 |                 if (kt_elem.end_flag) {
20439 | 1006 |                     all_end_flags[pe] = true;
20440 | 1007 |                 } else {
20441 | 1008 |                     int key = kt_elem.data.key >> LOG_PE_NUM;
20442 | 1009 |                     ap_fixed_pod_t incoming_dist_pod =
20443 | 1010 |                         kt_elem.data.transform.prop;
20444 | 1011 | 
20445 | 1012 |                     addr_map_t map_val = key_to_addr_map[pe][key];
20446 | 1013 |                     int word_addr = map_val.range(15, 2);
20447 | 1014 |                     int pack_idx = map_val.range(1, 0);
20448 | 1015 | 
20449 | 1016 |                     reduce_word_t current_word = prop_mem[pe][word_addr];
20450 | 1017 | 
20451 | 1018 |                     // Check cache first
20452 | 1019 |                     for (int i = L; i >= 0; --i) {
20453 | 1020 | #pragma HLS UNROLL
20454 | 1021 |                         if (cache_addr_buffer[pe][i] == word_addr) {
20455 | 1022 |                             current_word = cache_data_buffer[pe][i];
20456 | 1023 |                             break;
20457 | 1024 |                         }
20458 | 1025 |                     }
20459 | 1026 | 
20460 | 1027 |                     bool is_valid = prop_valid[pe][key];
20461 | 1028 | 
20462 | 1029 |                     for (int i = 0; i < L; i++) {
20463 | 1030 | #pragma HLS UNROLL
20464 | 1031 |                         tmp_cache_addr_buffer[pe][i] =
20465 | 1032 |                             cache_addr_buffer[pe][i + 1];
20466 | 1033 |                         tmp_cache_data_buffer[pe][i] =
20467 | 1034 |                             cache_data_buffer[pe][i + 1];
20468 | 1035 |                     }
20469 | 1036 | 
20470 | 1037 |                     for (int i = 0; i < L; i++) {
20471 | 1038 | #pragma HLS UNROLL
20472 | 1039 |                         cache_addr_buffer[pe][i] = tmp_cache_addr_buffer[pe][i];
20473 | 1040 |                         cache_data_buffer[pe][i] = tmp_cache_data_buffer[pe][i];
20474 | 1041 |                     }
20475 | 1042 | 
20476 | 1043 |                     distance_t new_dist_fp;
20477 | 1044 |                     distance_t incoming_dist_fp =
20478 | 1045 |                         *reinterpret_cast<distance_t *>(&incoming_dist_pod);
20479 | 1046 | 
20480 | 1047 |                     // printf("[BIG] PE %d processing key %d (word_addr %d,
20481 | 1048 |                     // pack_idx %d) with incoming_dist %f\n", pe, key,
20482 | 1049 |                     // word_addr, pack_idx, (float)incoming_dist_fp);
20483 | 1050 |                     // fflush(NULL);
20484 | 1051 | 
20485 | 1052 |                     if (is_valid) {
20486 | 1053 |                         distance_t old_dist_fp =
20487 | 1054 |                             get_val(current_word, pack_idx);
20488 | 1055 |                         // printf("[BIG]  Old distance: %f\n",
20489 | 1056 |                         // (float)old_dist_fp);
20490 | 1057 |                         new_dist_fp = (old_dist_fp < incoming_dist_fp)
20491 | 1058 |                                           ? old_dist_fp
20492 | 1059 |                                           : incoming_dist_fp;
20493 | 1060 |                     } else {
20494 | 1061 |                         new_dist_fp = incoming_dist_fp;
20495 | 1062 |                     }
20496 | 1063 | 
20497 | 1064 |                     prop_valid[pe][key] = true;
20498 | 1065 | 
20499 | 1066 |                     ap_fixed_pod_t new_dist_pod =
20500 | 1067 |                         *reinterpret_cast<ap_fixed_pod_t *>(&new_dist_fp);
20501 | 1068 |                     // current_word.range(end_bit, start_bit) = new_dist_pod;
20502 | 1069 |                     set_val(current_word, pack_idx, new_dist_fp);
20503 | 1070 | 
20504 | 1071 |                     // Write back to URAM and update cache
20505 | 1072 |                     prop_mem[pe][word_addr] = current_word;
20506 | 1073 |                     cache_addr_buffer[pe][L] = word_addr;
20507 | 1074 |                     cache_data_buffer[pe][L] = current_word;
20508 | 1075 |                 }
20509 | 1076 |             }
20510 | 1077 |         }
20511 | 1078 |         bool end_flag = true;
20512 | 1079 |         for (int i = 0; i < PE_NUM; i++) {
20513 | 1080 | #pragma HLS UNROLL
20514 | 1081 |             end_flag = (end_flag & all_end_flags[i]);
20515 | 1082 |         }
20516 | 1083 |         if (end_flag) {
20517 | 1084 |             break;
20518 | 1085 |         }
20519 | 1086 |     }
20520 | 1087 | 
20521 | 1088 |     // --- Phase 4: High-Performance Drain Loop ---
20522 | 1089 |     internal_end_data_batch_t data_pack;
20523 | 1090 | #pragma HLS ARRAY_PARTITION variable = data_pack.data complete dim = 0
20524 | 1091 |     data_pack.end_flag = 0;
20525 | 1092 | 
20526 | 1093 |     const int32_t num_keys_per_pe = (dst_num + PE_NUM - 1) >> LOG_PE_NUM;
20527 | 1094 |     int real_addr = 0;
20528 | 1095 | 
20529 | 1096 | LOOP_DRAIN_ADDR:
20530 | 1097 |     const int32_t mem_real_size =
20531 | 1098 |         (dst_num + DISTANCES_PER_REDUCE_WORD - 1) / DISTANCES_PER_REDUCE_WORD;
20532 | 1099 |     for (int addr = 0; addr < mem_real_size; addr++) {
20533 | 1100 |         reduce_word_t words[PE_NUM];
