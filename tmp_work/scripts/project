 474 |     struct_ibu_14_t in_batch_i_global_data_0;
 475 |     struct_nbu_11_t in_batch_i_global_data_1;
 476 |     struct_abu_9_t in_batch_i_global_data_2;
 477 |     struct_abu_9_t in_batch_i_global_data_3;
 478 |     struct_ibu_14_t out_batch_intermediate_key;
 479 |     internal_end_data_batch_t out_batch_intermediate_transform;
 480 |     bool end_flag;
 481 | LOOP_WHILE_81:
 482 |     while (true) {
 483 | #pragma HLS PIPELINE
 484 |         in_batch_i_global_data_0 = i_global_data_0.read();
 485 |         in_batch_i_global_data_1 = i_global_data_1.read();
 486 |         in_batch_i_global_data_2 = i_global_data_2.read();
 487 |         in_batch_i_global_data_3 = i_global_data_3.read();
 488 |     LOOP_FOR_80:
 489 |         for (uint32_t i = 0; i < PE_NUM; i++) {
 490 | #pragma HLS UNROLL
 491 |             int32_t key_out_elem;
 492 |             node_with_prop_t transform_out_elem;
 493 |             // -- Inline sub graph --
 494 |             // Inlining fused_op_155
 495 |             // -- Begin Nested Inline for FusedOp fused_op_155 --
 496 |             // Inlining Place_151
 497 |             key_out_elem = in_batch_i_global_data_0.data[i];
 498 |             // -- End Nested Inline for FusedOp fused_op_155 --
 499 |             // -- Inline sub graph end --
 500 |             // -- Inline sub graph --
 501 |             // Inlining fused_op_185
 502 |             // -- Begin Nested Inline for FusedOp fused_op_185 --
 503 |             // Inlining BinOp_68
 504 |             ap_fixed_pod_t fused_temp_BinOp_68_o_0;
 505 |             distance_t lhs_68 = *reinterpret_cast<distance_t *>(
 506 |                 &in_batch_i_global_data_2.data[i]);
 507 |             distance_t rhs_68 = *reinterpret_cast<distance_t *>(
 508 |                 &in_batch_i_global_data_3.data[i]);
 509 |             distance_t temp_BinOp_68_o_0_ap_result;
 510 |             temp_BinOp_68_o_0_ap_result = (lhs_68 + rhs_68);
 511 |             fused_temp_BinOp_68_o_0 = *reinterpret_cast<ap_fixed_pod_t *>(
 512 |                 &temp_BinOp_68_o_0_ap_result);
 513 |             // Inlining Gathe_179
 514 |             transform_out_elem.prop = fused_temp_BinOp_68_o_0;
 515 |             transform_out_elem.node_id = in_batch_i_global_data_1.data[i];
 516 |             // -- End Nested Inline for FusedOp fused_op_185 --
 517 |             // -- Inline sub graph end --
 518 |             out_batch_intermediate_key.data[i] = key_out_elem;
 519 |             out_batch_intermediate_transform.data[i] = transform_out_elem;
 520 |         }
 521 |         out_batch_intermediate_key.end_flag = in_batch_i_global_data_0.end_flag;
 522 |         out_batch_intermediate_key.end_pos = in_batch_i_global_data_0.end_pos;
 523 |         out_batch_intermediate_transform.end_flag =
 524 |             in_batch_i_global_data_0.end_flag;
 525 |         out_batch_intermediate_transform.end_pos =
 526 |             in_batch_i_global_data_0.end_pos;
 527 |         intermediate_key.write(out_batch_intermediate_key);
 528 |         intermediate_transform.write(out_batch_intermediate_transform);
 529 |         end_flag = in_batch_i_global_data_0.end_flag;
 530 |         if (end_flag) {
 531 |             break;
 532 |         }
 533 |     }
