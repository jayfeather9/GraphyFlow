 6338 |  6095 | 6005 |  841 |             // -- End Nested Inline for FusedOp fused_op_155 --
 6339 |  6096 | 6006 |  842 |             // -- Inline sub graph end --
 6340 |  6097 | 6007 |  843 |             // -- Inline sub graph --
 6341 |  6098 | 6008 |  844 |             // Inlining fused_op_185
 6342 |  6099 | 6009 |  845 |             // -- Begin Nested Inline for FusedOp fused_op_185 --
 6343 |  6100 | 6010 |  846 |             // Inlining BinOp_68
 6344 |  6101 | 6011 |  847 |             ap_fixed_pod_t fused_temp_BinOp_68_o_0;
 6345 |  6102 | 6012 |  848 |             distance_t lhs_68 = *reinterpret_cast<distance_t *>(
 6346 |  6103 | 6013 |  849 |                 &in_batch_i_global_data_2.data[i]);
 6347 |  6104 | 6014 |  850 |             distance_t rhs_68 = *reinterpret_cast<distance_t *>(
