17783 |  158 | // 新增函数，但是数据格式和我们用的不一样
17784 |  159 | void accScatter(
17785 |  160 |     hls::stream<ppb_request_dt>     &ppb_request_stm,
17786 |  161 |     hls::stream<ppb_response_dt>    &ppb_response_stm,
17787 |  162 |     hls::stream<node_id_burst_t> stream_src_ids_1
17788 |  163 |     //hls::stream<edge_burst_dt>      &edge_burst_stm,
17789 |  164 |     //hls::stream<update_set_dt>      &update_set_stm,
17790 |  165 |     //ap_uint<32>                     part_edge_num
17791 |  166 |     )
17792 |  167 | {
17793 |  168 |     //下面的数据结构与我们的不匹配！
17794 |  169 |     ap_uint<512> src_prop_buffer[SCATTER_PE_NUM][2][SRC_BUFFER_SIZE >> 4];
17795 |  170 | #pragma HLS ARRAY_PARTITION variable=src_prop_buffer dim=1 complete
17796 |  171 | #pragma HLS BIND_STORAGE variable=src_prop_buffer type = RAM_S2P impl = BRAM
17797 |  172 | #pragma HLS dependence variable=src_prop_buffer inter false    
17798 |  173 | 
17799 |  174 |     ap_uint<32> pp_read_idx = 0;
17800 |  175 |     ap_uint<32> pp_write_idx = 0;
17801 |  176 | 
17802 |  177 |     ap_uint<32> pp_reponse_idx = 0;
17803 |  178 | 
17804 |  179 |     ap_uint<32> pp_read_round = 0;
17805 |  180 |     ap_uint<32> pp_write_round = 0;
17806 |  181 | 
17807 |  182 |     ap_uint<32> pp_request_round = 0;
17808 |  183 | 
17809 |  184 |     ap_uint<32> edge_set_cnt = 0;
17810 |  185 |     
17811 |  186 |     bool wait_flag = 0;
17812 |  187 | 
17813 |  188 |     edge_burst_dt an_edge_burst;
17814 |  189 |     
17815 |  190 |     ppb_request_dt one_ppb_request;
17816 |  191 | 
17817 |  192 |     ppb_response_dt one_ppb_response;
17818 |  193 |     
17819 |  194 | 
17820 |  195 |     scatterLoop:
17821 |  196 |     while (true)
17822 |  197 |     {
17823 |  198 | #pragma HLS PIPELINE II=1
17824 |  199 |         // logic to fill the ping-pong buffer.
17825 |  200 |         if((pp_request_round - pp_read_round) <= 1){
17826 |  201 |             if(pp_request_round < pp_read_round) pp_request_round = pp_read_round;
17827 |  202 |             one_ppb_request.request_round = pp_request_round;
17828 |  203 |             one_ppb_request.end_flag = 0;
17829 |  204 |             write_to_stream(ppb_request_stm, one_ppb_request);
17830 |  205 |             pp_request_round ++;
17831 |  206 |         }
17832 |  207 |         
17833 |  208 |         if(read_from_stream_nb(ppb_response_stm, one_ppb_response)){
17834 |  209 |             
17835 |  210 |             pp_write_round = one_ppb_response.addr << 4 >> LOG2_SRC_BUFFER_SIZE;
17836 |  211 | 
17837 |  212 |             bool write_buffer = pp_write_round & 0x1;
17838 |  213 | 
17839 |  214 |             uint write_idx = one_ppb_response.addr & ((SRC_BUFFER_SIZE >> 4) - 1);
17840 |  215 | 
17841 |  216 |             ap_uint<512> one_read_burst = one_ppb_response.data; //src_prop[(base_addr >> 4) + pp_write_idx];
17842 |  217 | 
17843 |  218 |             for (int u = 0; u < SCATTER_PE_NUM; u++){
17844 |  219 |             #pragma HLS UNROLL
17845 |  220 |                 src_prop_buffer[u][write_buffer][write_idx] = one_read_burst;
17846 |  221 |             }
17847 |  222 |         }
17848 |  223 |         
17849 |  224 |         // logic to read the ping-pong buffer and synchronization.
17850 |  225 | 
17851 |  226 |         if(!wait_flag) read_from_stream(edge_burst_stm, an_edge_burst);
17852 |  227 | 
17853 |  228 |         pp_read_round = (an_edge_burst.edges[0].src.range(30, 0) / SRC_BUFFER_SIZE);
17854 |  229 | 
17855 |  230 |         if(pp_read_round >= pp_write_round) 
17856 |  231 |             wait_flag = 1; 
17857 |  232 |         else 
17858 |  233 |             wait_flag = 0;
17859 |  234 | 
17860 |  235 |         //DEBUG_PRINTF(" scatter pp_read_round = %d \n", (uint)pp_read_round);
17861 |  236 | 
17862 |  237 |         if(!wait_flag){
17863 |  238 | 
17864 |  239 |             bool read_buffer = pp_read_round & 0x1;
17865 |  240 |             
17866 |  241 |             update_set_dt an_update_set;
17867 |  242 |             
17868 |  243 |             for (int u = 0; u < SCATTER_PE_NUM; u ++){ // "u" indicates the default unroll factor of the loop
17869 |  244 |             #pragma HLS UNROLL
17870 |  245 |                 ap_uint<31> idx = (an_edge_burst.edges[u].src.range(30, 0) % SRC_BUFFER_SIZE);
17871 |  246 |                 ap_uint<30> uram_row_idx = idx >> 4;
17872 |  247 |                 ap_uint<30> uram_row_offset = (idx & 0xf);
17873 |  248 | 
