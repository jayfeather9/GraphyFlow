### Code

```unknown
 1 | cleanexe:
 2 | 	-$(RMDIR) $(EXECUTABLE)
 3 | 
 4 | clean:
 5 | 	-$(RMDIR) sdaccel_* TempConfig system_estimate.xtxt *.rpt
 6 | 	-$(RMDIR) src/*.ll _xocc_* .Xil dltmp* xmltmp* *.log *.jou *.wcfg *.wdb
 7 | 	-$(RMDIR) .Xil
 8 | 	-$(RMDIR) *.zip
 9 | 	-$(RMDIR) *.str
10 | 	-$(RMDIR) ./_x
11 | 	-$(RMDIR) ./membership.out
12 | 	-$(RMDIR) .run
13 | 	-$(RMDIR) makefile_gen
14 | 	-$(RMDIR) .ipcache
15 | 	-$(RMDIR) ./scripts/host/*.o
16 | 	-$(RMDIR) ./scripts/host/acc_setup.o
17 | 	-$(RMDIR) ./scripts/host/graph_preprocess.o
18 | 
19 | cleanall:
20 | 	-$(RMDIR) $(EXECUTABLE) $(XCLBIN)/{*sw_emu*,*hw_emu*,*hw*} 
21 | 	-$(RMDIR) sdaccel_* TempConfig system_estimate.xtxt *.rpt
22 | 	-$(RMDIR) src/*.ll _xocc_* .Xil dltmp* xmltmp* *.log *.jou *.wcfg *.wdb
23 | 	-$(RMDIR) .Xil
24 | 	-$(RMDIR) *.zip
25 | 	-$(RMDIR) *.str
26 | 	-$(RMDIR) $(XCLBIN)
27 | 	-$(RMDIR) ./_x
28 | 	-$(RMDIR) ./membership.out
29 | 	-$(RMDIR) xclbin*
30 | 	-$(RMDIR) .run
31 | 	-$(RMDIR) makefile_gen
32 | 	-$(RMDIR) .ipcache
33 | 	-$(RMDIR) *.csv
34 | 	-$(RMDIR) *.protoinst
35 | 	-$(RMDIR) ./scripts/host/*.o
36 | 	-$(RMDIR) ./scripts/host/acc_setup.o
37 | 	-$(RMDIR) ./scripts/host/graph_preprocess.o
```

## File: help.mk

- Extension: .mk
- Language: unknown
- Size: 560 bytes
- Created: 2025-10-17 17:06:09
- Modified: 2025-10-17 17:06:09

### Code

```unknown
 1 | .PHONY: help
 2 | 
 3 | help::
 4 | 	$(ECHO) "Makefile Usage:"
 5 | 	$(ECHO) "  make all TARGET=<sw_emu/hw_emu/hw> DEVICE=<FPGA platform>"
 6 | 	$(ECHO) "      Command to generate the design for specified Target and Device."
 7 | 	$(ECHO) ""
 8 | 	$(ECHO) "  make clean "
 9 | 	$(ECHO) "      Command to remove the generated non-hardware files."
10 | 	$(ECHO) ""
11 | 	$(ECHO) "  make cleanall"
12 | 	$(ECHO) "      Command to remove all the generated files."
13 | 	$(ECHO) ""
14 | 	$(ECHO) "  make check TARGET=<sw_emu/hw_emu/hw> DEVICE=<FPGA platform>"
15 | 	$(ECHO) "      Command to run application in emulation."
16 | 	$(ECHO) ""
```

## File: utils.mk

- Extension: .mk
- Language: unknown
- Size: 1743 bytes
- Created: 2025-10-17 17:05:43
- Modified: 2025-10-17 17:05:43

### Code

```unknown
 1 | #+-------------------------------------------------------------------------------
 2 | # The following parameters are assigned with default values. These parameters can
 3 | # be overridden through the make command line
 4 | #+-------------------------------------------------------------------------------
 5 | 
 6 | PROFILE := no
 7 | 
 8 | #Generates profile summary report
 9 | ifeq ($(PROFILE), yes)
10 | LDCLFLAGS += --profile_kernel data:all:all:all
11 | endif
12 | 
13 | DEBUG := no
14 | 
15 | #Generates debug summary report
16 | ifeq ($(DEBUG), yes)
17 | CLFLAGS += --dk protocol:all:all:all
18 | endif
19 | 
20 | #Generates debug summary report
21 | ifeq ($(DEBUG), yes)
22 | LDCLFLAGS += --dk list_ports
23 | endif
24 | 
25 | #Checks for XILINX_VITIS
26 | ifndef XILINX_VITIS
27 | $(error XILINX_VITIS variable is not set, please set correctly and rerun)
28 | endif
29 | 
30 | #Checks for XILINX_XRT
31 | check-xrt:
32 | ifndef XILINX_XRT
33 | 	$(error XILINX_XRT variable is not set, please set correctly and rerun)
34 | endif
35 | 
36 | check-devices:
37 | ifndef DEVICE
38 | 	$(error DEVICE not set. Please set the DEVICE properly and rerun. Run "make help" for more details.)
39 | endif
40 | 
41 | check-aws_repo:
42 | ifndef SDACCEL_DIR
43 | 	$(error SDACCEL_DIR not set. Please set it properly and rerun. Run "make help" for more details.)
44 | endif
45 | 
46 | #   sanitize_dsa - create a filesystem friendly name from dsa name
47 | #   $(1) - name of dsa
48 | COLON=:
49 | PERIOD=.
50 | UNDERSCORE=_
51 | sanitize_dsa = $(strip $(subst $(PERIOD),$(UNDERSCORE),$(subst $(COLON),$(UNDERSCORE),$(1))))
52 | 
53 | device2dsa = $(if $(filter $(suffix $(1)),.xpfm),$(shell $(COMMON_REPO)/utility/parsexpmf.py $(1) dsa 2>/dev/null),$(1))
54 | device2sandsa = $(call sanitize_dsa,$(call device2dsa,$(1)))
55 | device2dep = $(if $(filter $(suffix $(1)),.xpfm),$(dir $(1))/$(shell $(COMMON_REPO)/utility/parsexpmf.py $(1) hw 2>/dev/null) $(1),)
56 | 
57 | # Cleaning stuff
58 | RM = rm -f
59 | RMDIR = rm -rf
60 | 
61 | ECHO:= @echo
```

