  604 |   361 |  271 | ## File: host/graph_loader.cpp
  605 |   362 |  272 | 
  606 |   363 |  273 | - Extension: .cpp
  607 |   364 |  274 | - Language: cpp
  608 |   365 |  275 | - Size: 4090 bytes
  609 |   366 |  276 | - Created: 2025-10-17 17:28:26
  610 |   367 |  277 | - Modified: 2025-10-17 17:28:26
  611 |   368 |  278 | 
  612 |   369 |  279 | ### Code
  613 |   370 |  280 | 
  614 |   371 |  281 | ```cpp
  615 |   372 |  282 |   1 | #include "graph_loader.h"
  616 |   373 |  283 |   2 | #include <algorithm>
  617 |   374 |  284 |   3 | #include <fstream>
  618 |   375 |  285 |   4 | #include <iostream>
  619 |   376 |  286 |   5 | #include <sstream>
  620 |   377 |  287 |   6 | #include <stdexcept>
  621 |   378 |  288 |   7 | #include <vector>
  622 |   379 |  289 |   8 | 
  623 |   380 |  290 |   9 | // 边结构体，用于临时存储从文件中读取的边
  624 |   381 |  291 |  10 | struct Edge {
  625 |   382 |  292 |  11 |     int src, dest, weight;
  626 |   383 |  293 |  12 | };
  627 |   384 |  294 |  13 | 
  628 |   385 |  295 |  14 | // 主函数，从文件中加载图并转换为 CSR 格式
  629 |   386 |  296 |  15 | GraphCSR load_graph_from_file(const std::string &file_path) {
  630 |   387 |  297 |  16 |     // ---- 1. 根据文件扩展名判断图的格式 ----
  631 |   388 |  298 |  17 |     bool is_one_based = false; // 默认为 0-indexed
  632 |   389 |  299 |  18 |     char comment_char = '#';   // 默认注释符
  633 |   390 |  300 |  19 | 
  634 |   391 |  301 |  20 |     if (file_path.size() > 4 &&
  635 |   392 |  302 |  21 |         file_path.substr(file_path.size() - 4) == ".mtx") {
  636 |   393 |  303 |  22 |         is_one_based = true; // .mtx 文件通常是 1-indexed
  637 |   394 |  304 |  23 |         comment_char = '%';  // .mtx 文件使用 '%' 作为注释
  638 |   395 |  305 |  24 |         std::cout << "Detected .mtx format (1-based indexing)." << std::endl;
  639 |   396 |  306 |  25 |     } else {
  640 |   397 |  307 |  26 |         std::cout << "Detected .txt format (0-based indexing)." << std::endl;
  641 |   398 |  308 |  27 |     }
  642 |   399 |  309 |  28 | 
  643 |   400 |  310 |  29 |     // ---- 2. 打开文件并逐行解析 ----
  644 |   401 |  311 |  30 |     std::ifstream file(file_path);
  645 |   402 |  312 |  31 |     if (!file.is_open()) {
  646 |   403 |  313 |  32 |         std::cerr << "Error: Could not open graph file: " << file_path
  647 |   404 |  314 |  33 |                   << std::endl;
  648 |   405 |  315 |  34 |         exit(EXIT_FAILURE);
  649 |   406 |  316 |  35 |     }
  650 |   407 |  317 |  36 | 
  651 |   408 |  318 |  37 |     std::vector<Edge> edges;
  652 |   409 |  319 |  38 |     int max_vertex_id = -1;
  653 |   410 |  320 |  39 |     std::string line;
  654 |   411 |  321 |  40 |     long line_num = 0;
  655 |   412 |  322 |  41 | 
  656 |   413 |  323 |  42 |     while (std::getline(file, line)) {
  657 |   414 |  324 |  43 |         line_num++;
  658 |   415 |  325 |  44 |         // 跳过空行和注释行
  659 |   416 |  326 |  45 |         if (line.empty() || line[0] == comment_char) {
  660 |   417 |  327 |  46 |             continue;
  661 |   418 |  328 |  47 |         }
  662 |   419 |  329 |  48 | 
  663 |   420 |  330 |  49 |         std::istringstream iss(line);
  664 |   421 |  331 |  50 |         Edge edge;
  665 |   422 |  332 |  51 | 
  666 |   423 |  333 |  52 |         // 尝试读取 src, dest, weight
  667 |   424 |  334 |  53 |         if (iss >> edge.src >> edge.dest >> edge.weight) {
  668 |   425 |  335 |  54 |             // 成功读取三个值
  669 |   426 |  336 |  55 |         } else {
  670 |   427 |  337 |  56 |             // 如果失败，重置流并尝试只读取 src, dest
  671 |   428 |  338 |  57 |             iss.clear();
  672 |   429 |  339 |  58 |             iss.seekg(0);
  673 |   430 |  340 |  59 |             if (iss >> edge.src >> edge.dest) {
  674 |   431 |  341 |  60 |                 edge.weight = 1; // 赋予默认权重 1
  675 |   432 |  342 |  61 |             } else {
  676 |   433 |  343 |  62 |                 std::cerr << "Warning: Skipping malformed line " << line_num
  677 |   434 |  344 |  63 |                           << ": " << line << std::endl;
  678 |   435 |  345 |  64 |                 continue;
  679 |   436 |  346 |  65 |             }
  680 |   437 |  347 |  66 |         }
  681 |   438 |  348 |  67 | 
  682 |   439 |  349 |  68 |         // 如果是 1-based 格式，转换为 0-based
  683 |   440 |  350 |  69 |         if (is_one_based) {
  684 |   441 |  351 |  70 |             edge.src--;
  685 |   442 |  352 |  71 |             edge.dest--;
  686 |   443 |  353 |  72 |         }
  687 |   444 |  354 |  73 | 
  688 |   445 |  355 |  74 |         // 检查顶点ID是否有效
  689 |   446 |  356 |  75 |         if (edge.src < 0 || edge.dest < 0) {
  690 |   447 |  357 |  76 |             std::cerr
  691 |   448 |  358 |  77 |                 << "Warning: Skipping edge with negative vertex ID on line "
  692 |   449 |  359 |  78 |                 << line_num << std::endl;
  693 |   450 |  360 |  79 |             continue;
  694 |   451 |  361 |  80 |         }
  695 |   452 |  362 |  81 | 
  696 |   453 |  363 |  82 |         edges.push_back(edge);
  697 |   454 |  364 |  83 |         max_vertex_id = std::max({max_vertex_id, edge.src, edge.dest});
  698 |   455 |  365 |  84 |     }
  699 |   456 |  366 |  85 |     file.close();
  700 |   457 |  367 |  86 | 
  701 |   458 |  368 |  87 |     // ---- 3. 将边列表转换为 CSR 格式 ----
  702 |   459 |  369 |  88 |     GraphCSR graph;
  703 |   460 |  370 |  89 |     if (max_vertex_id == -1) { // 如果文件为空或无效
  704 |   461 |  371 |  90 |         graph.num_vertices = 0;
  705 |   462 |  372 |  91 |         graph.num_edges = 0;
  706 |   463 |  373 |  92 |         std::cout << "Graph is empty." << std::endl;
  707 |   464 |  374 |  93 |         return graph;
  708 |   465 |  375 |  94 |     }
  709 |   466 |  376 |  95 | 
  710 |   467 |  377 |  96 |     graph.num_vertices = max_vertex_id + 1;
  711 |   468 |  378 |  97 |     graph.num_edges = edges.size();
  712 |   469 |  379 |  98 | 
  713 |   470 |  380 |  99 |     std::cout << "Graph loaded: " << graph.num_vertices << " vertices, "
  714 |   471 |  381 | 100 |               << graph.num_edges << " edges." << std::endl;
  715 |   472 |  382 | 101 | 
  716 |   473 |  383 | 102 |     // 为了进行 CSR 转换，按源顶点 ID 对边进行排序
  717 |   474 |  384 | 103 |     std::sort(edges.begin(), edges.end(), [](const Edge &a, const Edge &b) {
  718 |   475 |  385 | 104 |         if (a.src != b.src) {
  719 |   476 |  386 | 105 |             return a.src < b.src;
  720 |   477 |  387 | 106 |         }
  721 |   478 |  388 | 107 |         return a.dest < b.dest;
  722 |   479 |  389 | 108 |     });
  723 |   480 |  390 | 109 | 
  724 |   481 |  391 | 110 |     // 分配 CSR 数组内存
  725 |   482 |  392 | 111 |     graph.offsets.resize(graph.num_vertices + 1);
  726 |   483 |  393 | 112 |     graph.columns.resize(graph.num_edges);
  727 |   484 |  394 | 113 |     graph.weights.resize(graph.num_edges);
  728 |   485 |  395 | 114 | 
  729 |   486 |  396 | 115 |     // 填充 columns 和 weights 数组，并计算每个顶点的出度
  730 |   487 |  397 | 116 |     std::vector<int> out_degree(graph.num_vertices, 0);
  731 |   488 |  398 | 117 |     for (int i = 0; i < graph.num_edges; ++i) {
  732 |   489 |  399 | 118 |         graph.columns[i] = edges[i].dest;
  733 |   490 |  400 | 119 |         graph.weights[i] = edges[i].weight;
  734 |   491 |  401 | 120 |         out_degree[edges[i].src]++;
  735 |   492 |  402 | 121 |     }
  736 |   493 |  403 | 122 | 
  737 |   494 |  404 | 123 |     // 通过出度的前缀和计算 offsets 数组
  738 |   495 |  405 | 124 |     graph.offsets[0] = 0;
  739 |   496 |  406 | 125 |     for (int i = 0; i < graph.num_vertices; ++i) {
  740 |   497 |  407 | 126 |         graph.offsets[i + 1] = graph.offsets[i] + out_degree[i];
  741 |   498 |  408 | 127 |     }
  742 |   499 |  409 | 128 | 
  743 |   500 |  410 | 129 |     return graph;
  744 |   501 |  411 | 130 | }
  745 |   502 |  412 | ```
