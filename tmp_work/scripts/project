16196 | 394 |     std::cout << "--- [Host] Phase 2.1: Updating host-side data for new iteration ---" << std::endl;
16197 | 395 | 
16198 | 396 |     const size_t bytes_per_word = AXI_BUS_WIDTH / 8;
16199 | 397 | 
16200 | 398 |     // DISABLED FOR LITTLE KERNEL TESTING
16201 | 399 |     /*
16202 | 400 |     for (size_t i = 0; i < big_kernel_buffers.size(); ++i) {
16203 | 401 |         // ... (BIG KERNEL LOGIC IS COMMENTED OUT)
16204 | 402 |     }
16205 | 403 |     */
16206 | 404 | 
16207 | 405 |     // ENABLED for LITTLE KERNEL TESTING
16208 | 406 |     // This loop now only updates the HBM manager's buffer, which is correct for subsequent iterations.
