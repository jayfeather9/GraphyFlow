 2707 |  2464 | 2374 | 176 |             p_graph.weights.resize(p_graph.num_edges);
 2708 |  2465 | 2375 | 177 | 
 2709 |  2466 | 2376 | 178 |             std::vector<int> out_degree(p_graph.num_vertices, 0);
 2710 |  2467 | 2377 | 179 |             for (int j = 0; j < p_graph.num_edges; ++j) {
 2711 |  2468 | 2378 | 180 |                 p_graph.columns[j] = local_edges[j].dest;
 2712 |  2469 | 2379 | 181 |                 p_graph.weights[j] = local_edges[j].weight;
 2713 |  2470 | 2380 | 182 |                 out_degree[local_edges[j].src]++;
 2714 |  2471 | 2381 | 183 |             }
 2715 |  2472 | 2382 | 184 | 
 2716 |  2473 | 2383 | 185 |             p_graph.offsets[0] = 0;
 2717 |  2474 | 2384 | 186 |             for (int j = 0; j < p_graph.num_vertices; ++j) {
 2718 |  2475 | 2385 | 187 |                 p_graph.offsets[j + 1] = p_graph.offsets[j] + out_degree[j];
 2719 |  2476 | 2386 | 188 |             }
 2720 |  2477 | 2387 | 189 | 
 2721 |  2478 | 2388 | 190 |             // --- 4.4: Finalize partition descriptor metadata ---
 2722 |  2479 | 2389 | 191 |             pd.num_edges = p_graph.num_edges;
 2723 |  2480 | 2390 | 192 |             pd.num_vertices = p_graph.num_vertices;
 2724 |  2481 | 2391 | 193 |         }
 2725 |  2482 | 2392 | 194 | 
 2726 |  2483 | 2393 | 195 |         pd.kernel_id = i;
 2727 |  2484 | 2394 | 196 |         if (i < LITTLE_KERNEL_NUM) {
 2728 |  2485 | 2395 | 197 |             pd.is_dense =
 2729 |  2486 | 2396 | 198 |                 true; // This is a Dense Partition (DP) for a little kernel
 2730 |  2487 | 2397 | 199 |             container.DPs.push_back(pd);
 2731 |  2488 | 2398 | 200 |         } else {
 2732 |  2489 | 2399 | 201 |             pd.is_dense =
 2733 |  2490 | 2400 | 202 |                 false; // This is a Sparse Partition (SP) for a big kernel
 2734 |  2491 | 2401 | 203 |             container.SPs.push_back(pd);
 2735 |  2492 | 2402 | 204 |         }
 2736 |  2493 | 2403 | 205 |         std::cout << "  - Processed Partition " << i << ": " << pd.num_vertices
 2737 |  2494 | 2404 | 206 |                   << " local vertices, " << pd.num_edges << " edges."
 2738 |  2495 | 2405 | 207 |                   << std::endl;
 2739 |  2496 | 2406 | 208 |     }
 2740 |  2497 | 2407 | 209 | 
 2741 |  2498 | 2408 | 210 |     container.num_dense_partitions = container.DPs.size();
 2742 |  2499 | 2409 | 211 |     container.num_sparse_partitions = container.SPs.size();
 2743 |  2500 | 2410 | 212 | 
 2744 |  2501 | 2411 | 213 |     std::cout<<"DP: "<<container.num_dense_partitions<<"SP: "<<container.num_sparse_partitions<<std::endl;
 2745 |  2502 | 2412 | 214 |     std::cout << "[SUCCESS] Graph partitioning and preprocessing complete."
 2746 |  2503 | 2413 | 215 |               << std::endl;
 2747 |  2504 | 2414 | 216 |     return container;
 2748 |  2505 | 2415 | 217 | }
