19894 |  461 | static void node_property_responder(
19895 |  462 |     hls::stream<b_node_distance_burst_t> &node_distance_burst_stream,
19896 |  463 |     int32_t num_nodes, hls::stream<node_dist_batch_t> &all_distances_stream) {
19897 |  464 |     node_dist_batch_t dist_batch;
19898 |  465 |     dist_batch.end_flag = false;
19899 |  466 |     //     const int32_t max_node_burst_idx = (num_nodes + PE_NUM - 1) / PE_NUM;
19900 |  467 |     // LOOP_FOR_14:
19901 |  468 |     // for (uint32_t node_burst_idx = 0; node_burst_idx < max_node_burst_idx;
19902 |  469 |     //      node_burst_idx++) {
19903 |  470 |     uint32_t node_burst_idx = 0;
19904 |  471 |     while (true) {
19905 |  472 | #pragma HLS PIPELINE II = 1
19906 |  473 |         b_node_distance_burst_t node_distance_burst;
19907 |  474 |         node_distance_burst = node_distance_burst_stream.read();
19908 |  475 |         if (node_distance_burst.last) {
19909 |  476 |             break;
19910 |  477 |         }
19911 |  478 |         const int32_t base_idx = (node_burst_idx << LOG_PE_NUM);
19912 |  479 |         node_burst_idx++;
19913 |  480 |     LOOP_FOR_13:
19914 |  481 |         for (uint32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
19915 |  482 | #pragma HLS UNROLL
19916 |  483 |             // Direct indexing with pe_idx to avoid race conditions in UNROLL
19917 |  484 |             dist_batch.data[pe_idx] =
19918 |  485 |                 get_val_from_256_bus(node_distance_burst.data, pe_idx);
19919 |  486 |         }
19920 |  487 |         // Calculate end_pos as the number of valid nodes in this burst
19921 |  488 |         const int32_t remaining_nodes = num_nodes - base_idx;
19922 |  489 |         dist_batch.end_pos =
19923 |  490 |             (remaining_nodes < PE_NUM) ? remaining_nodes : PE_NUM;
19924 |  491 |         all_distances_stream.write(dist_batch);
19925 |  492 |     }
19926 |  493 |     dist_batch.end_flag = true;
19927 |  494 |     dist_batch.end_pos = 0;
19928 |  495 |     all_distances_stream.write(dist_batch);
19929 |  496 | }
