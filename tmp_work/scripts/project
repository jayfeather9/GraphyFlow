14646 | 14403 | 1717 |                 // (int)cur_id, burst_idx, j); fflush(NULL);
14647 | 14404 | 1718 |             }
14648 | 14405 | 1719 |         }
14649 | 14406 | 1720 |         bool burst2_valid = false;
14650 | 14407 | 1721 |         for (int j = 8; j < 16; j++) {
14651 | 14408 | 1722 | #pragma HLS UNROLL
14652 | 14409 | 1723 |             if (nodes_read + j < num_edges) {
14653 | 14410 | 1724 |                 burst2.data[j - 8] = wide_word.range(
14654 | 14411 | 1725 |                     (j + 1) * NODE_ID_BITWIDTH - 1, j * NODE_ID_BITWIDTH);
14655 | 14412 | 1726 |                 burst2_valid |= true;
