13341 | 13098 |  412 |                 out_batch.weights[pe_idx] = edge_batch.edges[pe_idx].prop;
13342 | 13099 |  413 |                 out_batch.dsts[pe_idx] = edge_batch.edges[pe_idx].node_id;
13343 | 13100 |  414 | 
13344 | 13101 |  415 |                 if (pe_idx == PE_NUM - 1) {
13345 | 13102 |  416 |                     cur_last_cacheline = cacheline;
13346 | 13103 |  417 |                     cur_last_cache_idx = cacheline_idx;
13347 | 13104 |  418 |                 }
13348 | 13105 |  419 |             }
13349 | 13106 |  420 |         }
13350 | 13107 |  421 |         edge_batch_stream.write(out_batch);
13351 | 13108 |  422 |         // printf("Sent edge batch with %d entries\n", (int)out_batch.end_pos);
13352 | 13109 |  423 |         // fflush(NULL);
13353 | 13110 |  424 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
13354 | 13111 |  425 | #pragma HLS UNROLL
13355 | 13112 |  426 |             last_cacheline[pe_idx] = cur_last_cacheline;
13356 | 13113 |  427 |             last_cache_idx[pe_idx] = cur_last_cache_idx;
13357 | 13114 |  428 |         }
13358 | 13115 |  429 |     }
13359 | 13116 |  430 |     // Send end marker
13360 | 13117 |  431 |     edge_batch_t end_batch;
13361 | 13118 |  432 |     end_batch.end_flag = true;
