 5902 |  5659 | 5569 |  405 |                 }
 5903 |  5660 | 5570 |  406 | 
 5904 |  5661 | 5571 |  407 |                 // ap_fixed_pod_t prop = cacheline.range(
 5905 |  5662 | 5572 |  408 |                 //     31 + (offset << 5), offset << 5);
