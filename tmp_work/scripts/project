 320 | static void node_property_responder(
 321 |     hls::stream<b_node_distance_burst_t> &node_distance_burst_stream,
 322 |     int32_t num_nodes, hls::stream<node_dist_batch_t> &all_distances_stream) {
 323 |     node_dist_batch_t dist_batch;
 324 |     dist_batch.end_flag = false;
 325 |     //     const int32_t max_node_burst_idx = (num_nodes + PE_NUM - 1) / PE_NUM;
 326 |     // LOOP_FOR_14:
 327 |     // for (uint32_t node_burst_idx = 0; node_burst_idx < max_node_burst_idx;
 328 |     //      node_burst_idx++) {
 329 |     uint32_t node_burst_idx = 0;
 330 |     while (true) {
 331 | #pragma HLS PIPELINE II = 1
 332 |         b_node_distance_burst_t node_distance_burst;
 333 |         node_distance_burst = node_distance_burst_stream.read();
 334 |         if (node_distance_burst.last) {
 335 |             break;
 336 |         }
 337 |         const int32_t base_idx = (node_burst_idx << LOG_PE_NUM);
 338 |         node_burst_idx++;
 339 |     LOOP_FOR_13:
 340 |         for (uint32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
 341 | #pragma HLS UNROLL
 342 |             // Direct indexing with pe_idx to avoid race conditions in UNROLL
 343 |             dist_batch.data[pe_idx] =
 344 |                 get_val_from_256_bus(node_distance_burst.data, pe_idx);
 345 |         }
 346 |         // Calculate end_pos as the number of valid nodes in this burst
 347 |         const int32_t remaining_nodes = num_nodes - base_idx;
 348 |         dist_batch.end_pos =
 349 |             (remaining_nodes < PE_NUM) ? remaining_nodes : PE_NUM;
 350 |         all_distances_stream.write(dist_batch);
 351 |     }
 352 |     dist_batch.end_flag = true;
 353 |     dist_batch.end_pos = 0;
 354 |     all_distances_stream.write(dist_batch);
 355 | }
