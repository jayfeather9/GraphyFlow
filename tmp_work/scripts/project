 1581 |  1338 | 1248 | 566 | 
 1582 |  1339 | 1249 | 567 | bool AlgorithmHost::check_convergence_and_update(const PartitionContainer &container) {
 1583 |  1340 | 1250 | 568 |     bool changed = false;
 1584 |  1341 | 1251 | 569 |     std::cout << "--- [Host] Phase 5: Unpacking results and checking for convergence ---" << std::endl;
 1585 |  1342 | 1252 | 570 | 
 1586 |  1343 | 1253 | 571 |     std::map<int, distance_t> min_distances;
 1587 |  1344 | 1254 | 572 |     const int bits_per_output = NODE_ID_BITWIDTH + DISTANCE_BITWIDTH + OUT_END_MARKER_BITWIDTH;
 1588 |  1345 | 1255 | 573 |     const int outputs_per_word = AXI_BUS_WIDTH / bits_per_output;
 1589 |  1346 | 1256 | 574 | 
 1590 |  1347 | 1257 | 575 |     // DISABLED
 1591 |  1348 | 1258 | 576 |     /*
 1592 |  1349 | 1259 | 577 |     for (size_t i = 0; i < big_kernel_host_outputs.size(); ++i) {
 1593 |  1350 | 1260 | 578 |         // ... (BIG KERNEL LOGIC IS COMMENTED OUT)
 1594 |  1351 | 1261 | 579 |     }
 1595 |  1352 | 1262 | 580 |     */
 1596 |  1353 | 1263 | 581 | 
 1597 |  1354 | 1264 | 582 |     // ENABLED
 1598 |  1355 | 1265 | 583 |     for (size_t i = 0; i < little_kernel_host_outputs.size(); ++i) {
 1599 |  1356 | 1266 | 584 |         const auto &p_graph = container.DPs[i].partitioned_graph;
 1600 |  1357 | 1267 | 585 |         for (const auto &word : little_kernel_host_outputs[i]) {
 1601 |  1358 | 1268 | 586 |             out_end_marker_t end_flag = 0;
 1602 |  1359 | 1269 | 587 |             for (int k = 0; k < outputs_per_word; ++k) {
 1603 |  1360 | 1270 | 588 |                 int bit_offset = k * bits_per_output;
 1604 |  1361 | 1271 | 589 |                 ap_uint<bits_per_output> packed_output = word.range(bit_offset + bits_per_output - 1, bit_offset);
 1605 |  1362 | 1272 | 590 | 
 1606 |  1363 | 1273 | 591 |                 ap_uint<NODE_ID_BITWIDTH> local_id_pod = packed_output.range(NODE_ID_BITWIDTH - 1, 0);
 1607 |  1364 | 1274 | 592 |                 ap_fixed_pod_t dist_pod = packed_output.range(NODE_ID_BITWIDTH + DISTANCE_BITWIDTH - 1, NODE_ID_BITWIDTH);
 1608 |  1365 | 1275 | 593 |                 end_flag = packed_output.range(bits_per_output - 1, NODE_ID_BITWIDTH + DISTANCE_BITWIDTH);
 1609 |  1366 | 1276 | 594 | 
 1610 |  1367 | 1277 | 595 |                 if (end_flag != 0) break;
 1611 |  1368 | 1278 | 596 | 
 1612 |  1369 | 1279 | 597 |                 int local_id = local_id_pod;
 1613 |  1370 | 1280 | 598 |                 if (p_graph.vtx_map_rev.count(local_id) == 0) continue;
 1614 |  1371 | 1281 | 599 | 
 1615 |  1372 | 1282 | 600 |                 int global_id = p_graph.vtx_map_rev.at(local_id);
 1616 |  1373 | 1283 | 601 |                 if (global_id >= m_num_vertices) continue;
 1617 |  1374 | 1284 | 602 | 
 1618 |  1375 | 1285 | 603 |                 distance_t new_dist = *reinterpret_cast<distance_t *>(&dist_pod);
 1619 |  1376 | 1286 | 604 | 
 1620 |  1377 | 1287 | 605 |                 if (min_distances.find(global_id) == min_distances.end() || new_dist < min_distances[global_id]) {
 1621 |  1378 | 1288 | 606 |                     min_distances[global_id] = new_dist;
 1622 |  1379 | 1289 | 607 |                 }
 1623 |  1380 | 1290 | 608 |             }
 1624 |  1381 | 1291 | 609 |             if (end_flag != 0) break;
 1625 |  1382 | 1292 | 610 |         }
 1626 |  1383 | 1293 | 611 |     }
 1627 |  1384 | 1294 | 612 | 
 1628 |  1385 | 1295 | 613 |     for (auto const &[global_id, new_dist] : min_distances) {
 1629 |  1386 | 1296 | 614 |         if (global_id < m_num_vertices && new_dist < h_distances[global_id]) {
 1630 |  1387 | 1297 | 615 |             h_distances[global_id] = new_dist;
 1631 |  1388 | 1298 | 616 |             changed = true;
 1632 |  1389 | 1299 | 617 |         }
 1633 |  1390 | 1300 | 618 |     }
 1634 |  1391 | 1301 | 619 | 
 1635 |  1392 | 1302 | 620 |     if (changed) {
 1636 |  1393 | 1303 | 621 |         std::cout << "[INFO] Distances updated. Preparing for next iteration." << std::endl;
 1637 |  1394 | 1304 | 622 |     } else {
 1638 |  1395 | 1305 | 623 |         std::cout << "[INFO] No distance updates. Algorithm has converged." << std::endl;
 1639 |  1396 | 1306 | 624 |     }
 1640 |  1397 | 1307 | 625 | 
 1641 |  1398 | 1308 | 626 |     return !changed;
 1642 |  1399 | 1309 | 627 | }
 1643 |  1400 | 1310 | 628 | 
 1644 |  1401 | 1311 | 629 | const std::vector<int> &AlgorithmHost::get_results() const {
 1645 |  1402 | 1312 | 630 |     static std::vector<int> final_distances;
 1646 |  1403 | 1313 | 631 |     final_distances.clear();
 1647 |  1404 | 1314 | 632 |     final_distances.reserve(h_distances.size());
 1648 |  1405 | 1315 | 633 | 
 1649 |  1406 | 1316 | 634 |     for (const auto &dist : h_distances) {
 1650 |  1407 | 1317 | 635 |         if (dist >= INFINITY_DIST) {
 1651 |  1408 | 1318 | 636 |             final_distances.push_back(std::numeric_limits<int>::max());
 1652 |  1409 | 1319 | 637 |         } else {
 1653 |  1410 | 1320 | 638 |             final_distances.push_back(dist.to_int());
 1654 |  1411 | 1321 | 639 |         }
