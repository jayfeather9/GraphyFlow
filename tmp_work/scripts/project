20180 |  747 | static void switch2x2_2(int32_t i,
20181 |  748 |                         hls::stream<net_wrapper_kt_pair_105_t_t> &in1,
20182 |  749 |                         hls::stream<net_wrapper_kt_pair_105_t_t> &in2,
20183 |  750 |                         hls::stream<net_wrapper_kt_pair_105_t_t> &out1,
20184 |  751 |                         hls::stream<net_wrapper_kt_pair_105_t_t> &out2) {
20185 |  752 | #pragma HLS DATAFLOW
20186 |  753 |     hls::stream<net_wrapper_kt_pair_105_t_t> l1_1;
20187 |  754 | #pragma HLS STREAM variable = l1_1 depth = 2
20188 |  755 |     hls::stream<net_wrapper_kt_pair_105_t_t> l1_2;
20189 |  756 | #pragma HLS STREAM variable = l1_2 depth = 2
20190 |  757 |     hls::stream<net_wrapper_kt_pair_105_t_t> l1_3;
20191 |  758 | #pragma HLS STREAM variable = l1_3 depth = 2
20192 |  759 |     hls::stream<net_wrapper_kt_pair_105_t_t> l1_4;
