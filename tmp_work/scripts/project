## File: host/host_bellman_ford.cpp

- Extension: .cpp
- Language: cpp
- Size: 855 bytes
- Created: 2025-10-17 17:29:02
- Modified: 2025-10-17 17:29:02

### Code

```cpp
 1 | #include "host_bellman_ford.h"
 2 | 
 3 | bool host_bellman_ford_iteration(const GraphCSR &graph,
 4 |                                  std::vector<int> &distances) {
 5 |     bool changed = false;
 6 | 
 7 |     // --- USER MODIFIABLE SECTION: Host Computation Logic ---
 8 |     // For each vertex, relax all outgoing edges
 9 |     for (int u = 0; u < graph.num_vertices; ++u) {
10 |         if (distances[u] != INFINITY_DIST) {
11 |             for (int i = graph.offsets[u]; i < graph.offsets[u + 1]; ++i) {
12 |                 int v = graph.columns[i];
13 |                 int weight = graph.weights[i];
14 | 
15 |                 // Relaxation step
16 |                 if (distances[u] + weight < distances[v]) {
17 |                     distances[v] = distances[u] + weight;
18 |                     changed = true;
19 |                 }
20 |             }
21 |         }
22 |     }
23 |     // --- END USER MODIFIABLE SECTION ---
24 | 
25 |     return changed;
26 | }
```

## File: host/graph_loader.cpp

- Extension: .cpp
- Language: cpp
- Size: 4090 bytes
- Created: 2025-10-17 17:28:26
- Modified: 2025-10-17 17:28:26

### Code

```cpp
  1 | #include "graph_loader.h"
  2 | #include <algorithm>
  3 | #include <fstream>
  4 | #include <iostream>
  5 | #include <sstream>
  6 | #include <stdexcept>
  7 | #include <vector>
  8 | 
  9 | // 边结构体，用于临时存储从文件中读取的边
 10 | struct Edge {
 11 |     int src, dest, weight;
 12 | };
 13 | 
 14 | // 主函数，从文件中加载图并转换为 CSR 格式
 15 | GraphCSR load_graph_from_file(const std::string &file_path) {
 16 |     // ---- 1. 根据文件扩展名判断图的格式 ----
 17 |     bool is_one_based = false; // 默认为 0-indexed
 18 |     char comment_char = '#';   // 默认注释符
 19 | 
 20 |     if (file_path.size() > 4 &&
 21 |         file_path.substr(file_path.size() - 4) == ".mtx") {
 22 |         is_one_based = true; // .mtx 文件通常是 1-indexed
 23 |         comment_char = '%';  // .mtx 文件使用 '%' 作为注释
 24 |         std::cout << "Detected .mtx format (1-based indexing)." << std::endl;
 25 |     } else {
 26 |         std::cout << "Detected .txt format (0-based indexing)." << std::endl;
 27 |     }
 28 | 
 29 |     // ---- 2. 打开文件并逐行解析 ----
 30 |     std::ifstream file(file_path);
 31 |     if (!file.is_open()) {
 32 |         std::cerr << "Error: Could not open graph file: " << file_path
 33 |                   << std::endl;
 34 |         exit(EXIT_FAILURE);
 35 |     }
 36 | 
 37 |     std::vector<Edge> edges;
 38 |     int max_vertex_id = -1;
 39 |     std::string line;
 40 |     long line_num = 0;
 41 | 
 42 |     while (std::getline(file, line)) {
 43 |         line_num++;
 44 |         // 跳过空行和注释行
 45 |         if (line.empty() || line[0] == comment_char) {
 46 |             continue;
 47 |         }
 48 | 
 49 |         std::istringstream iss(line);
 50 |         Edge edge;
 51 | 
 52 |         // 尝试读取 src, dest, weight
 53 |         if (iss >> edge.src >> edge.dest >> edge.weight) {
 54 |             // 成功读取三个值
 55 |         } else {
 56 |             // 如果失败，重置流并尝试只读取 src, dest
 57 |             iss.clear();
 58 |             iss.seekg(0);
 59 |             if (iss >> edge.src >> edge.dest) {
 60 |                 edge.weight = 1; // 赋予默认权重 1
 61 |             } else {
 62 |                 std::cerr << "Warning: Skipping malformed line " << line_num
 63 |                           << ": " << line << std::endl;
 64 |                 continue;
 65 |             }
 66 |         }
 67 | 
 68 |         // 如果是 1-based 格式，转换为 0-based
 69 |         if (is_one_based) {
 70 |             edge.src--;
 71 |             edge.dest--;
 72 |         }
 73 | 
 74 |         // 检查顶点ID是否有效
 75 |         if (edge.src < 0 || edge.dest < 0) {
 76 |             std::cerr
 77 |                 << "Warning: Skipping edge with negative vertex ID on line "
 78 |                 << line_num << std::endl;
 79 |             continue;
 80 |         }
 81 | 
 82 |         edges.push_back(edge);
 83 |         max_vertex_id = std::max({max_vertex_id, edge.src, edge.dest});
 84 |     }
 85 |     file.close();
 86 | 
 87 |     // ---- 3. 将边列表转换为 CSR 格式 ----
 88 |     GraphCSR graph;
 89 |     if (max_vertex_id == -1) { // 如果文件为空或无效
 90 |         graph.num_vertices = 0;
 91 |         graph.num_edges = 0;
 92 |         std::cout << "Graph is empty." << std::endl;
 93 |         return graph;
 94 |     }
 95 | 
 96 |     graph.num_vertices = max_vertex_id + 1;
 97 |     graph.num_edges = edges.size();
 98 | 
 99 |     std::cout << "Graph loaded: " << graph.num_vertices << " vertices, "
100 |               << graph.num_edges << " edges." << std::endl;
101 | 
102 |     // 为了进行 CSR 转换，按源顶点 ID 对边进行排序
103 |     std::sort(edges.begin(), edges.end(), [](const Edge &a, const Edge &b) {
104 |         if (a.src != b.src) {
105 |             return a.src < b.src;
106 |         }
107 |         return a.dest < b.dest;
108 |     });
109 | 
110 |     // 分配 CSR 数组内存
111 |     graph.offsets.resize(graph.num_vertices + 1);
112 |     graph.columns.resize(graph.num_edges);
113 |     graph.weights.resize(graph.num_edges);
114 | 
115 |     // 填充 columns 和 weights 数组，并计算每个顶点的出度
116 |     std::vector<int> out_degree(graph.num_vertices, 0);
117 |     for (int i = 0; i < graph.num_edges; ++i) {
118 |         graph.columns[i] = edges[i].dest;
119 |         graph.weights[i] = edges[i].weight;
120 |         out_degree[edges[i].src]++;
121 |     }
122 | 
123 |     // 通过出度的前缀和计算 offsets 数组
124 |     graph.offsets[0] = 0;
125 |     for (int i = 0; i < graph.num_vertices; ++i) {
126 |         graph.offsets[i + 1] = graph.offsets[i] + out_degree[i];
127 |     }
128 | 
129 |     return graph;
130 | }
```

