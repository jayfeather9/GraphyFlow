17444 | 126 |             pd.num_edges = 0;
17445 | 127 |             pd.num_vertices = 0;
17446 | 128 |             p_graph.num_edges = 0;
17447 | 129 |             p_graph.num_vertices = 0;
17448 | 130 |             p_graph.offsets.push_back(0);
17449 | 131 | 
17450 | 132 |         } else {
17451 | 133 |             // --- 4.1: Collect unique vertices and build ID mappings ---
17452 | 134 |             std::set<int> local_vertices_set;
17453 | 135 |             for (const auto &edge : partition_edges) {
17454 | 136 |                 local_vertices_set.insert(edge.src);
17455 | 137 |                 local_vertices_set.insert(edge.dest);
17456 | 138 |             }
17457 | 139 | 
17458 | 140 |             int local_id_counter = 0;
17459 | 141 |             // First, map destination vertices to guarantee they have
17460 | 142 |             // lower-range IDs
17461 | 143 |             for (int global_id : partition_dst_nodes) {
17462 | 144 |                 p_graph.vtx_map[global_id] = local_id_counter;
17463 | 145 |                 p_graph.vtx_map_rev[local_id_counter] = global_id;
17464 | 146 |                 local_id_counter++;
17465 | 147 |             }
17466 | 148 |             p_graph.num_dsts = partition_dst_nodes.size();
17467 | 149 |             // Then, map the remaining source vertices
17468 | 150 |             for (int global_id : local_vertices_set) {
17469 | 151 |                 if (p_graph.vtx_map.find(global_id) == p_graph.vtx_map.end()) {
17470 | 152 |                     p_graph.vtx_map[global_id] = local_id_counter;
17471 | 153 |                     p_graph.vtx_map_rev[local_id_counter] = global_id;
17472 | 154 |                     local_id_counter++;
17473 | 155 |                 }
17474 | 156 |             }
17475 | 157 |             p_graph.num_vertices = local_vertices_set.size();
17476 | 158 |             p_graph.num_edges = partition_edges.size();
17477 | 159 | 
17478 | 160 |             // --- 4.2: Rewrite edges with local, compressed IDs ---
17479 | 161 |             std::vector<Edge> local_edges;
17480 | 162 |             local_edges.reserve(p_graph.num_edges);
17481 | 163 |             for (const auto &global_edge : partition_edges) {
17482 | 164 |                 local_edges.push_back({p_graph.vtx_map[global_edge.src],
17483 | 165 |                                        p_graph.vtx_map[global_edge.dest],
17484 | 166 |                                        global_edge.weight});
17485 | 167 |             }
17486 | 168 | 
17487 | 169 |             // --- 4.3: Convert local edges to CSR format ---
17488 | 170 |             std::sort(
17489 | 171 |                 local_edges.begin(), local_edges.end(),
17490 | 172 |                 [](const Edge &a, const Edge &b) { return a.src < b.src; });
17491 | 173 | 
17492 | 174 |             p_graph.offsets.resize(p_graph.num_vertices + 1, 0);
17493 | 175 |             p_graph.columns.resize(p_graph.num_edges);
17494 | 176 |             p_graph.weights.resize(p_graph.num_edges);
17495 | 177 | 
17496 | 178 |             std::vector<int> out_degree(p_graph.num_vertices, 0);
17497 | 179 |             for (int j = 0; j < p_graph.num_edges; ++j) {
17498 | 180 |                 p_graph.columns[j] = local_edges[j].dest;
17499 | 181 |                 p_graph.weights[j] = local_edges[j].weight;
17500 | 182 |                 out_degree[local_edges[j].src]++;
