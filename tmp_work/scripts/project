15827 |  25 |     little_kernel_input_buffers.resize(container.DPs.size());
15828 |  26 |     hbm_manager_host_buffers.resize(1);
15829 |  27 | 
15830 |  28 |     auto start_time = std::chrono::system_clock::now();
15831 |  29 |     auto current_time = start_time;
15832 |  30 | 
15833 |  31 | 
15834 |  32 |     std::cout<<"DEBUG big:"<<big_kernel_input_buffers.size()<<"little :"<<little_kernel_input_buffers.size()<<std::endl;
15835 |  33 |     // --- 2.1: 为 BIG kernels 手动序列化数据 (带 Padding) ---
15836 |  34 |     // DISABLED FOR LITTLE KERNEL TESTING
15837 |  35 |     /*
15838 |  36 |     for (size_t i = 0; i < big_kernel_input_buffers.size(); ++i) {
15839 |  37 |         const auto &p_graph = container.SPs[i].partitioned_graph;
15840 |  38 | 
15841 |  39 |         // --- Pack node distances (ap_fixed<24,8> -> 3 bytes) ---
15842 |  40 |         {
15843 |  41 |             const size_t bytes_per_dist = DISTANCE_BITWIDTH / 8;
15844 |  42 |             const size_t dist_per_word = bytes_per_word / bytes_per_dist;
15845 |  43 |             const size_t word_number =
15846 |  44 |                 (p_graph.num_vertices + dist_per_word - 1) / dist_per_word;
15847 |  45 |             std::vector<char> temp_byte_buffer;
15848 |  46 |             temp_byte_buffer.reserve(word_number * bytes_per_word);
15849 |  47 | 
15850 |  48 |             for (int j = 0; j < p_graph.num_vertices; ++j) {
15851 |  49 |                 if ((temp_byte_buffer.size() % bytes_per_word) +
15852 |  50 |                         bytes_per_dist >
15853 |  51 |                     bytes_per_word) {
15854 |  52 |                     size_t padding_needed =
15855 |  53 |                         bytes_per_word -
15856 |  54 |                         (temp_byte_buffer.size() % bytes_per_word);
15857 |  55 |                     temp_byte_buffer.insert(temp_byte_buffer.end(),
15858 |  56 |                                             padding_needed,
15859 |  57 |                                             0); 
15860 |  58 |                 }
15861 |  59 | 
15862 |  60 |                 int global_id = p_graph.vtx_map_rev.at(j);
15863 |  61 |                 distance_t dist_val = h_distances[global_id];
15864 |  62 | 
15865 |  63 |                 const char *data_ptr =
15866 |  64 |                     reinterpret_cast<const char *>(&dist_val);
15867 |  65 |                 temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr,
15868 |  66 |                                         data_ptr + bytes_per_dist);
15869 |  67 |             }
15870 |  68 |             // 关键修正点：原big kernel的hbm_manager索引也应为0，因为它的大小是1
15871 |  69 |             hbm_manager_host_buffers[0].packed_node_props.resize(
15872 |  70 |                 (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word,
15873 |  71 |                 0);
15874 |  72 |             std::memcpy(hbm_manager_host_buffers[0].packed_node_props.data(),
15875 |  73 |                         temp_byte_buffer.data(), temp_byte_buffer.size());
15876 |  74 |         }
15877 |  75 | 
15878 |  76 |         current_time = std::chrono::system_clock::now();
15879 |  77 |         std::cout
15880 |  78 |             << "--- [Host] Phase 0: Preparing data structures big node dist ("
15881 |  79 |             << std::chrono::duration<double>(current_time - start_time).count()
15882 |  80 |             << " sec) ---" << std::endl;
15883 |  81 |         start_time = current_time;
15884 |  82 | 
15885 |  83 |         // --- Pack edge properties (node_id<24b> + weight<24b> -> 6 bytes) ---
15886 |  84 |         {
15887 |  85 |             const size_t bytes_per_edge =
15888 |  86 |                 (NODE_ID_BITWIDTH + WEIGHT_BITWIDTH) / 8;
15889 |  87 |             const size_t edges_per_word = bytes_per_word / bytes_per_edge;
15890 |  88 |             const size_t word_number =
15891 |  89 |                 (p_graph.num_edges + edges_per_word - 1) / edges_per_word;
15892 |  90 |             std::vector<char> temp_byte_buffer;
15893 |  91 |             temp_byte_buffer.reserve(word_number * bytes_per_word);
15894 |  92 | 
15895 |  93 |             for (size_t j = 0; j < p_graph.num_edges; ++j) {
15896 |  94 |                 if ((temp_byte_buffer.size() % bytes_per_word) +
15897 |  95 |                         bytes_per_edge >
15898 |  96 |                     bytes_per_word) {
15899 |  97 |                     size_t padding_needed =
15900 |  98 |                         bytes_per_word -
15901 |  99 |                         (temp_byte_buffer.size() % bytes_per_word);
15902 | 100 |                     temp_byte_buffer.insert(temp_byte_buffer.end(),
15903 | 101 |                                             padding_needed, 0);
15904 | 102 |                 }
15905 | 103 | 
15906 | 104 |                 char edge_bytes[bytes_per_edge];
15907 | 105 |                 uint32_t dest_id = p_graph.columns[j];
15908 | 106 |                 for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
15909 | 107 |                     edge_bytes[b] = (dest_id >> (8 * b)) & 0xFF;
15910 | 108 |                 }
15911 | 109 | 
15912 | 110 |                 weight_t weight_val = (float)p_graph.weights[j];
15913 | 111 |                 std::memcpy(edge_bytes + (NODE_ID_BITWIDTH / 8), &weight_val,
15914 | 112 |                             (WEIGHT_BITWIDTH / 8));
15915 | 113 | 
15916 | 114 |                 temp_byte_buffer.insert(temp_byte_buffer.end(), edge_bytes,
15917 | 115 |                                         edge_bytes + bytes_per_edge);
15918 | 116 |             }
15919 | 117 |             big_kernel_input_buffers[i].packed_edge_props.resize(
15920 | 118 |                 (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word,
15921 | 119 |                 0);
15922 | 120 |             std::memcpy(big_kernel_input_buffers[i].packed_edge_props.data(),
15923 | 121 |                         temp_byte_buffer.data(), temp_byte_buffer.size());
15924 | 122 |         }
15925 | 123 | 
15926 | 124 |         current_time = std::chrono::system_clock::now();
15927 | 125 |         std::cout
15928 | 126 |             << "--- [Host] Phase 0: Preparing data structures edge props ("
15929 | 127 |             << std::chrono::duration<double>(current_time - start_time).count()
15930 | 128 |             << " sec) ---" << std::endl;
15931 | 129 |         start_time = current_time;
15932 | 130 | 
15933 | 131 |         // --- Pack source IDs (node_id_t -> 4 bytes) ---
15934 | 132 |         {
15935 | 133 |             const size_t bytes_per_id = sizeof(node_id_t);
15936 | 134 |             const size_t ids_per_word = bytes_per_word / bytes_per_id;
15937 | 135 |             const size_t word_number =
15938 | 136 |                 (p_graph.num_edges + ids_per_word - 1) / ids_per_word;
15939 | 137 |             std::vector<char> temp_byte_buffer;
15940 | 138 |             temp_byte_buffer.reserve(word_number * bytes_per_word);
15941 | 139 | 
15942 | 140 |             for (int j = 0; j < p_graph.num_vertices; ++j) {
15943 | 141 |                 for (int k = p_graph.offsets[j]; k < p_graph.offsets[j + 1];
15944 | 142 |                      ++k) {
15945 | 143 |                     node_id_t src_id = j;
15946 | 144 |                     const char *id_bytes =
15947 | 145 |                         reinterpret_cast<const char *>(&src_id);
15948 | 146 |                     for (size_t l = 0; l < bytes_per_id; ++l) {
15949 | 147 |                         temp_byte_buffer.push_back(id_bytes[l]);
15950 | 148 |                     }
15951 | 149 |                 }
15952 | 150 |             }
15953 | 151 | 
15954 | 152 |             big_kernel_input_buffers[i].packed_src_ids.resize(
15955 | 153 |                 (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word,
15956 | 154 |                 0);
15957 | 155 |             std::memcpy(big_kernel_input_buffers[i].packed_src_ids.data(),
15958 | 156 |                         temp_byte_buffer.data(), temp_byte_buffer.size());
15959 | 157 |         }
15960 | 158 | 
15961 | 159 |         current_time = std::chrono::system_clock::now();
15962 | 160 |         std::cout
15963 | 161 |             << "--- [Host] Phase 0: Preparing data structures src ids ("
15964 | 162 |             << std::chrono::duration<double>(current_time - start_time).count()
15965 | 163 |             << " sec) ---" << std::endl;
15966 | 164 |         start_time = current_time;
15967 | 165 |     }
15968 | 166 |     */
15969 | 167 |     
15970 | 168 |     // --- 2.2: 为 LITTLE kernels 手动序列化数据 (带 Padding) ---
15971 | 169 |     // ENABLED AND CORRECTED FOR LITTLE KERNEL TESTING
15972 | 170 |     for (size_t i = 0; i < little_kernel_input_buffers.size(); ++i) {
15973 | 171 |         const auto &p_graph = container.DPs[i].partitioned_graph;
15974 | 172 | 
15975 | 173 |         // --- Pack node distances (ap_fixed<24,8> -> 3 bytes) ---
15976 | 174 |         // 关键修正: 完全复制big kernel的逻辑，为HBM Manager准备数据
15977 | 175 |         {
15978 | 176 |             const size_t bytes_per_dist = DISTANCE_BITWIDTH / 8;
15979 | 177 |             const size_t dist_per_word = bytes_per_word / bytes_per_dist;
15980 | 178 |             const size_t word_number =
15981 | 179 |                 (p_graph.num_vertices + dist_per_word - 1) / dist_per_word;
15982 | 180 |             std::vector<char> temp_byte_buffer;
15983 | 181 |             temp_byte_buffer.reserve(word_number * bytes_per_word);
15984 | 182 | 
15985 | 183 |             for (int j = 0; j < p_graph.num_vertices; ++j) {
15986 | 184 |                 if ((temp_byte_buffer.size() % bytes_per_word) +
15987 | 185 |                         bytes_per_dist >
15988 | 186 |                     bytes_per_word) {
15989 | 187 |                     size_t padding_needed =
15990 | 188 |                         bytes_per_word -
15991 | 189 |                         (temp_byte_buffer.size() % bytes_per_word);
15992 | 190 |                     temp_byte_buffer.insert(temp_byte_buffer.end(),
15993 | 191 |                                             padding_needed,
15994 | 192 |                                             0); 
15995 | 193 |                 }
15996 | 194 | 
15997 | 195 |                 int global_id = p_graph.vtx_map_rev.at(j);
15998 | 196 |                 distance_t dist_val = h_distances[global_id];
15999 | 197 | 
16000 | 198 |                 const char *data_ptr =
16001 | 199 |                     reinterpret_cast<const char *>(&dist_val);
16002 | 200 |                 temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr,
16003 | 201 |                                         data_ptr + bytes_per_dist);
16004 | 202 |             }
16005 | 203 |             // 关键修正点：目标是hbm_manager_host_buffers[0]，因为只有一个HBM manager
16006 | 204 |             hbm_manager_host_buffers[0].packed_node_props.resize(
16007 | 205 |                 (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word,
16008 | 206 |                 0);
16009 | 207 |             std::memcpy(hbm_manager_host_buffers[0].packed_node_props.data(),
16010 | 208 |                         temp_byte_buffer.data(), temp_byte_buffer.size());
16011 | 209 |         }
16012 | 210 | 
16013 | 211 |         current_time = std::chrono::system_clock::now();
16014 | 212 |         std::cout << "--- [Host] Phase 0: Preparing data structures little node dist ("
16015 | 213 |                   << std::chrono::duration<double>(current_time - start_time).count()
16016 | 214 |                   << " sec) ---" << std::endl;
16017 | 215 |         start_time = current_time;
16018 | 216 | 
16019 | 217 |         // --- Pack edge properties (node_id<24b> + weight<24b> -> 6 bytes) ---
16020 | 218 |         // 关键修正: 完全复制big kernel的逻辑
16021 | 219 |         {
16022 | 220 |             const size_t bytes_per_edge =
16023 | 221 |                 (NODE_ID_BITWIDTH + WEIGHT_BITWIDTH) / 8;
16024 | 222 |             const size_t edges_per_word = bytes_per_word / bytes_per_edge;
16025 | 223 |             const size_t word_number = (p_graph.num_edges + edges_per_word - 1) /
16026 | 224 |                                        edges_per_word;
16027 | 225 |             std::vector<char> temp_byte_buffer;
16028 | 226 |             temp_byte_buffer.reserve(word_number * bytes_per_word);
16029 | 227 | 
16030 | 228 |             for (size_t j = 0; j < p_graph.num_edges; ++j) {
16031 | 229 |                 if ((temp_byte_buffer.size() % bytes_per_word) +
16032 | 230 |                         bytes_per_edge >
16033 | 231 |                     bytes_per_word) {
16034 | 232 |                     size_t padding_needed =
16035 | 233 |                         bytes_per_word -
16036 | 234 |                         (temp_byte_buffer.size() % bytes_per_word);
16037 | 235 |                     temp_byte_buffer.insert(temp_byte_buffer.end(),
16038 | 236 |                                             padding_needed, 0);
16039 | 237 |                 }
16040 | 238 |                 char edge_bytes[bytes_per_edge];
16041 | 239 |                 uint32_t dest_id = p_graph.columns[j];
16042 | 240 |                 for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
16043 | 241 |                     edge_bytes[b] = (dest_id >> (8 * b)) & 0xFF;
16044 | 242 |                 }
16045 | 243 |                 weight_t weight_val = (float)p_graph.weights[j];
16046 | 244 |                 std::memcpy(edge_bytes + (NODE_ID_BITWIDTH / 8), &weight_val, (WEIGHT_BITWIDTH / 8));
16047 | 245 |                 temp_byte_buffer.insert(temp_byte_buffer.end(), edge_bytes,
16048 | 246 |                                         edge_bytes + bytes_per_edge);
16049 | 247 |             }
16050 | 248 |             little_kernel_input_buffers[i].packed_edge_props.resize(
16051 | 249 |                 (temp_byte_buffer.size() + bytes_per_word - 1) /
16052 | 250 |                 bytes_per_word, 0);
16053 | 251 |             std::memcpy(little_kernel_input_buffers[i].packed_edge_props.data(),
16054 | 252 |                         temp_byte_buffer.data(), temp_byte_buffer.size());
16055 | 253 |         }
16056 | 254 | 
16057 | 255 |         current_time = std::chrono::system_clock::now();
16058 | 256 |         std::cout << "--- [Host] Phase 0: Preparing data structures little edge props ("
16059 | 257 |                   << std::chrono::duration<double>(current_time - start_time).count()
16060 | 258 |                   << " sec) ---" << std::endl;
16061 | 259 |         start_time = current_time;
16062 | 260 | 
16063 | 261 |         // --- Pack source IDs (node_id_t -> 4 bytes) ---
16064 | 262 |         // 关键修正: 完全复制big kernel的逻辑
16065 | 263 |         {
16066 | 264 |             const size_t bytes_per_id = sizeof(node_id_t);
16067 | 265 |             const size_t ids_per_word = bytes_per_word / bytes_per_id;
16068 | 266 |             const size_t word_number =
16069 | 267 |                 (p_graph.num_edges + ids_per_word - 1) / ids_per_word;
16070 | 268 |             std::vector<char> temp_byte_buffer;
16071 | 269 |             temp_byte_buffer.reserve(word_number * bytes_per_word);
16072 | 270 | 
