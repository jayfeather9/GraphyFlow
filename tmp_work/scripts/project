19686 |  253 | void stream2axistream(hls::stream<T1> &stream, hls::stream<T2> &axi_stream) {
19687 |  254 | LOOP_STREAM2AXISTREAM:
19688 |  255 |     while (true) {
19689 |  256 | #pragma HLS PIPELINE II = 1
19690 |  257 |         T1 tmp_t1 = stream.read();
19691 |  258 | 
19692 |  259 |         T2 tmp_t2;
19693 |  260 |         tmp_t2.data = tmp_t1.idx;
19694 |  261 |         tmp_t2.dest = tmp_t1.dst;
19695 |  262 |         tmp_t2.last = tmp_t1.end_flag;
19696 |  263 | 
19697 |  264 |         axi_stream.write(tmp_t2);
19698 |  265 | 
19699 |  266 |         if (tmp_t1.end_flag)
19700 |  267 |             break;
19701 |  268 |     }
19702 |  269 | }
