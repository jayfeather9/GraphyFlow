 357 | // --- REWRITTEN: New final_writeback function packs results into 512-bit words.
 358 | static void final_writeback(hls::stream<internal_end_data_batch_t> &in_stream,
 359 |                             bus_word_t *out_ddr) {
 360 |     const int bits_per_output =
 361 |         NODE_ID_BITWIDTH + DISTANCE_BITWIDTH + OUT_END_MARKER_BITWIDTH;
 362 |     const int outputs_per_word = AXI_BUS_WIDTH / bits_per_output;
 363 | 
 364 |     bus_word_t write_word = 0;
 365 |     int pack_count = 0;
 366 |     int ddr_addr = 0;
 367 | 
 368 | LOOP_WRITEBACK_MAIN:
 369 |     while (true) {
 370 | #pragma HLS PIPELINE II = 1
 371 |         internal_end_data_batch_t in_batch;
 372 |         if (in_stream.read_nb(in_batch)) {
 373 | 
 374 |         LOOP_WRITEBACK_PACK:
 375 |             for (int i = 0; i < in_batch.end_pos; i++) {
 376 | #pragma HLS UNROLL
 377 |                 node_with_prop_t item = in_batch.data[i];
 378 |                 ap_uint<bits_per_output> packed_output;
 379 |                 // printf("[LITTLE]Packing output: node_id=%d, distance=%f\n",
 380 |                 // (int)item.node_id, (float)*reinterpret_cast<distance_t
 381 |                 // *>(&item.prop)); fflush(NULL);
 382 |                 packed_output.range(NODE_ID_BITWIDTH - 1, 0) = item.node_id;
 383 |                 packed_output.range(NODE_ID_BITWIDTH + DISTANCE_BITWIDTH - 1,
 384 |                                     NODE_ID_BITWIDTH) = item.prop;
 385 |                 out_end_marker_t end_marker =
 386 |                     0; // No end marker for regular entries
 387 |                 packed_output.range(bits_per_output - 1,
 388 |                                     NODE_ID_BITWIDTH + DISTANCE_BITWIDTH) =
 389 |                     end_marker;
 390 |                 ap_fixed_pod_t tmp_dist = packed_output.range(
 391 |                     NODE_ID_BITWIDTH + DISTANCE_BITWIDTH - 1, NODE_ID_BITWIDTH);
 392 |                 // printf("[LITTLE]Packing output: node_id=%d, distance=%f\n",
 393 |                 // (int)packed_output.range(NODE_ID_BITWIDTH - 1, 0),
 394 |                 // (float)*reinterpret_cast<distance_t *>(&tmp_dist));
 395 |                 // fflush(NULL);
 396 | 
 397 |                 int start_bit = pack_count * bits_per_output;
 398 |                 write_word.range(start_bit + bits_per_output - 1, start_bit) =
 399 |                     packed_output;
 400 | 
 401 |                 pack_count++;
 402 |                 if (pack_count == outputs_per_word) {
 403 |                     // printf("[LITTLE] Writing packed word to DDR at address
 404 |                     // %d\n", ddr_addr); fflush(NULL);
 405 |                     out_ddr[ddr_addr++] = write_word;
 406 |                     write_word = 0;
 407 |                     pack_count = 0;
 408 |                 }
 409 |             }
 410 | 
 411 |             if (in_batch.end_flag) {
 412 |                 break;
 413 |             }
 414 |         }
 415 |     }
 416 | 
 417 |     // if pack_count is 0, write a final end marker word
 418 |     // else, put the end marker in the current write_word and write it
 419 |     ap_uint<bits_per_output> end_marker;
 420 |     end_marker.range(NODE_ID_BITWIDTH - 1, 0) = 0;
 421 |     end_marker.range(NODE_ID_BITWIDTH + DISTANCE_BITWIDTH - 1,
 422 |                      NODE_ID_BITWIDTH) = 0; // Distance = 0
 423 |     end_marker.range(bits_per_output - 1,
 424 |                      NODE_ID_BITWIDTH + DISTANCE_BITWIDTH) =
 425 |         (out_end_marker_t)1; // End marker = 1
 426 |     if (pack_count == 0) {
 427 |         bus_word_t end_word = 0;
 428 |         end_word.range(bits_per_output - 1, 0) = end_marker;
 429 |         out_ddr[ddr_addr++] = end_word;
 430 |     } else {
 431 |         int start_bit = pack_count * bits_per_output;
 432 |         write_word.range(start_bit + bits_per_output - 1, start_bit) =
 433 |             end_marker;
 434 |         out_ddr[ddr_addr++] = write_word;
 435 |     }
 436 | }
