16910 | 112 | std::vector<unsigned char>
16911 | 113 | read_binary_file(const std::string &xclbin_file_name) {
16912 | 114 |     std::cout << "INFO: Reading " << xclbin_file_name << std::endl;
16913 | 115 |     FILE *fp;
16914 | 116 |     if ((fp = fopen(xclbin_file_name.c_str(), "r")) == nullptr) {
16915 | 117 |         printf("ERROR: %s xclbin not available please build\n",
16916 | 118 |                xclbin_file_name.c_str());
16917 | 119 |         exit(EXIT_FAILURE);
16918 | 120 |     }
16919 | 121 |     // Loading XCL Bin into char buffer
16920 | 122 |     std::cout << "Loading: '" << xclbin_file_name.c_str() << "'\n";
16921 | 123 |     std::ifstream bin_file(xclbin_file_name.c_str(), std::ifstream::binary);
16922 | 124 |     bin_file.seekg(0, bin_file.end);
16923 | 125 |     auto nb = bin_file.tellg();
16924 | 126 |     bin_file.seekg(0, bin_file.beg);
16925 | 127 |     std::vector<unsigned char> buf;
16926 | 128 |     buf.resize(nb);
16927 | 129 |     bin_file.read(reinterpret_cast<char *>(buf.data()), nb);
16928 | 130 |     return buf;
16929 | 131 | }
