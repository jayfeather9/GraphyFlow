 5597 |  5354 | 5264 |  100 | ap_uint<4> count_end_ones(ap_uint<PE_NUM> valid_mask) {
 5598 |  5355 | 5265 |  101 | #pragma HLS INLINE
 5599 |  5356 | 5266 |  102 |     ap_uint<4> count = 0;
 5600 |  5357 | 5267 |  103 |     switch (valid_mask) {
 5601 |  5358 | 5268 |  104 |     case 0:
 5602 |  5359 | 5269 |  105 |         count = 0;
