 439 | static void stream_zipper_3(
 440 |     hls::stream<struct_ibu_14_t> &in_key_batch_stream,
 441 |     hls::stream<internal_end_data_batch_t> &in_transform_batch_stream,
 442 |     hls::stream<struct_kbu_50_t> &out_pair_batch_stream) {
