 2168 |  1925 | 1835 | 157 | std::string convert_size(size_t size) {
 2169 |  1926 | 1836 | 158 |     static const char *SIZES[] = {"B", "KB", "MB", "GB"};
 2170 |  1927 | 1837 | 159 |     uint32_t div = 0;
 2171 |  1928 | 1838 | 160 |     size_t rem = 0;
 2172 |  1929 | 1839 | 161 | 
 2173 |  1930 | 1840 | 162 |     while (size >= 1024 && div < (sizeof SIZES / sizeof *SIZES)) {
 2174 |  1931 | 1841 | 163 |         rem = (size % 1024);
 2175 |  1932 | 1842 | 164 |         div++;
 2176 |  1933 | 1843 | 165 |         size /= 1024;
 2177 |  1934 | 1844 | 166 |     }
 2178 |  1935 | 1845 | 167 | 
 2179 |  1936 | 1846 | 168 |     double size_d = (float)size + (float)rem / 1024.0;
 2180 |  1937 | 1847 | 169 |     double size_val = round_off(size_d);
 2181 |  1938 | 1848 | 170 | 
 2182 |  1939 | 1849 | 171 |     std::stringstream stream;
 2183 |  1940 | 1850 | 172 |     stream << std::fixed << std::setprecision(2) << size_val;
 2184 |  1941 | 1851 | 173 |     std::string size_str = stream.str();
 2185 |  1942 | 1852 | 174 |     std::string result = size_str + " " + SIZES[div];
 2186 |  1943 | 1853 | 175 |     return result;
 2187 |  1944 | 1854 | 176 | }
