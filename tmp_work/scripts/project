 9090 |  8847 | 567 | bool AlgorithmHost::check_convergence_and_update(const PartitionContainer &container) {
 9091 |  8848 | 568 |     bool changed = false;
 9092 |  8849 | 569 |     std::cout << "--- [Host] Phase 5: Unpacking results and checking for convergence ---" << std::endl;
 9093 |  8850 | 570 | 
 9094 |  8851 | 571 |     std::map<int, distance_t> min_distances;
 9095 |  8852 | 572 |     const int bits_per_output = NODE_ID_BITWIDTH + DISTANCE_BITWIDTH + OUT_END_MARKER_BITWIDTH;
 9096 |  8853 | 573 |     const int outputs_per_word = AXI_BUS_WIDTH / bits_per_output;
 9097 |  8854 | 574 | 
 9098 |  8855 | 575 |     // DISABLED
