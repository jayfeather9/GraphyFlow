16078 | 276 |                         reinterpret_cast<const char *>(&src_id);
16079 | 277 |                     for (size_t l = 0; l < bytes_per_id; ++l) {
16080 | 278 |                         temp_byte_buffer.push_back(id_bytes[l]);
16081 | 279 |                     }
16082 | 280 |                 }
16083 | 281 |             }
16084 | 282 | 
16085 | 283 |             little_kernel_input_buffers[i].packed_src_ids.resize(
16086 | 284 |                 (temp_byte_buffer.size() + bytes_per_word - 1) /
16087 | 285 |                     bytes_per_word,
16088 | 286 |                 0);
16089 | 287 |             std::memcpy(little_kernel_input_buffers[i].packed_src_ids.data(),
16090 | 288 |                         temp_byte_buffer.data(), temp_byte_buffer.size());
16091 | 289 |         }
16092 | 290 | 
