 148 | 
 149 | // 新增函数
 150 | static void ping_pong_buffer_manager(
 151 |     hls::stream<ppb_request_dt>     &ppb_request_stm,
 152 |     hls::stream<ppb_response_dt>    &ppb_response_stm,
 153 |     hls::stream<edge_descriptor_batch_t> &edge_batch_stream,
 154 |     hls::stream<node_id_burst_t> &stream_src_id,
 155 |     hls::stream<edge_batch_t> &stream_edge_data,
 156 |     int32_t num_edges
 157 | ) {
 158 | 
 159 |      // as we can buffer two vertices in one row with width of 64-bit, we can let the depth go as MAX_VERTICES_IN_ONE_PARTITION / 2.
 160 |     ap_uint<512> src_prop_buffer[SCATTER_PE_NUM][2][SRC_BUFFER_SIZE >> 4];
 161 | 
 162 | #pragma HLS ARRAY_PARTITION variable=src_prop_buffer dim=1 complete
 163 | #pragma HLS BIND_STORAGE variable=src_prop_buffer type = RAM_S2P impl = BRAM
 164 | #pragma HLS dependence variable=src_prop_buffer inter false    
 165 | 
 166 |     ap_uint<32> pp_read_idx = 0;
 167 |     ap_uint<32> pp_write_idx = 0;
 168 | 
 169 |     ap_uint<32> pp_reponse_idx = 0;
 170 | 
 171 |     ap_uint<32> pp_read_round = 0;
 172 |     ap_uint<32> pp_write_round = 0;
 173 | 
 174 |     ap_uint<32> pp_request_round = 0;
 175 | 
 176 |     ap_uint<32> edge_set_cnt = 0;
 177 |     
 178 |     bool wait_flag = 0;
 179 | 
 180 |     // edge_burst_dt an_edge_burst; // <-- 不再使用
 181 |     
 182 |     ppb_request_dt one_ppb_request;
 183 | 
 184 |     ppb_response_dt one_ppb_response;
 185 |     
 186 |     // 【修改】为新的输入/输出数据声明变量
 187 |     edge_descriptor_batch_t an_edge_desc_batch;
 188 |     node_id_burst_t a_src_id_burst;
 189 | 
 190 |     scatterLoop:
 191 |     while (true)
 192 |     {
 193 | #pragma HLS PIPELINE II=1
 194 |         // logic to fill the ping-pong buffer.
 195 |         if((pp_request_round - pp_read_round) <= 1){
 196 |             if(pp_request_round < pp_read_round) 
 197 |                 pp_request_round = pp_read_round;
 198 | 
 199 |             one_ppb_request.request_round = pp_request_round;
 200 |             one_ppb_request.end_flag = 0;
 201 | 
 202 |             ppb_request_stm.write(one_ppb_request);
 203 |             pp_request_round ++;
 204 |         }
 205 |         
 206 |         if(ppb_response_stm.read_nb(one_ppb_response)){
 207 |             
 208 |             pp_write_round = one_ppb_response.addr << 4 >> LOG2_SRC_BUFFER_SIZE;
 209 | 
 210 |             bool write_buffer = pp_write_round & 0x1;
 211 | 
 212 |             uint write_idx = one_ppb_response.addr & ((SRC_BUFFER_SIZE >> 4) - 1);
 213 | 
 214 |             ap_uint<512> one_read_burst = one_ppb_response.data; 
 215 | 
 216 |             for (int u = 0; u < SCATTER_PE_NUM; u++){
 217 |             #pragma HLS UNROLL
 218 |                 src_prop_buffer[u][write_buffer][write_idx] = one_read_burst;
 219 |             }
 220 |         }
 221 |         
 222 |         // --- 【修改】重写消费者逻辑 ---
 223 | 
 224 |         if(!wait_flag) {
 225 |             // 从两个流中读取数据
 226 |             an_edge_desc_batch = edge_batch_stream.read();
 227 |             a_src_id_burst = stream_src_id.read();
 228 |         }
 229 | 
 230 |         // 使用 src_id 计算所需的轮次
 231 |         // (假设一个 burst 中的所有 src_id 都在同一个轮次)
 232 |         pp_read_round = (a_src_id_burst.data[0].range(30, 0) / SRC_BUFFER_SIZE);
 233 | 
 234 |         if(pp_read_round >= pp_write_round) 
 235 |             wait_flag = 1; 
 236 |         else 
 237 |             wait_flag = 0;
 238 | 
 239 |         //DEBUG_PRINTF(" scatter pp_read_round = %d \n", (uint)pp_read_round);
 240 | 
 241 |         if(!wait_flag){
 242 | 
 243 |             bool read_buffer = pp_read_round & 0x1;
 244 |             
 245 |             // 声明输出类型
 246 |             edge_batch_t output_batch;
 247 | #pragma HLS DATA_PACK variable=output_batch
 248 |             
 249 |             for (int u = 0; u < PE_NUM; u ++){ 
 250 |             #pragma HLS UNROLL
 251 |                 // 使用 src_id 进行查找
 252 |                 node_id_t src_id = a_src_id_burst.data[u];
 253 |                 ap_uint<31> idx = (src_id.range(30, 0) % SRC_BUFFER_SIZE);
 254 |                 ap_uint<30> uram_row_idx = idx >> 4; // BRAM 行索引 (0-255)
 255 |                 ap_uint<30> uram_row_offset = (idx & 0xf); // 512位行内的偏移 (0-15)
 256 | 
 257 |                 ap_uint<512> uram_row = src_prop_buffer[u][read_buffer][uram_row_idx];
 258 |                 
 259 |                 // 提取32位的 src 属性 (距离)
 260 |                 ap_uint<32> src_prop = uram_row.range(31 + (uram_row_offset << 5), (uram_row_offset << 5));  
 261 | 
 262 |                 // 打包成 edge_batch_t
 263 |                 output_batch.src_distances[u] = src_prop;
 264 |                 output_batch.dsts[u] = an_edge_desc_batch.edges[u].node_id;
 265 |                 output_batch.weights[u] = an_edge_desc_batch.edges[u].prop;
 266 |             }
 267 |             
 268 |             // 设置 end_pos 和 end_flag
 269 |             output_batch.end_pos = an_edge_desc_batch.end_pos;
 270 |             output_batch.end_flag = false; // 由下面的 edge_set_cnt 控制
 271 | 
 272 |             // 写入到正确的输出流
 273 |             stream_edge_data.write(output_batch);
 274 |             edge_set_cnt ++;
 275 |         }
 276 |         //DEBUG_PRINTF("current processed sets of edges = %d \n", cnt++);
 277 | 
 278 |         // 【修改】使用正确的变量 (num_edges, LOG_PE_NUM) 来判断结束
 279 |         if(edge_set_cnt >= (num_edges >> LOG_PE_NUM)){ // LOG_PE_NUM = 3
 280 |             one_ppb_request.end_flag = 1;
 281 |             ppb_request_stm.write(one_ppb_request); // 发送结束请求
 282 |             exitscatter:
 283 |             while(1){ 
 284 |                 one_ppb_response = ppb_response_stm.read(); // 使用阻塞读来清空
 285 |                 if (one_ppb_response.end_flag) break;    
 286 |             }
 287 |             //DEBUG_PRINTF("function accScatter exits!\n");
 288 |             break;
 289 |         }  
 290 |     }
 291 | 
 292 |    
 293 | }
