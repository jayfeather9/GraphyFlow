19570 |  137 | static void
19571 |  138 | dist_req_packer(hls::stream<node_id_burst_t> &src_id_burst_stream,
19572 |  139 |                 hls::stream<distance_req_pack_t> &distance_req_pack_stream,
19573 |  140 |                 int32_t num_nodes) {
19574 |  141 | 
19575 |  142 |     const int max_node_burst_idx = (num_nodes + PE_NUM - 1) / PE_NUM;
19576 |  143 |     ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> last_idx_max = 0;
19577 |  144 | 
19578 |  145 | LOOP_DRP_SEND_REQ:
19579 |  146 |     for (int32_t node_burst_idx = 0; node_burst_idx < max_node_burst_idx;
19580 |  147 |          node_burst_idx += 1) {
19581 |  148 | #pragma HLS PIPELINE II = 1
19582 |  149 |         ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cache_idx[PE_NUM];
19583 |  150 | #pragma HLS ARRAY_PARTITION variable = cache_idx complete dim = 0
19584 |  151 |         node_id_burst_t node_id_burst = src_id_burst_stream.read();
19585 |  152 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
19586 |  153 | #pragma HLS UNROLL
19587 |  154 |             cache_idx[pe_idx] = node_id_burst.data[pe_idx] >> LOG_DIST_PER_WORD;
19588 |  155 |             // printf("PE %d requests node ID %d (cache idx %d)\n", pe_idx,
19589 |  156 |             // (int)node_id_burst.data[pe_idx], (int)cache_idx[pe_idx]);
19590 |  157 |             // fflush(NULL);
19591 |  158 |         }
19592 |  159 | 
19593 |  160 |         ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cache_idx_diffs[PE_NUM];
19594 |  161 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
19595 |  162 | #pragma HLS UNROLL
19596 |  163 |             cache_idx_diffs[pe_idx] = cache_idx[pe_idx] - last_idx_max;
19597 |  164 |             // printf("PE %d cache idx diff: %d\n", pe_idx,
19598 |  165 |             // (int)cache_idx_diffs[pe_idx]); fflush(NULL);
19599 |  166 |         }
19600 |  167 | 
19601 |  168 |         // if not all diffs are zero, send a req_pack
19602 |  169 |         if (cache_idx_diffs[PE_NUM - 1]) {
19603 |  170 |             ap_uint<PE_NUM> valid_mask;
19604 |  171 |             for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
19605 |  172 | #pragma HLS UNROLL
19606 |  173 |                 if (cache_idx_diffs[pe_idx] == 0) {
19607 |  174 |                     valid_mask[pe_idx] = 1;
19608 |  175 |                 } else {
19609 |  176 |                     valid_mask[pe_idx] = 0;
19610 |  177 |                 }
19611 |  178 |             }
19612 |  179 | 
19613 |  180 |             ap_uint<4> num_unread = count_end_ones(valid_mask);
19614 |  181 |             // printf("Packing req for %d unread PEs\n", (int)num_unread);
19615 |  182 |             // fflush(NULL);
19616 |  183 | 
19617 |  184 |             distance_req_pack_t req_pack;
19618 |  185 |             req_pack.offset = num_unread;
19619 |  186 |             req_pack.end_flag = false;
19620 |  187 | 
19621 |  188 |             for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
19622 |  189 | #pragma HLS UNROLL
19623 |  190 |                 req_pack.node_ids[pe_idx] = node_id_burst.data[pe_idx];
19624 |  191 |                 // printf("Req pack PE %d node ID: %d\n", pe_idx,
19625 |  192 |                 // (int)req_pack.node_ids[pe_idx]); fflush(NULL);
19626 |  193 |             }
19627 |  194 | 
19628 |  195 |             distance_req_pack_stream.write(req_pack);
19629 |  196 |         }
19630 |  197 | 
19631 |  198 |         last_idx_max = cache_idx[PE_NUM - 1];
19632 |  199 |     }
19633 |  200 | 
19634 |  201 |     distance_req_pack_t end_req_pack;
19635 |  202 |     end_req_pack.end_flag = true;
19636 |  203 |     end_req_pack.offset = 8;
19637 |  204 |     distance_req_pack_stream.write(end_req_pack);
19638 |  205 | }
