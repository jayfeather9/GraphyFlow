17875 |  250 |                 ap_uint<32> src_prop = uram_row.range(31 + (uram_row_offset << 5), (uram_row_offset << 5));  
17876 |  251 | 
17877 |  252 |                 ap_uint<32> update = PROP_COMPUTE_STAGE0(src_prop);
17878 |  253 | 
17879 |  254 |                 // ap_uint<32> update = uram_row.range(31 + (uram_row_offset << 5), (uram_row_offset << 5));
17880 |  255 |                 
17881 |  256 |                 an_update_set.tuples[u].update = update;
17882 |  257 |                 an_update_set.tuples[u].dst = an_edge_burst.edges[u].dst;
17883 |  258 |             }
17884 |  259 |             write_to_stream(update_set_stm, an_update_set);
17885 |  260 |             edge_set_cnt ++;
17886 |  261 |         }
17887 |  262 |         //DEBUG_PRINTF("current processed sets of edges = %d \n", cnt++);
17888 |  263 | 
17889 |  264 |         if(edge_set_cnt >= (part_edge_num >> LOG2_NUM_EDGE_PER_BURST)){
17890 |  265 |             one_ppb_request.end_flag = 1;
17891 |  266 |             write_to_stream(ppb_request_stm, one_ppb_request);
17892 |  267 |             exitscatter:
17893 |  268 |             while(1){ 
17894 |  269 |                 read_from_stream(ppb_response_stm, one_ppb_response);
17895 |  270 |                 if (one_ppb_response.end_flag) break;    
17896 |  271 |             }
17897 |  272 |             DEBUG_PRINTF("function accScatter exits!\n");
17898 |  273 |             break;
17899 |  274 |         }  
17900 |  275 |     }
17901 |  276 | }
