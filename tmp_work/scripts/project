 6323 |  6080 | 5990 |  826 | #pragma HLS PIPELINE
 6324 |  6081 | 5991 |  827 |         in_batch_i_global_data_0 = i_global_data_0.read();
 6325 |  6082 | 5992 |  828 |         in_batch_i_global_data_1 = i_global_data_1.read();
