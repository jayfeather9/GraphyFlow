## File: main.mk

- Extension: .mk
- Language: unknown
- Size: 836 bytes
- Created: 2025-10-16 22:56:38
- Modified: 2025-10-16 22:56:38

### Code

```unknown
 1 | SHELL           := /bin/bash
 2 | 
 3 | COMMON_REPO     = ./
 4 | ABS_COMMON_REPO = $(shell readlink -f $(COMMON_REPO))
 5 | SCRIPTS_PATH    = ./scripts
 6 | 
 7 | # Remove unused targets from .PHONY
 8 | .PHONY: all clean cleanall exe emconfig
 9 | 
10 | include $(SCRIPTS_PATH)/help.mk
11 | include $(SCRIPTS_PATH)/utils.mk
12 | 
13 | include global_para.mk
14 | 
15 | # Use SCRIPTS_PATH for consistency
16 | 
17 | # Remove non-existent makefiles
18 | # include autogen/autogen.mk
19 | # include acc_template/acc.mk
20 | 
21 | # Include our new kernel makefile
22 | include $(SCRIPTS_PATH)/kernel/kernel.mk
23 | 
24 | include $(SCRIPTS_PATH)/host/host.mk 
25 | 
26 | # This include seems to be for Vitis 1.0 examples, not needed here
27 | # include $(SCRIPTS_PATH)/bitstream.mk
28 | include $(SCRIPTS_PATH)/clean.mk
29 | 
30 | # Update the 'all' rule to depend on the .xclbin file, the host executable, and emconfig
31 | all: $(XCLBIN_FILE) $(EXECUTABLE) emconfig
32 | 
33 | exe: $(EXECUTABLE)
```

