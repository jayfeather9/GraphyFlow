 8299 |  8056 |  34 | #include <CL/cl2.hpp>
 8300 |  8057 |  35 | #include <CL/cl_ext_xilinx.h>
 8301 |  8058 |  36 | #include <fstream>
 8302 |  8059 |  37 | #include <iostream>
 8303 |  8060 |  38 | // When creating a buffer with user pointer (CL_MEM_USE_HOST_PTR), under the
 8304 |  8061 |  39 | // hood
 8305 |  8062 |  40 | // User ptr is used if and only if it is properly aligned (page aligned). When
 8306 |  8063 |  41 | // not
 8307 |  8064 |  42 | // aligned, runtime has no choice but to create its own host side buffer that
 8308 |  8065 |  43 | // backs
 8309 |  8066 |  44 | // user ptr. This in turn implies that all operations that move data to and from
 8310 |  8067 |  45 | // device incur an extra memcpy to move data to/from runtime's own host buffer
 8311 |  8068 |  46 | // from/to user pointer. So it is recommended to use this allocator if user wish
 8312 |  8069 |  47 | // to
 8313 |  8070 |  48 | // Create Buffer/Memory Object with CL_MEM_USE_HOST_PTR to align user buffer to
 8314 |  8071 |  49 | // the
 8315 |  8072 |  50 | // page boundary. It will ensure that user buffer will be used when user create
 8316 |  8073 |  51 | // Buffer/Mem Object with CL_MEM_USE_HOST_PTR.
 8317 |  8074 |  52 | template <typename T> struct aligned_allocator {
 8318 |  8075 |  53 |     using value_type = T;
 8319 |  8076 |  54 | 
 8320 |  8077 |  55 |     aligned_allocator() {}
 8321 |  8078 |  56 | 
 8322 |  8079 |  57 |     aligned_allocator(const aligned_allocator &) {}
 8323 |  8080 |  58 | 
 8324 |  8081 |  59 |     template <typename U> aligned_allocator(const aligned_allocator<U> &) {}
 8325 |  8082 |  60 | 
 8326 |  8083 |  61 |     T *allocate(std::size_t num) {
 8327 |  8084 |  62 |         void *ptr = nullptr;
 8328 |  8085 |  63 | 
 8329 |  8086 |  64 | #if defined(_WINDOWS)
 8330 |  8087 |  65 |         {
 8331 |  8088 |  66 |             ptr = _aligned_malloc(num * sizeof(T), 4096);
 8332 |  8089 |  67 |             if (ptr == nullptr) {
 8333 |  8090 |  68 |                 std::cout << "Failed to allocate memory" << std::endl;
 8334 |  8091 |  69 |                 exit(EXIT_FAILURE);
 8335 |  8092 |  70 |             }
 8336 |  8093 |  71 |         }
 8337 |  8094 |  72 | #else
 8338 |  8095 |  73 |         {
 8339 |  8096 |  74 |             if (posix_memalign(&ptr, 4096, num * sizeof(T)))
 8340 |  8097 |  75 |                 throw std::bad_alloc();
 8341 |  8098 |  76 |         }
 8342 |  8099 |  77 | #endif
 8343 |  8100 |  78 |         return reinterpret_cast<T *>(ptr);
 8344 |  8101 |  79 |     }
 8345 |  8102 |  80 |     void deallocate(T *p, std::size_t num) {
 8346 |  8103 |  81 | #if defined(_WINDOWS)
 8347 |  8104 |  82 |         _aligned_free(p);
 8348 |  8105 |  83 | #else
 8349 |  8106 |  84 |         free(p);
 8350 |  8107 |  85 | #endif
 8351 |  8108 |  86 |     }
 8352 |  8109 |  87 | };
 8353 |  8110 |  88 | 
 8354 |  8111 |  89 | namespace xcl {
 8355 |  8112 |  90 | std::vector<cl::Device> get_xil_devices();
 8356 |  8113 |  91 | std::vector<cl::Device> get_devices(const std::string &vendor_name);
 8357 |  8114 |  92 | cl::Device find_device_bdf(const std::vector<cl::Device> &devices,
 8358 |  8115 |  93 |                            const std::string &bdf);
 8359 |  8116 |  94 | cl_device_id find_device_bdf_c(cl_device_id *devices, const std::string &bdf,
 8360 |  8117 |  95 |                                cl_uint dev_count);
