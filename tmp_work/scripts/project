20535 | 1102 |         for (int pe = 0; pe < PE_NUM; ++pe) {
20536 | 1103 | #pragma HLS UNROLL
20537 | 1104 |             words[pe] = prop_mem[pe][addr];
20538 | 1105 |         }
20539 | 1106 | 
20540 | 1107 |     LOOP_DRAIN_PACK_IDX:
