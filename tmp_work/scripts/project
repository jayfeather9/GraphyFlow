 8289 |  8046 |  24 | 
 8290 |  8047 |  25 | // OCL_CHECK doesn't work if call has templatized function call
 8291 |  8048 |  26 | #define OCL_CHECK(error, call)                                                 \
 8292 |  8049 |  27 |     call;                                                                      \
