10173 |  9930 | 134 |             std::set<int> local_vertices_set;
10174 |  9931 | 135 |             for (const auto &edge : partition_edges) {
10175 |  9932 | 136 |                 local_vertices_set.insert(edge.src);
10176 |  9933 | 137 |                 local_vertices_set.insert(edge.dest);
10177 |  9934 | 138 |             }
10178 |  9935 | 139 | 
10179 |  9936 | 140 |             int local_id_counter = 0;
