```cpp
  1 | 
  2 | #include "fpga_executor.h"
  3 | #include "acc_setup/acc_setup.h"
  4 | #include "generated_host.h"
  5 | #include "graph_preprocess/graph_preprocess.h"
  6 | #include <iostream>
  7 | 
  8 | #define KERNEL_NAME "graphyflow"
  9 | 
 10 | std::vector<int> run_fpga_kernel(const std::string &xclbin_path,
 11 |                                  const GraphCSR &graph, int start_node,
 12 |                                  double &total_kernel_time_sec,
 13 |                                  int &iter_count) {
 14 | 
 15 |     // GraphPartiton
 16 |     PartitionContainer partition_container = partitionGraph(&graph);
 17 | 
 18 |     // init accelerator
 19 |     AccDescriptor acc = initAccelerator(xclbin_path);
 20 | 
 21 |     AlgorithmHost algo_host(acc);
 22 |     algo_host.prepare_data(partition_container, start_node);
 23 |     algo_host.setup_buffers(partition_container);
 24 |     total_kernel_time_sec = 0;
 25 |     double current_kernel_time_sec = 0;
 26 |     int max_iterations = graph.num_vertices;
 27 |     int iter = 0;
 28 |     std::cout << "\nStarting FPGA execution..." << std::endl;
 29 | 
 30 |     for (iter = 0; iter < max_iterations; ++iter) {
 31 |         algo_host.update_data(partition_container);
 32 |         algo_host.transfer_data_to_fpga(partition_container);
 33 |         std::vector<cl::Event> big_kernel_events(acc.num_big_krnl),
 34 |             little_kernel_events(acc.num_little_krnl);
 35 |         algo_host.execute_kernel_iteration(
 36 |             partition_container, big_kernel_events, little_kernel_events);
 37 |         for (auto &q : acc.big_gs_queue)
 38 |             q.finish();
 39 |         acc.hbm_manager_queue.finish();
 40 |         for (auto &q : acc.little_gs_queue)
 41 |             q.finish();
 42 |         algo_host.transfer_data_from_fpga();
 43 | 
 44 |         // iv. 性能统计
 45 |         for (auto &event : big_kernel_events)
 46 |             event.wait();
 47 |         for (auto &event : little_kernel_events)
 48 |             event.wait();
 49 | 
 50 |         int cnt = 0;
 51 |         for (auto &event : big_kernel_events) {
 52 |             unsigned long start = 0, end = 0;
 53 |             event.getProfilingInfo(CL_PROFILING_COMMAND_START, &start);
 54 |             event.getProfilingInfo(CL_PROFILING_COMMAND_END, &end);
 55 |             double iteration_time_ns = end - start;
 56 |             current_kernel_time_sec =
 57 |                 std::max(current_kernel_time_sec, iteration_time_ns * 1.0e-9);
 58 |             double mteps = (double)partition_container.SPs[cnt].num_edges /
 59 |                            (iteration_time_ns * 1.0e-9) / 1.0e6;
 60 | 
 61 |             std::cout << "FPGA Iteration " << iter << ": "
 62 |                       << "Big Kernel " << cnt++ << ", "
 63 |                       << "Time = " << (iteration_time_ns * 1.0e-6) << " ms, "
 64 |                       << "Throughput = " << mteps << " MTEPS" << std::endl;
 65 |         }
 66 |         cnt = 0;
 67 |         for (auto &event : little_kernel_events) {
 68 |             unsigned long start = 0, end = 0;
 69 |             event.getProfilingInfo(CL_PROFILING_COMMAND_START, &start);
 70 |             event.getProfilingInfo(CL_PROFILING_COMMAND_END, &end);
 71 |             double iteration_time_ns = end - start;
 72 |             current_kernel_time_sec =
 73 |                 std::max(current_kernel_time_sec, iteration_time_ns * 1.0e-9);
 74 |             double mteps = (double)partition_container.DPs[cnt].num_edges /
 75 |                            (iteration_time_ns * 1.0e-9) / 1.0e6;
 76 | 
 77 |             std::cout << "FPGA Iteration " << iter << ": "
 78 |                       << "Little Kernel " << cnt++ << ", "
 79 |                       << "Time = " << (iteration_time_ns * 1.0e-6) << " ms, "
 80 |                       << "Throughput = " << mteps << " MTEPS" << std::endl;
 81 |         }
 82 | 
 83 |         double iteration_time_ns = current_kernel_time_sec * 1.0e9;
 84 |         total_kernel_time_sec += current_kernel_time_sec;
 85 |         current_kernel_time_sec = 0;
 86 |         double mteps =
 87 |             (double)graph.num_edges / (iteration_time_ns * 1.0e-9) / 1.0e6;
 88 | 
 89 |         std::cout << "FPGA Iteration " << iter << ": "
 90 |                   << "Time = " << (iteration_time_ns * 1.0e-6) << " ms, "
 91 |                   << "Throughput = " << mteps << " MTEPS" << std::endl;
 92 | 
 93 |         // v. 检查是否收敛。如果未收敛，此函数会更新 partition_container
 94 |         // 为下次迭代做准备
 95 |         if (algo_host.check_convergence_and_update(partition_container)) {
 96 |             std::cout << "FPGA computation converged after " << iter + 1
 97 |                       << " iteration(s)." << std::endl;
 98 |             break;
 99 |         }
100 |     }
101 | 
102 |     iter_count = iter + 1;
103 | 
104 |     const std::vector<int> &final_results_ref = algo_host.get_results();
105 |     std::vector<int> final_results = final_results_ref;
106 | 
107 |     return final_results;
108 | }
