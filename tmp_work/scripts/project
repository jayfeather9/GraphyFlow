16215 | 413 |                 if ((temp_byte_buffer.size() % bytes_per_word) + bytes_per_dist > bytes_per_word) {
16216 | 414 |                     size_t padding_needed = bytes_per_word - (temp_byte_buffer.size() % bytes_per_word);
16217 | 415 |                     temp_byte_buffer.insert(temp_byte_buffer.end(), padding_needed, 0);
