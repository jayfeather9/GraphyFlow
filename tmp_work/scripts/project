 9676 |  9433 | 157 | std::string convert_size(size_t size) {
 9677 |  9434 | 158 |     static const char *SIZES[] = {"B", "KB", "MB", "GB"};
 9678 |  9435 | 159 |     uint32_t div = 0;
 9679 |  9436 | 160 |     size_t rem = 0;
 9680 |  9437 | 161 | 
 9681 |  9438 | 162 |     while (size >= 1024 && div < (sizeof SIZES / sizeof *SIZES)) {
 9682 |  9439 | 163 |         rem = (size % 1024);
 9683 |  9440 | 164 |         div++;
 9684 |  9441 | 165 |         size /= 1024;
 9685 |  9442 | 166 |     }
 9686 |  9443 | 167 | 
 9687 |  9444 | 168 |     double size_d = (float)size + (float)rem / 1024.0;
 9688 |  9445 | 169 |     double size_val = round_off(size_d);
 9689 |  9446 | 170 | 
 9690 |  9447 | 171 |     std::stringstream stream;
 9691 |  9448 | 172 |     stream << std::fixed << std::setprecision(2) << size_val;
 9692 |  9449 | 173 |     std::string size_str = stream.str();
 9693 |  9450 | 174 |     std::string result = size_str + " " + SIZES[div];
 9694 |  9451 | 175 |     return result;
 9695 |  9452 | 176 | }
