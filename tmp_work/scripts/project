10212 |  9969 | 173 | 
10213 |  9970 | 174 |             p_graph.offsets.resize(p_graph.num_vertices + 1, 0);
10214 |  9971 | 175 |             p_graph.columns.resize(p_graph.num_edges);
10215 |  9972 | 176 |             p_graph.weights.resize(p_graph.num_edges);
10216 |  9973 | 177 | 
