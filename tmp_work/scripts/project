## File: host/graph_preprocess/graph_preprocess.cpp

- Extension: .cpp
- Language: cpp
- Size: 9378 bytes
- Created: 2025-10-17 19:23:25
- Modified: 2025-10-17 19:23:25

### Code

```cpp
  1 | #include "graph_preprocess.h"
  2 | #include <algorithm>
  3 | #include <iostream>
  4 | #include <numeric>
  5 | #include <set>
  6 | #include <vector>
  7 | 
  8 | // A local helper struct to temporarily hold edge information with global vertex
  9 | // IDs.
 10 | struct Edge {
 11 |     int src, dest, weight;
 12 | };
 13 | 
 14 | /**
 15 |  * @brief Partitions a global graph and preprocesses each partition into a local
 16 |  * CSR format.
 17 |  *
 18 |  * This function implements a partitioning strategy based on destination
 19 |  * vertices.
 20 |  * 1.  It identifies all unique destination vertices in the graph.
 21 |  * 2.  It distributes these destination vertices disjointly and as evenly as
 22 |  * possible among all available partitions (for both big and little kernels).
 23 |  * 3.  It assigns each edge from the global graph to the partition that is
 24 |  * responsible for its destination vertex.
 25 |  * 4.  For each partition, it collects all unique vertices involved (both
 26 |  * sources and destinations).
 27 |  * 5.  It performs vertex ID compression for each partition, creating a local ID
 28 |  * space. Destination vertices are mapped first to ensure they occupy the lower
 29 |  * ID range.
 30 |  * 6.  It rewrites the partition's edges using these new local IDs.
 31 |  * 7.  Finally, it converts the rewritten edges into a local CSR format.
 32 |  *
 33 |  * @param graph The input global graph in CSR format.
 34 |  * @return A PartitionContainer object containing all processed partitions.
 35 |  */
 36 | PartitionContainer partitionGraph(const GraphCSR *graph) {
 37 |     std::cout << "--- Starting Graph Partitioning and Preprocessing ---"
 38 |               << std::endl;
 39 |     PartitionContainer container;
 40 |     container.num_graph_vertices = graph->num_vertices;
 41 |     container.num_graph_edges = graph->num_edges;
 42 |     printf("Global graph has %d vertices and %d edges.\n", graph->num_vertices,
 43 |            graph->num_edges);
 44 |     const int num_partitions = BIG_KERNEL_NUM + LITTLE_KERNEL_NUM;
 45 | 
 46 |     std::cout<<"DEBUG big num:"<<BIG_KERNEL_NUM<<" little num :"<<LITTLE_KERNEL_NUM;
 47 | 
 48 |     if (num_partitions == 0) {
 49 |         std::cerr << "Error: No kernels defined (BIG_KERNEL_NUM and "
 50 |                      "LITTLE_KERNEL_NUM are both 0)."
 51 |                   << std::endl;
 52 |         return container;
 53 |     }
 54 |     std::cout << "[INFO] Total partitions to create: " << num_partitions
 55 |               << std::endl;
 56 | 
 57 |     // --- PHASE 1: Identify and Collect All Unique Destination Vertices ---
 58 |     std::set<int> unique_dst_vertices_set;
 59 |     for (int i = 0; i < graph->num_edges; ++i) {
 60 |         unique_dst_vertices_set.insert(graph->columns[i]);
 61 |     }
 62 |     std::vector<int> unique_dst_vertices(unique_dst_vertices_set.begin(),
 63 |                                          unique_dst_vertices_set.end());
 64 |     std::cout << "[PHASE 1] Found " << unique_dst_vertices.size()
 65 |               << " unique destination vertices." << std::endl;
 66 | 
 67 |     // --- PHASE 2: Distribute Destination Vertices to Partitions ---
 68 |     std::vector<std::set<int>> dst_vertices_per_partition(num_partitions);
 69 |     std::unordered_map<int, int> dst_vertex_to_partition_map;
 70 | 
 71 |     size_t base_dst_per_part = unique_dst_vertices.size() / num_partitions;
 72 |     size_t remainder_dst = unique_dst_vertices.size() % num_partitions;
 73 |     size_t current_dst_idx = 0;
 74 | 
 75 |     for (int i = 0; i < num_partitions; ++i) {
 76 |         size_t num_dst_in_part =
 77 |             base_dst_per_part + (i < remainder_dst ? 1 : 0);
 78 |         for (size_t j = 0; j < num_dst_in_part; ++j) {
 79 |             if (current_dst_idx < unique_dst_vertices.size()) {
 80 |                 int vertex_id = unique_dst_vertices[current_dst_idx];
 81 |                 dst_vertices_per_partition[i].insert(vertex_id);
 82 |                 dst_vertex_to_partition_map[vertex_id] = i;
 83 |                 current_dst_idx++;
 84 |             }
 85 |         }
 86 |         std::cout << "[PHASE 2] Partition " << i << " assigned "
 87 |                   << dst_vertices_per_partition[i].size()
 88 |                   << " destination vertices." << std::endl;
 89 |     }
 90 | 
 91 |     // --- PHASE 3: Assign Edges to Partitions Based on Destination Vertex ---
 92 |     std::vector<std::vector<Edge>> edges_per_partition(num_partitions);
 93 |     for (int u = 0; u < graph->num_vertices; ++u) {
 94 |         for (int i = graph->offsets[u]; i < graph->offsets[u + 1]; ++i) {
 95 |             int v = graph->columns[i];
 96 |             int w = graph->weights[i];
 97 | 
 98 |             // Find which partition this edge belongs to
 99 |             auto it = dst_vertex_to_partition_map.find(v);
100 |             if (it != dst_vertex_to_partition_map.end()) {
101 |                 int partition_id = it->second;
102 |                 edges_per_partition[partition_id].push_back({u, v, w});
103 |             } else {
104 |                 // This case should not happen if all dst vertices are mapped.
105 |                 // It might occur for sink nodes with no incoming edges, which
106 |                 // is fine.
107 |             }
108 |         }
109 |     }
110 |     std::cout << "[PHASE 3] All edges have been assigned to their respective "
111 |                  "partitions."
112 |               << std::endl;
113 | 
114 |     // --- PHASE 4: Process Each Partition (Compress IDs and Convert to CSR) ---
115 |     std::cout << "[PHASE 4] Processing each partition..." << std::endl;
116 |     for (int i = 0; i < num_partitions; ++i) {
117 |         PartitionDescriptor pd;
118 |         GraphCSR &p_graph = pd.partitioned_graph;
119 |         const auto &partition_edges = edges_per_partition[i];
120 |         const auto &partition_dst_nodes = dst_vertices_per_partition[i];
121 | 
122 |         if (partition_edges.empty()) {
123 |             std::cout << "  - Partition " << i << " has no edges. Skipping."
124 |                       << std::endl;
125 |             // Still create a valid (but empty) partition descriptor
126 |             pd.num_edges = 0;
127 |             pd.num_vertices = 0;
128 |             p_graph.num_edges = 0;
129 |             p_graph.num_vertices = 0;
130 |             p_graph.offsets.push_back(0);
131 | 
132 |         } else {
133 |             // --- 4.1: Collect unique vertices and build ID mappings ---
134 |             std::set<int> local_vertices_set;
135 |             for (const auto &edge : partition_edges) {
136 |                 local_vertices_set.insert(edge.src);
137 |                 local_vertices_set.insert(edge.dest);
138 |             }
139 | 
140 |             int local_id_counter = 0;
141 |             // First, map destination vertices to guarantee they have
142 |             // lower-range IDs
143 |             for (int global_id : partition_dst_nodes) {
144 |                 p_graph.vtx_map[global_id] = local_id_counter;
145 |                 p_graph.vtx_map_rev[local_id_counter] = global_id;
146 |                 local_id_counter++;
147 |             }
148 |             p_graph.num_dsts = partition_dst_nodes.size();
149 |             // Then, map the remaining source vertices
150 |             for (int global_id : local_vertices_set) {
151 |                 if (p_graph.vtx_map.find(global_id) == p_graph.vtx_map.end()) {
152 |                     p_graph.vtx_map[global_id] = local_id_counter;
153 |                     p_graph.vtx_map_rev[local_id_counter] = global_id;
154 |                     local_id_counter++;
155 |                 }
156 |             }
157 |             p_graph.num_vertices = local_vertices_set.size();
158 |             p_graph.num_edges = partition_edges.size();
159 | 
160 |             // --- 4.2: Rewrite edges with local, compressed IDs ---
161 |             std::vector<Edge> local_edges;
162 |             local_edges.reserve(p_graph.num_edges);
163 |             for (const auto &global_edge : partition_edges) {
164 |                 local_edges.push_back({p_graph.vtx_map[global_edge.src],
165 |                                        p_graph.vtx_map[global_edge.dest],
166 |                                        global_edge.weight});
167 |             }
168 | 
169 |             // --- 4.3: Convert local edges to CSR format ---
170 |             std::sort(
171 |                 local_edges.begin(), local_edges.end(),
172 |                 [](const Edge &a, const Edge &b) { return a.src < b.src; });
173 | 
174 |             p_graph.offsets.resize(p_graph.num_vertices + 1, 0);
175 |             p_graph.columns.resize(p_graph.num_edges);
176 |             p_graph.weights.resize(p_graph.num_edges);
177 | 
178 |             std::vector<int> out_degree(p_graph.num_vertices, 0);
179 |             for (int j = 0; j < p_graph.num_edges; ++j) {
180 |                 p_graph.columns[j] = local_edges[j].dest;
181 |                 p_graph.weights[j] = local_edges[j].weight;
182 |                 out_degree[local_edges[j].src]++;
183 |             }
184 | 
185 |             p_graph.offsets[0] = 0;
186 |             for (int j = 0; j < p_graph.num_vertices; ++j) {
187 |                 p_graph.offsets[j + 1] = p_graph.offsets[j] + out_degree[j];
188 |             }
189 | 
190 |             // --- 4.4: Finalize partition descriptor metadata ---
191 |             pd.num_edges = p_graph.num_edges;
192 |             pd.num_vertices = p_graph.num_vertices;
193 |         }
194 | 
195 |         pd.kernel_id = i;
196 |         if (i < LITTLE_KERNEL_NUM) {
197 |             pd.is_dense =
198 |                 true; // This is a Dense Partition (DP) for a little kernel
199 |             container.DPs.push_back(pd);
200 |         } else {
201 |             pd.is_dense =
202 |                 false; // This is a Sparse Partition (SP) for a big kernel
203 |             container.SPs.push_back(pd);
204 |         }
205 |         std::cout << "  - Processed Partition " << i << ": " << pd.num_vertices
206 |                   << " local vertices, " << pd.num_edges << " edges."
207 |                   << std::endl;
208 |     }
209 | 
210 |     container.num_dense_partitions = container.DPs.size();
211 |     container.num_sparse_partitions = container.SPs.size();
212 | 
213 |     std::cout<<"DP: "<<container.num_dense_partitions<<"SP: "<<container.num_sparse_partitions<<std::endl;
214 |     std::cout << "[SUCCESS] Graph partitioning and preprocessing complete."
215 |               << std::endl;
216 |     return container;
217 | }
```

