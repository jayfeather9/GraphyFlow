19137 | 249 | // --- New Bitwidth Definitions for HLS Synthesis ---
19138 | 250 | #define NODE_ID_BITWIDTH 32
19139 | 251 | #define DISTANCE_BITWIDTH 32
19140 | 252 | #define DISTANCE_INTEGER_PART 16
19141 | 253 | #define WEIGHT_BITWIDTH DISTANCE_BITWIDTH
19142 | 254 | #define WEIGHT_INTEGER_PART DISTANCE_INTEGER_PART
19143 | 255 | #define OUT_END_MARKER_BITWIDTH 4
19144 | 256 | #define DIST_PER_WORD 16 // AXI_BUS_WIDTH / DISTANCE_BITWIDTH = 512 / 32 = 16
19145 | 257 | #define LOG_DIST_PER_WORD                                                      \
19146 | 258 |     4 // log2(AXI_BUS_WIDTH / DISTANCE_BITWIDTH) = log2(512 / 32) = log2(16) = 4
19147 | 259 | 
19148 | 260 | // --- New Memory Word and Bus Definitions ---
19149 | 261 | #define AXI_BUS_WIDTH 512
19150 | 262 | 
19151 | 263 | #define REDUCE_MEM_WIDTH 64
19152 | 264 | typedef ap_uint<AXI_BUS_WIDTH> bus_word_t;
19153 | 265 | typedef ap_uint<REDUCE_MEM_WIDTH> reduce_word_t;
19154 | 266 | 
19155 | 267 | const int INFINITY_DIST = 16384;
19156 | 268 | 
19157 | 269 | // --- New Packing-related Constants ---
19158 | 270 | // Number of distances that can be packed into a single reduce memory word.
19159 | 271 | #define DISTANCES_PER_REDUCE_WORD (REDUCE_MEM_WIDTH / DISTANCE_BITWIDTH)
19160 | 272 | 
