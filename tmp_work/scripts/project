 1 | #include "host_verifier.h"
 2 | #include "host_bellman_ford.h"
 3 | #include <iostream>
 4 | 
 5 | std::vector<int> verify_on_host(const GraphCSR &graph, int start_node) {
 6 |     std::vector<int> distances(graph.num_vertices, INFINITY_DIST);
 7 |     distances[start_node] = 0;
 8 | 
 9 |     int max_iterations = graph.num_vertices;
10 |     int iter = 0;
11 |     bool changed = true;
12 | 
13 |     std::cout << "\nStarting Host verification..." << std::endl;
14 | 
15 |     while (changed && iter < max_iterations) {
16 |         // Run one iteration of the algorithm
17 |         changed = host_bellman_ford_iteration(graph, distances);
18 |         iter++;
19 |     }
20 | 
21 |     std::cout << "Host computation converged after " << iter << " iterations."
22 |               << std::endl;
23 | 
24 |     // Check for negative weight cycles (optional but good practice)
25 |     if (iter == max_iterations &&
26 |         host_bellman_ford_iteration(graph, distances)) {
27 |         std::cout << "Warning: Negative weight cycle detected by host verifier."
28 |                   << std::endl;
29 |     }
30 | 
31 |     return distances;
32 | }
