20095 |  662 |             net_wrapper_kt_pair_105_t_t data2;
20096 |  663 |             data2 = in2.read();
20097 |  664 |             if ((!data2.end_flag)) {
20098 |  665 |                 if (((data2.data.key >> i) & 1)) {
20099 |  666 |                     out4.write(data2);
20100 |  667 |                 } else {
20101 |  668 |                     out3.write(data2);
20102 |  669 |                 }
20103 |  670 |             } else {
20104 |  671 |                 in2_end_flag = true;
20105 |  672 |             }
20106 |  673 |         }
20107 |  674 |         if ((in1_end_flag & in2_end_flag)) {
20108 |  675 |             net_wrapper_kt_pair_105_t_t data;
20109 |  676 |             data.end_flag = true;
20110 |  677 |             out1.write(data);
20111 |  678 |             out2.write(data);
20112 |  679 |             out3.write(data);
20113 |  680 |             out4.write(data);
20114 |  681 |             in1_end_flag = false;
20115 |  682 |             in2_end_flag = false;
20116 |  683 |             break;
20117 |  684 |         }
20118 |  685 |     }
20119 |  686 | }
