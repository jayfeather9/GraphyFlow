14625 | 14382 | 1696 |     // src_id_loader(src_ids, stream_src_ids_1, stream_src_ids_2, num_edges);
14626 | 14383 | 1697 |     const int num_ids_per_word = AXI_BUS_WIDTH / NODE_ID_BITWIDTH;
14627 | 14384 | 1698 |     const int num_wide_reads =
14628 | 14385 | 1699 |         (num_edges + num_ids_per_word - 1) / num_ids_per_word;
14629 | 14386 | 1700 | 
