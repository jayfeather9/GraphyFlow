14641 | 14398 | 1712 |             if (nodes_read + j < num_edges) {
14642 | 14399 | 1713 |                 node_id_t cur_id = wide_word.range(
14643 | 14400 | 1714 |                     (j + 1) * NODE_ID_BITWIDTH - 1, j * NODE_ID_BITWIDTH);
