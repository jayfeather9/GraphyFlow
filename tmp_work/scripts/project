 2684 |  2441 | 2351 | 153 |                     p_graph.vtx_map_rev[local_id_counter] = global_id;
 2685 |  2442 | 2352 | 154 |                     local_id_counter++;
 2686 |  2443 | 2353 | 155 |                 }
 2687 |  2444 | 2354 | 156 |             }
 2688 |  2445 | 2355 | 157 |             p_graph.num_vertices = local_vertices_set.size();
