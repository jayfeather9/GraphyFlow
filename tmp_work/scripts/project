16221 | 419 |                 const char *data_ptr = reinterpret_cast<const char *>(&dist_val);
16222 | 420 |                 temp_byte_buffer.insert(temp_byte_buffer.end(), data_ptr, data_ptr + bytes_per_dist);
16223 | 421 |             }
16224 | 422 |             hbm_manager_host_buffers[0].packed_node_props.resize(
16225 | 423 |                 (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word, 0);
16226 | 424 |             std::memcpy(hbm_manager_host_buffers[0].packed_node_props.data(),
16227 | 425 |                         temp_byte_buffer.data(), temp_byte_buffer.size());
