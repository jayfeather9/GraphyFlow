16368 | 566 | 
16369 | 567 | bool AlgorithmHost::check_convergence_and_update(const PartitionContainer &container) {
16370 | 568 |     bool changed = false;
16371 | 569 |     std::cout << "--- [Host] Phase 5: Unpacking results and checking for convergence ---" << std::endl;
16372 | 570 | 
16373 | 571 |     std::map<int, distance_t> min_distances;
16374 | 572 |     const int bits_per_output = NODE_ID_BITWIDTH + DISTANCE_BITWIDTH + OUT_END_MARKER_BITWIDTH;
16375 | 573 |     const int outputs_per_word = AXI_BUS_WIDTH / bits_per_output;
16376 | 574 | 
16377 | 575 |     // DISABLED
16378 | 576 |     /*
16379 | 577 |     for (size_t i = 0; i < big_kernel_host_outputs.size(); ++i) {
16380 | 578 |         // ... (BIG KERNEL LOGIC IS COMMENTED OUT)
16381 | 579 |     }
16382 | 580 |     */
16383 | 581 | 
16384 | 582 |     // ENABLED
16385 | 583 |     for (size_t i = 0; i < little_kernel_host_outputs.size(); ++i) {
16386 | 584 |         const auto &p_graph = container.DPs[i].partitioned_graph;
16387 | 585 |         for (const auto &word : little_kernel_host_outputs[i]) {
16388 | 586 |             out_end_marker_t end_flag = 0;
16389 | 587 |             for (int k = 0; k < outputs_per_word; ++k) {
16390 | 588 |                 int bit_offset = k * bits_per_output;
16391 | 589 |                 ap_uint<bits_per_output> packed_output = word.range(bit_offset + bits_per_output - 1, bit_offset);
16392 | 590 | 
16393 | 591 |                 ap_uint<NODE_ID_BITWIDTH> local_id_pod = packed_output.range(NODE_ID_BITWIDTH - 1, 0);
16394 | 592 |                 ap_fixed_pod_t dist_pod = packed_output.range(NODE_ID_BITWIDTH + DISTANCE_BITWIDTH - 1, NODE_ID_BITWIDTH);
16395 | 593 |                 end_flag = packed_output.range(bits_per_output - 1, NODE_ID_BITWIDTH + DISTANCE_BITWIDTH);
16396 | 594 | 
16397 | 595 |                 if (end_flag != 0) break;
16398 | 596 | 
16399 | 597 |                 int local_id = local_id_pod;
16400 | 598 |                 if (p_graph.vtx_map_rev.count(local_id) == 0) continue;
16401 | 599 | 
16402 | 600 |                 int global_id = p_graph.vtx_map_rev.at(local_id);
16403 | 601 |                 if (global_id >= m_num_vertices) continue;
16404 | 602 | 
16405 | 603 |                 distance_t new_dist = *reinterpret_cast<distance_t *>(&dist_pod);
16406 | 604 | 
16407 | 605 |                 if (min_distances.find(global_id) == min_distances.end() || new_dist < min_distances[global_id]) {
16408 | 606 |                     min_distances[global_id] = new_dist;
16409 | 607 |                 }
16410 | 608 |             }
16411 | 609 |             if (end_flag != 0) break;
16412 | 610 |         }
16413 | 611 |     }
16414 | 612 | 
16415 | 613 |     for (auto const &[global_id, new_dist] : min_distances) {
16416 | 614 |         if (global_id < m_num_vertices && new_dist < h_distances[global_id]) {
16417 | 615 |             h_distances[global_id] = new_dist;
16418 | 616 |             changed = true;
16419 | 617 |         }
16420 | 618 |     }
16421 | 619 | 
16422 | 620 |     if (changed) {
16423 | 621 |         std::cout << "[INFO] Distances updated. Preparing for next iteration." << std::endl;
16424 | 622 |     } else {
16425 | 623 |         std::cout << "[INFO] No distance updates. Algorithm has converged." << std::endl;
16426 | 624 |     }
16427 | 625 | 
16428 | 626 |     return !changed;
16429 | 627 | }
16430 | 628 | 
16431 | 629 | const std::vector<int> &AlgorithmHost::get_results() const {
16432 | 630 |     static std::vector<int> final_distances;
16433 | 631 |     final_distances.clear();
16434 | 632 |     final_distances.reserve(h_distances.size());
16435 | 633 | 
16436 | 634 |     for (const auto &dist : h_distances) {
16437 | 635 |         if (dist >= INFINITY_DIST) {
16438 | 636 |             final_distances.push_back(std::numeric_limits<int>::max());
16439 | 637 |         } else {
16440 | 638 |             final_distances.push_back(dist.to_int());
16441 | 639 |         }
16442 | 640 |     }
16443 | 641 |     return final_distances;
16444 | 642 | }
16445 | ```
