16101 | 299 | void AlgorithmHost::setup_buffers(const PartitionContainer &container) {
16102 | 300 |     cl_int err;
16103 | 301 |     std::cout << "--- [Host] Phase 1: Setting up HBM buffers for all kernels ---" << std::endl;
16104 | 302 | 
16105 | 303 |     big_kernel_buffers.clear();
16106 | 304 |     little_kernel_buffers.clear();
16107 | 305 |     hbm_manager_buffers.clear(); // Clear HBM manager buffers as well
16108 | 306 |     big_kernel_host_outputs.resize(container.SPs.size());
16109 | 307 |     little_kernel_host_outputs.resize(container.DPs.size());
16110 | 308 | 
16111 | 309 |     const size_t bytes_per_word = AXI_BUS_WIDTH / 8;
16112 | 310 | 
16113 | 311 |     // --- 1.3: Setup buffers for BIG kernels (Sparse Partitions) ---
16114 | 312 |     // DISABLED FOR LITTLE KERNEL TESTING
16115 | 313 |     /*
16116 | 314 |     for (size_t i = 0; i < container.SPs.size(); ++i) {
16117 | 315 |         // ... (BIG KERNEL LOGIC IS COMMENTED OUT)
16118 | 316 |     }
16119 | 317 |     */
16120 | 318 |     
16121 | 319 |     // --- Setup buffer for HBM Manager Kernel (Now for Little Kernels) ---
16122 | 320 |     // Assuming we have at least one little kernel to test
16123 | 321 |     if (!container.DPs.empty()) {
16124 | 322 |         KernelBuffers hbm_buffers;
16125 | 323 |         cl_mem_ext_ptr_t hbm_ext_in2;
16126 | 324 |         // This HBM bank should be accessible by the little kernels
16127 | 325 |         hbm_ext_in2.flags = XCL_MEM_TOPOLOGY | 2; // Example HBM bank
16128 | 326 |         hbm_ext_in2.obj = nullptr;
16129 | 327 |         hbm_ext_in2.param = 0;
16130 | 328 |         
16131 | 329 |         size_t num_dist_words = hbm_manager_host_buffers[0].packed_node_props.size();
16132 | 330 |         OCL_CHECK(err,
16133 | 331 |                   hbm_buffers.node_props_buf = cl::Buffer(
16134 | 332 |                       acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX,
16135 | 333 |                       num_dist_words * bytes_per_word, &hbm_ext_in2, &err));
16136 | 334 |         hbm_manager_buffers.push_back(hbm_buffers);
16137 | 335 |     }
16138 | 336 | 
16139 | 337 | 
16140 | 338 |     // --- 1.4: Setup buffers for LITTLE kernels (Dense Partitions) ---
16141 | 339 |     // ENABLED FOR LITTLE KERNEL TESTING
16142 | 340 |     for (size_t i = 0; i < container.DPs.size(); ++i) {
16143 | 341 |         const auto &p_graph = container.DPs[i].partitioned_graph;
16144 | 342 |         KernelBuffers buffers;
16145 | 343 | 
16146 | 344 |         cl_mem_ext_ptr_t hbm_ext_in0, hbm_ext_in1, hbm_ext_out;
16147 | 345 |         hbm_ext_in0.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_input_id[i];
16148 | 346 |         hbm_ext_in0.obj = nullptr;
16149 | 347 |         hbm_ext_in0.param = 0;
16150 | 348 |         hbm_ext_in1.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_input_id[i];
16151 | 349 |         hbm_ext_in1.obj = nullptr;
16152 | 350 |         hbm_ext_in1.param = 0;
16153 | 351 |         hbm_ext_out.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_output_id[i];
16154 | 352 |         hbm_ext_out.obj = nullptr;
16155 | 353 |         hbm_ext_out.param = 0;
16156 | 354 | 
16157 | 355 |         size_t num_id_words = little_kernel_input_buffers[i].packed_src_ids.size();
16158 | 356 |         size_t num_edge_words = little_kernel_input_buffers[i].packed_edge_props.size();
16159 | 357 | 
