13808 | 13565 |  879 | inline ap_fixed_pod_t get_raw_val(reduce_word_t word, int idx) {
13809 | 13566 |  880 | #pragma HLS INLINE
13810 | 13567 |  881 |     ap_uint<DISTANCE_BITWIDTH> bits;
13811 | 13568 |  882 |     switch (idx) {
13812 | 13569 |  883 |     case 0:
13813 | 13570 |  884 |         bits = word.range(DISTANCE_BITWIDTH - 1, 0);
13814 | 13571 |  885 |         break;
13815 | 13572 |  886 |     case 1:
13816 | 13573 |  887 |         bits = word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH);
13817 | 13574 |  888 |         break;
13818 | 13575 |  889 |     case 2:
13819 | 13576 |  890 |         bits =
13820 | 13577 |  891 |             word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1));
13821 | 13578 |  892 |         break;
13822 | 13579 |  893 |     default:
13823 | 13580 |  894 |         bits = 0;
13824 | 13581 |  895 |         break;
13825 | 13582 |  896 |     }
13826 | 13583 |  897 |     return bits;
13827 | 13584 |  898 | }
