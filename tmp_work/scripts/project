17398 |  80 |                 int vertex_id = unique_dst_vertices[current_dst_idx];
17399 |  81 |                 dst_vertices_per_partition[i].insert(vertex_id);
17400 |  82 |                 dst_vertex_to_partition_map[vertex_id] = i;
17401 |  83 |                 current_dst_idx++;
17402 |  84 |             }
17403 |  85 |         }
17404 |  86 |         std::cout << "[PHASE 2] Partition " << i << " assigned "
17405 |  87 |                   << dst_vertices_per_partition[i].size()
17406 |  88 |                   << " destination vertices." << std::endl;
17407 |  89 |     }
17408 |  90 | 
17409 |  91 |     // --- PHASE 3: Assign Edges to Partitions Based on Destination Vertex ---
17410 |  92 |     std::vector<std::vector<Edge>> edges_per_partition(num_partitions);
17411 |  93 |     for (int u = 0; u < graph->num_vertices; ++u) {
17412 |  94 |         for (int i = graph->offsets[u]; i < graph->offsets[u + 1]; ++i) {
