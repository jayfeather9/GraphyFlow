 8134 |  7891 |  12 | };
 8135 |  7892 |  13 | 
 8136 |  7893 |  14 | // 主函数，从文件中加载图并转换为 CSR 格式
 8137 |  7894 |  15 | GraphCSR load_graph_from_file(const std::string &file_path) {
 8138 |  7895 |  16 |     // ---- 1. 根据文件扩展名判断图的格式 ----
 8139 |  7896 |  17 |     bool is_one_based = false; // 默认为 0-indexed
 8140 |  7897 |  18 |     char comment_char = '#';   // 默认注释符
 8141 |  7898 |  19 | 
 8142 |  7899 |  20 |     if (file_path.size() > 4 &&
 8143 |  7900 |  21 |         file_path.substr(file_path.size() - 4) == ".mtx") {
 8144 |  7901 |  22 |         is_one_based = true; // .mtx 文件通常是 1-indexed
 8145 |  7902 |  23 |         comment_char = '%';  // .mtx 文件使用 '%' 作为注释
 8146 |  7903 |  24 |         std::cout << "Detected .mtx format (1-based indexing)." << std::endl;
 8147 |  7904 |  25 |     } else {
 8148 |  7905 |  26 |         std::cout << "Detected .txt format (0-based indexing)." << std::endl;
 8149 |  7906 |  27 |     }
 8150 |  7907 |  28 | 
 8151 |  7908 |  29 |     // ---- 2. 打开文件并逐行解析 ----
 8152 |  7909 |  30 |     std::ifstream file(file_path);
 8153 |  7910 |  31 |     if (!file.is_open()) {
 8154 |  7911 |  32 |         std::cerr << "Error: Could not open graph file: " << file_path
 8155 |  7912 |  33 |                   << std::endl;
 8156 |  7913 |  34 |         exit(EXIT_FAILURE);
 8157 |  7914 |  35 |     }
 8158 |  7915 |  36 | 
 8159 |  7916 |  37 |     std::vector<Edge> edges;
 8160 |  7917 |  38 |     int max_vertex_id = -1;
 8161 |  7918 |  39 |     std::string line;
 8162 |  7919 |  40 |     long line_num = 0;
 8163 |  7920 |  41 | 
 8164 |  7921 |  42 |     while (std::getline(file, line)) {
 8165 |  7922 |  43 |         line_num++;
 8166 |  7923 |  44 |         // 跳过空行和注释行
 8167 |  7924 |  45 |         if (line.empty() || line[0] == comment_char) {
 8168 |  7925 |  46 |             continue;
 8169 |  7926 |  47 |         }
 8170 |  7927 |  48 | 
 8171 |  7928 |  49 |         std::istringstream iss(line);
 8172 |  7929 |  50 |         Edge edge;
 8173 |  7930 |  51 | 
 8174 |  7931 |  52 |         // 尝试读取 src, dest, weight
 8175 |  7932 |  53 |         if (iss >> edge.src >> edge.dest >> edge.weight) {
 8176 |  7933 |  54 |             // 成功读取三个值
 8177 |  7934 |  55 |         } else {
 8178 |  7935 |  56 |             // 如果失败，重置流并尝试只读取 src, dest
 8179 |  7936 |  57 |             iss.clear();
 8180 |  7937 |  58 |             iss.seekg(0);
 8181 |  7938 |  59 |             if (iss >> edge.src >> edge.dest) {
 8182 |  7939 |  60 |                 edge.weight = 1; // 赋予默认权重 1
 8183 |  7940 |  61 |             } else {
 8184 |  7941 |  62 |                 std::cerr << "Warning: Skipping malformed line " << line_num
 8185 |  7942 |  63 |                           << ": " << line << std::endl;
 8186 |  7943 |  64 |                 continue;
 8187 |  7944 |  65 |             }
 8188 |  7945 |  66 |         }
 8189 |  7946 |  67 | 
 8190 |  7947 |  68 |         // 如果是 1-based 格式，转换为 0-based
 8191 |  7948 |  69 |         if (is_one_based) {
 8192 |  7949 |  70 |             edge.src--;
 8193 |  7950 |  71 |             edge.dest--;
 8194 |  7951 |  72 |         }
 8195 |  7952 |  73 | 
 8196 |  7953 |  74 |         // 检查顶点ID是否有效
 8197 |  7954 |  75 |         if (edge.src < 0 || edge.dest < 0) {
 8198 |  7955 |  76 |             std::cerr
 8199 |  7956 |  77 |                 << "Warning: Skipping edge with negative vertex ID on line "
 8200 |  7957 |  78 |                 << line_num << std::endl;
 8201 |  7958 |  79 |             continue;
 8202 |  7959 |  80 |         }
 8203 |  7960 |  81 | 
 8204 |  7961 |  82 |         edges.push_back(edge);
 8205 |  7962 |  83 |         max_vertex_id = std::max({max_vertex_id, edge.src, edge.dest});
 8206 |  7963 |  84 |     }
 8207 |  7964 |  85 |     file.close();
 8208 |  7965 |  86 | 
 8209 |  7966 |  87 |     // ---- 3. 将边列表转换为 CSR 格式 ----
 8210 |  7967 |  88 |     GraphCSR graph;
 8211 |  7968 |  89 |     if (max_vertex_id == -1) { // 如果文件为空或无效
 8212 |  7969 |  90 |         graph.num_vertices = 0;
 8213 |  7970 |  91 |         graph.num_edges = 0;
 8214 |  7971 |  92 |         std::cout << "Graph is empty." << std::endl;
 8215 |  7972 |  93 |         return graph;
 8216 |  7973 |  94 |     }
 8217 |  7974 |  95 | 
 8218 |  7975 |  96 |     graph.num_vertices = max_vertex_id + 1;
 8219 |  7976 |  97 |     graph.num_edges = edges.size();
 8220 |  7977 |  98 | 
 8221 |  7978 |  99 |     std::cout << "Graph loaded: " << graph.num_vertices << " vertices, "
 8222 |  7979 | 100 |               << graph.num_edges << " edges." << std::endl;
 8223 |  7980 | 101 | 
 8224 |  7981 | 102 |     // 为了进行 CSR 转换，按源顶点 ID 对边进行排序
 8225 |  7982 | 103 |     std::sort(edges.begin(), edges.end(), [](const Edge &a, const Edge &b) {
 8226 |  7983 | 104 |         if (a.src != b.src) {
 8227 |  7984 | 105 |             return a.src < b.src;
 8228 |  7985 | 106 |         }
 8229 |  7986 | 107 |         return a.dest < b.dest;
 8230 |  7987 | 108 |     });
 8231 |  7988 | 109 | 
 8232 |  7989 | 110 |     // 分配 CSR 数组内存
 8233 |  7990 | 111 |     graph.offsets.resize(graph.num_vertices + 1);
 8234 |  7991 | 112 |     graph.columns.resize(graph.num_edges);
 8235 |  7992 | 113 |     graph.weights.resize(graph.num_edges);
 8236 |  7993 | 114 | 
 8237 |  7994 | 115 |     // 填充 columns 和 weights 数组，并计算每个顶点的出度
 8238 |  7995 | 116 |     std::vector<int> out_degree(graph.num_vertices, 0);
 8239 |  7996 | 117 |     for (int i = 0; i < graph.num_edges; ++i) {
 8240 |  7997 | 118 |         graph.columns[i] = edges[i].dest;
 8241 |  7998 | 119 |         graph.weights[i] = edges[i].weight;
 8242 |  7999 | 120 |         out_degree[edges[i].src]++;
 8243 |  8000 | 121 |     }
 8244 |  8001 | 122 | 
 8245 |  8002 | 123 |     // 通过出度的前缀和计算 offsets 数组
 8246 |  8003 | 124 |     graph.offsets[0] = 0;
 8247 |  8004 | 125 |     for (int i = 0; i < graph.num_vertices; ++i) {
 8248 |  8005 | 126 |         graph.offsets[i + 1] = graph.offsets[i] + out_degree[i];
 8249 |  8006 | 127 |     }
 8250 |  8007 | 128 | 
 8251 |  8008 | 129 |     return graph;
 8252 |  8009 | 130 | }
 8253 |  8010 | ```
