19486 |   53 | static void
19487 |   54 | edge_descriptor_loader(const bus_word_t *edge_props_ddr,
19488 |   55 |                        hls::stream<edge_descriptor_batch_t> &edge_stream,
19489 |   56 |                        int32_t num_edges) {
19490 |   57 |     const int bits_per_edge = NODE_ID_BITWIDTH + WEIGHT_BITWIDTH;
19491 |   58 |     const int edges_per_word = AXI_BUS_WIDTH / bits_per_edge;
19492 |   59 |     const int num_wide_reads =
19493 |   60 |         (num_edges + edges_per_word - 1) / edges_per_word;
19494 |   61 | 
19495 |   62 |     int edges_read = 0;
19496 |   63 |     edge_descriptor_batch_t edge_batch;
19497 |   64 | #pragma HLS ARRAY_PARTITION variable = edge_batch.edges complete dim = 0
19498 |   65 |     edge_batch.end_pos = 0;
19499 |   66 | 
19500 |   67 | #if (NODE_ID_BITWIDTH == 32) && (WEIGHT_BITWIDTH == 32)
19501 |   68 | LOOP_EDL_READ:
19502 |   69 |     for (int i = 0; i < num_wide_reads; i++) {
19503 |   70 | #pragma HLS PIPELINE II = 1
19504 |   71 |         bus_word_t wide_word = edge_props_ddr[i];
19505 |   72 |     LOOP_EDL_UNPACK:
19506 |   73 |         for (int j = 0; j < edges_per_word; j++) {
19507 |   74 | #pragma HLS UNROLL
19508 |   75 |             if (edges_read + j < num_edges) {
19509 |   76 |                 ap_uint<bits_per_edge> packed_edge = wide_word.range(
19510 |   77 |                     (j + 1) * bits_per_edge - 1, j * bits_per_edge);
19511 |   78 |                 node_with_prop_t edge;
19512 |   79 |                 edge.node_id = packed_edge.range(NODE_ID_BITWIDTH - 1, 0);
19513 |   80 |                 edge.prop =
19514 |   81 |                     packed_edge.range(bits_per_edge - 1, NODE_ID_BITWIDTH);
19515 |   82 | 
19516 |   83 |                 edge_batch.edges[j] = edge;
19517 |   84 |             }
19518 |   85 |         }
19519 |   86 |         edges_read += edges_per_word;
19520 |   87 |         edge_batch.end_pos = (edges_read <= num_edges)
19521 |   88 |                                  ? edges_per_word
19522 |   89 |                                  : (num_edges % edges_per_word);
19523 |   90 |         edge_stream.write(edge_batch);
19524 |   91 |         edge_batch.end_pos = 0;
19525 |   92 |     }
19526 |   93 | #else
19527 |   94 | // Add support for other bitwidth combinations if needed.
19528 |   95 | #error                                                                         \
19529 |   96 |     "edge_descriptor_loader currently only supports 32-bit node_id and 32-bit weight."
19530 |   97 | #endif
19531 |   98 | }
