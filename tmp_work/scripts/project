10893 | 10650 |  547 | static void
10894 | 10651 |  548 | merge_node_props(hls::stream<bus_word_t> (&cacheline_streams)[PE_NUM],
10895 | 10652 |  549 |                  hls::stream<edge_descriptor_batch_t> &edge_stream,
10896 | 10653 |  550 |                  hls::stream<node_id_burst_t> &src_id_burst_stream,
