 5604 |  5361 | 5271 |  107 |     case 1:
 5605 |  5362 | 5272 |  108 |         count = 1;
 5606 |  5363 | 5273 |  109 |         break;
 5607 |  5364 | 5274 |  110 |     case 3:
 5608 |  5365 | 5275 |  111 |         count = 2;
 5609 |  5366 | 5276 |  112 |         break;
 5610 |  5367 | 5277 |  113 |     case 7:
 5611 |  5368 | 5278 |  114 |         count = 3;
 5612 |  5369 | 5279 |  115 |         break;
 5613 |  5370 | 5280 |  116 |     case 15:
 5614 |  5371 | 5281 |  117 |         count = 4;
 5615 |  5372 | 5282 |  118 |         break;
 5616 |  5373 | 5283 |  119 |     case 31:
