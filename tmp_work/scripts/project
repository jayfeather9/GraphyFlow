15400 | 
15401 | ```cpp
15402 |   1 | #include "graph_loader.h"
15403 |   2 | #include <algorithm>
15404 |   3 | #include <fstream>
15405 |   4 | #include <iostream>
15406 |   5 | #include <sstream>
15407 |   6 | #include <stdexcept>
15408 |   7 | #include <vector>
15409 |   8 | 
15410 |   9 | // 边结构体，用于临时存储从文件中读取的边
15411 |  10 | struct Edge {
15412 |  11 |     int src, dest, weight;
15413 |  12 | };
15414 |  13 | 
15415 |  14 | // 主函数，从文件中加载图并转换为 CSR 格式
15416 |  15 | GraphCSR load_graph_from_file(const std::string &file_path) {
15417 |  16 |     // ---- 1. 根据文件扩展名判断图的格式 ----
15418 |  17 |     bool is_one_based = false; // 默认为 0-indexed
15419 |  18 |     char comment_char = '#';   // 默认注释符
15420 |  19 | 
15421 |  20 |     if (file_path.size() > 4 &&
15422 |  21 |         file_path.substr(file_path.size() - 4) == ".mtx") {
15423 |  22 |         is_one_based = true; // .mtx 文件通常是 1-indexed
15424 |  23 |         comment_char = '%';  // .mtx 文件使用 '%' 作为注释
15425 |  24 |         std::cout << "Detected .mtx format (1-based indexing)." << std::endl;
15426 |  25 |     } else {
15427 |  26 |         std::cout << "Detected .txt format (0-based indexing)." << std::endl;
15428 |  27 |     }
15429 |  28 | 
15430 |  29 |     // ---- 2. 打开文件并逐行解析 ----
15431 |  30 |     std::ifstream file(file_path);
15432 |  31 |     if (!file.is_open()) {
15433 |  32 |         std::cerr << "Error: Could not open graph file: " << file_path
15434 |  33 |                   << std::endl;
15435 |  34 |         exit(EXIT_FAILURE);
15436 |  35 |     }
15437 |  36 | 
15438 |  37 |     std::vector<Edge> edges;
15439 |  38 |     int max_vertex_id = -1;
15440 |  39 |     std::string line;
15441 |  40 |     long line_num = 0;
15442 |  41 | 
15443 |  42 |     while (std::getline(file, line)) {
15444 |  43 |         line_num++;
15445 |  44 |         // 跳过空行和注释行
15446 |  45 |         if (line.empty() || line[0] == comment_char) {
15447 |  46 |             continue;
15448 |  47 |         }
15449 |  48 | 
15450 |  49 |         std::istringstream iss(line);
15451 |  50 |         Edge edge;
15452 |  51 | 
15453 |  52 |         // 尝试读取 src, dest, weight
15454 |  53 |         if (iss >> edge.src >> edge.dest >> edge.weight) {
15455 |  54 |             // 成功读取三个值
15456 |  55 |         } else {
15457 |  56 |             // 如果失败，重置流并尝试只读取 src, dest
15458 |  57 |             iss.clear();
15459 |  58 |             iss.seekg(0);
15460 |  59 |             if (iss >> edge.src >> edge.dest) {
15461 |  60 |                 edge.weight = 1; // 赋予默认权重 1
15462 |  61 |             } else {
15463 |  62 |                 std::cerr << "Warning: Skipping malformed line " << line_num
15464 |  63 |                           << ": " << line << std::endl;
15465 |  64 |                 continue;
15466 |  65 |             }
15467 |  66 |         }
15468 |  67 | 
15469 |  68 |         // 如果是 1-based 格式，转换为 0-based
15470 |  69 |         if (is_one_based) {
15471 |  70 |             edge.src--;
15472 |  71 |             edge.dest--;
15473 |  72 |         }
15474 |  73 | 
15475 |  74 |         // 检查顶点ID是否有效
15476 |  75 |         if (edge.src < 0 || edge.dest < 0) {
15477 |  76 |             std::cerr
15478 |  77 |                 << "Warning: Skipping edge with negative vertex ID on line "
15479 |  78 |                 << line_num << std::endl;
15480 |  79 |             continue;
15481 |  80 |         }
15482 |  81 | 
15483 |  82 |         edges.push_back(edge);
15484 |  83 |         max_vertex_id = std::max({max_vertex_id, edge.src, edge.dest});
15485 |  84 |     }
15486 |  85 |     file.close();
15487 |  86 | 
15488 |  87 |     // ---- 3. 将边列表转换为 CSR 格式 ----
15489 |  88 |     GraphCSR graph;
15490 |  89 |     if (max_vertex_id == -1) { // 如果文件为空或无效
15491 |  90 |         graph.num_vertices = 0;
15492 |  91 |         graph.num_edges = 0;
15493 |  92 |         std::cout << "Graph is empty." << std::endl;
15494 |  93 |         return graph;
15495 |  94 |     }
15496 |  95 | 
15497 |  96 |     graph.num_vertices = max_vertex_id + 1;
15498 |  97 |     graph.num_edges = edges.size();
15499 |  98 | 
15500 |  99 |     std::cout << "Graph loaded: " << graph.num_vertices << " vertices, "
15501 | 100 |               << graph.num_edges << " edges." << std::endl;
15502 | 101 | 
15503 | 102 |     // 为了进行 CSR 转换，按源顶点 ID 对边进行排序
15504 | 103 |     std::sort(edges.begin(), edges.end(), [](const Edge &a, const Edge &b) {
15505 | 104 |         if (a.src != b.src) {
15506 | 105 |             return a.src < b.src;
15507 | 106 |         }
15508 | 107 |         return a.dest < b.dest;
15509 | 108 |     });
15510 | 109 | 
15511 | 110 |     // 分配 CSR 数组内存
15512 | 111 |     graph.offsets.resize(graph.num_vertices + 1);
15513 | 112 |     graph.columns.resize(graph.num_edges);
15514 | 113 |     graph.weights.resize(graph.num_edges);
15515 | 114 | 
15516 | 115 |     // 填充 columns 和 weights 数组，并计算每个顶点的出度
15517 | 116 |     std::vector<int> out_degree(graph.num_vertices, 0);
15518 | 117 |     for (int i = 0; i < graph.num_edges; ++i) {
15519 | 118 |         graph.columns[i] = edges[i].dest;
15520 | 119 |         graph.weights[i] = edges[i].weight;
15521 | 120 |         out_degree[edges[i].src]++;
15522 | 121 |     }
15523 | 122 | 
15524 | 123 |     // 通过出度的前缀和计算 offsets 数组
15525 | 124 |     graph.offsets[0] = 0;
15526 | 125 |     for (int i = 0; i < graph.num_vertices; ++i) {
15527 | 126 |         graph.offsets[i + 1] = graph.offsets[i] + out_degree[i];
15528 | 127 |     }
15529 | 128 | 
15530 | 129 |     return graph;
15531 | 130 | }
15532 | ```
