 34 | #include <CL/cl2.hpp>
 35 | #include <CL/cl_ext_xilinx.h>
 36 | #include <fstream>
 37 | #include <iostream>
 38 | // When creating a buffer with user pointer (CL_MEM_USE_HOST_PTR), under the
 39 | // hood
 40 | // User ptr is used if and only if it is properly aligned (page aligned). When
 41 | // not
 42 | // aligned, runtime has no choice but to create its own host side buffer that
 43 | // backs
 44 | // user ptr. This in turn implies that all operations that move data to and from
 45 | // device incur an extra memcpy to move data to/from runtime's own host buffer
 46 | // from/to user pointer. So it is recommended to use this allocator if user wish
 47 | // to
 48 | // Create Buffer/Memory Object with CL_MEM_USE_HOST_PTR to align user buffer to
 49 | // the
 50 | // page boundary. It will ensure that user buffer will be used when user create
 51 | // Buffer/Mem Object with CL_MEM_USE_HOST_PTR.
 52 | template <typename T> struct aligned_allocator {
 53 |     using value_type = T;
 54 | 
 55 |     aligned_allocator() {}
 56 | 
 57 |     aligned_allocator(const aligned_allocator &) {}
 58 | 
 59 |     template <typename U> aligned_allocator(const aligned_allocator<U> &) {}
 60 | 
 61 |     T *allocate(std::size_t num) {
 62 |         void *ptr = nullptr;
 63 | 
 64 | #if defined(_WINDOWS)
 65 |         {
 66 |             ptr = _aligned_malloc(num * sizeof(T), 4096);
 67 |             if (ptr == nullptr) {
 68 |                 std::cout << "Failed to allocate memory" << std::endl;
 69 |                 exit(EXIT_FAILURE);
 70 |             }
 71 |         }
 72 | #else
 73 |         {
 74 |             if (posix_memalign(&ptr, 4096, num * sizeof(T)))
 75 |                 throw std::bad_alloc();
 76 |         }
 77 | #endif
 78 |         return reinterpret_cast<T *>(ptr);
 79 |     }
 80 |     void deallocate(T *p, std::size_t num) {
 81 | #if defined(_WINDOWS)
 82 |         _aligned_free(p);
 83 | #else
 84 |         free(p);
 85 | #endif
 86 |     }
 87 | };
 88 | 
