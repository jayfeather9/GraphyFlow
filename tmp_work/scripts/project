  47 | edge_descriptor_loader(const bus_word_t *edge_props_ddr,
  48 |                        hls::stream<edge_descriptor_batch_t> &edge_stream,
  49 |                        int32_t num_edges) {
  50 |     const int bits_per_edge = NODE_ID_BITWIDTH + WEIGHT_BITWIDTH;
  51 |     const int edges_per_word = AXI_BUS_WIDTH / bits_per_edge;
  52 |     const int num_wide_reads =
  53 |         (num_edges + edges_per_word - 1) / edges_per_word;
  54 | 
  55 |     int edges_read = 0;
  56 |     edge_descriptor_batch_t edge_batch;
  57 | #pragma HLS ARRAY_PARTITION variable = edge_batch.edges complete dim = 0
  58 |     edge_batch.end_pos = 0;
  59 | 
  60 | LOOP_EDL_READ:
  61 |     for (int i = 0; i < num_wide_reads; i++) {
  62 | #pragma HLS PIPELINE II = 1
  63 |         bus_word_t wide_word = edge_props_ddr[i];
  64 |         // printf("Read a new edge.\n");
  65 |     LOOP_EDL_UNPACK:
  66 |         for (int j = 0; j < edges_per_word; j++) {
  67 | #pragma HLS UNROLL
  68 |             if (edges_read < num_edges) {
  69 |                 ap_uint<bits_per_edge> packed_edge = wide_word.range(
  70 |                     (j + 1) * bits_per_edge - 1, j * bits_per_edge);
  71 | 
  72 |                 node_with_prop_t edge;
  73 |                 edge.node_id = packed_edge.range(NODE_ID_BITWIDTH - 1, 0);
  74 |                 edge.prop =
  75 |                     packed_edge.range(bits_per_edge - 1, NODE_ID_BITWIDTH);
  76 |                 //   printf("[LITTLE]Loaded edge: dst=%d, weight=%f\n",
  77 |                 //   edge.node_id, (float)*reinterpret_cast<distance_t
  78 |                 //   *>(&edge.prop)); fflush(NULL);
  79 | 
  80 |                 edge_batch.edges[edge_batch.end_pos++] = edge;
  81 |                 edges_read++;
  82 | 
  83 |                 if (edge_batch.end_pos == PE_NUM) {
  84 |                     edge_stream.write(edge_batch);
  85 |                     edge_batch.end_pos = 0;
  86 |                 }
  87 |             }
  88 |         }
  89 |     }
  90 | 
  91 |     // Send any remaining partial batch
  92 |     if (edge_batch.end_pos > 0) {
  93 |         edge_stream.write(edge_batch);
  94 |     }
  95 | }
