 5624 |  5381 | 5291 |  127 |         break;
 5625 |  5382 | 5292 |  128 |     case 255:
 5626 |  5383 | 5293 |  129 |         count = 8;
 5627 |  5384 | 5294 |  130 |         break;
 5628 |  5385 | 5295 |  131 |     default:
 5629 |  5386 | 5296 |  132 |         break;
