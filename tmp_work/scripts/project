12982 | 12739 |   53 | static void
12983 | 12740 |   54 | edge_descriptor_loader(const bus_word_t *edge_props_ddr,
12984 | 12741 |   55 |                        hls::stream<edge_descriptor_batch_t> &edge_stream,
12985 | 12742 |   56 |                        int32_t num_edges) {
12986 | 12743 |   57 |     const int bits_per_edge = NODE_ID_BITWIDTH + WEIGHT_BITWIDTH;
12987 | 12744 |   58 |     const int edges_per_word = AXI_BUS_WIDTH / bits_per_edge;
12988 | 12745 |   59 |     const int num_wide_reads =
12989 | 12746 |   60 |         (num_edges + edges_per_word - 1) / edges_per_word;
12990 | 12747 |   61 | 
12991 | 12748 |   62 |     int edges_read = 0;
12992 | 12749 |   63 |     edge_descriptor_batch_t edge_batch;
12993 | 12750 |   64 | #pragma HLS ARRAY_PARTITION variable = edge_batch.edges complete dim = 0
12994 | 12751 |   65 |     edge_batch.end_pos = 0;
12995 | 12752 |   66 | 
12996 | 12753 |   67 | #if (NODE_ID_BITWIDTH == 32) && (WEIGHT_BITWIDTH == 32)
12997 | 12754 |   68 | LOOP_EDL_READ:
12998 | 12755 |   69 |     for (int i = 0; i < num_wide_reads; i++) {
12999 | 12756 |   70 | #pragma HLS PIPELINE II = 1
13000 | 12757 |   71 |         bus_word_t wide_word = edge_props_ddr[i];
13001 | 12758 |   72 |     LOOP_EDL_UNPACK:
13002 | 12759 |   73 |         for (int j = 0; j < edges_per_word; j++) {
13003 | 12760 |   74 | #pragma HLS UNROLL
13004 | 12761 |   75 |             if (edges_read + j < num_edges) {
13005 | 12762 |   76 |                 ap_uint<bits_per_edge> packed_edge = wide_word.range(
13006 | 12763 |   77 |                     (j + 1) * bits_per_edge - 1, j * bits_per_edge);
13007 | 12764 |   78 |                 node_with_prop_t edge;
13008 | 12765 |   79 |                 edge.node_id = packed_edge.range(NODE_ID_BITWIDTH - 1, 0);
13009 | 12766 |   80 |                 edge.prop =
13010 | 12767 |   81 |                     packed_edge.range(bits_per_edge - 1, NODE_ID_BITWIDTH);
13011 | 12768 |   82 | 
13012 | 12769 |   83 |                 edge_batch.edges[j] = edge;
13013 | 12770 |   84 |             }
13014 | 12771 |   85 |         }
13015 | 12772 |   86 |         edges_read += edges_per_word;
13016 | 12773 |   87 |         edge_batch.end_pos = (edges_read <= num_edges)
13017 | 12774 |   88 |                                  ? edges_per_word
13018 | 12775 |   89 |                                  : (num_edges % edges_per_word);
13019 | 12776 |   90 |         edge_stream.write(edge_batch);
13020 | 12777 |   91 |         edge_batch.end_pos = 0;
13021 | 12778 |   92 |     }
13022 | 12779 |   93 | #else
13023 | 12780 |   94 | // Add support for other bitwidth combinations if needed.
13024 | 12781 |   95 | #error                                                                         \
13025 | 12782 |   96 |     "edge_descriptor_loader currently only supports 32-bit node_id and 32-bit weight."
13026 | 12783 |   97 | #endif
13027 | 12784 |   98 | }
