299 | void AlgorithmHost::setup_buffers(const PartitionContainer &container) {
300 |     cl_int err;
301 |     std::cout << "--- [Host] Phase 1: Setting up HBM buffers for all kernels ---" << std::endl;
302 | 
303 |     big_kernel_buffers.clear();
304 |     little_kernel_buffers.clear();
305 |     hbm_manager_buffers.clear(); // Clear HBM manager buffers as well
306 |     big_kernel_host_outputs.resize(container.SPs.size());
307 |     little_kernel_host_outputs.resize(container.DPs.size());
308 | 
309 |     const size_t bytes_per_word = AXI_BUS_WIDTH / 8;
310 | 
311 |     // --- 1.3: Setup buffers for BIG kernels (Sparse Partitions) ---
312 |     // DISABLED FOR LITTLE KERNEL TESTING
313 |     /*
314 |     for (size_t i = 0; i < container.SPs.size(); ++i) {
315 |         // ... (BIG KERNEL LOGIC IS COMMENTED OUT)
316 |     }
317 |     */
318 |     
319 |     // --- Setup buffer for HBM Manager Kernel (Now for Little Kernels) ---
320 |     // Assuming we have at least one little kernel to test
321 |     if (!container.DPs.empty()) {
322 |         KernelBuffers hbm_buffers;
323 |         cl_mem_ext_ptr_t hbm_ext_in2;
324 |         // This HBM bank should be accessible by the little kernels
325 |         hbm_ext_in2.flags = XCL_MEM_TOPOLOGY | 2; // Example HBM bank
326 |         hbm_ext_in2.obj = nullptr;
327 |         hbm_ext_in2.param = 0;
328 |         
329 |         size_t num_dist_words = hbm_manager_host_buffers[0].packed_node_props.size();
330 |         OCL_CHECK(err,
331 |                   hbm_buffers.node_props_buf = cl::Buffer(
332 |                       acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX,
333 |                       num_dist_words * bytes_per_word, &hbm_ext_in2, &err));
334 |         hbm_manager_buffers.push_back(hbm_buffers);
335 |     }
336 | 
337 | 
338 |     // --- 1.4: Setup buffers for LITTLE kernels (Dense Partitions) ---
339 |     // ENABLED FOR LITTLE KERNEL TESTING
340 |     for (size_t i = 0; i < container.DPs.size(); ++i) {
341 |         const auto &p_graph = container.DPs[i].partitioned_graph;
342 |         KernelBuffers buffers;
343 | 
344 |         cl_mem_ext_ptr_t hbm_ext_in0, hbm_ext_in1, hbm_ext_out;
345 |         hbm_ext_in0.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_input_id[i];
346 |         hbm_ext_in0.obj = nullptr;
347 |         hbm_ext_in0.param = 0;
348 |         hbm_ext_in1.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_input_id[i];
349 |         hbm_ext_in1.obj = nullptr;
350 |         hbm_ext_in1.param = 0;
351 |         hbm_ext_out.flags = XCL_MEM_TOPOLOGY | acc.little_kernel_hbm_output_id[i];
352 |         hbm_ext_out.obj = nullptr;
353 |         hbm_ext_out.param = 0;
354 | 
355 |         size_t num_id_words = little_kernel_input_buffers[i].packed_src_ids.size();
356 |         size_t num_edge_words = little_kernel_input_buffers[i].packed_edge_props.size();
357 | 
358 |         OCL_CHECK(err,
359 |                   buffers.src_ids_buf = cl::Buffer(
360 |                       acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX,
361 |                       num_id_words * bytes_per_word, &hbm_ext_in0, &err));
362 |         OCL_CHECK(err,
363 |                   buffers.edge_props_buf = cl::Buffer(
364 |                       acc.context, CL_MEM_READ_ONLY | CL_MEM_EXT_PTR_XILINX,
365 |                       num_edge_words * bytes_per_word, &hbm_ext_in1, &err));
366 |         
367 |         // Note: node_props_buf is no longer set here, it's handled by the HBM manager
368 | 
369 |         size_t bits_per_output = NODE_ID_BITWIDTH + DISTANCE_BITWIDTH + OUT_END_MARKER_BITWIDTH;
370 |         size_t max_dst_local_id = 0;
371 |         for (size_t e = 0; e < p_graph.num_edges; ++e) {
372 |             int dst = p_graph.columns[e];
373 |             if (dst > max_dst_local_id) {
374 |                 max_dst_local_id = dst;
375 |             }
376 |         }
377 |         size_t num_dst_vertices = max_dst_local_id + 1;
378 |         size_t vert_num_in_word = AXI_BUS_WIDTH / bits_per_output;
379 |         size_t num_output_words = (num_dst_vertices + vert_num_in_word - 1) / vert_num_in_word + 1;
380 | 
381 |         little_kernel_host_outputs[i].resize(num_output_words);
382 |         OCL_CHECK(err,
383 |                   buffers.output_buf = cl::Buffer(
384 |                       acc.context, CL_MEM_WRITE_ONLY | CL_MEM_EXT_PTR_XILINX,
385 |                       num_output_words * bytes_per_word, &hbm_ext_out, &err));
386 | 
387 |         little_kernel_buffers.push_back(buffers);
388 |     }
389 | 
390 |     std::cout << "[SUCCESS] HBM buffers created for " << container.DPs.size() << " little kernels and 1 HBM manager." << std::endl;
391 | }
