 295 | 
 296 | ap_fixed_pod_t get_val_from_256_bus(const ap_uint<256> bus, int offset) {
 297 | #pragma HLS INLINE
 298 |     switch (offset) {
 299 |     case 0:
 300 |         return bus.range(31, 0);
 301 |     case 1:
 302 |         return bus.range(63, 32);
 303 |     case 2:
 304 |         return bus.range(95, 64);
 305 |     case 3:
 306 |         return bus.range(127, 96);
 307 |     case 4:
 308 |         return bus.range(159, 128);
 309 |     case 5:
 310 |         return bus.range(191, 160);
 311 |     case 6:
 312 |         return bus.range(223, 192);
 313 |     case 7:
 314 |         return bus.range(255, 224);
 315 |     default:
 316 |         return 0;
 317 |     }
 318 | }
