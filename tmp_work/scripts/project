 8771 |  8528 | 248 |             little_kernel_input_buffers[i].packed_edge_props.resize(
 8772 |  8529 | 249 |                 (temp_byte_buffer.size() + bytes_per_word - 1) /
 8773 |  8530 | 250 |                 bytes_per_word, 0);
 8774 |  8531 | 251 |             std::memcpy(little_kernel_input_buffers[i].packed_edge_props.data(),
 8775 |  8532 | 252 |                         temp_byte_buffer.data(), temp_byte_buffer.size());
 8776 |  8533 | 253 |         }
 8777 |  8534 | 254 | 
 8778 |  8535 | 255 |         current_time = std::chrono::system_clock::now();
 8779 |  8536 | 256 |         std::cout << "--- [Host] Phase 0: Preparing data structures little edge props ("
 8780 |  8537 | 257 |                   << std::chrono::duration<double>(current_time - start_time).count()
 8781 |  8538 | 258 |                   << " sec) ---" << std::endl;
 8782 |  8539 | 259 |         start_time = current_time;
 8783 |  8540 | 260 | 
 8784 |  8541 | 261 |         // --- Pack source IDs (node_id_t -> 4 bytes) ---
 8785 |  8542 | 262 |         // 关键修正: 完全复制big kernel的逻辑
 8786 |  8543 | 263 |         {
 8787 |  8544 | 264 |             const size_t bytes_per_id = sizeof(node_id_t);
 8788 |  8545 | 265 |             const size_t ids_per_word = bytes_per_word / bytes_per_id;
 8789 |  8546 | 266 |             const size_t word_number =
 8790 |  8547 | 267 |                 (p_graph.num_edges + ids_per_word - 1) / ids_per_word;
 8791 |  8548 | 268 |             std::vector<char> temp_byte_buffer;
 8792 |  8549 | 269 |             temp_byte_buffer.reserve(word_number * bytes_per_word);
 8793 |  8550 | 270 | 
 8794 |  8551 | 271 |             for (int j = 0; j < p_graph.num_vertices; ++j) {
 8795 |  8552 | 272 |                 for (int k = p_graph.offsets[j]; k < p_graph.offsets[j + 1];
 8796 |  8553 | 273 |                      ++k) {
 8797 |  8554 | 274 |                     node_id_t src_id = j;
 8798 |  8555 | 275 |                     const char *id_bytes =
 8799 |  8556 | 276 |                         reinterpret_cast<const char *>(&src_id);
 8800 |  8557 | 277 |                     for (size_t l = 0; l < bytes_per_id; ++l) {
 8801 |  8558 | 278 |                         temp_byte_buffer.push_back(id_bytes[l]);
 8802 |  8559 | 279 |                     }
 8803 |  8560 | 280 |                 }
 8804 |  8561 | 281 |             }
 8805 |  8562 | 282 | 
 8806 |  8563 | 283 |             little_kernel_input_buffers[i].packed_src_ids.resize(
 8807 |  8564 | 284 |                 (temp_byte_buffer.size() + bytes_per_word - 1) /
 8808 |  8565 | 285 |                     bytes_per_word,
 8809 |  8566 | 286 |                 0);
 8810 |  8567 | 287 |             std::memcpy(little_kernel_input_buffers[i].packed_src_ids.data(),
 8811 |  8568 | 288 |                         temp_byte_buffer.data(), temp_byte_buffer.size());
 8812 |  8569 | 289 |         }
 8813 |  8570 | 290 | 
 8814 |  8571 | 291 |         current_time = std::chrono::system_clock::now();
 8815 |  8572 | 292 |         std::cout << "--- [Host] Phase 0: Preparing data structures little src ids ("
 8816 |  8573 | 293 |                   << std::chrono::duration<double>(current_time - start_time).count()
 8817 |  8574 | 294 |                   << " sec) ---" << std::endl;
 8818 |  8575 | 295 |         start_time = current_time;
 8819 |  8576 | 296 |     }
