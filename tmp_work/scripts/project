  795 |   552 |  462 |  38 | // When creating a buffer with user pointer (CL_MEM_USE_HOST_PTR), under the
  796 |   553 |  463 |  39 | // hood
  797 |   554 |  464 |  40 | // User ptr is used if and only if it is properly aligned (page aligned). When
  798 |   555 |  465 |  41 | // not
  799 |   556 |  466 |  42 | // aligned, runtime has no choice but to create its own host side buffer that
  800 |   557 |  467 |  43 | // backs
  801 |   558 |  468 |  44 | // user ptr. This in turn implies that all operations that move data to and from
  802 |   559 |  469 |  45 | // device incur an extra memcpy to move data to/from runtime's own host buffer
  803 |   560 |  470 |  46 | // from/to user pointer. So it is recommended to use this allocator if user wish
  804 |   561 |  471 |  47 | // to
  805 |   562 |  472 |  48 | // Create Buffer/Memory Object with CL_MEM_USE_HOST_PTR to align user buffer to
  806 |   563 |  473 |  49 | // the
  807 |   564 |  474 |  50 | // page boundary. It will ensure that user buffer will be used when user create
  808 |   565 |  475 |  51 | // Buffer/Mem Object with CL_MEM_USE_HOST_PTR.
  809 |   566 |  476 |  52 | template <typename T> struct aligned_allocator {
  810 |   567 |  477 |  53 |     using value_type = T;
  811 |   568 |  478 |  54 | 
  812 |   569 |  479 |  55 |     aligned_allocator() {}
  813 |   570 |  480 |  56 | 
  814 |   571 |  481 |  57 |     aligned_allocator(const aligned_allocator &) {}
  815 |   572 |  482 |  58 | 
  816 |   573 |  483 |  59 |     template <typename U> aligned_allocator(const aligned_allocator<U> &) {}
  817 |   574 |  484 |  60 | 
  818 |   575 |  485 |  61 |     T *allocate(std::size_t num) {
  819 |   576 |  486 |  62 |         void *ptr = nullptr;
  820 |   577 |  487 |  63 | 
  821 |   578 |  488 |  64 | #if defined(_WINDOWS)
  822 |   579 |  489 |  65 |         {
  823 |   580 |  490 |  66 |             ptr = _aligned_malloc(num * sizeof(T), 4096);
  824 |   581 |  491 |  67 |             if (ptr == nullptr) {
  825 |   582 |  492 |  68 |                 std::cout << "Failed to allocate memory" << std::endl;
  826 |   583 |  493 |  69 |                 exit(EXIT_FAILURE);
  827 |   584 |  494 |  70 |             }
  828 |   585 |  495 |  71 |         }
  829 |   586 |  496 |  72 | #else
  830 |   587 |  497 |  73 |         {
  831 |   588 |  498 |  74 |             if (posix_memalign(&ptr, 4096, num * sizeof(T)))
  832 |   589 |  499 |  75 |                 throw std::bad_alloc();
  833 |   590 |  500 |  76 |         }
  834 |   591 |  501 |  77 | #endif
  835 |   592 |  502 |  78 |         return reinterpret_cast<T *>(ptr);
  836 |   593 |  503 |  79 |     }
  837 |   594 |  504 |  80 |     void deallocate(T *p, std::size_t num) {
  838 |   595 |  505 |  81 | #if defined(_WINDOWS)
  839 |   596 |  506 |  82 |         _aligned_free(p);
  840 |   597 |  507 |  83 | #else
  841 |   598 |  508 |  84 |         free(p);
  842 |   599 |  509 |  85 | #endif
  843 |   600 |  510 |  86 |     }
  844 |   601 |  511 |  87 | };
  845 |   602 |  512 |  88 | 
