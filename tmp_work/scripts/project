 8998 |  8755 | 475 | void AlgorithmHost::execute_kernel_iteration(
 8999 |  8756 | 476 |     const PartitionContainer &container,
 9000 |  8757 | 477 |     std::vector<cl::Event> &big_kernel_events,
 9001 |  8758 | 478 |     std::vector<cl::Event> &little_kernel_events) {
 9002 |  8759 | 479 |     cl_int err;
