13427 | 13184 |  498 | // --- REWRITTEN: New final_writeback function packs results into 512-bit words.
13428 | 13185 |  499 | static void final_writeback(hls::stream<internal_end_data_batch_t> &in_stream,
13429 | 13186 |  500 |                             bus_word_t *out_ddr) {
13430 | 13187 |  501 |     const int bits_per_output =
13431 | 13188 |  502 |         NODE_ID_BITWIDTH + DISTANCE_BITWIDTH + OUT_END_MARKER_BITWIDTH;
13432 | 13189 |  503 |     const int outputs_per_word = AXI_BUS_WIDTH / bits_per_output;
13433 | 13190 |  504 | 
13434 | 13191 |  505 |     bus_word_t write_word = 0;
13435 | 13192 |  506 |     int pack_count = 0;
13436 | 13193 |  507 |     int ddr_addr = 0;
13437 | 13194 |  508 | 
