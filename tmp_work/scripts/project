 535 | 
 536 | inline distance_t get_val(reduce_word_t word, int idx) {
 537 | #pragma HLS INLINE
 538 |     ap_uint<DISTANCE_BITWIDTH> bits;
 539 |     switch (idx) {
 540 |     case 0:
 541 |         bits = word.range(DISTANCE_BITWIDTH - 1, 0);
 542 |         break;
 543 |     case 1:
 544 |         bits = word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH);
 545 |         break;
 546 |     case 2:
 547 |         bits =
 548 |             word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1));
 549 |         break;
 550 |     default:
 551 |         bits = 0;
 552 |         break;
 553 |     }
 554 |     // Convert bits back to distance_t (floating point)
 555 |     return *reinterpret_cast<distance_t *>(&bits);
 556 | }
 557 | 
 558 | inline void set_val(reduce_word_t &word, int idx, distance_t val) {
 559 | #pragma HLS INLINE
 560 |     ap_uint<DISTANCE_BITWIDTH> val_bits =
 561 |         *reinterpret_cast<ap_uint<DISTANCE_BITWIDTH> *>(&val);
 562 |     switch (idx) {
 563 |     case 0:
 564 |         word.range(DISTANCE_BITWIDTH - 1, 0) = val_bits;
 565 |         break;
 566 |     case 1:
 567 |         word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH) = val_bits;
 568 |         break;
 569 |     case 2:
 570 |         word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1)) =
 571 |             val_bits;
 572 |         break;
 573 |     default:
 574 |         break;
 575 |     }
 576 | }
