16864 |  66 | cl::Device find_device_bdf(const std::vector<cl::Device> &devices,
16865 |  67 |                            const std::string &bdf) {
16866 |  68 |     char device_bdf[20];
16867 |  69 |     cl_int err;
16868 |  70 |     cl::Device device;
16869 |  71 |     int cnt = 0;
16870 |  72 |     for (uint32_t i = 0; i < devices.size(); i++) {
16871 |  73 |         OCL_CHECK(err,
16872 |  74 |                   err = devices[i].getInfo(CL_DEVICE_PCIE_BDF, &device_bdf));
16873 |  75 |         if (bdf == device_bdf) {
16874 |  76 |             device = devices[i];
16875 |  77 |             cnt++;
16876 |  78 |             break;
16877 |  79 |         }
16878 |  80 |     }
16879 |  81 |     if (cnt == 0) {
16880 |  82 |         std::cout << "Invalid device bdf. Please check and provide valid bdf\n";
16881 |  83 |         exit(EXIT_FAILURE);
16882 |  84 |     }
16883 |  85 |     return device;
16884 |  86 | }
