16234 | 432 | void AlgorithmHost::transfer_data_to_fpga(const PartitionContainer &container) {
16235 | 433 |     cl_int err;
16236 | 434 |     std::cout << "--- [Host] Phase 2: Packing and transferring data to HBM ---" << std::endl;
16237 | 435 | 
16238 | 436 |     // DISABLED FOR LITTLE KERNEL TESTING
16239 | 437 |     /*
16240 | 438 |     for (size_t i = 0; i < big_kernel_buffers.size(); ++i) {
16241 | 439 |         // ... (BIG KERNEL LOGIC IS COMMENTED OUT)
16242 | 440 |     }
16243 | 441 |     */
16244 | 442 |     
16245 | 443 |     // Transfer data for HBM Manager (for little kernels)
16246 | 444 |     if (!hbm_manager_buffers.empty()) {
16247 | 445 |         OCL_CHECK(err,
16248 | 446 |               err = acc.hbm_manager_queue.enqueueWriteBuffer(
16249 | 447 |                   hbm_manager_buffers[0].node_props_buf, CL_FALSE, 0,
16250 | 448 |                   hbm_manager_host_buffers[0].packed_node_props.size() * sizeof(bus_word_t),
16251 | 449 |                   hbm_manager_host_buffers[0].packed_node_props.data()));
16252 | 450 |     }
16253 | 451 | 
16254 | 452 |     // ENABLED FOR LITTLE KERNEL TESTING
16255 | 453 |     for (size_t i = 0; i < little_kernel_buffers.size(); ++i) {
16256 | 454 |         // Note: node_props_buf is no longer transferred here.
16257 | 455 |         OCL_CHECK(err,
16258 | 456 |                   err = acc.little_gs_queue[i].enqueueWriteBuffer(
16259 | 457 |                       little_kernel_buffers[i].edge_props_buf, CL_FALSE, 0,
16260 | 458 |                       little_kernel_input_buffers[i].packed_edge_props.size() * sizeof(bus_word_t),
16261 | 459 |                       little_kernel_input_buffers[i].packed_edge_props.data()));
16262 | 460 |         OCL_CHECK(err,
16263 | 461 |                   err = acc.little_gs_queue[i].enqueueWriteBuffer(
16264 | 462 |                       little_kernel_buffers[i].src_ids_buf, CL_FALSE, 0,
16265 | 463 |                       little_kernel_input_buffers[i].packed_src_ids.size() * sizeof(bus_word_t),
16266 | 464 |                       little_kernel_input_buffers[i].packed_src_ids.data()));
16267 | 465 |     }
16268 | 466 | 
16269 | 467 |     // --- 2.4: 在所有命令入队后，执行一次全局同步 ---
16270 | 468 |     for (auto &q : acc.big_gs_queue) q.finish(); // Stays for safety, though should be empty
16271 | 469 |     acc.hbm_manager_queue.finish();
16272 | 470 |     for (auto &q : acc.little_gs_queue) q.finish();
16273 | 471 | 
16274 | 472 |     std::cout << "[SUCCESS] All data packed and transferred for current iteration." << std::endl;
16275 | 473 | }
16276 | 474 | 
16277 | 475 | void AlgorithmHost::execute_kernel_iteration(
16278 | 476 |     const PartitionContainer &container,
16279 | 477 |     std::vector<cl::Event> &big_kernel_events,
16280 | 478 |     std::vector<cl::Event> &little_kernel_events) {
16281 | 479 |     cl_int err;
16282 | 480 |     std::cout << "--- [Host] Phase 3: Enqueuing kernel tasks ---" << std::endl;
16283 | 481 | 
16284 | 482 |     // DISABLED FOR LITTLE KERNEL TESTING
16285 | 483 |     /*
16286 | 484 |     for (size_t i = 0; i < big_kernel_buffers.size(); ++i) {
16287 | 485 |         // ... (BIG KERNEL LOGIC IS COMMENTED OUT)
16288 | 486 |     }
16289 | 487 |     */
16290 | 488 | 
16291 | 489 |     // Enqueue HBM Manager (for little kernels)
16292 | 490 |     if (!hbm_manager_buffers.empty()) {
16293 | 491 |         auto &kernel = acc.hbm_manager_krnl;
16294 | 492 |         auto &buffers = hbm_manager_buffers[0];
16295 | 493 |         
16296 | 494 |         // This assumes the number of vertices for the manager is the total number
16297 | 495 |         // or a relevant subset for all little kernels. Using m_num_vertices for now.
16298 | 496 |         int num_nodes_for_manager = m_num_vertices;
16299 | 497 | 
16300 | 498 |         int arg_idx = 0;
16301 | 499 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, buffers.node_props_buf));
16302 | 500 |         OCL_CHECK(err, err = kernel.setArg(arg_idx++, num_nodes_for_manager));
16303 | 501 | 
16304 | 502 |         // Use the first little kernel's event to chain the manager
16305 | 503 |         cl::Event *event_ptr = &little_kernel_events[0];
16306 | 504 |         OCL_CHECK(err, err = acc.hbm_manager_queue.enqueueTask(kernel, nullptr, event_ptr));
16307 | 505 |     }
16308 | 506 | 
16309 | 507 | 
16310 | 508 |     // ENABLED AND CORRECTED FOR LITTLE KERNEL TESTING
16311 | 509 |     for (size_t i = 0; i < little_kernel_buffers.size(); ++i) {
16312 | 510 |         auto &kernel = acc.little_gs_krnls[i];
16313 | 511 |         auto &buffers = little_kernel_buffers[i];
16314 | 512 |         const auto &p_graph = container.DPs[i].partitioned_graph;
