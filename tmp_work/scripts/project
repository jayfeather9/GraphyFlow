16948 | 150 | double round_off(double n) {
16949 | 151 |     double d = n * 100.0;
16950 | 152 |     int i = d + 0.5;
16951 | 153 |     d = i / 100.0;
16952 | 154 |     return d;
16953 | 155 | }
16954 | 156 | 
16955 | 157 | std::string convert_size(size_t size) {
16956 | 158 |     static const char *SIZES[] = {"B", "KB", "MB", "GB"};
16957 | 159 |     uint32_t div = 0;
16958 | 160 |     size_t rem = 0;
16959 | 161 | 
16960 | 162 |     while (size >= 1024 && div < (sizeof SIZES / sizeof *SIZES)) {
16961 | 163 |         rem = (size % 1024);
16962 | 164 |         div++;
16963 | 165 |         size /= 1024;
16964 | 166 |     }
16965 | 167 | 
16966 | 168 |     double size_d = (float)size + (float)rem / 1024.0;
16967 | 169 |     double size_val = round_off(size_d);
16968 | 170 | 
16969 | 171 |     std::stringstream stream;
16970 | 172 |     stream << std::fixed << std::setprecision(2) << size_val;
16971 | 173 |     std::string size_str = stream.str();
16972 | 174 |     std::string result = size_str + " " + SIZES[div];
16973 | 175 |     return result;
16974 | 176 | }
16975 | 177 | 
16976 | 178 | bool is_xpr_device(const char *device_name) {
16977 | 179 |     const char *output = strstr(device_name, "xpr");
16978 | 180 | 
16979 | 181 |     if (output == nullptr) {
16980 | 182 |         return false;
16981 | 183 |     } else {
16982 | 184 |         return true;
16983 | 185 |     }
16984 | 186 | }
