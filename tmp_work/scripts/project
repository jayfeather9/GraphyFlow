15580 |  36 | #include <fstream>
15581 |  37 | #include <iostream>
15582 |  38 | // When creating a buffer with user pointer (CL_MEM_USE_HOST_PTR), under the
15583 |  39 | // hood
15584 |  40 | // User ptr is used if and only if it is properly aligned (page aligned). When
15585 |  41 | // not
15586 |  42 | // aligned, runtime has no choice but to create its own host side buffer that
15587 |  43 | // backs
15588 |  44 | // user ptr. This in turn implies that all operations that move data to and from
15589 |  45 | // device incur an extra memcpy to move data to/from runtime's own host buffer
15590 |  46 | // from/to user pointer. So it is recommended to use this allocator if user wish
15591 |  47 | // to
15592 |  48 | // Create Buffer/Memory Object with CL_MEM_USE_HOST_PTR to align user buffer to
15593 |  49 | // the
15594 |  50 | // page boundary. It will ensure that user buffer will be used when user create
15595 |  51 | // Buffer/Mem Object with CL_MEM_USE_HOST_PTR.
15596 |  52 | template <typename T> struct aligned_allocator {
15597 |  53 |     using value_type = T;
15598 |  54 | 
15599 |  55 |     aligned_allocator() {}
15600 |  56 | 
15601 |  57 |     aligned_allocator(const aligned_allocator &) {}
15602 |  58 | 
15603 |  59 |     template <typename U> aligned_allocator(const aligned_allocator<U> &) {}
15604 |  60 | 
15605 |  61 |     T *allocate(std::size_t num) {
15606 |  62 |         void *ptr = nullptr;
15607 |  63 | 
15608 |  64 | #if defined(_WINDOWS)
15609 |  65 |         {
15610 |  66 |             ptr = _aligned_malloc(num * sizeof(T), 4096);
15611 |  67 |             if (ptr == nullptr) {
15612 |  68 |                 std::cout << "Failed to allocate memory" << std::endl;
15613 |  69 |                 exit(EXIT_FAILURE);
15614 |  70 |             }
15615 |  71 |         }
15616 |  72 | #else
15617 |  73 |         {
15618 |  74 |             if (posix_memalign(&ptr, 4096, num * sizeof(T)))
15619 |  75 |                 throw std::bad_alloc();
15620 |  76 |         }
15621 |  77 | #endif
15622 |  78 |         return reinterpret_cast<T *>(ptr);
15623 |  79 |     }
15624 |  80 |     void deallocate(T *p, std::size_t num) {
15625 |  81 | #if defined(_WINDOWS)
15626 |  82 |         _aligned_free(p);
15627 |  83 | #else
15628 |  84 |         free(p);
15629 |  85 | #endif
15630 |  86 |     }
15631 |  87 | };
