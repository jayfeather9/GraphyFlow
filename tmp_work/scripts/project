17373 |  55 |               << std::endl;
17374 |  56 | 
17375 |  57 |     // --- PHASE 1: Identify and Collect All Unique Destination Vertices ---
17376 |  58 |     std::set<int> unique_dst_vertices_set;
17377 |  59 |     for (int i = 0; i < graph->num_edges; ++i) {
17378 |  60 |         unique_dst_vertices_set.insert(graph->columns[i]);
17379 |  61 |     }
