13839 | 13596 |  910 |         *reinterpret_cast<ap_uint<DISTANCE_BITWIDTH> *>(&val);
13840 | 13597 |  911 |     switch (idx) {
13841 | 13598 |  912 |     case 0:
13842 | 13599 |  913 |         word.range(DISTANCE_BITWIDTH - 1, 0) = val_bits;
13843 | 13600 |  914 |         break;
13844 | 13601 |  915 |     case 1:
13845 | 13602 |  916 |         word.range((DISTANCE_BITWIDTH << 1) - 1, DISTANCE_BITWIDTH) = val_bits;
13846 | 13603 |  917 |         break;
13847 | 13604 |  918 |     case 2:
13848 | 13605 |  919 |         word.range((DISTANCE_BITWIDTH * 3) - 1, (DISTANCE_BITWIDTH << 1)) =
13849 | 13606 |  920 |             val_bits;
13850 | 13607 |  921 |         break;
