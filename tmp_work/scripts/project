157 | std::string convert_size(size_t size) {
158 |     static const char *SIZES[] = {"B", "KB", "MB", "GB"};
159 |     uint32_t div = 0;
160 |     size_t rem = 0;
161 | 
162 |     while (size >= 1024 && div < (sizeof SIZES / sizeof *SIZES)) {
163 |         rem = (size % 1024);
164 |         div++;
165 |         size /= 1024;
166 |     }
167 | 
168 |     double size_d = (float)size + (float)rem / 1024.0;
169 |     double size_val = round_off(size_d);
170 | 
171 |     std::stringstream stream;
172 |     stream << std::fixed << std::setprecision(2) << size_val;
173 |     std::string size_str = stream.str();
174 |     std::string result = size_str + " " + SIZES[div];
175 |     return result;
176 | }
