13284 | 13041 |  355 | static void
13285 | 13042 |  356 | merge_node_props(hls::stream<bus_word_t> (&cacheline_streams)[PE_NUM],
13286 | 13043 |  357 |                  hls::stream<edge_descriptor_batch_t> &edge_stream,
13287 | 13044 |  358 |                  hls::stream<node_id_burst_t> &src_id_burst_stream,
13288 | 13045 |  359 |                  hls::stream<edge_batch_t> &edge_batch_stream,
13289 | 13046 |  360 |                  uint32_t edge_num) {
13290 | 13047 |  361 |     bus_word_t last_cacheline[PE_NUM];
13291 | 13048 |  362 | #pragma HLS ARRAY_PARTITION variable = last_cacheline complete dim = 0
13292 | 13049 |  363 |     ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> last_cache_idx[PE_NUM];
13293 | 13050 |  364 | #pragma HLS ARRAY_PARTITION variable = last_cache_idx complete dim = 0
13294 | 13051 |  365 | 
13295 | 13052 |  366 | // Init first cacheline for each PE
13296 | 13053 |  367 | LOOP_INIT_CACHELINE:
13297 | 13054 |  368 |     for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
13298 | 13055 |  369 | #pragma HLS UNROLL
13299 | 13056 |  370 |         last_cacheline[pe_idx] = cacheline_streams[pe_idx].read();
13300 | 13057 |  371 |         last_cache_idx[pe_idx] = 0;
13301 | 13058 |  372 |     }
13302 | 13059 |  373 | 
13303 | 13060 |  374 |     const uint32_t scatter_size = (edge_num + PE_NUM - 1) / PE_NUM;
13304 | 13061 |  375 | // printf("Merging node properties for %d edges (%d scatter batches)\n",
13305 | 13062 |  376 | // edge_num, scatter_size); fflush(NULL);
13306 | 13063 |  377 | LOOP_SCATTER_EDGES:
13307 | 13064 |  378 |     for (int32_t edge_batch_idx = 0; edge_batch_idx < scatter_size;
13308 | 13065 |  379 |          edge_batch_idx++) {
13309 | 13066 |  380 | #pragma HLS PIPELINE II = 1
13310 | 13067 |  381 |         edge_descriptor_batch_t edge_batch;
13311 | 13068 |  382 | #pragma HLS ARRAY_PARTITION variable = edge_batch.edges complete dim = 0
13312 | 13069 |  383 |         edge_batch = edge_stream.read();
13313 | 13070 |  384 |         node_id_burst_t src_id_burst = src_id_burst_stream.read();
13314 | 13071 |  385 | #pragma HLS ARRAY_PARTITION variable = src_id_burst.data complete dim = 0
13315 | 13072 |  386 |         edge_batch_t out_batch;
13316 | 13073 |  387 | #pragma HLS ARRAY_PARTITION variable = out_batch.src_distances complete dim = 0
13317 | 13074 |  388 | #pragma HLS ARRAY_PARTITION variable = out_batch.weights complete dim = 0
13318 | 13075 |  389 | #pragma HLS ARRAY_PARTITION variable = out_batch.dsts complete dim = 0
13319 | 13076 |  390 |         out_batch.end_flag = false;
13320 | 13077 |  391 |         out_batch.end_pos = edge_batch.end_pos;
13321 | 13078 |  392 |         bus_word_t cur_last_cacheline;
13322 | 13079 |  393 |         ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cur_last_cache_idx;
13323 | 13080 |  394 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
13324 | 13081 |  395 | #pragma HLS UNROLL
13325 | 13082 |  396 |             ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cacheline_idx =
13326 | 13083 |  397 |                 (src_id_burst.data[pe_idx] >> LOG_DIST_PER_WORD);
13327 | 13084 |  398 |             uint32_t offset = (src_id_burst.data[pe_idx] & (DIST_PER_WORD - 1));
13328 | 13085 |  399 |             if (pe_idx < edge_batch.end_pos) {
13329 | 13086 |  400 |                 bus_word_t cacheline;
13330 | 13087 |  401 |                 if (cacheline_idx == last_cache_idx[pe_idx]) {
13331 | 13088 |  402 |                     cacheline = last_cacheline[pe_idx];
13332 | 13089 |  403 |                 } else {
13333 | 13090 |  404 |                     cacheline = cacheline_streams[pe_idx].read();
13334 | 13091 |  405 |                 }
13335 | 13092 |  406 | 
