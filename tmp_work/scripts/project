19640 |  207 | static void
19641 |  208 | cacheline_req_sender(hls::stream<distance_req_pack_t> &distance_req_pack_stream,
19642 |  209 |                      hls::stream<cacheline_req_t> &cacheline_req_stream) {
19643 |  210 | 
19644 |  211 |     cacheline_req_t cache_req;
19645 |  212 |     cache_req.end_flag = false;
19646 |  213 |     cache_req.idx = 0;
19647 |  214 |     cache_req.dst = 0;
19648 |  215 |     cacheline_req_stream.write(cache_req);
19649 |  216 | 
19650 |  217 |     ap_uint<NODE_ID_BITWIDTH - LOG_DIST_PER_WORD> cacheline_idx[PE_NUM];
19651 |  218 | #pragma HLS ARRAY_PARTITION variable = cacheline_idx complete dim = 0
19652 |  219 | 
19653 |  220 | LOOP_SEND_CACHE_REQ:
19654 |  221 |     while (true) {
19655 |  222 | #pragma HLS PIPELINE II = 1
19656 |  223 |         distance_req_pack_t req_pack = distance_req_pack_stream.read();
19657 |  224 |         for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
19658 |  225 | #pragma HLS UNROLL
19659 |  226 |             cacheline_idx[pe_idx] =
19660 |  227 |                 req_pack.node_ids[pe_idx] >> LOG_DIST_PER_WORD;
19661 |  228 |         }
19662 |  229 | 
19663 |  230 |         {
19664 |  231 |         LOOP_SEND_CACHE_REQ_INNER:
19665 |  232 |             for (ap_uint<4> i = req_pack.offset; i < PE_NUM; i++) {
19666 |  233 | #pragma HLS PIPELINE II = 1 rewind
19667 |  234 | #pragma HLS unroll factor = 1
19668 |  235 |                 cache_req.idx = cacheline_idx[i];
19669 |  236 |                 cache_req.dst = i;
19670 |  237 |                 cache_req.end_flag = req_pack.end_flag;
19671 |  238 |                 cacheline_req_stream.write(cache_req);
19672 |  239 |                 // printf("Sent cacheline req for idx %d to PE %d\n",
19673 |  240 |                 // (int)cache_req.idx, (int)cache_req.dst); fflush(NULL);
19674 |  241 |             }
19675 |  242 |         }
19676 |  243 | 
19677 |  244 |         if (req_pack.end_flag) {
19678 |  245 |             break;
19679 |  246 |         }
19680 |  247 |     }
19681 |  248 |     cache_req.end_flag = true;
19682 |  249 |     cacheline_req_stream.write(cache_req);
19683 |  250 | }
