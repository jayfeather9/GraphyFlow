566 | 
567 | bool AlgorithmHost::check_convergence_and_update(const PartitionContainer &container) {
568 |     bool changed = false;
569 |     std::cout << "--- [Host] Phase 5: Unpacking results and checking for convergence ---" << std::endl;
570 | 
571 |     std::map<int, distance_t> min_distances;
572 |     const int bits_per_output = NODE_ID_BITWIDTH + DISTANCE_BITWIDTH + OUT_END_MARKER_BITWIDTH;
573 |     const int outputs_per_word = AXI_BUS_WIDTH / bits_per_output;
574 | 
575 |     // DISABLED
576 |     /*
577 |     for (size_t i = 0; i < big_kernel_host_outputs.size(); ++i) {
578 |         // ... (BIG KERNEL LOGIC IS COMMENTED OUT)
579 |     }
580 |     */
581 | 
582 |     // ENABLED
583 |     for (size_t i = 0; i < little_kernel_host_outputs.size(); ++i) {
584 |         const auto &p_graph = container.DPs[i].partitioned_graph;
585 |         for (const auto &word : little_kernel_host_outputs[i]) {
586 |             out_end_marker_t end_flag = 0;
587 |             for (int k = 0; k < outputs_per_word; ++k) {
588 |                 int bit_offset = k * bits_per_output;
589 |                 ap_uint<bits_per_output> packed_output = word.range(bit_offset + bits_per_output - 1, bit_offset);
590 | 
591 |                 ap_uint<NODE_ID_BITWIDTH> local_id_pod = packed_output.range(NODE_ID_BITWIDTH - 1, 0);
592 |                 ap_fixed_pod_t dist_pod = packed_output.range(NODE_ID_BITWIDTH + DISTANCE_BITWIDTH - 1, NODE_ID_BITWIDTH);
593 |                 end_flag = packed_output.range(bits_per_output - 1, NODE_ID_BITWIDTH + DISTANCE_BITWIDTH);
594 | 
595 |                 if (end_flag != 0) break;
596 | 
597 |                 int local_id = local_id_pod;
598 |                 if (p_graph.vtx_map_rev.count(local_id) == 0) continue;
599 | 
600 |                 int global_id = p_graph.vtx_map_rev.at(local_id);
601 |                 if (global_id >= m_num_vertices) continue;
602 | 
603 |                 distance_t new_dist = *reinterpret_cast<distance_t *>(&dist_pod);
604 | 
605 |                 if (min_distances.find(global_id) == min_distances.end() || new_dist < min_distances[global_id]) {
606 |                     min_distances[global_id] = new_dist;
607 |                 }
608 |             }
609 |             if (end_flag != 0) break;
610 |         }
611 |     }
612 | 
613 |     for (auto const &[global_id, new_dist] : min_distances) {
614 |         if (global_id < m_num_vertices && new_dist < h_distances[global_id]) {
615 |             h_distances[global_id] = new_dist;
616 |             changed = true;
617 |         }
618 |     }
619 | 
620 |     if (changed) {
621 |         std::cout << "[INFO] Distances updated. Preparing for next iteration." << std::endl;
622 |     } else {
623 |         std::cout << "[INFO] No distance updates. Algorithm has converged." << std::endl;
624 |     }
625 | 
626 |     return !changed;
627 | }
628 | 
629 | const std::vector<int> &AlgorithmHost::get_results() const {
630 |     static std::vector<int> final_distances;
631 |     final_distances.clear();
632 |     final_distances.reserve(h_distances.size());
633 | 
634 |     for (const auto &dist : h_distances) {
635 |         if (dist >= INFINITY_DIST) {
636 |             final_distances.push_back(std::numeric_limits<int>::max());
637 |         } else {
638 |             final_distances.push_back(dist.to_int());
639 |         }
640 |     }
641 |     return final_distances;
642 | }
```

