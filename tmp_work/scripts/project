 6048 |  5805 | 5715 |  551 |             }
 6049 |  5806 | 5716 |  552 |         }
 6050 |  5807 | 5717 |  553 |     }
 6051 |  5808 | 5718 |  554 | 
 6052 |  5809 | 5719 |  555 |     // if pack_count is 0, write a final end marker word
 6053 |  5810 | 5720 |  556 |     // else, put the end marker in the current write_word and write it
