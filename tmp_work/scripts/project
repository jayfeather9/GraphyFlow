10691 | 10448 |  345 |         if (cache_idx_diffs[PE_NUM - 1]) {
10692 | 10449 |  346 |             ap_uint<PE_NUM> valid_mask;
10693 | 10450 |  347 |             for (int32_t pe_idx = 0; pe_idx < PE_NUM; pe_idx++) {
10694 | 10451 |  348 | #pragma HLS UNROLL
10695 | 10452 |  349 |                 if (cache_idx_diffs[pe_idx] == 0) {
10696 | 10453 |  350 |                     valid_mask[pe_idx] = 1;
10697 | 10454 |  351 |                 } else {
10698 | 10455 |  352 |                     valid_mask[pe_idx] = 0;
10699 | 10456 |  353 |                 }
10700 | 10457 |  354 |             }
10701 | 10458 |  355 | 
