 1022 |   779 |  689 |   7 | 
 1023 |   780 |  690 |   8 | AlgorithmHost::AlgorithmHost(AccDescriptor &acc) : acc(acc) {}
 1024 |   781 |  691 |   9 | 
 1025 |   782 |  692 |  10 | void AlgorithmHost::prepare_data(const PartitionContainer &container,
 1026 |   783 |  693 |  11 |                                  int start_node) {
 1027 |   784 |  694 |  12 |     std::cout << "--- [Host] Phase 0: Preparing data structures ---"
 1028 |   785 |  695 |  13 |               << std::endl;
 1029 |   786 |  696 |  14 | 
 1030 |   787 |  697 |  15 |     // 1. Initialize algorithm state
 1031 |   788 |  698 |  16 |     m_num_vertices = container.num_graph_vertices;
 1032 |   789 |  699 |  17 |     h_distances.assign(m_num_vertices, distance_t(INFINITY_DIST));
 1033 |   790 |  700 |  18 |     if (start_node >= 0 && start_node < m_num_vertices) {
 1034 |   791 |  701 |  19 |         h_distances[start_node] = 0;
 1035 |   792 |  702 |  20 |     }
 1036 |   793 |  703 |  21 | 
 1037 |   794 |  704 |  22 |     // 2. Prepare host-side input buffers for each kernel
 1038 |   795 |  705 |  23 |     const size_t bytes_per_word = AXI_BUS_WIDTH / 8;
 1039 |   796 |  706 |  24 |     big_kernel_input_buffers.resize(container.SPs.size());
 1040 |   797 |  707 |  25 |     little_kernel_input_buffers.resize(container.DPs.size());
 1041 |   798 |  708 |  26 |     hbm_manager_host_buffers.resize(1);
 1042 |   799 |  709 |  27 | 
 1043 |   800 |  710 |  28 |     auto start_time = std::chrono::system_clock::now();
 1044 |   801 |  711 |  29 |     auto current_time = start_time;
 1045 |   802 |  712 |  30 | 
 1046 |   803 |  713 |  31 | 
 1047 |   804 |  714 |  32 |     std::cout<<"DEBUG big:"<<big_kernel_input_buffers.size()<<"little :"<<little_kernel_input_buffers.size()<<std::endl;
 1048 |   805 |  715 |  33 |     // --- 2.1: 为 BIG kernels 手动序列化数据 (带 Padding) ---
 1049 |   806 |  716 |  34 |     // DISABLED FOR LITTLE KERNEL TESTING
 1050 |   807 |  717 |  35 |     /*
 1051 |   808 |  718 |  36 |     for (size_t i = 0; i < big_kernel_input_buffers.size(); ++i) {
 1052 |   809 |  719 |  37 |         const auto &p_graph = container.SPs[i].partitioned_graph;
 1053 |   810 |  720 |  38 | 
 1054 |   811 |  721 |  39 |         // --- Pack node distances (ap_fixed<24,8> -> 3 bytes) ---
 1055 |   812 |  722 |  40 |         {
 1056 |   813 |  723 |  41 |             const size_t bytes_per_dist = DISTANCE_BITWIDTH / 8;
 1057 |   814 |  724 |  42 |             const size_t dist_per_word = bytes_per_word / bytes_per_dist;
 1058 |   815 |  725 |  43 |             const size_t word_number =
 1059 |   816 |  726 |  44 |                 (p_graph.num_vertices + dist_per_word - 1) / dist_per_word;
 1060 |   817 |  727 |  45 |             std::vector<char> temp_byte_buffer;
 1061 |   818 |  728 |  46 |             temp_byte_buffer.reserve(word_number * bytes_per_word);
