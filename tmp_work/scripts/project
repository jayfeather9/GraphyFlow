 6307 |  6064 | 5974 |  810 | static void Reduc_105_pre_process(
 6308 |  6065 | 5975 |  811 |     hls::stream<struct_ibu_14_t> &i_global_data_0,
 6309 |  6066 | 5976 |  812 |     hls::stream<struct_nbu_11_t> &i_global_data_1,
 6310 |  6067 | 5977 |  813 |     hls::stream<struct_abu_9_t> &i_global_data_2,
 6311 |  6068 | 5978 |  814 |     hls::stream<struct_abu_9_t> &i_global_data_3,
 6312 |  6069 | 5979 |  815 |     hls::stream<struct_ibu_14_t> &intermediate_key,
 6313 |  6070 | 5980 |  816 |     hls::stream<internal_end_data_batch_t> &intermediate_transform) {
 6314 |  6071 | 5981 |  817 |     struct_ibu_14_t in_batch_i_global_data_0;
