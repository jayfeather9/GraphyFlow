19533 |  100 | ap_uint<4> count_end_ones(ap_uint<PE_NUM> valid_mask) {
19534 |  101 | #pragma HLS INLINE
19535 |  102 |     ap_uint<4> count = 0;
19536 |  103 |     switch (valid_mask) {
19537 |  104 |     case 0:
19538 |  105 |         count = 0;
19539 |  106 |         break;
19540 |  107 |     case 1:
19541 |  108 |         count = 1;
19542 |  109 |         break;
19543 |  110 |     case 3:
19544 |  111 |         count = 2;
19545 |  112 |         break;
19546 |  113 |     case 7:
19547 |  114 |         count = 3;
19548 |  115 |         break;
19549 |  116 |     case 15:
19550 |  117 |         count = 4;
19551 |  118 |         break;
19552 |  119 |     case 31:
19553 |  120 |         count = 5;
19554 |  121 |         break;
19555 |  122 |     case 63:
19556 |  123 |         count = 6;
19557 |  124 |         break;
19558 |  125 |     case 127:
19559 |  126 |         count = 7;
19560 |  127 |         break;
19561 |  128 |     case 255:
19562 |  129 |         count = 8;
19563 |  130 |         break;
19564 |  131 |     default:
19565 |  132 |         break;
19566 |  133 |     }
19567 |  134 |     return count;
19568 |  135 | }
