 6369 |  6126 | 6036 |  872 |         end_flag = in_batch_i_global_data_0.end_flag;
 6370 |  6127 | 6037 |  873 |         if (end_flag) {
 6371 |  6128 | 6038 |  874 |             break;
 6372 |  6129 | 6039 |  875 |         }
