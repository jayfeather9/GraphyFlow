10181 |  9938 | 142 |             // lower-range IDs
10182 |  9939 | 143 |             for (int global_id : partition_dst_nodes) {
10183 |  9940 | 144 |                 p_graph.vtx_map[global_id] = local_id_counter;
10184 |  9941 | 145 |                 p_graph.vtx_map_rev[local_id_counter] = global_id;
10185 |  9942 | 146 |                 local_id_counter++;
10186 |  9943 | 147 |             }
