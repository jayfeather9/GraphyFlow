 3 | bool host_bellman_ford_iteration(const GraphCSR &graph,
 4 |                                  std::vector<int> &distances) {
 5 |     bool changed = false;
 6 | 
 7 |     // --- USER MODIFIABLE SECTION: Host Computation Logic ---
 8 |     // For each vertex, relax all outgoing edges
 9 |     for (int u = 0; u < graph.num_vertices; ++u) {
10 |         if (distances[u] != INFINITY_DIST) {
11 |             for (int i = graph.offsets[u]; i < graph.offsets[u + 1]; ++i) {
12 |                 int v = graph.columns[i];
13 |                 if ((v & 0x40000000) != 0) {
14 |                     continue; // Skip dummy edges
15 |                 }
16 |                 int weight = graph.weights[i];
17 | 
18 |                 // Relaxation step
19 |                 if (distances[u] + weight < distances[v]) {
20 |                     distances[v] = distances[u] + weight;
21 |                     changed = true;
22 |                 }
23 |             }
24 |         }
25 |     }
26 |     // --- END USER MODIFIABLE SECTION ---
27 | 
28 |     return changed;
29 | }
