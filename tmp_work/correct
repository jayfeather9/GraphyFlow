 14 | // 主函数，从文件中加载图并转换为 CSR 格式
 15 | GraphCSR load_graph_from_file(const std::string &file_path) {
 16 |     // ---- 1. 根据文件扩展名判断图的格式 ----
 17 |     bool is_one_based = false; // 默认为 0-indexed
 18 |     char comment_char = '#';   // 默认注释符
 19 | 
 20 |     if (file_path.size() > 4 &&
 21 |         file_path.substr(file_path.size() - 4) == ".mtx") {
 22 |         is_one_based = true; // .mtx 文件通常是 1-indexed
 23 |         comment_char = '%';  // .mtx 文件使用 '%' 作为注释
 24 |         std::cout << "Detected .mtx format (1-based indexing)." << std::endl;
 25 |     } else {
 26 |         std::cout << "Detected .txt format (0-based indexing)." << std::endl;
 27 |     }
 28 | 
 29 |     // ---- 2. 打开文件并逐行解析 ----
 30 |     std::ifstream file(file_path);
 31 |     if (!file.is_open()) {
 32 |         std::cerr << "Error: Could not open graph file: " << file_path
 33 |                   << std::endl;
 34 |         exit(EXIT_FAILURE);
 35 |     }
 36 | 
 37 |     std::vector<Edge> edges;
 38 |     int max_vertex_id = -1;
 39 |     int min_vertex_id = 1;
 40 |     std::string line;
 41 |     long line_num = 0;
 42 | 
 43 |     while (std::getline(file, line)) {
 44 |         line_num++;
 45 |         // 跳过空行和注释行
 46 |         if (line.empty() || line[0] == comment_char) {
 47 |             continue;
 48 |         }
 49 | 
 50 |         std::istringstream iss(line);
 51 |         Edge edge;
 52 | 
 53 |         // 尝试读取 src, dest, weight
 54 |         if (iss >> edge.src >> edge.dest >> edge.weight) {
 55 |             // 成功读取三个值
 56 |         } else {
 57 |             // 如果失败，重置流并尝试只读取 src, dest
 58 |             iss.clear();
 59 |             iss.seekg(0);
 60 |             if (iss >> edge.src >> edge.dest) {
 61 |                 edge.weight = 1; // 赋予默认权重 1
 62 |             } else {
 63 |                 std::cerr << "Warning: Skipping malformed line " << line_num
 64 |                           << ": " << line << std::endl;
 65 |                 continue;
 66 |             }
 67 |         }
 68 | 
 69 |         // 如果是 1-based 格式，转换为 0-based
 70 |         if (is_one_based) {
 71 |             edge.src--;
 72 |             edge.dest--;
 73 |         }
 74 | 
 75 |         // 检查顶点ID是否有效
 76 |         if (edge.src < 0 || edge.dest < 0) {
 77 |             std::cerr
 78 |                 << "Warning: Skipping edge with negative vertex ID on line "
 79 |                 << line_num << std::endl;
 80 |             continue;
 81 |         }
 82 | 
 83 |         edges.push_back(edge);
 84 |         max_vertex_id = std::max({max_vertex_id, edge.src, edge.dest});
 85 |         min_vertex_id = std::min({min_vertex_id, edge.src, edge.dest});
 86 |     }
 87 |     file.close();
 88 | 
 89 |     if (min_vertex_id == 1 && !is_one_based) {
 90 |         // modify to 0-based
 91 |         std::cout << "Converting graph from 1-based to 0-based indexing."
 92 |                   << std::endl;
 93 |         for (auto &edge : edges) {
 94 |             edge.src--;
 95 |             edge.dest--;
 96 |         }
 97 |     }
 98 | 
 99 |     // ---- 3. 将边列表转换为 CSR 格式 ----
100 |     GraphCSR graph;
101 |     if (max_vertex_id == -1) { // 如果文件为空或无效
102 |         graph.num_vertices = 0;
103 |         graph.num_edges = 0;
104 |         std::cout << "Graph is empty." << std::endl;
105 |         return graph;
106 |     }
107 | 
108 |     graph.num_vertices = max_vertex_id + 1;
109 |     graph.num_edges = edges.size();
110 | 
111 |     std::cout << "Graph loaded: " << graph.num_vertices << " vertices, "
112 |               << graph.num_edges << " edges." << std::endl;
113 | 
114 |     // 为了进行 CSR 转换，按源顶点 ID 对边进行排序
115 |     std::sort(edges.begin(), edges.end(), [](const Edge &a, const Edge &b) {
116 |         if (a.src != b.src) {
117 |             return a.src < b.src;
118 |         }
119 |         return a.dest < b.dest;
120 |     });
121 | 
122 |     // 分配 CSR 数组内存
123 |     graph.offsets.resize(graph.num_vertices + 1);
124 |     graph.columns.resize(graph.num_edges);
125 |     graph.weights.resize(graph.num_edges);
126 | 
127 |     // 填充 columns 和 weights 数组，并计算每个顶点的出度
128 |     std::vector<int> out_degree(graph.num_vertices, 0);
129 |     for (int i = 0; i < graph.num_edges; ++i) {
130 |         graph.columns[i] = edges[i].dest;
131 |         graph.weights[i] = edges[i].weight;
132 |         out_degree[edges[i].src]++;
133 |     }
134 | 
135 |     // 通过出度的前缀和计算 offsets 数组
136 |     graph.offsets[0] = 0;
137 |     for (int i = 0; i < graph.num_vertices; ++i) {
138 |         graph.offsets[i + 1] = graph.offsets[i] + out_degree[i];
139 |     }
140 | 
141 |     return graph;
142 | }
