 343 |             const size_t edges_per_word = bytes_per_word / bytes_per_edge;
 344 | 
 345 |             // Check if this pipeline has no edges - if so, add 8 dummy edges
 346 |             const size_t actual_edges =
 347 |                 (pipeline_edges.num_edges == 0) ? 8 : pipeline_edges.num_edges;
 348 |             const size_t word_number =
 349 |                 (actual_edges + edges_per_word - 1) / edges_per_word;
 350 |             std::vector<char> temp_byte_buffer;
 351 |             temp_byte_buffer.reserve(word_number * bytes_per_word);
 352 | 
 353 |             if (pipeline_edges.num_edges == 0) {
 354 |                 printf(
 355 |                     "Padding DP No.%d, little pipe No.%d with 8 dummy edges.\n",
 356 |                     i, pip);
 357 |                 // Add 8 dummy edges with dst_id = 0x7FFFFFFF and src_id = 0
 358 |                 const uint32_t dummy_dst_id = 0x7FFFFFFF;
 359 |                 const uint32_t dummy_src_id = 0;
 360 | 
 361 |                 for (int dummy_idx = 0; dummy_idx < 8; ++dummy_idx) {
 362 |                     if ((temp_byte_buffer.size() % bytes_per_word) +
 363 |                             bytes_per_edge >
 364 |                         bytes_per_word) {
 365 |                         size_t padding_needed =
 366 |                             bytes_per_word -
 367 |                             (temp_byte_buffer.size() % bytes_per_word);
 368 |                         temp_byte_buffer.insert(temp_byte_buffer.end(),
 369 |                                                 padding_needed, 0);
 370 |                     }
 371 | 
 372 |                     char edge_bytes[bytes_per_edge];
 373 | 
 374 |                     // Pack dst_id (first NODE_ID_BITWIDTH bits)
 375 |                     for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
 376 |                         edge_bytes[b] = (dummy_dst_id >> (8 * b)) & 0xFF;
 377 |                     }
 378 | 
 379 |                     // Pack src_id (next NODE_ID_BITWIDTH bits)
 380 |                     for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
 381 |                         edge_bytes[(NODE_ID_BITWIDTH / 8) + b] =
 382 |                             (dummy_src_id >> (8 * b)) & 0xFF;
 383 |                     }
 384 | 
 385 |                     temp_byte_buffer.insert(temp_byte_buffer.end(), edge_bytes,
 386 |                                             edge_bytes + bytes_per_edge);
 387 |                 }
 388 |             } else {
 389 |                 // Iterate through vertices, then their edges
 390 |                 for (int v = 0; v < little_partition.num_vertices; ++v) {
 391 |                     node_id_t src_id = v;
 392 |                     for (int edge_idx = pipeline_edges.offsets[v];
 393 |                          edge_idx < pipeline_edges.offsets[v + 1]; ++edge_idx) {
 394 |                         if ((temp_byte_buffer.size() % bytes_per_word) +
 395 |                                 bytes_per_edge >
 396 |                             bytes_per_word) {
 397 |                             size_t padding_needed =
 398 |                                 bytes_per_word -
 399 |                                 (temp_byte_buffer.size() % bytes_per_word);
 400 |                             temp_byte_buffer.insert(temp_byte_buffer.end(),
 401 |                                                     padding_needed, 0);
 402 |                         }
 403 | 
 404 |                         char edge_bytes[bytes_per_edge];
 405 |                         uint32_t dest_id = pipeline_edges.columns[edge_idx];
 406 | 
 407 |                         // Pack dst_id (first NODE_ID_BITWIDTH bits)
 408 |                         for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
 409 |                             edge_bytes[b] = (dest_id >> (8 * b)) & 0xFF;
 410 |                         }
 411 | 
 412 |                         // Pack src_id (next NODE_ID_BITWIDTH bits)
 413 |                         for (int b = 0; b < NODE_ID_BITWIDTH / 8; ++b) {
 414 |                             edge_bytes[(NODE_ID_BITWIDTH / 8) + b] =
 415 |                                 (src_id >> (8 * b)) & 0xFF;
 416 |                         }
 417 | 
 418 |                         temp_byte_buffer.insert(temp_byte_buffer.end(),
 419 |                                                 edge_bytes,
 420 |                                                 edge_bytes + bytes_per_edge);
 421 |                     }
 422 |                 }
 423 |             }
 424 |             dense_buffers[i].pipelines[pip].packed_edge_props.resize(
 425 |                 (temp_byte_buffer.size() + bytes_per_word - 1) / bytes_per_word,
 426 |                 0);
 427 |             std::memcpy(
 428 |                 dense_buffers[i].pipelines[pip].packed_edge_props.data(),
 429 |                 temp_byte_buffer.data(), temp_byte_buffer.size());
 430 |         }
 431 | 
 432 |         current_time = std::chrono::system_clock::now();
 433 |         std::cout
 434 |             << "--- [Host] Phase 0: Prepared " << LITTLE_KERNEL_NUM
 435 |             << " little pipeline edge props ("
 436 |             << std::chrono::duration<double>(current_time - start_time).count()
 437 |             << " sec) ---" << std::endl;
 438 |         start_time = current_time;
 439 |     }
 440 | 
 441 |     // apply kernel node props should be first each little partition's dst
 442 |     // props, then each big partition's dst props
 443 |     size_t total_little_dst_words = dense_dst_offset;
 444 |     size_t total_big_dst_words = sparse_dst_offset;
 445 |     size_t total_little_node_words = dense_node_offset;
 446 |     size_t total_big_node_words = sparse_node_offset;
 447 | 
 448 |     apply_kernel_node_props.assign(total_little_dst_words + total_big_dst_words,
 449 |                                    0);
 450 |     for (int i = 0; i < container.num_dense_partitions; ++i) {
 451 |         std::copy(dense_buffers[i].packed_dst_props.begin(),
 452 |                   dense_buffers[i].packed_dst_props.end(),
 453 |                   apply_kernel_node_props.begin() +
 454 |                       dense_buffers[i].dst_prop_offset);
 455 |     }
 456 |     big_dst_offset = total_little_dst_words;
